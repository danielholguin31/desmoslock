{
  "name": "desmoslock",
  "productName": "DesmosLock",
  "version": "1.0.1",
  "private": true,
  "description": "Locked-down Desmos graphing calculator for exams",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "build:vendor": "esbuild build/vendor-entry.js --bundle --format=iife --global-name=SupabaseSDK --minify --target=chrome110 --outfile=renderer/vendor/supabase.js",
    "test:recovery": "node --test test/force-quit-recovery.test.js",
    "test:provenance": "node --test test/release-provenance.test.js"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "7zip-bin": "5.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "app.desmoslock.client",
    "productName": "DesmosLock",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "notarize": false,
      "identity": "-",
      "sign": "./scripts/sign-macos-adhoc.js",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2"
  }
}
