# DesmosLock v2 uses the disposable local Supabase stack by default.
# Run `supabase status -o env` after `npm run db:start` and copy only the
# development values needed by a local process. Never copy production values
# into this file or a client bundle.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
