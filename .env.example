# Copy to .env and fill in. .env is gitignored.
#
# The desktop app does NOT read this file — it ships the publishable key in
# desktop/renderer/config.js, which is correct: that key is designed for
# clients and grants nothing without a signed-in user. These values are for
# server-side tooling and migrations.

SUPABASE_URL=https://xoholqrbhgffivvklpvd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_AccnNR1GRBajugI-Qu0cuQ_RC9V-KDi
SUPABASE_JWKS_URL=https://xoholqrbhgffivvklpvd.supabase.co/auth/v1/.well-known/jwks.json

# Never put this in the desktop app or any client bundle — it bypasses every
# row-level security policy and can read every classroom's data.
SUPABASE_SECRET_KEY=

# Applying migrations.
#
# The direct host (db.<ref>.supabase.co) resolves to IPv6 only, which fails on
# networks without an IPv6 route. The IPv4 pooler for this project is:
#   host  aws-1-us-west-2.pooler.supabase.com
#   port  5432          (session mode — required for DDL)
#   user  postgres.xoholqrbhgffivvklpvd
#
# Percent-encode any special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.xoholqrbhgffivvklpvd:YOUR_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
