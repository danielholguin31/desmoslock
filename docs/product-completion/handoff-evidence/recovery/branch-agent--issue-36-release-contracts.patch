+    throw new TypeError(`${path} must be a positive safe integer`);
+  }
+  return value as number;
+}
+
+const exactProhibitedEvidenceFields = new Set([
+  "api_key",
+  "authorization",
+  "cookie",
+  "credential",
+  "password",
+  "passphrase",
+  "private_key",
+  "secret",
+  "stderr",
+  "stdout",
+  "token",
