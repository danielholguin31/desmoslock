+function assertInventoryRollbackAuthority(
+  receipt: InternalGatekeeperReceipt,
+  authority: AuthenticatedTrustedRollbackInventory,
+  trustRoot: ReleaseEvidenceVerificationContext,
+): string {
+  assertAuthenticatedRollbackInventory(authority, trustRoot);
+  const release = authority.release;
+  const previous = receipt.rollback.artifacts[1];
+  if (previous.trust.kind !== "trusted-inventory") {
+    throw new TypeError(
+      "Gatekeeper receipt.rollback previous trust must use the supplied trusted inventory",
+    );
+  }
+  assertMatches(
+    readSha256(
+      previous.trust.bindingSha256,
+      "Gatekeeper receipt.rollback.artifacts[1].trust.bindingSha256",
+    ),
+    authority.bindingSha256,
+    "Gatekeeper receipt.rollback.artifacts[1].trust.bindingSha256",
+    "the external trusted inventory binding",
+  );
+  const comparisons = [
+    ["certificateSha256", readSha256] as const,
+    ["developerTeamId", readTeamId] as const,
+    ["installerSha256", readSha256] as const,
+    ["sourceCommitSha", readGitCommitSha] as const,
+    ["version", readStableVersion] as const,
+  ];
+  for (const [field, reader] of comparisons) {
+    assertMatches(
+      reader(
+        previous[field],
+        `Gatekeeper receipt.rollback.artifacts[1].${field}`,
+      ),
+      reader(
+        release[field],
+        `authenticated rollback inventory.release.${field}`,
+      ),
+      `Gatekeeper receipt.rollback.artifacts[1].${field}`,
+      "the external trusted inventory release",
+    );
+  }
+  readLiteral(
+    release.sourceRepository,
+    "danielholguin31/desmoslock",
+    "authenticated rollback inventory.release.sourceRepository",
+  );
+  assertMatches(
+    previous.sourceRepository,
+    release.sourceRepository as "danielholguin31/desmoslock",
+    "Gatekeeper receipt.rollback.artifacts[1].sourceRepository",
+    "the external trusted inventory release",
+  );
+  return authority.signedEvidence.payloadSha256;
+}
+
+function assertVerifiedRollbackAuthority(
+  receipt: InternalGatekeeperReceipt,
+  authority: Record<string, unknown>,
+  releasePolicy: AuthenticatedInternalReleasePolicy,
+  trustRoot: ReleaseEvidenceVerificationContext,
+  acceptanceStates: WeakMap<object, GatekeeperAcceptanceTrustState>,
+): string {
+  assertExactKeys(
+    authority,
+    ["acceptance", "kind", "provenance"],
+    "rollback authority",
+  );
+  readLiteral(
+    authority.kind,
+    "module-verified-release",
+    "rollback authority.kind",
+  );
+  assertVerifiedInternalReleaseProvenance(authority.provenance);
+  assertVerifiedAcceptance(authority.acceptance, acceptanceStates);
+  const priorTrustState = acceptanceStates.get(authority.acceptance);
+  if (priorTrustState?.provenance !== authority.provenance) {
+    throw new TypeError(
+      "Rollback authority acceptance is not bound to the supplied verified provenance",
+    );
+  }
+  if (priorTrustState.trustRoot !== trustRoot) {
+    throw new TypeError(
+      "Rollback authority was approved by a different release-evidence capability instance",
+    );
+  }
+  if (
+    priorTrustState.trustRootFingerprintSha256 !==
+    trustRoot.trustRootFingerprintSha256
+  ) {
+    throw new TypeError(
+      "Rollback authority was approved by a different release-evidence trust root",
+    );
+  }
+  if (
+    priorTrustState.policyLineageSha256 !==
+    releasePolicy.rollbackPolicyLineage.lineageSha256
+  ) {
+    throw new TypeError(
+      "Rollback authority was approved under a disjoint release policy",
+    );
+  }
+  const currentPolicyFingerprintSha256 =
+    releasePolicy.signedEvidence.payloadSha256;
+  if (
+    priorTrustState.policyFingerprintSha256 !==
+      currentPolicyFingerprintSha256 &&
+    !releasePolicy.rollbackPolicyLineage.allowedPreviousPolicySha256s.includes(
+      priorTrustState.policyFingerprintSha256,
+    )
+  ) {
+    throw new TypeError(
+      "Rollback authority prior policy is not allowed by the current signed policy lineage",
+    );
+  }
+  const previous = receipt.rollback.artifacts[1];
+  if (previous.trust.kind !== "module-verified-release") {
+    throw new TypeError(
+      "Gatekeeper receipt.rollback previous trust must identify a module-verified release",
+    );
+  }
+  assertMatches(
+    previous.version,
+    authority.acceptance.identity.version,
+    "Gatekeeper receipt.rollback.artifacts[1].version",
+    "the module-verified prior release",
+  );
+  assertMatches(
+    previous.sourceCommitSha,
+    authority.acceptance.identity.sourceCommitSha,
+    "Gatekeeper receipt.rollback.artifacts[1].sourceCommitSha",
+    "the module-verified prior release",
+  );
+  assertMatches(
+    previous.sourceRepository,
+    authority.acceptance.identity.sourceRepository,
+    "Gatekeeper receipt.rollback.artifacts[1].sourceRepository",
+    "the module-verified prior release",
+  );
+  assertMatches(
+    previous.installerSha256,
+    authority.acceptance.artifacts[1].sha256,
+    "Gatekeeper receipt.rollback.artifacts[1].installerSha256",
+    "the module-verified prior release",
+  );
+  assertMatches(
+    previous.developerTeamId,
+    authority.acceptance.developerId.teamId,
+    "Gatekeeper receipt.rollback.artifacts[1].developerTeamId",
+    "the module-verified prior release",
+  );
+  assertMatches(
+    previous.certificateSha256,
+    authority.acceptance.developerId.certificateSha256,
+    "Gatekeeper receipt.rollback.artifacts[1].certificateSha256",
+    "the module-verified prior release",
+  );
+  return hashCanonicalReleaseEvidence(
+    {
+      acceptanceSha256: hashCanonicalReleaseEvidence(
+        authority.acceptance,
+        trustRoot,
+        "module-verified rollback acceptance digest",
+      ),
+      kind: "module-verified-release",
+      policyFingerprintSha256: priorTrustState.policyFingerprintSha256,
+      policyLineageSha256: priorTrustState.policyLineageSha256,
+      provenanceSha256: hashCanonicalReleaseEvidence(
+        authority.provenance,
+        trustRoot,
+        "module-verified rollback provenance digest",
+      ),
+      trustRootFingerprintSha256: priorTrustState.trustRootFingerprintSha256,
+    },
+    trustRoot,
+    "module-verified rollback authority digest",
+  );
+}
+
+interface EvaluatedGatekeeperAcceptance {
+  readonly receipt: InternalGatekeeperReceipt;
+  readonly trustState: GatekeeperAcceptanceTrustState;
+}
+
+function evaluateInternalGatekeeperAcceptance(
+  receiptInput: InternalGatekeeperReceipt,
+  provenance: InternalReleaseProvenance,
+  authorizationInput: unknown,
+  trustRoot: ReleaseEvidenceVerificationContext,
+  priorAcceptanceStates: WeakMap<object, GatekeeperAcceptanceTrustState>,
+): EvaluatedGatekeeperAcceptance {
+  const receipt = parseInternalGatekeeperReceipt(receiptInput);
+  assertVerifiedInternalReleaseProvenance(provenance);
+  const authorization = snapshotDescriptorRecord(
+    authorizationInput,
+    "Gatekeeper authorization",
+  );
+  assertExactKeys(
+    authorization,
+    ["collectorWitness", "releasePolicy", "rollbackAuthority"],
+    "Gatekeeper authorization",
+  );
+  assertAuthenticatedCollectorWitness(
+    authorization.collectorWitness,
+    trustRoot,
+  );
+  assertAuthenticatedReleasePolicy(authorization.releasePolicy, trustRoot);
+  const collectorWitness = authorization.collectorWitness;
+  const releasePolicy = authorization.releasePolicy;
+  const policy = releasePolicy.policy;
+  const policyFingerprintSha256 = releasePolicy.signedEvidence.payloadSha256;
+  assertVerifiedInternalReleaseExpectation(
+    provenance,
+    policy.release,
+    "Gatekeeper trust policy.release",
+  );
+  assertReceiptMatchesProvenance(receipt, provenance);
+  assertApprovedDeveloperId(receipt, policy);
+
+  let rollbackAuthority: InternalRollbackAuthority;
+  let rollbackAuthoritySha256: string;
+  if (
+    typeof authorization.rollbackAuthority === "object" &&
+    authorization.rollbackAuthority !== null &&
+    authenticatedRollbackInventories.has(authorization.rollbackAuthority)
+  ) {
+    assertAuthenticatedRollbackInventory(
+      authorization.rollbackAuthority,
+      trustRoot,
+    );
+    rollbackAuthority = authorization.rollbackAuthority;
+    rollbackAuthoritySha256 = assertInventoryRollbackAuthority(
+      receipt,
+      rollbackAuthority,
+      trustRoot,
+    );
+  } else {
+    const moduleAuthority = snapshotDescriptorRecord(
+      authorization.rollbackAuthority,
+      "rollback authority",
+    );
+    const kind = readString(moduleAuthority.kind, "rollback authority.kind");
+    if (kind !== "module-verified-release") {
+      throw new TypeError(
+        "rollback authority must be an authenticated inventory or module-verified release",
+      );
+    }
+    rollbackAuthoritySha256 = assertVerifiedRollbackAuthority(
+      receipt,
+      moduleAuthority,
+      releasePolicy,
+      trustRoot,
+      priorAcceptanceStates,
+    );
+    rollbackAuthority = moduleAuthority as unknown as InternalRollbackAuthority;
+  }
+
+  const witness = collectorWitness.witness;
+  assertMatches(
+    witness.receiptSha256,
+    hashCanonicalReleaseEvidence(
+      receipt,
+      trustRoot,
+      "Gatekeeper receipt canonical digest",
+    ),
+    "collector witness.receiptSha256",
+    "the exact parsed Gatekeeper receipt",
+  );
+  assertMatches(
+    witness.provenanceSha256,
+    hashCanonicalReleaseEvidence(
+      provenance,
+      trustRoot,
+      "release provenance canonical digest",
+    ),
+    "collector witness.provenanceSha256",
+    "the exact verified release provenance",
+  );
+  assertMatches(
+    witness.releasePolicySha256,
+    policyFingerprintSha256,
+    "collector witness.releasePolicySha256",
+    "the authenticated release policy",
+  );
+  assertMatches(
+    witness.rollbackAuthoritySha256,
+    rollbackAuthoritySha256,
+    "collector witness.rollbackAuthoritySha256",
+    "the authenticated rollback authority",
+  );
+  consumeCollectorWitnessReplayNonce(
+    collectorWitness.signedEvidence,
+    witness.witnessId,
+    trustRoot,
+  );
+
+  return {
+    receipt,
+    trustState: {
+      authorization: {
+        collectorWitness,
+        releasePolicy,
+        rollbackAuthority,
+      },
+      policyFingerprintSha256,
+      policyLineageSha256: releasePolicy.rollbackPolicyLineage.lineageSha256,
+      provenance,
+      trustRoot,
+      trustRootFingerprintSha256: trustRoot.trustRootFingerprintSha256,
+    },
+  };
+}
+
+export function verifyInternalGatekeeperAcceptance(
+  receiptInput: InternalGatekeeperReceipt,
+  provenance: InternalReleaseProvenance,
+  authorizationInput: unknown,
+  trustRoot: PinnedReleaseEvidenceTrustRoot,
+): InternalGatekeeperAcceptance {
+  assertPinnedReleaseEvidenceTrustRoot(trustRoot);
+  const evaluated = evaluateInternalGatekeeperAcceptance(
+    receiptInput,
+    provenance,
+    authorizationInput,
+    trustRoot,
+    verifiedInternalGatekeeperAcceptances,
+  );
+  const accepted = cloneAndFreezeEvidence(
+    evaluated.receipt,
+  ) as InternalGatekeeperAcceptance;
+  verifiedInternalGatekeeperAcceptances.set(accepted, evaluated.trustState);
+  return accepted;
+}
+
+/**
+ * @internal Test-only semantic inspection for caller-injected cryptographic
+ * adapters. Its result is deliberately unbranded and cannot authorize a
+ * production release or production rollback.
+ */
+export function inspectInternalGatekeeperAcceptanceForTests(
+  receiptInput: InternalGatekeeperReceipt,
+  provenance: InternalReleaseProvenance,
+  authorizationInput: unknown,
+  trustRoot: UntrustedReleaseEvidenceTestContext,
+): InternalGatekeeperReceipt {
+  assertUntrustedReleaseEvidenceTestContext(trustRoot);
+  const evaluated = evaluateInternalGatekeeperAcceptance(
+    receiptInput,
+    provenance,
+    authorizationInput,
+    trustRoot,
+    inspectedInternalGatekeeperAcceptances,
+  );
+  const inspected = cloneAndFreezeEvidence(evaluated.receipt);
+  inspectedInternalGatekeeperAcceptances.set(inspected, evaluated.trustState);
+  return inspected;
+}
