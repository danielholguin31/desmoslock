+/** Validates an expectation already captured by snapshotDescriptorEvidence. */
+export function parseCapturedInternalReleaseExpectation(
+  value: unknown,
+  path: string,
+): InternalReleaseExpectation {
+  const expected = readExactRecord(
+    value,
+    [
+      "applicationFileName",
+      "architectures",
+      "build",
+      "bundleIdentifier",
+      "dependencyLockSha256",
+      "installerFileName",
+      "minimumMacOSVersion",
+      "sourceCommitSha",
+      "version",
+    ],
+    path,
+  );
+  const expectedBuild = readExactRecord(
+    expected.build,
+    [
+      "electronBuilderVersion",
+      "electronVersion",
+      "macOSSDKVersion",
+      "macOSVersion",
+      "nodeVersion",
+      "npmVersion",
+      "runnerArchitecture",
+      "runnerImage",
+      "xcodeBuildVersion",
+      "xcodeVersion",
+    ],
+    `${path}.build`,
+  );
+
+  readFileName(
+    expected.applicationFileName,
+    ".app",
+    `${path}.applicationFileName`,
+  );
+  readArchitectures(expected.architectures, `${path}.architectures`);
+  readBundleIdentifier(expected.bundleIdentifier, `${path}.bundleIdentifier`);
+  readSha256(expected.dependencyLockSha256, `${path}.dependencyLockSha256`);
+  readFileName(expected.installerFileName, ".dmg", `${path}.installerFileName`);
+  readStableVersion(
+    expected.minimumMacOSVersion,
+    `${path}.minimumMacOSVersion`,
+  );
+  readGitCommitSha(expected.sourceCommitSha, `${path}.sourceCommitSha`);
+  readStableVersion(expected.version, `${path}.version`);
+
+  for (const field of [
+    "electronBuilderVersion",
+    "electronVersion",
+    "nodeVersion",
+    "npmVersion",
+  ] as const) {
+    readStableVersion(expectedBuild[field], `${path}.build.${field}`);
+  }
+  for (const field of [
+    "macOSSDKVersion",
+    "macOSVersion",
+    "xcodeVersion",
+  ] as const) {
+    readDottedVersion(expectedBuild[field], `${path}.build.${field}`);
+  }
+  const runnerArchitecture = readString(
+    expectedBuild.runnerArchitecture,
+    `${path}.build.runnerArchitecture`,
+  );
+  if (runnerArchitecture !== "arm64" && runnerArchitecture !== "x64") {
+    throw new TypeError(
+      `${path}.build.runnerArchitecture must be a supported macOS architecture`,
+    );
+  }
+  const runnerImage = readString(
+    expectedBuild.runnerImage,
+    `${path}.build.runnerImage`,
+  );
+  if (!/^[a-z0-9][a-z0-9._-]{0,63}$/u.test(runnerImage)) {
+    throw new TypeError(`${path}.build.runnerImage must be exact`);
+  }
+  const xcodeBuildVersion = readString(
+    expectedBuild.xcodeBuildVersion,
+    `${path}.build.xcodeBuildVersion`,
+  );
+  if (!/^[0-9]{1,3}[A-Z][0-9A-Za-z]{1,8}$/u.test(xcodeBuildVersion)) {
+    throw new TypeError(`${path}.build.xcodeBuildVersion must be exact`);
+  }
+
+  return cloneAndFreezeEvidence(
+    expected as unknown as InternalReleaseExpectation,
+  );
+}
+
+function assertReleaseExpectationsMatch(
+  actual: InternalReleaseExpectation,
+  expected: InternalReleaseExpectation,
+  path: string,
+): void {
+  for (const field of [
+    "applicationFileName",
+    "bundleIdentifier",
+    "dependencyLockSha256",
+    "installerFileName",
+    "minimumMacOSVersion",
+    "sourceCommitSha",
+    "version",
+  ] as const) {
+    assertMatches(
+      actual[field],
+      expected[field],
+      `${path}.${field}`,
+      "the provenance-approved release expectation",
+    );
+  }
+  for (const index of [0, 1] as const) {
+    assertMatches(
+      actual.architectures[index],
+      expected.architectures[index],
+      `${path}.architectures[${index}]`,
+      "the provenance-approved release expectation",
+    );
+  }
+  for (const field of [
+    "electronBuilderVersion",
+    "electronVersion",
+    "macOSSDKVersion",
+    "macOSVersion",
+    "nodeVersion",
+    "npmVersion",
+    "runnerArchitecture",
+    "runnerImage",
+    "xcodeBuildVersion",
+    "xcodeVersion",
+  ] as const) {
+    assertMatches(
+      actual.build[field],
+      expected.build[field],
+      `${path}.build.${field}`,
+      "the provenance-approved release expectation",
+    );
+  }
+}
+
+export function assertVerifiedInternalReleaseProvenance(
+  value: unknown,
+): asserts value is InternalReleaseProvenance {
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    !verifiedInternalReleaseProvenances.has(value)
+  ) {
+    throw new TypeError(
+      "Gatekeeper acceptance requires verified provenance from parseInternalReleaseProvenance",
+    );
+  }
+}
+
+export function assertVerifiedInternalReleaseExpectation(
+  provenance: InternalReleaseProvenance,
+  expectation: InternalReleaseExpectation,
+  path: string,
+): void {
+  assertVerifiedInternalReleaseProvenance(provenance);
+  const approved = verifiedInternalReleaseProvenances.get(provenance);
+  if (approved === undefined) {
+    throw new TypeError(
+      "Verified provenance is missing its release expectation",
+    );
+  }
+  assertReleaseExpectationsMatch(expectation, approved, path);
+}
