+    signature.algorithm,
+    "ed25519",
+    `${expectedPurpose} signed evidence.signature.algorithm`,
+  );
+  readLiteral(
+    signature.purpose,
+    expectedPurpose,
+    `${expectedPurpose} signed evidence.signature.purpose`,
+  );
+  const keyId = readKeyId(
+    signature.keyId,
+    `${expectedPurpose} signed evidence.signature.keyId`,
+  );
+  const publicKeySha256 = readSha256(
+    signature.publicKeySha256,
+    `${expectedPurpose} signed evidence.signature.publicKeySha256`,
+  );
+  const signatureBase64 = readSignatureBase64(
+    signature.signatureBase64,
+    `${expectedPurpose} signed evidence.signature.signatureBase64`,
+  );
+  const pinnedSigner = state.signersByKeyId.get(keyId);
+  if (pinnedSigner === undefined || pinnedSigner.purpose !== expectedPurpose) {
+    throw new TypeError(
+      `${expectedPurpose} signed evidence uses an unknown or wrong-purpose signer`,
+    );
+  }
+  assertMatches(
+    publicKeySha256,
+    pinnedSigner.publicKeySha256,
+    `${expectedPurpose} signed evidence.signature.publicKeySha256`,
+    "the pinned signer public key",
+  );
+  let signatureValid: boolean;
+  try {
+    signatureValid =
+      state.port.verifyEd25519({
+        canonicalPayloadUtf8,
+        keyId,
+        publicKeySha256,
+        signatureBase64,
+      }) === true;
+  } catch {
+    signatureValid = false;
+  }
+  if (!signatureValid) {
+    throw new TypeError(
+      `${expectedPurpose} cryptographic signature is invalid or unverifiable`,
+    );
+  }
+
+  const authenticated = cloneAndFreezeEvidence(
+    envelope as unknown as SignedReleaseEvidenceEnvelope,
+  ) as AuthenticatedSignedReleaseEvidence;
+  authenticatedEnvelopeStates.set(authenticated, {
+    purpose: expectedPurpose,
+    trustRoot,
+  });
+  return authenticated;
+}
+
+export function assertAuthenticatedSignedReleaseEvidence(
+  value: unknown,
+  expectedPurpose: ReleaseEvidencePurpose,
+  trustRoot: ReleaseEvidenceVerificationContext,
+): asserts value is AuthenticatedSignedReleaseEvidence {
+  assertVerificationContext(trustRoot);
+  if (typeof value !== "object" || value === null) {
+    throw new TypeError(
+      `${expectedPurpose} requires authenticated signed evidence`,
+    );
+  }
+  const state = authenticatedEnvelopeStates.get(value);
+  if (state?.purpose !== expectedPurpose || state.trustRoot !== trustRoot) {
+    throw new TypeError(
+      `${expectedPurpose} requires evidence authenticated by the supplied pinned trust root`,
+    );
+  }
+}
+
+export function hashCanonicalReleaseEvidence(
+  value: unknown,
+  trustRoot: ReleaseEvidenceVerificationContext,
+  path: string,
+): string {
+  const state = getTrustRootState(trustRoot);
+  return callSha256(state, canonicalizeReleaseEvidence(value), path);
+}
+
+export function consumeCollectorWitnessReplayNonce(
+  witness: AuthenticatedSignedReleaseEvidence,
+  replayNonce: string,
+  trustRoot: ReleaseEvidenceVerificationContext,
+): void {
+  assertAuthenticatedSignedReleaseEvidence(
+    witness,
+    "collector-witness",
+    trustRoot,
+  );
+  const state = getTrustRootState(trustRoot);
+  let consumed: boolean;
+  try {
+    consumed =
+      state.port.consumeReplayNonce({
+        collectorWitnessSha256: witness.payloadSha256,
+        replayNonce,
+        signerKeyId: witness.signature.keyId,
+        trustRootFingerprintSha256: state.fingerprintSha256,
+      }) === true;
+  } catch {
+    consumed = false;
+  }
+  if (!consumed) {
+    throw new TypeError(
+      "collector witness replay nonce was already consumed or could not be recorded",
+    );
+  }
+}
