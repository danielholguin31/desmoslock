+function assertApprovedDeveloperId(
+  receipt: InternalGatekeeperReceipt,
+  policy: InternalGatekeeperTrustPolicy,
+): void {
+  assertMatches(
+    receipt.developerId.teamId,
+    policy.developerId.approvedTeamId,
+    "Gatekeeper receipt.developerId.teamId",
+    "the externally approved Developer ID team",
+  );
+  const releaseVersion = receipt.identity.version;
+  const approvedCertificate = policy.developerId.approvedCertificates.find(
+    (certificate) =>
+      certificate.sha256 === receipt.developerId.certificateSha256,
+  );
+  if (
+    approvedCertificate === undefined ||
+    compareStableVersions(
+      releaseVersion,
+      approvedCertificate.validFromVersion,
+    ) < 0 ||
+    compareStableVersions(
+      releaseVersion,
+      approvedCertificate.validThroughVersion,
+    ) > 0
+  ) {
+    throw new TypeError(
+      "Gatekeeper receipt Developer ID certificate is not approved for this release version by the external rotation policy",
+    );
+  }
+}
