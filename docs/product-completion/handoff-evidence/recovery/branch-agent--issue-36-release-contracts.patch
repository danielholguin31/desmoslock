+): string {
+  const fileName = readString(value, path);
+  const containsUnsafeCharacter = Array.from(fileName).some((character) => {
+    const codePoint = character.codePointAt(0);
+    return (
+      character === "/" ||
+      character === "\\" ||
+      codePoint === undefined ||
+      codePoint <= 31 ||
+      codePoint === 127
+    );
+  });
