+
+export function rejectProhibitedEvidenceFields(
+  value: unknown,
+  path: string,
+  seen: WeakSet<object> = new WeakSet<object>(),
+): void {
+  if (typeof value !== "object" || value === null) return;
+  if (seen.has(value)) {
+    throw new TypeError(`${path} must not contain cyclic evidence`);
+  }
