+export function parseInternalGatekeeperReceipt(
+  input: unknown,
+): InternalGatekeeperReceipt {
+  const capturedInput = snapshotDescriptorEvidence(input, "Gatekeeper receipt");
+  rejectProhibitedEvidenceFields(capturedInput, "Gatekeeper receipt");
+  const receipt = readExactRecord(
+    capturedInput,
+    [
+      "artifacts",
+      "checksums",
+      "developerId",
+      "distribution",
+      "identity",
+      "installation",
+      "rollback",
+      "schemaVersion",
+    ],
+    "Gatekeeper receipt",
+  );
+  readLiteral(receipt.schemaVersion, 1, "Gatekeeper receipt.schemaVersion");
+  parseIdentity(receipt.identity, "Gatekeeper receipt.identity");
+  parseDistribution(receipt.distribution, "Gatekeeper receipt.distribution");
+  const developer = parseDeveloperId(
+    receipt.developerId,
+    "Gatekeeper receipt.developerId",
+  );
+  const artifacts = readExactArray(
+    receipt.artifacts,
+    2,
+    "Gatekeeper receipt.artifacts",
+  );
+  const app = parseArtifactCommon(artifacts[0], 0, developer);
+  const dmg = parseArtifactCommon(artifacts[1], 1, developer);
+  if (
+    app.finalSha256 === dmg.finalSha256 ||
+    app.preNotarySha256 === dmg.preNotarySha256
+  ) {
+    throw new TypeError(
+      "Gatekeeper receipt app and DMG artifact chains must be distinct",
+    );
+  }
+  if (app.notarizationSubmissionId === dmg.notarizationSubmissionId) {
+    throw new TypeError(
+      "Gatekeeper receipt notarization submissions must be distinct",
+    );
+  }
+
+  const checksums = readExactRecord(
+    receipt.checksums,
+    ["applicationSha256", "installerSha256"],
+    "Gatekeeper receipt.checksums",
+  );
+  assertMatches(
+    readSha256(
+      checksums.applicationSha256,
+      "Gatekeeper receipt.checksums.applicationSha256",
+    ),
+    app.finalSha256,
+    "Gatekeeper receipt.checksums.applicationSha256",
+    "the final stapled application",
+  );
+  assertMatches(
+    readSha256(
+      checksums.installerSha256,
+      "Gatekeeper receipt.checksums.installerSha256",
+    ),
+    dmg.finalSha256,
+    "Gatekeeper receipt.checksums.installerSha256",
+    "the final stapled DMG",
+  );
+
+  const installation = readExactRecord(
+    receipt.installation,
+    [
+      "cleanMachine",
+      "gatekeeperBypassUsed",
+      "installSucceeded",
+      "installerSha256",
+      "launchSucceeded",
+      "quarantinePreserved",
+      "uninstallSucceeded",
+    ],
+    "Gatekeeper receipt.installation",
+  );
+  readLiteral(
+    installation.cleanMachine,
+    true,
+    "Gatekeeper receipt.installation.cleanMachine",
+  );
+  readLiteral(
+    installation.gatekeeperBypassUsed,
+    false,
+    "Gatekeeper receipt.installation.gatekeeperBypassUsed",
+  );
+  readLiteral(
+    installation.installSucceeded,
+    true,
+    "Gatekeeper receipt.installation.installSucceeded",
+  );
+  readLiteral(
+    installation.launchSucceeded,
+    true,
+    "Gatekeeper receipt.installation.launchSucceeded",
+  );
+  readLiteral(
+    installation.quarantinePreserved,
+    true,
+    "Gatekeeper receipt.installation.quarantinePreserved",
+  );
+  readLiteral(
+    installation.uninstallSucceeded,
+    true,
+    "Gatekeeper receipt.installation.uninstallSucceeded",
+  );
+  assertMatches(
+    readSha256(
+      installation.installerSha256,
+      "Gatekeeper receipt.installation.installerSha256",
+    ),
+    dmg.finalSha256,
+    "Gatekeeper receipt.installation.installerSha256",
+    "the final stapled DMG",
+  );
+
+  const rollback = readExactRecord(
+    receipt.rollback,
+    ["artifacts", "status"],
+    "Gatekeeper receipt.rollback",
+  );
+  readLiteral(
+    rollback.status,
+    "verified",
+    "Gatekeeper receipt.rollback.status",
+  );
+  const rollbackArtifacts = readExactArray(
+    rollback.artifacts,
+    2,
+    "Gatekeeper receipt.rollback.artifacts",
+  );
+  const current = parseRollbackIdentity(
+    rollbackArtifacts[0],
+    "Gatekeeper receipt.rollback.artifacts[0]",
+  );
+  const previous = parseRollbackIdentity(
+    rollbackArtifacts[1],
+    "Gatekeeper receipt.rollback.artifacts[1]",
+  );
+  readLiteral(
+    current.role,
+    "current",
+    "Gatekeeper receipt.rollback.artifacts[0].role",
+  );
+  readLiteral(
+    current.result,
+    "installed-and-launched",
+    "Gatekeeper receipt.rollback.artifacts[0].result",
+  );
+  const currentTrust = readExactRecord(
+    current.trust,
+    ["kind"],
+    "Gatekeeper receipt.rollback.artifacts[0].trust",
+  );
+  readLiteral(
+    currentTrust.kind,
+    "current-verified-release",
+    "Gatekeeper receipt.rollback.artifacts[0].trust.kind",
+  );
+  const identity = receipt.identity as Record<string, unknown>;
+  assertMatches(
+    readSha256(
+      current.installerSha256,
+      "Gatekeeper receipt.rollback.artifacts[0].installerSha256",
+    ),
+    dmg.finalSha256,
+    "Gatekeeper receipt.rollback.artifacts[0].installerSha256",
+    "the final stapled DMG",
+  );
+  assertMatches(
+    readStableVersion(
+      current.version,
+      "Gatekeeper receipt.rollback.artifacts[0].version",
+    ),
+    readStableVersion(identity.version, "Gatekeeper receipt.identity.version"),
+    "Gatekeeper receipt.rollback.artifacts[0].version",
+    "the current release identity",
+  );
+  assertMatches(
+    readGitCommitSha(
+      current.sourceCommitSha,
+      "Gatekeeper receipt.rollback.artifacts[0].sourceCommitSha",
+    ),
+    readGitCommitSha(
+      identity.sourceCommitSha,
+      "Gatekeeper receipt.identity.sourceCommitSha",
+    ),
+    "Gatekeeper receipt.rollback.artifacts[0].sourceCommitSha",
+    "the current release identity",
+  );
+  assertMatches(
+    readTeamId(
+      current.developerTeamId,
+      "Gatekeeper receipt.rollback.artifacts[0].developerTeamId",
+    ),
+    developer.teamId,
+    "Gatekeeper receipt.rollback.artifacts[0].developerTeamId",
+    "the current Developer ID identity",
+  );
+  assertMatches(
+    readSha256(
+      current.certificateSha256,
+      "Gatekeeper receipt.rollback.artifacts[0].certificateSha256",
+    ),
+    developer.certificateSha256,
+    "Gatekeeper receipt.rollback.artifacts[0].certificateSha256",
+    "the current Developer ID certificate",
+  );
+
+  readLiteral(
+    previous.role,
+    "previous",
+    "Gatekeeper receipt.rollback.artifacts[1].role",
+  );
+  readLiteral(
+    previous.result,
+    "restored-and-launched",
+    "Gatekeeper receipt.rollback.artifacts[1].result",
+  );
+  const previousTrust = readExactRecord(
+    previous.trust,
+    Reflect.ownKeys(previous.trust as object).includes("bindingSha256")
+      ? ["bindingSha256", "kind"]
+      : ["kind"],
+    "Gatekeeper receipt.rollback.artifacts[1].trust",
+  );
+  if (previousTrust.kind === "trusted-inventory") {
+    readSha256(
+      previousTrust.bindingSha256,
+      "Gatekeeper receipt.rollback.artifacts[1].trust.bindingSha256",
+    );
+  } else {
+    readLiteral(
+      previousTrust.kind,
+      "module-verified-release",
+      "Gatekeeper receipt.rollback.artifacts[1].trust.kind",
+    );
+  }
+  const currentVersion = readStableVersion(
+    current.version,
+    "Gatekeeper receipt.rollback.artifacts[0].version",
+  );
+  const previousVersion = readStableVersion(
+    previous.version,
+    "Gatekeeper receipt.rollback.artifacts[1].version",
+  );
+  if (compareStableVersions(previousVersion, currentVersion) >= 0) {
+    throw new TypeError(
+      "Gatekeeper receipt.rollback previous version must be older than the current version",
+    );
+  }
+  if (previous.installerSha256 === current.installerSha256) {
+    throw new TypeError(
+      "Gatekeeper receipt.rollback previous and current artifacts must be distinct",
+    );
+  }
+
+  return cloneAndFreezeEvidence(
+    receipt as unknown as InternalGatekeeperReceipt,
+  );
+}
+
+function parseTrustPolicy(input: unknown): InternalGatekeeperTrustPolicy {
+  const captured = snapshotDescriptorEvidence(input, "Gatekeeper trust policy");
+  rejectProhibitedEvidenceFields(captured, "Gatekeeper trust policy");
+  const policy = readExactRecord(
+    captured,
+    ["developerId", "release"],
+    "Gatekeeper trust policy",
+  );
+  const release = parseCapturedInternalReleaseExpectation(
+    policy.release,
+    "Gatekeeper trust policy.release",
+  );
+  const developerId = readExactRecord(
+    policy.developerId,
+    ["approvedCertificates", "approvedTeamId", "certificateRotationPolicy"],
+    "Gatekeeper trust policy.developerId",
+  );
+  readTeamId(
+    developerId.approvedTeamId,
+    "Gatekeeper trust policy.developerId.approvedTeamId",
+  );
+  readLiteral(
+    developerId.certificateRotationPolicy,
+    "explicit-version-bounded-allowlist",
+    "Gatekeeper trust policy.developerId.certificateRotationPolicy",
+  );
+  if (!Array.isArray(developerId.approvedCertificates)) {
+    throw new TypeError(
+      "Gatekeeper trust policy.developerId.approvedCertificates must be an array",
+    );
+  }
+  if (
+    developerId.approvedCertificates.length === 0 ||
+    developerId.approvedCertificates.length > 32
+  ) {
+    throw new TypeError(
+      "Gatekeeper trust policy.developerId.approvedCertificates must contain 1 to 32 entries",
+    );
+  }
+  const certificates = readExactArray(
+    developerId.approvedCertificates,
+    developerId.approvedCertificates.length,
+    "Gatekeeper trust policy.developerId.approvedCertificates",
+  );
+  const certificateDigests = new Set<string>();
+  certificates.forEach((value, index) => {
+    const path = `Gatekeeper trust policy.developerId.approvedCertificates[${index}]`;
+    const certificate = readExactRecord(
+      value,
+      ["sha256", "validFromVersion", "validThroughVersion"],
+      path,
+    );
+    const sha256 = readSha256(certificate.sha256, `${path}.sha256`);
+    const validFrom = readStableVersion(
+      certificate.validFromVersion,
+      `${path}.validFromVersion`,
+    );
+    const validThrough = readStableVersion(
+      certificate.validThroughVersion,
+      `${path}.validThroughVersion`,
+    );
+    if (certificateDigests.has(sha256)) {
+      throw new TypeError(`${path}.sha256 duplicates an approved certificate`);
+    }
+    certificateDigests.add(sha256);
+    if (compareStableVersions(validFrom, validThrough) > 0) {
+      throw new TypeError(
+        `${path} has an invalid certificate rotation version range`,
+      );
+    }
+  });
+  return cloneAndFreezeEvidence({
+    developerId:
+      policy.developerId as InternalGatekeeperTrustPolicy["developerId"],
+    release,
+  });
+}
+
+function readCollectorWitnessId(value: unknown, path: string): string {
+  const witnessId = readString(value, path);
+  if (
+    !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u.test(
+      witnessId,
+    )
+  ) {
+    throw new TypeError(`${path} must be an exact collector witness ID`);
+  }
+  return witnessId;
+}
+
+export function authenticateInternalReleasePolicy(
+  input: unknown,
+  trustRoot: PinnedReleaseEvidenceTrustRoot,
+): AuthenticatedInternalReleasePolicy {
+  const signedEvidence = authenticateSignedReleaseEvidence(
+    input,
+    "release-policy",
+    trustRoot,
+  );
+  const payload = readExactRecord(
+    signedEvidence.payload,
+    ["policy", "purpose", "rollbackPolicyLineage"],
+    "release-policy signed evidence.payload",
+  );
+  readLiteral(
+    payload.purpose,
+    "release-policy",
+    "release-policy signed evidence.payload.purpose",
+  );
+  const policy = parseTrustPolicy(payload.policy);
+  const rollbackPolicyLineage = readExactRecord(
+    payload.rollbackPolicyLineage,
+    ["allowedPreviousPolicySha256s", "lineageSha256"],
+    "release-policy signed evidence.payload.rollbackPolicyLineage",
+  );
+  const lineageSha256 = readSha256(
+    rollbackPolicyLineage.lineageSha256,
+    "release-policy signed evidence.payload.rollbackPolicyLineage.lineageSha256",
+  );
+  if (!Array.isArray(rollbackPolicyLineage.allowedPreviousPolicySha256s)) {
+    throw new TypeError(
+      "release-policy rollback lineage allowlist must be an array",
+    );
+  }
+  if (rollbackPolicyLineage.allowedPreviousPolicySha256s.length > 32) {
+    throw new TypeError(
+      "release-policy rollback lineage allowlist must contain at most 32 entries",
+    );
+  }
+  const allowedPreviousPolicyValues = readExactArray(
+    rollbackPolicyLineage.allowedPreviousPolicySha256s,
+    rollbackPolicyLineage.allowedPreviousPolicySha256s.length,
+    "release-policy signed evidence.payload.rollbackPolicyLineage.allowedPreviousPolicySha256s",
+  );
+  const allowedPreviousPolicySha256s = allowedPreviousPolicyValues.map(
+    (value, index) =>
+      readSha256(
+        value,
+        `release-policy signed evidence.payload.rollbackPolicyLineage.allowedPreviousPolicySha256s[${index}]`,
+      ),
+  );
+  if (
+    new Set(allowedPreviousPolicySha256s).size !==
+    allowedPreviousPolicySha256s.length
+  ) {
+    throw new TypeError(
+      "release-policy rollback lineage allowlist contains a duplicate policy",
+    );
+  }
+  const authenticated = Object.freeze({
+    policy,
+    rollbackPolicyLineage: cloneAndFreezeEvidence({
+      allowedPreviousPolicySha256s,
+      lineageSha256,
+    }),
+    signedEvidence,
+  }) as unknown as AuthenticatedInternalReleasePolicy;
+  authenticatedReleasePolicies.set(authenticated, trustRoot);
+  return authenticated;
+}
+
+export function authenticateInternalCollectorWitness(
+  input: unknown,
+  trustRoot: PinnedReleaseEvidenceTrustRoot,
+): AuthenticatedInternalCollectorWitness {
+  const signedEvidence = authenticateSignedReleaseEvidence(
+    input,
+    "collector-witness",
+    trustRoot,
+  );
+  const payload = readExactRecord(
+    signedEvidence.payload,
+    ["purpose", "witness"],
+    "collector-witness signed evidence.payload",
+  );
+  readLiteral(
+    payload.purpose,
+    "collector-witness",
+    "collector-witness signed evidence.payload.purpose",
+  );
+  const witness = readExactRecord(
+    payload.witness,
+    [
+      "provenanceSha256",
+      "receiptSha256",
+      "releasePolicySha256",
+      "rollbackAuthoritySha256",
+      "witnessId",
+    ],
+    "collector-witness signed evidence.payload.witness",
+  );
+  readSha256(
+    witness.provenanceSha256,
+    "collector-witness signed evidence.payload.witness.provenanceSha256",
+  );
+  readSha256(
+    witness.receiptSha256,
+    "collector-witness signed evidence.payload.witness.receiptSha256",
+  );
+  readSha256(
+    witness.releasePolicySha256,
+    "collector-witness signed evidence.payload.witness.releasePolicySha256",
+  );
+  readSha256(
+    witness.rollbackAuthoritySha256,
+    "collector-witness signed evidence.payload.witness.rollbackAuthoritySha256",
+  );
+  readCollectorWitnessId(
+    witness.witnessId,
+    "collector-witness signed evidence.payload.witness.witnessId",
+  );
+  const authenticated = Object.freeze({
+    signedEvidence,
+    witness: cloneAndFreezeEvidence(
+      witness as unknown as InternalCollectorWitness,
+    ),
+  }) as unknown as AuthenticatedInternalCollectorWitness;
+  authenticatedCollectorWitnesses.set(authenticated, trustRoot);
+  return authenticated;
+}
+
+export function authenticateTrustedRollbackInventory(
+  input: unknown,
+  trustRoot: PinnedReleaseEvidenceTrustRoot,
+): AuthenticatedTrustedRollbackInventory {
+  const signedEvidence = authenticateSignedReleaseEvidence(
+    input,
+    "rollback-inventory",
+    trustRoot,
+  );
+  const payload = readExactRecord(
+    signedEvidence.payload,
+    ["inventory", "purpose"],
+    "rollback-inventory signed evidence.payload",
+  );
+  readLiteral(
+    payload.purpose,
+    "rollback-inventory",
+    "rollback-inventory signed evidence.payload.purpose",
+  );
+  const inventory = readExactRecord(
+    payload.inventory,
+    ["release"],
+    "rollback-inventory signed evidence.payload.inventory",
+  );
+  const release = readExactRecord(
+    inventory.release,
+    [
+      "certificateSha256",
+      "developerTeamId",
+      "installerSha256",
+      "sourceCommitSha",
+      "sourceRepository",
+      "version",
+    ],
+    "rollback-inventory signed evidence.payload.inventory.release",
+  );
+  readSha256(
+    release.certificateSha256,
+    "rollback-inventory signed evidence.payload.inventory.release.certificateSha256",
+  );
+  readTeamId(
+    release.developerTeamId,
+    "rollback-inventory signed evidence.payload.inventory.release.developerTeamId",
+  );
+  readSha256(
+    release.installerSha256,
+    "rollback-inventory signed evidence.payload.inventory.release.installerSha256",
+  );
+  readGitCommitSha(
+    release.sourceCommitSha,
+    "rollback-inventory signed evidence.payload.inventory.release.sourceCommitSha",
+  );
+  readLiteral(
+    release.sourceRepository,
+    "danielholguin31/desmoslock",
+    "rollback-inventory signed evidence.payload.inventory.release.sourceRepository",
+  );
+  readStableVersion(
+    release.version,
+    "rollback-inventory signed evidence.payload.inventory.release.version",
+  );
+  const authenticated = Object.freeze({
+    bindingSha256: hashCanonicalReleaseEvidence(
+      release,
+      trustRoot,
+      "rollback-inventory canonical release binding",
+    ),
+    kind: "authenticated-rollback-inventory" as const,
+    release: cloneAndFreezeEvidence(
+      release as unknown as InternalRollbackInventory["release"],
+    ),
+    signedEvidence,
+  }) as unknown as AuthenticatedTrustedRollbackInventory;
+  authenticatedRollbackInventories.set(authenticated, trustRoot);
+  return authenticated;
+}
