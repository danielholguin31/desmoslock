+import {
+  assertExactKeys,
+  assertMatches,
+  cloneAndFreezeEvidence,
+  readExactArray,
+  readExactRecord,
+  readLiteral,
+  readSha256,
+  readString,
+  rejectProhibitedEvidenceFields,
+  snapshotDescriptorEvidence,
+  snapshotDescriptorRecord,
+} from "./release-evidence-validation.js";
+
+export type ReleaseEvidencePurpose =
+  "collector-witness" | "release-policy" | "rollback-inventory";
+
+export interface ReleaseEvidenceSignatureMetadata {
+  readonly algorithm: "ed25519";
+  readonly keyId: string;
+  readonly publicKeySha256: string;
+  readonly purpose: ReleaseEvidencePurpose;
+  readonly signatureBase64: string;
+}
+
+export interface SignedReleaseEvidenceEnvelope {
+  readonly canonicalPayloadUtf8: string;
+  readonly payload: unknown;
+  readonly payloadSha256: string;
+  readonly signature: ReleaseEvidenceSignatureMetadata;
+}
+
+export interface ReleaseEvidenceCryptographicVerificationPort {
+  readonly consumeReplayNonce: (input: {
+    readonly collectorWitnessSha256: string;
+    readonly replayNonce: string;
+    readonly signerKeyId: string;
+    readonly trustRootFingerprintSha256: string;
+  }) => boolean;
+  readonly sha256Utf8: (canonicalPayloadUtf8: string) => string;
+  readonly verifyEd25519: (input: {
+    readonly canonicalPayloadUtf8: string;
+    readonly keyId: string;
+    readonly publicKeySha256: string;
+    readonly signatureBase64: string;
+  }) => boolean;
+}
+
+export interface PinnedReleaseEvidenceSigner {
+  readonly algorithm: "ed25519";
+  readonly keyId: string;
+  readonly publicKeySha256: string;
+  readonly purpose: ReleaseEvidencePurpose;
+}
+
+export interface PinnedReleaseEvidenceTrustRootConfiguration {
+  readonly signers: readonly [
+    PinnedReleaseEvidenceSigner & { readonly purpose: "collector-witness" },
+    PinnedReleaseEvidenceSigner & { readonly purpose: "release-policy" },
+    PinnedReleaseEvidenceSigner & { readonly purpose: "rollback-inventory" },
+  ];
+}
+
+declare const pinnedTrustRootBrand: unique symbol;
+
+export interface PinnedReleaseEvidenceTrustRoot {
+  readonly trustRootFingerprintSha256: string;
+  readonly [pinnedTrustRootBrand]: true;
+}
+
+declare const untrustedTestContextBrand: unique symbol;
+
+/**
+ * Caller-injected cryptography is useful for deterministic contract inspection,
+ * but it is not a production trust root and cannot mint trusted acceptance.
+ * This type is intentionally omitted from the package entry point.
+ */
+export interface UntrustedReleaseEvidenceTestContext {
+  readonly trustRootFingerprintSha256: string;
+  readonly [untrustedTestContextBrand]: true;
+}
+
+export type ReleaseEvidenceVerificationContext =
+  PinnedReleaseEvidenceTrustRoot | UntrustedReleaseEvidenceTestContext;
+
+declare const authenticatedEnvelopeBrand: unique symbol;
+
+export interface AuthenticatedSignedReleaseEvidence extends SignedReleaseEvidenceEnvelope {
+  readonly [authenticatedEnvelopeBrand]: true;
+}
+
+interface CapturedVerificationPort {
+  readonly consumeReplayNonce: ReleaseEvidenceCryptographicVerificationPort["consumeReplayNonce"];
+  readonly sha256Utf8: ReleaseEvidenceCryptographicVerificationPort["sha256Utf8"];
+  readonly verifyEd25519: ReleaseEvidenceCryptographicVerificationPort["verifyEd25519"];
+}
+
+interface TrustRootState {
+  readonly fingerprintSha256: string;
+  readonly port: CapturedVerificationPort;
+  readonly signersByKeyId: ReadonlyMap<string, PinnedReleaseEvidenceSigner>;
+}
+
+interface AuthenticatedEnvelopeState {
+  readonly purpose: ReleaseEvidencePurpose;
+  readonly trustRoot: ReleaseEvidenceVerificationContext;
+}
+
+// Intentionally has no caller-accessible writer. A future module-owned
+// integration must pin approved public keys and replay storage before
+// production trust can be issued; until then, trusted acceptance stays
+// expected-red.
+const productionTrustRootStates = new WeakMap<object, TrustRootState>();
+const untrustedTestContextStates = new WeakMap<object, TrustRootState>();
+const authenticatedEnvelopeStates = new WeakMap<
+  object,
+  AuthenticatedEnvelopeState
+>();
+
+function readKeyId(value: unknown, path: string): string {
+  const keyId = readString(value, path);
+  if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/u.test(keyId)) {
+    throw new TypeError(`${path} must be an exact signer key ID`);
+  }
+  return keyId;
+}
+
+function readSignatureBase64(value: unknown, path: string): string {
+  const signature = readString(value, path);
+  if (!/^[A-Za-z0-9+/]{85}[AQgw]==$/u.test(signature)) {
+    throw new TypeError(`${path} must be a canonical Ed25519 signature`);
+  }
+  return signature;
+}
+
+function callSha256(
+  state: TrustRootState,
+  canonicalPayloadUtf8: string,
+  path: string,
+): string {
+  let digest: unknown;
+  try {
+    digest = state.port.sha256Utf8(canonicalPayloadUtf8);
+  } catch {
+    throw new TypeError(
+      `${path} failed closed in the SHA-256 verification port`,
+    );
+  }
+  return readSha256(digest, path);
+}
+
+export function canonicalizeReleaseEvidence(value: unknown): string {
+  if (value === null) return "null";
+  if (typeof value === "string" || typeof value === "boolean") {
+    return JSON.stringify(value);
+  }
+  if (typeof value === "number") {
+    if (!Number.isSafeInteger(value)) {
+      throw new TypeError(
+        "canonical release evidence numbers must be safe integers",
+      );
+    }
+    return JSON.stringify(value);
+  }
+  if (Array.isArray(value)) {
+    return `[${value
+      .map((entry) => canonicalizeReleaseEvidence(entry))
+      .join(",")}]`;
+  }
+  const prototype =
+    typeof value === "object" ? Object.getPrototypeOf(value) : undefined;
+  if (
+    typeof value !== "object" ||
+    (prototype !== Object.prototype && prototype !== null)
+  ) {
+    throw new TypeError("canonical release evidence must be JSON data");
+  }
+  const record = value as Record<string, unknown>;
+  return `{${Object.keys(record)
+    .sort()
+    .map(
+      (key) =>
+        `${JSON.stringify(key)}:${canonicalizeReleaseEvidence(record[key])}`,
+    )
+    .join(",")}}`;
+}
+
+function assertVerificationContext(
+  value: unknown,
+): asserts value is ReleaseEvidenceVerificationContext {
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    (!productionTrustRootStates.has(value) &&
+      !untrustedTestContextStates.has(value))
+  ) {
+    throw new TypeError(
+      "Release evidence authentication requires a module-created verification capability",
+    );
+  }
+}
+
+function getTrustRootState(
+  trustRoot: ReleaseEvidenceVerificationContext,
+): TrustRootState {
+  assertVerificationContext(trustRoot);
+  const state =
+    productionTrustRootStates.get(trustRoot) ??
+    untrustedTestContextStates.get(trustRoot);
+  if (state === undefined) {
+    throw new TypeError(
+      "Release-evidence verification capability is unavailable",
+    );
+  }
+  return state;
+}
+
+function createUntrustedVerificationContext(
+  configuration: unknown,
+  verificationPort: ReleaseEvidenceCryptographicVerificationPort,
+): UntrustedReleaseEvidenceTestContext {
+  const capturedConfiguration = snapshotDescriptorEvidence(
+    configuration,
+    "release-evidence trust-root configuration",
+  );
+  rejectProhibitedEvidenceFields(
+    capturedConfiguration,
+    "release-evidence trust-root configuration",
+  );
+  const config = readExactRecord(
+    capturedConfiguration,
+    ["signers"],
+    "release-evidence trust-root configuration",
+  );
+  const signerValues = readExactArray(
+    config.signers,
+    3,
+    "release-evidence trust-root configuration.signers",
+  );
+  const expectedPurposes = [
+    "collector-witness",
+    "release-policy",
+    "rollback-inventory",
+  ] as const;
+  const signers: PinnedReleaseEvidenceSigner[] = [];
+  const keyIds = new Set<string>();
+  const publicKeys = new Set<string>();
+  signerValues.forEach((value, index) => {
+    const path = `release-evidence trust-root configuration.signers[${index}]`;
+    const signer = readExactRecord(
+      value,
+      ["algorithm", "keyId", "publicKeySha256", "purpose"],
+      path,
+    );
+    const purpose = expectedPurposes[index];
+    if (purpose === undefined) {
+      throw new TypeError("release-evidence trust root has an invalid signer");
+    }
+    readLiteral(signer.algorithm, "ed25519", `${path}.algorithm`);
+    readLiteral(signer.purpose, purpose, `${path}.purpose`);
+    const keyId = readKeyId(signer.keyId, `${path}.keyId`);
+    const publicKeySha256 = readSha256(
+      signer.publicKeySha256,
+      `${path}.publicKeySha256`,
+    );
+    if (keyIds.has(keyId) || publicKeys.has(publicKeySha256)) {
+      throw new TypeError(
+        "release-evidence trust root must pin distinct signer keys",
+      );
+    }
+    keyIds.add(keyId);
+    publicKeys.add(publicKeySha256);
+    signers.push({
+      algorithm: "ed25519",
+      keyId,
+      publicKeySha256,
+      purpose,
+    });
+  });
+
+  const capturedPort = snapshotDescriptorRecord(
+    verificationPort,
+    "release-evidence cryptographic verification port",
+  );
+  assertExactKeys(
+    capturedPort,
+    ["consumeReplayNonce", "sha256Utf8", "verifyEd25519"],
+    "release-evidence cryptographic verification port",
+  );
+  for (const field of [
+    "consumeReplayNonce",
+    "sha256Utf8",
+    "verifyEd25519",
+  ] as const) {
+    if (typeof capturedPort[field] !== "function") {
+      throw new TypeError(
+        `release-evidence cryptographic verification port.${field} must be a function`,
+      );
+    }
+  }
+  const port = capturedPort as unknown as CapturedVerificationPort;
+  const provisionalState: TrustRootState = {
+    fingerprintSha256: "",
+    port,
+    signersByKeyId: new Map(
+      signers.map((signer) => [signer.keyId, signer] as const),
+    ),
+  };
+  const fingerprintSha256 = callSha256(
+    provisionalState,
+    canonicalizeReleaseEvidence(config),
+    "release-evidence trust-root fingerprint",
+  );
+  const capability = Object.freeze({
+    trustRootFingerprintSha256: fingerprintSha256,
+  }) as UntrustedReleaseEvidenceTestContext;
+  untrustedTestContextStates.set(capability, {
+    ...provisionalState,
+    fingerprintSha256,
+  });
+  return capability;
+}
+
+/**
+ * @deprecated Caller-supplied verification and replay callbacks cannot create
+ * a production trust root. A future integration must provide a module-owned,
+ * pinned implementation before trusted release acceptance can be enabled.
+ */
+export function createPinnedReleaseEvidenceTrustRoot(
+  configuration: unknown,
+  verificationPort: ReleaseEvidenceCryptographicVerificationPort,
+): PinnedReleaseEvidenceTrustRoot {
+  void configuration;
+  void verificationPort;
+  throw new TypeError(
+    "Caller-supplied verification and replay callbacks cannot create a production pinned trust root",
+  );
+}
+
+/** @internal Test-only. Never accepted by the trusted acceptance API. */
+export function createUntrustedReleaseEvidenceTestContext(
+  configuration: unknown,
+  verificationPort: ReleaseEvidenceCryptographicVerificationPort,
+): UntrustedReleaseEvidenceTestContext {
+  return createUntrustedVerificationContext(configuration, verificationPort);
+}
+
+export function assertPinnedReleaseEvidenceTrustRoot(
+  value: unknown,
+): asserts value is PinnedReleaseEvidenceTrustRoot {
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    !productionTrustRootStates.has(value)
+  ) {
+    throw new TypeError(
+      "Trusted release acceptance requires a module-owned production trust root; caller-supplied verification or replay callbacks are untrusted",
+    );
+  }
+}
+
+/** @internal Test-only. */
+export function assertUntrustedReleaseEvidenceTestContext(
+  value: unknown,
+): asserts value is UntrustedReleaseEvidenceTestContext {
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    !untrustedTestContextStates.has(value)
+  ) {
+    throw new TypeError(
+      "Release evidence test inspection requires an untrusted test context",
+    );
+  }
+}
+
+export function authenticateSignedReleaseEvidence(
+  input: unknown,
+  expectedPurpose: ReleaseEvidencePurpose,
+  trustRoot: ReleaseEvidenceVerificationContext,
+): AuthenticatedSignedReleaseEvidence {
+  const state = getTrustRootState(trustRoot);
+  const capturedInput = snapshotDescriptorEvidence(
+    input,
+    `${expectedPurpose} signed evidence`,
+  );
+  rejectProhibitedEvidenceFields(
+    capturedInput,
+    `${expectedPurpose} signed evidence`,
+  );
+  const envelope = readExactRecord(
+    capturedInput,
+    ["canonicalPayloadUtf8", "payload", "payloadSha256", "signature"],
+    `${expectedPurpose} signed evidence`,
+  );
+  const signature = readExactRecord(
+    envelope.signature,
+    ["algorithm", "keyId", "publicKeySha256", "purpose", "signatureBase64"],
+    `${expectedPurpose} signed evidence.signature`,
+  );
+  const canonicalPayloadUtf8 = readString(
+    envelope.canonicalPayloadUtf8,
+    `${expectedPurpose} signed evidence.canonicalPayloadUtf8`,
+  );
+  if (canonicalPayloadUtf8.length > 1_000_000) {
