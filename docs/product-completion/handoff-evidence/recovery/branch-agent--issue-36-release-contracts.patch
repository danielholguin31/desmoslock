+
+function parseArtifactCommon(
+  artifactValue: unknown,
+  index: 0 | 1,
+  developer: { readonly certificateSha256: string; readonly teamId: string },
+): {
+  readonly artifact: Record<string, unknown>;
+  readonly fileName: string;
+  readonly finalSha256: string;
+  readonly notarizationSubmissionId: string;
+  readonly preNotarySha256: string;
+} {
+  const path = `Gatekeeper receipt.artifacts[${index}]`;
+  const isApp = index === 0;
+  const artifact = readExactRecord(
+    artifactValue,
+    isApp
+      ? [
+          "byteLength",
+          "codesign",
+          "fileName",
+          "gatekeeper",
+          "hardenedRuntime",
+          "notarization",
+          "role",
+          "sandboxEnabled",
+          "sha256",
+          "stapling",
+        ]
+      : [
+          "byteLength",
+          "codesign",
+          "fileName",
+          "gatekeeper",
+          "notarization",
+          "role",
+          "sha256",
+          "stapling",
+        ],
+    path,
+  );
+  const codesign = readExactRecord(
+    artifact.codesign,
+    ["artifactSha256", "certificateSha256", "signer", "status", "teamId"],
+    `${path}.codesign`,
+  );
+  const gatekeeper = readExactRecord(
+    artifact.gatekeeper,
+    ["artifactSha256", "assessment", "source", "status"],
+    `${path}.gatekeeper`,
+  );
+  const notarization = readExactRecord(
+    artifact.notarization,
+    ["status", "submissionId", "submittedSha256"],
+    `${path}.notarization`,
+  );
+  const stapling = readExactRecord(
+    artifact.stapling,
+    ["inputSha256", "outputSha256", "status"],
+    `${path}.stapling`,
+  );
+
+  readLiteral(
+    artifact.role,
+    isApp ? "stapled-app" : "stapled-dmg",
+    `${path}.role`,
+  );
+  const fileName = readFileName(
+    artifact.fileName,
+    isApp ? ".app" : ".dmg",
+    `${path}.fileName`,
+  );
+  const finalSha256 = readSha256(artifact.sha256, `${path}.sha256`);
+  readPositiveSafeInteger(artifact.byteLength, `${path}.byteLength`);
+  readLiteral(codesign.status, "valid", `${path}.codesign.status`);
+  readLiteral(
+    codesign.signer,
+    "developer-id-application",
+    `${path}.codesign.signer`,
+  );
+  assertMatches(
+    readTeamId(codesign.teamId, `${path}.codesign.teamId`),
+    developer.teamId,
+    `${path}.codesign.teamId`,
+    "the receipt Developer ID identity",
+  );
+  assertMatches(
+    readSha256(
+      codesign.certificateSha256,
+      `${path}.codesign.certificateSha256`,
+    ),
+    developer.certificateSha256,
+    `${path}.codesign.certificateSha256`,
+    "the receipt Developer ID certificate",
+  );
+  assertMatches(
+    readSha256(codesign.artifactSha256, `${path}.codesign.artifactSha256`),
+    finalSha256,
+    `${path}.codesign.artifactSha256`,
+    "the final stapled artifact",
+  );
+
+  readLiteral(gatekeeper.status, "accepted", `${path}.gatekeeper.status`);
+  readLiteral(
+    gatekeeper.assessment,
+    isApp ? "execute" : "open",
+    `${path}.gatekeeper.assessment`,
+  );
+  readLiteral(
+    gatekeeper.source,
+    "Notarized Developer ID",
+    `${path}.gatekeeper.source`,
+  );
+  assertMatches(
+    readSha256(gatekeeper.artifactSha256, `${path}.gatekeeper.artifactSha256`),
+    finalSha256,
+    `${path}.gatekeeper.artifactSha256`,
+    "the final stapled artifact",
+  );
+  readLiteral(notarization.status, "accepted", `${path}.notarization.status`);
+  const notarizationSubmissionId = readNotarizationSubmissionId(
+    notarization.submissionId,
+    `${path}.notarization.submissionId`,
+  );
+  const preNotarySha256 = readSha256(
+    notarization.submittedSha256,
+    `${path}.notarization.submittedSha256`,
+  );
+  readLiteral(stapling.status, "valid", `${path}.stapling.status`);
+  assertMatches(
+    readSha256(stapling.inputSha256, `${path}.stapling.inputSha256`),
+    preNotarySha256,
+    `${path}.stapling.inputSha256`,
+    "the notarized pre-staple artifact",
+  );
+  assertMatches(
+    readSha256(stapling.outputSha256, `${path}.stapling.outputSha256`),
+    finalSha256,
+    `${path}.stapling.outputSha256`,
+    "the final stapled artifact",
+  );
+  if (preNotarySha256 === finalSha256) {
+    throw new TypeError(
+      `${path} must distinguish pre-notary and final stapled artifact hashes`,
+    );
+  }
+  if (isApp) {
+    readLiteral(artifact.hardenedRuntime, true, `${path}.hardenedRuntime`);
+    readLiteral(artifact.sandboxEnabled, true, `${path}.sandboxEnabled`);
+  }
+  return {
+    artifact,
+    fileName,
+    finalSha256,
+    notarizationSubmissionId,
+    preNotarySha256,
+  };
+}
