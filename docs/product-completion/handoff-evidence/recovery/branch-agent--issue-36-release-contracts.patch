+  const artifact = readExactRecord(
+    value,
+    [
+      "certificateSha256",
+      "developerTeamId",
+      "installerSha256",
+      "result",
+      "role",
+      "sourceCommitSha",
+      "sourceRepository",
+      "trust",
+      "version",
+    ],
+    path,
+  );
+  readSha256(artifact.certificateSha256, `${path}.certificateSha256`);
+  readTeamId(artifact.developerTeamId, `${path}.developerTeamId`);
+  readSha256(artifact.installerSha256, `${path}.installerSha256`);
+  readGitCommitSha(artifact.sourceCommitSha, `${path}.sourceCommitSha`);
+  readLiteral(
+    artifact.sourceRepository,
+    "danielholguin31/desmoslock",
+    `${path}.sourceRepository`,
+  );
+  readStableVersion(artifact.version, `${path}.version`);
+  return artifact;
+}
