+    "the provenance final stapled app",
+  );
+  assertMatches(
+    receiptDmg.notarization.submittedSha256,
+    provenance.ordering.dmgNotarize.artifactSha256,
+    "Gatekeeper receipt.artifacts[1].notarization.submittedSha256",
+    "the provenance DMG notarization input",
+  );
+  assertMatches(
+    receiptDmg.notarization.submissionId,
+    provenance.ordering.dmgNotarize.submissionId,
+    "Gatekeeper receipt.artifacts[1].notarization.submissionId",
+    "the provenance DMG notarization receipt",
+  );
+  assertMatches(
+    receiptDmg.stapling.inputSha256,
+    provenance.ordering.dmgStaple.inputSha256,
+    "Gatekeeper receipt.artifacts[1].stapling.inputSha256",
