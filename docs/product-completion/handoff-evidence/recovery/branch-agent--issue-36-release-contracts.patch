+function parseDeveloperId(
+  value: unknown,
+  path: string,
+): {
+  readonly certificateSha256: string;
+  readonly teamId: string;
+} {
+  const developerId = readExactRecord(
+    value,
+    [
+      "certificateCommonName",
+      "certificateSerialNumber",
+      "certificateSha256",
+      "teamId",
+    ],
+    path,
+  );
+  const teamId = readTeamId(developerId.teamId, `${path}.teamId`);
+  const certificateSha256 = readSha256(
+    developerId.certificateSha256,
+    `${path}.certificateSha256`,
+  );
+  readCertificateSerialNumber(
+    developerId.certificateSerialNumber,
+    `${path}.certificateSerialNumber`,
+  );
+  const commonName = readString(
+    developerId.certificateCommonName,
+    `${path}.certificateCommonName`,
+  );
+  const commonNameMatch =
+    /^Developer ID Application: ([A-Za-z0-9][A-Za-z0-9 .,'&_-]{0,100}) \(([A-Z0-9]{10})\)$/u.exec(
+      commonName,
+    );
+  if (commonNameMatch === null || commonNameMatch[2] !== teamId) {
+    throw new TypeError(
+      `${path}.certificateCommonName must identify the same Developer ID team`,
+    );
+  }
+  return { certificateSha256, teamId };
+}
