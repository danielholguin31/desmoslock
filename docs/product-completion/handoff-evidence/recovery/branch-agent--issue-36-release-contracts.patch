diff --git a/packages/contracts/tests/release-evidence-test-trust.ts b/packages/contracts/tests/release-evidence-test-trust.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e0a930df33b768d6279584b108f94de80243e3e5
--- /dev/null
+++ b/packages/contracts/tests/release-evidence-test-trust.ts
@@ -0,0 +1,309 @@
+/// <reference types="node" />
+
+import {
+  createHash,
+  generateKeyPairSync,
+  sign,
+  verify,
+  type KeyObject,
+} from "node:crypto";
+
+import {
+  authenticateInternalCollectorWitness,
+  authenticateInternalReleasePolicy,
+  authenticateTrustedRollbackInventory,
+  type InternalGatekeeperReceipt,
+  type InternalReleaseProvenance,
+  type PinnedReleaseEvidenceTrustRoot,
+  type ReleaseEvidencePurpose,
+  type SignedReleaseEvidenceEnvelope,
+} from "../src/index.js";
+import {
+  createUntrustedReleaseEvidenceTestContext,
+  type UntrustedReleaseEvidenceTestContext,
+} from "../src/release-evidence-authentication.js";
+import {
+  syntheticGatekeeperTrustPolicy,
+  syntheticTrustedRollbackInventory,
+} from "./release-evidence-fixtures.js";
+
+interface SyntheticSigner {
+  readonly keyId: string;
+  readonly privateKey: KeyObject;
+  readonly publicKey: KeyObject;
+  readonly publicKeySha256: string;
+  readonly purpose: ReleaseEvidencePurpose;
+}
+
+let witnessSequence = 0;
+
+export const syntheticPolicyLineageSha256 =
+  "abababababababababababababababababababababababababababababababab";
+
+function sha256Utf8(value: string): string {
+  return createHash("sha256").update(value, "utf8").digest("hex");
+}
+
+export function canonicalSyntheticJson(value: unknown): string {
+  if (value === null || typeof value !== "object") {
+    const primitive = JSON.stringify(value);
+    if (primitive === undefined) throw new TypeError("unsupported test value");
+    return primitive;
+  }
+  if (Array.isArray(value)) {
+    return `[${value.map((entry) => canonicalSyntheticJson(entry)).join(",")}]`;
+  }
+  const record = value as Record<string, unknown>;
+  return `{${Object.keys(record)
+    .sort()
+    .map(
+      (key) => `${JSON.stringify(key)}:${canonicalSyntheticJson(record[key])}`,
+    )
+    .join(",")}}`;
+}
+
+function createSigner(
+  purpose: ReleaseEvidencePurpose,
+  ordinal: number,
+): SyntheticSigner {
+  const { privateKey, publicKey } = generateKeyPairSync("ed25519");
+  const publicKeyDer = publicKey.export({ format: "der", type: "spki" });
+  return {
+    keyId: `synthetic-${purpose}-${ordinal}`,
+    privateKey,
+    publicKey,
+    publicKeySha256: createHash("sha256").update(publicKeyDer).digest("hex"),
+    purpose,
+  };
+}
+
+const syntheticSigners = [
+  createSigner("collector-witness", 1),
+  createSigner("release-policy", 2),
+  createSigner("rollback-inventory", 3),
+] as const;
+
+export interface SyntheticTrustHarness {
+  readonly capability: UntrustedReleaseEvidenceTestContext;
+  readonly signEnvelope: (
+    purpose: ReleaseEvidencePurpose,
+    payload: unknown,
+  ) => SignedReleaseEvidenceEnvelope;
+}
+
+export function createSyntheticTrustHarness(
+  options: {
+    readonly trustEverySignatureAndReplay?: boolean;
+  } = {},
+): SyntheticTrustHarness {
+  const consumedReplayKeys = new Set<string>();
+  const signersByKeyId = new Map(
+    syntheticSigners.map((signer) => [signer.keyId, signer] as const),
+  );
+  const capability = createUntrustedReleaseEvidenceTestContext(
+    {
+      signers: syntheticSigners.map((signer) => ({
+        algorithm: "ed25519" as const,
+        keyId: signer.keyId,
+        publicKeySha256: signer.publicKeySha256,
+        purpose: signer.purpose,
+      })),
+    },
+    {
+      consumeReplayNonce(input) {
+        if (options.trustEverySignatureAndReplay === true) return true;
+        const replayKey = canonicalSyntheticJson(input);
+        if (consumedReplayKeys.has(replayKey)) return false;
+        consumedReplayKeys.add(replayKey);
+        return true;
+      },
+      sha256Utf8,
+      verifyEd25519(input) {
+        if (options.trustEverySignatureAndReplay === true) return true;
+        const signer = signersByKeyId.get(input.keyId);
+        if (
+          signer === undefined ||
+          signer.publicKeySha256 !== input.publicKeySha256
+        ) {
+          return false;
+        }
+        return verify(
+          null,
+          Buffer.from(input.canonicalPayloadUtf8, "utf8"),
+          signer.publicKey,
+          Buffer.from(input.signatureBase64, "base64"),
+        );
+      },
+    },
+  );
+
+  return {
+    capability,
+    signEnvelope(purpose, payload) {
+      const signer = syntheticSigners.find(
+        (candidate) => candidate.purpose === purpose,
+      );
+      if (signer === undefined) throw new TypeError("missing synthetic signer");
+      const canonicalPayloadUtf8 = canonicalSyntheticJson(payload);
+      return {
+        canonicalPayloadUtf8,
+        payload,
+        payloadSha256: sha256Utf8(canonicalPayloadUtf8),
+        signature: {
+          algorithm: "ed25519",
+          keyId: signer.keyId,
+          publicKeySha256: signer.publicKeySha256,
+          purpose,
+          signatureBase64:
+            options.trustEverySignatureAndReplay === true
+              ? `${"A".repeat(86)}==`
+              : sign(
+                  null,
+                  Buffer.from(canonicalPayloadUtf8, "utf8"),
+                  signer.privateKey,
+                ).toString("base64"),
+        },
+      };
+    },
+  };
+}
+
+export function createAuthenticatedInventoryAuthorization(
+  receipt: InternalGatekeeperReceipt,
+  provenance: InternalReleaseProvenance,
+  options: {
+    readonly harness?: SyntheticTrustHarness;
+    readonly inventory?: { readonly release: unknown };
+    readonly policy?: unknown;
+    readonly policyLineage?: {
+      readonly allowedPreviousPolicySha256s: readonly string[];
+      readonly lineageSha256: string;
+    };
+  } = {},
+) {
+  const harness = options.harness ?? createSyntheticTrustHarness();
+  const policy = options.policy ?? syntheticGatekeeperTrustPolicy;
+  const inventory = options.inventory ?? syntheticTrustedRollbackInventory;
+  const policyLineage = options.policyLineage ?? {
+    allowedPreviousPolicySha256s: [],
+    lineageSha256: syntheticPolicyLineageSha256,
+  };
+  const signedPolicy = harness.signEnvelope("release-policy", {
+    policy,
+    purpose: "release-policy",
+    rollbackPolicyLineage: policyLineage,
+  });
+  const authenticatedPolicy = authenticateInternalReleasePolicy(
+    signedPolicy,
+    harness.capability as unknown as PinnedReleaseEvidenceTrustRoot,
+  );
+  const signedInventory = harness.signEnvelope("rollback-inventory", {
+    inventory: { release: inventory.release },
+    purpose: "rollback-inventory",
+  });
+  const authenticatedInventory = authenticateTrustedRollbackInventory(
+    signedInventory,
+    harness.capability as unknown as PinnedReleaseEvidenceTrustRoot,
+  );
+  witnessSequence += 1;
+  const witnessId = `00000000-0000-4000-8000-${String(witnessSequence).padStart(12, "0")}`;
+  const signedWitness = harness.signEnvelope("collector-witness", {
+    purpose: "collector-witness",
+    witness: {
+      provenanceSha256: sha256Utf8(canonicalSyntheticJson(provenance)),
+      receiptSha256: sha256Utf8(canonicalSyntheticJson(receipt)),
+      releasePolicySha256: signedPolicy.payloadSha256,
+      rollbackAuthoritySha256: signedInventory.payloadSha256,
+      witnessId,
+    },
+  });
+  const authenticatedWitness = authenticateInternalCollectorWitness(
+    signedWitness,
+    harness.capability as unknown as PinnedReleaseEvidenceTrustRoot,
+  );
+
+  return {
+    authorization: {
+      collectorWitness: authenticatedWitness,
+      releasePolicy: authenticatedPolicy,
+      rollbackAuthority: authenticatedInventory,
+    },
+    capability: harness.capability,
+    harness,
+    signedInventory,
+    signedPolicy,
+    signedWitness,
+  } as const;
+}
+
+export function createAuthenticatedModuleAuthorization(
+  receipt: InternalGatekeeperReceipt,
+  provenance: InternalReleaseProvenance,
+  moduleAuthority: {
+    readonly acceptance: unknown;
+    readonly kind: "module-verified-release";
+    readonly provenance: InternalReleaseProvenance;
+  },
+  options: {
+    readonly harness: SyntheticTrustHarness;
+    readonly policy: unknown;
+    readonly priorPolicyFingerprintSha256: string;
+    readonly policyLineageSha256?: string;
+  },
+) {
+  const policyLineageSha256 =
+    options.policyLineageSha256 ?? syntheticPolicyLineageSha256;
+  const signedPolicy = options.harness.signEnvelope("release-policy", {
+    policy: options.policy,
+    purpose: "release-policy",
+    rollbackPolicyLineage: {
+      allowedPreviousPolicySha256s: [options.priorPolicyFingerprintSha256],
+      lineageSha256: policyLineageSha256,
+    },
+  });
+  const authenticatedPolicy = authenticateInternalReleasePolicy(
+    signedPolicy,
+    options.harness.capability as unknown as PinnedReleaseEvidenceTrustRoot,
+  );
+  const rollbackAuthoritySha256 = sha256Utf8(
+    canonicalSyntheticJson({
+      acceptanceSha256: sha256Utf8(
+        canonicalSyntheticJson(moduleAuthority.acceptance),
+      ),
+      kind: "module-verified-release",
+      policyFingerprintSha256: options.priorPolicyFingerprintSha256,
+      policyLineageSha256,
+      provenanceSha256: sha256Utf8(
+        canonicalSyntheticJson(moduleAuthority.provenance),
+      ),
+      trustRootFingerprintSha256:
+        options.harness.capability.trustRootFingerprintSha256,
+    }),
+  );
+  witnessSequence += 1;
+  const witnessId = `00000000-0000-4000-8000-${String(witnessSequence).padStart(12, "0")}`;
+  const signedWitness = options.harness.signEnvelope("collector-witness", {
+    purpose: "collector-witness",
+    witness: {
+      provenanceSha256: sha256Utf8(canonicalSyntheticJson(provenance)),
+      receiptSha256: sha256Utf8(canonicalSyntheticJson(receipt)),
+      releasePolicySha256: signedPolicy.payloadSha256,
+      rollbackAuthoritySha256,
+      witnessId,
+    },
+  });
+  const authenticatedWitness = authenticateInternalCollectorWitness(
+    signedWitness,
+    options.harness.capability as unknown as PinnedReleaseEvidenceTrustRoot,
+  );
+  return {
+    authorization: {
+      collectorWitness: authenticatedWitness,
+      releasePolicy: authenticatedPolicy,
+      rollbackAuthority: moduleAuthority,
+    },
+    capability: options.harness.capability,
+    signedPolicy,
+    signedWitness,
+  } as const;
+}
diff --git a/packages/contracts/tests/release-evidence-trust.test.ts b/packages/contracts/tests/release-evidence-trust.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..52036829c6c3ea1217ffb6b80692cc033b9652df
--- /dev/null
+++ b/packages/contracts/tests/release-evidence-trust.test.ts
@@ -0,0 +1,432 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  authenticateInternalCollectorWitness,
+  authenticateInternalReleasePolicy,
+  authenticateTrustedRollbackInventory,
+  createPinnedReleaseEvidenceTrustRoot,
+  parseInternalGatekeeperReceipt,
+  parseInternalReleaseProvenance,
+  type PinnedReleaseEvidenceTrustRoot,
+  verifyInternalGatekeeperAcceptance,
+} from "../src/index.js";
+import { inspectInternalGatekeeperAcceptanceForTests } from "../src/gatekeeper-acceptance.js";
+import {
+  createValidGatekeeperReceipt,
+  createValidReleaseProvenance,
+  syntheticGatekeeperTrustPolicy,
+  syntheticReleaseExpectation,
+  syntheticTrustedRollbackInventory,
+} from "./release-evidence-fixtures.js";
+import {
+  createAuthenticatedInventoryAuthorization,
+  createSyntheticTrustHarness,
+  syntheticPolicyLineageSha256,
+} from "./release-evidence-test-trust.js";
+
+function createParsedEvidence() {
+  const provenance = parseInternalReleaseProvenance(
+    createValidReleaseProvenance(),
+    syntheticReleaseExpectation,
+  );
+  const receipt = parseInternalGatekeeperReceipt(
+    createValidGatekeeperReceipt(),
+  );
+  return { provenance, receipt };
+}
+
+function asAuthenticationContext(
+  value: unknown,
+): PinnedReleaseEvidenceTrustRoot {
+  return value as PinnedReleaseEvidenceTrustRoot;
+}
+
+describe("pinned release-evidence trust root", () => {
+  it("rejects the legacy public callback constructor without invoking it", () => {
+    let callbackCalls = 0;
+
+    expect(() =>
+      createPinnedReleaseEvidenceTrustRoot(
+        {
+          signers: [
+            {
+              algorithm: "ed25519",
+              keyId: "collector",
+              publicKeySha256: "11".repeat(32),
+              purpose: "collector-witness",
+            },
+            {
+              algorithm: "ed25519",
+              keyId: "policy",
+              publicKeySha256: "22".repeat(32),
+              purpose: "release-policy",
+            },
+            {
+              algorithm: "ed25519",
+              keyId: "inventory",
+              publicKeySha256: "33".repeat(32),
+              purpose: "rollback-inventory",
+            },
+          ],
+        },
+        {
+          consumeReplayNonce() {
+            callbackCalls += 1;
+            return true;
+          },
+          sha256Utf8() {
+            callbackCalls += 1;
+            return "44".repeat(32);
+          },
+          verifyEd25519() {
+            callbackCalls += 1;
+            return true;
+          },
+        },
+      ),
+    ).toThrow(/caller-supplied.*cannot create.*production/i);
+    expect(callbackCalls).toBe(0);
+  });
+
+  it("does not let always-true caller callbacks mint or replay a trusted acceptance", () => {
+    const { provenance, receipt } = createParsedEvidence();
+    const harness = createSyntheticTrustHarness({
+      trustEverySignatureAndReplay: true,
+    });
+    const { authorization } = createAuthenticatedInventoryAuthorization(
+      receipt,
+      provenance,
+      { harness },
+    );
+
+    expect(() =>
+      verifyInternalGatekeeperAcceptance(
+        receipt,
+        provenance,
+        authorization,
+        asAuthenticationContext(harness.capability),
+      ),
+    ).toThrow(/caller-supplied|module-owned|untrusted/i);
+    expect(() =>
+      verifyInternalGatekeeperAcceptance(
+        receipt,
+        provenance,
+        authorization,
+        asAuthenticationContext(harness.capability),
+      ),
+    ).toThrow(/caller-supplied|module-owned|untrusted/i);
+    expect(
+      inspectInternalGatekeeperAcceptanceForTests(
+        receipt,
+        provenance,
+        authorization,
+        harness.capability,
+      ),
+    ).toEqual(receipt);
+    expect(
+      inspectInternalGatekeeperAcceptanceForTests(
+        receipt,
+        provenance,
+        authorization,
+        harness.capability,
+      ),
+    ).toEqual(receipt);
+  });
+
+  it("keeps even valid injected cryptography explicitly untrusted", () => {
+    const { provenance, receipt } = createParsedEvidence();
+    const {
+      authorization,
+      capability,
+      signedInventory,
+      signedPolicy,
+      signedWitness,
+    } = createAuthenticatedInventoryAuthorization(receipt, provenance);
+
+    expect(authorization.releasePolicy.signedEvidence).toEqual(signedPolicy);
+    expect(authorization.rollbackAuthority.signedEvidence).toEqual(
+      signedInventory,
+    );
+    expect(authorization.collectorWitness.signedEvidence).toEqual(
+      signedWitness,
+    );
+    expect(Object.isFrozen(authorization.releasePolicy.signedEvidence)).toBe(
+      true,
+    );
+    expect(
+      inspectInternalGatekeeperAcceptanceForTests(
+        receipt,
+        provenance,
+        authorization,
+        capability,
+      ),
+    ).toEqual(receipt);
+    expect(() =>
+      verifyInternalGatekeeperAcceptance(
+        receipt,
+        provenance,
+        authorization,
+        asAuthenticationContext(capability),
+      ),
+    ).toThrow(/module-owned production trust root|caller-supplied/i);
+  });
+
+  it("rejects synthetic plain policy and inventory fixtures", () => {
+    const { provenance, receipt } = createParsedEvidence();
+    const harness = createSyntheticTrustHarness();
+
+    expect(() =>
+      inspectInternalGatekeeperAcceptanceForTests(
+        receipt,
+        provenance,
+        {
+          collectorWitness: {},
+          releasePolicy: syntheticGatekeeperTrustPolicy,
+          rollbackAuthority: syntheticTrustedRollbackInventory,
+        },
+        harness.capability,
+      ),
+    ).toThrow(/authenticated|signed|trust/i);
+  });
+
+  it("rejects a lookalike for an authenticated policy brand", () => {
+    const { provenance, receipt } = createParsedEvidence();
+    const { authorization, capability } =
+      createAuthenticatedInventoryAuthorization(receipt, provenance);
+    const policyLookalike = structuredClone(authorization.releasePolicy);
+
+    expect(() =>
+      inspectInternalGatekeeperAcceptanceForTests(
+        receipt,
+        provenance,
+        { ...authorization, releasePolicy: policyLookalike },
+        capability,
+      ),
+    ).toThrow(/authenticated release policy/i);
+  });
+
+  it("rejects a lookalike for an authenticated rollback inventory brand", () => {
+    const { provenance, receipt } = createParsedEvidence();
+    const { authorization, capability } =
+      createAuthenticatedInventoryAuthorization(receipt, provenance);
+    const inventoryLookalike = structuredClone(authorization.rollbackAuthority);
+
+    expect(() =>
+      inspectInternalGatekeeperAcceptanceForTests(
+        receipt,
+        provenance,
+        { ...authorization, rollbackAuthority: inventoryLookalike },
+        capability,
+      ),
+    ).toThrow(/authenticated inventory|module-verified release/i);
+  });
+
+  it("rejects a serialized copy of an untrusted verification context", () => {
+    const { provenance, receipt } = createParsedEvidence();
+    const { authorization, capability, signedPolicy } =
+      createAuthenticatedInventoryAuthorization(receipt, provenance);
+    const capabilityLookalike = structuredClone(
+      capability,
+    ) as typeof capability;
+
+    expect(() =>
+      authenticateInternalReleasePolicy(
+        signedPolicy,
+        asAuthenticationContext(capabilityLookalike),
+      ),
+    ).toThrow(/module-created verification capability/i);
+    expect(() =>
+      verifyInternalGatekeeperAcceptance(
+        receipt,
+        provenance,
+        authorization,
+        asAuthenticationContext(capabilityLookalike),
+      ),
+    ).toThrow(/module-owned production trust root/i);
+  });
+
+  it("rejects replay of a consumed collector witness", () => {
+    const { provenance, receipt } = createParsedEvidence();
+    const { authorization, capability } =
+      createAuthenticatedInventoryAuthorization(receipt, provenance);
+
+    inspectInternalGatekeeperAcceptanceForTests(
+      receipt,
+      provenance,
+      authorization,
+      capability,
+    );
+    expect(() =>
+      inspectInternalGatekeeperAcceptanceForTests(
+        receipt,
+        provenance,
+        authorization,
+        capability,
+      ),
+    ).toThrow(/replay|consumed/i);
+  });
+
+  it("rejects an authenticated inventory with an arbitrary field even when the attacker supplies a binding", () => {
+    const harness = createSyntheticTrustHarness();
+    const envelope = harness.signEnvelope("rollback-inventory", {
+      inventory: {
+        bindingSha256:
+          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        release: {
+          ...syntheticTrustedRollbackInventory.release,
+          arbitraryReleaseTrack: "attacker-controlled",
+        },
+      },
+      purpose: "rollback-inventory",
+    });
+
+    expect(() =>
+      authenticateTrustedRollbackInventory(
+        envelope,
+        asAuthenticationContext(harness.capability),
+      ),
+    ).toThrow(/unknown field|arbitraryReleaseTrack|bindingSha256/i);
+  });
+
+  it.each([
+    ["collector witness", "collector-witness"],
+    ["release policy", "release-policy"],
+    ["rollback inventory", "rollback-inventory"],
+  ] as const)("rejects a fake signed %s", (_label, purpose) => {
+    const harness = createSyntheticTrustHarness();
+    const payload =
+      purpose === "collector-witness"
+        ? {
+            purpose,
+            witness: {
+              provenanceSha256: "11".repeat(32),
+              receiptSha256: "22".repeat(32),
+              releasePolicySha256: "33".repeat(32),
+              rollbackAuthoritySha256: "44".repeat(32),
+              witnessId: "00000000-0000-4000-8000-000000000001",
+            },
+          }
+        : purpose === "release-policy"
+          ? {
+              policy: syntheticGatekeeperTrustPolicy,
+              purpose,
+              rollbackPolicyLineage: {
+                allowedPreviousPolicySha256s: [],
+                lineageSha256: syntheticPolicyLineageSha256,
+              },
+            }
+          : {
+              inventory: { release: syntheticTrustedRollbackInventory.release },
+              purpose,
+            };
+    const envelope = structuredClone(harness.signEnvelope(purpose, payload));
+    Object.assign(envelope.signature, {
+      signatureBase64: "A".repeat(86) + "==",
+    });
+
+    const authenticate =
+      purpose === "collector-witness"
+        ? authenticateInternalCollectorWitness
+        : purpose === "release-policy"
+          ? authenticateInternalReleasePolicy
+          : authenticateTrustedRollbackInventory;
+    expect(() =>
+      authenticate(envelope, asAuthenticationContext(harness.capability)),
+    ).toThrow(/signature.*invalid|cryptographic/i);
+  });
+
+  it("rejects an unknown signer before acceptance", () => {
+    const harness = createSyntheticTrustHarness();
+    const envelope = structuredClone(
+      harness.signEnvelope("release-policy", {
+        policy: syntheticGatekeeperTrustPolicy,
+        purpose: "release-policy",
+        rollbackPolicyLineage: {
+          allowedPreviousPolicySha256s: [],
+          lineageSha256: syntheticPolicyLineageSha256,
+        },
+      }),
+    );
+    Object.assign(envelope.signature, {
+      keyId: "unknown-policy-signer",
+    });
+
+    expect(() =>
+      authenticateInternalReleasePolicy(
+        envelope,
+        asAuthenticationContext(harness.capability),
+      ),
+    ).toThrow(/unknown.*signer|signer.*pinned/i);
+  });
+
+  it("rejects a wrong signature purpose before acceptance", () => {
+    const harness = createSyntheticTrustHarness();
+    const envelope = structuredClone(
+      harness.signEnvelope("release-policy", {
+        policy: syntheticGatekeeperTrustPolicy,
+        purpose: "release-policy",
+        rollbackPolicyLineage: {
+          allowedPreviousPolicySha256s: [],
+          lineageSha256: syntheticPolicyLineageSha256,
+        },
+      }),
+    );
+    Object.assign(envelope.signature, { purpose: "collector-witness" });
+
+    expect(() =>
+      authenticateInternalReleasePolicy(
+        envelope,
+        asAuthenticationContext(harness.capability),
+      ),
+    ).toThrow(/purpose.*release-policy|must be.*release-policy/i);
+  });
+
+  it("rejects a canonical-payload mismatch", () => {
+    const harness = createSyntheticTrustHarness();
+    const envelope = structuredClone(
+      harness.signEnvelope("release-policy", {
+        policy: syntheticGatekeeperTrustPolicy,
+        purpose: "release-policy",
+        rollbackPolicyLineage: {
+          allowedPreviousPolicySha256s: [],
+          lineageSha256: syntheticPolicyLineageSha256,
+        },
+      }),
+    );
+    Object.assign(envelope, {
+      canonicalPayloadUtf8: `${envelope.canonicalPayloadUtf8} `,
+    });
+
+    expect(() =>
+      authenticateInternalReleasePolicy(
+        envelope,
+        asAuthenticationContext(harness.capability),
+      ),
+    ).toThrow(/canonical payload/i);
+  });
+
+  it("rejects a canonical-payload digest mismatch", () => {
+    const harness = createSyntheticTrustHarness();
+    const envelope = structuredClone(
+      harness.signEnvelope("release-policy", {
+        policy: syntheticGatekeeperTrustPolicy,
+        purpose: "release-policy",
