+  for (const field of [
+    "dependencyLockSha256",
+    "sourceCommitSha",
+    "sourceRepository",
+    "version",
+  ] as const) {
+    assertMatches(
+      receipt.identity[field],
+      provenance.identity[field],
+      `Gatekeeper receipt.identity.${field}`,
+      "the verified provenance identity",
+    );
+  }
+  for (const field of [
+    "audience",
+    "channel",
+    "commercialAuthorization",
+    "generalAvailability",
+    "schoolReady",
+    "visibility",
+  ] as const) {
+    assertMatches(
+      receipt.distribution[field],
+      provenance.distribution[field],
+      `Gatekeeper receipt.distribution.${field}`,
+      "the verified provenance classification",
+    );
+  }
+  const receiptApp = receipt.artifacts[0];
+  const receiptDmg = receipt.artifacts[1];
+  const provenanceApp = provenance.artifacts[1];
+  const provenanceDmg = provenance.artifacts[2];
+  for (const [receiptArtifact, provenanceArtifact, path] of [
+    [receiptApp, provenanceApp, "Gatekeeper receipt.artifacts[0]"],
+    [receiptDmg, provenanceDmg, "Gatekeeper receipt.artifacts[1]"],
+  ] as const) {
+    assertMatches(
+      receiptArtifact.fileName,
+      provenanceArtifact.fileName,
+      `${path}.fileName`,
+      "the final stapled provenance artifact",
+    );
+    assertMatches(
+      receiptArtifact.sha256,
+      provenanceArtifact.sha256,
+      `${path}.sha256`,
+      "the final stapled provenance artifact",
+    );
+    assertMatches(
+      receiptArtifact.byteLength,
+      provenanceArtifact.byteLength,
+      `${path}.byteLength`,
+      "the final stapled provenance artifact",
+    );
+  }
+  assertMatches(
+    receiptApp.notarization.submittedSha256,
+    provenance.ordering.appNotarize.artifactSha256,
+    "Gatekeeper receipt.artifacts[0].notarization.submittedSha256",
+    "the provenance app notarization input",
+  );
+  assertMatches(
+    receiptApp.notarization.submissionId,
+    provenance.ordering.appNotarize.submissionId,
+    "Gatekeeper receipt.artifacts[0].notarization.submissionId",
+    "the provenance app notarization receipt",
+  );
+  assertMatches(
+    receiptApp.stapling.inputSha256,
+    provenance.ordering.appStaple.inputSha256,
+    "Gatekeeper receipt.artifacts[0].stapling.inputSha256",
+    "the provenance app stapling input",
+  );
+  assertMatches(
+    receiptApp.stapling.outputSha256,
+    provenance.ordering.appStaple.outputSha256,
