+function readTeamId(value: unknown, path: string): string {
+  const teamId = readString(value, path);
+  if (!/^[A-Z0-9]{10}$/u.test(teamId)) {
+    throw new TypeError(`${path} must be a ten-character Developer ID team ID`);
+  }
+  return teamId;
+}
+
+function readCertificateSerialNumber(value: unknown, path: string): string {
+  const serialNumber = readString(value, path);
+  if (!/^[0-9A-F]{2,40}$/u.test(serialNumber)) {
+    throw new TypeError(
+      `${path} must be an uppercase certificate serial number`,
+    );
+  }
+  return serialNumber;
+}
+
+function readNotarizationSubmissionId(value: unknown, path: string): string {
+  const submissionId = readString(value, path);
+  if (
+    !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u.test(
+      submissionId,
+    )
+  ) {
+    throw new TypeError(`${path} must be an exact notarization submission ID`);
+  }
+  return submissionId;
+}
+
+function compareStableVersions(left: string, right: string): number {
+  const leftParts = left.split(".").map(Number);
+  const rightParts = right.split(".").map(Number);
+  for (let index = 0; index < 3; index += 1) {
+    const difference = (leftParts[index] ?? 0) - (rightParts[index] ?? 0);
+    if (difference !== 0) return difference;
+  }
+  return 0;
+}
