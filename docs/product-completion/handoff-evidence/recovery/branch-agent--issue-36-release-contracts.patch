+export type JsonRecord = Record<string, unknown>;
+
+export function snapshotDescriptorRecord(
+  value: unknown,
+  path: string,
+): JsonRecord {
+  const prototype =
+    typeof value === "object" && value !== null
+      ? Object.getPrototypeOf(value)
+      : undefined;
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    Array.isArray(value) ||
+    (prototype !== Object.prototype && prototype !== null)
+  ) {
+    throw new TypeError(`${path} must be a plain object`);
+  }
+  const snapshot: JsonRecord = Object.create(null) as JsonRecord;
+  for (const key of Reflect.ownKeys(value)) {
+    if (typeof key !== "string") {
+      throw new TypeError(`${path} contains an unknown symbol field`);
+    }
+    const descriptor = Object.getOwnPropertyDescriptor(value, key);
+    if (
+      descriptor === undefined ||
+      !("value" in descriptor) ||
+      descriptor.enumerable !== true
+    ) {
+      throw new TypeError(`${path}.${key} must be an enumerable data field`);
+    }
+    Object.defineProperty(snapshot, key, {
+      configurable: true,
+      enumerable: true,
+      value: descriptor.value,
+      writable: true,
+    });
+  }
+  return snapshot;
+}
+
+export function snapshotDescriptorEvidence(
+  value: unknown,
+  path: string,
+  seen: WeakSet<object> = new WeakSet<object>(),
+): unknown {
+  if (typeof value !== "object" || value === null) return value;
+  if (seen.has(value)) {
+    throw new TypeError(`${path} must not contain cyclic or aliased evidence`);
+  }
