index 0000000000000000000000000000000000000000..c0f8c8dd5a8c137fc52e2c9c33980a3d0a08866a
--- /dev/null
+++ b/packages/domain/tests/student-capability-test-fixtures.ts
@@ -0,0 +1,264 @@
+import { createHmac } from "node:crypto";
+
+import {
+  admitAccountlessStudentSession,
+  connectAccountlessStudentSession,
+  createAccountlessStudentSession,
+  STUDENT_AUTHORITY_DIGEST_DOMAINS,
+  type AccountlessStudentSessionRecord,
+  type DeterministicStudentCredentialIssuance,
+  type DeviceSessionPublicKeyThumbprint,
+  type SealedStudentCredentialReceipt,
+  type StudentCapabilityDigest,
+  type StudentCapabilityIntent,
+  type StudentCapabilityIntentAuthority,
+  type StudentCapabilityIntentAuthorityDigest,
+  type StudentCapabilityIntentAuthorityVerificationPort,
+  type StudentConnectionDecision,
+  type StudentIntentSetDigest,
+  type StudentLogicalOperationDigest,
+  type StudentProofEnvelopeDigest,
+  type StudentReconnectGrantDigest,
+  type StudentSessionMutationDecision,
+  type VerifiedDeviceSessionProof,
+} from "../src/index.js";
+
+export const ids = {
+  antiReplayA: "70000000-0000-4000-8000-000000000001",
+  antiReplayB: "70000000-0000-4000-8000-000000000002",
+  antiReplayC: "70000000-0000-4000-8000-000000000003",
+  acknowledgmentRequest: "60000000-0000-4000-8000-000000000003",
+  challenge: "50000000-0000-4000-8000-000000000001",
+  deviceA: "40000000-0000-4000-8000-000000000001",
+  deviceB: "40000000-0000-4000-8000-000000000002",
+  request: "60000000-0000-4000-8000-000000000001",
+  recoveryRequest: "60000000-0000-4000-8000-000000000002",
+  schoolA: "10000000-0000-4000-8000-000000000001",
+  schoolB: "10000000-0000-4000-8000-000000000002",
+  sessionA: "30000000-0000-4000-8000-000000000001",
+  sessionB: "30000000-0000-4000-8000-000000000002",
+  testA: "20000000-0000-4000-8000-000000000001",
+  testB: "20000000-0000-4000-8000-000000000002",
+} as const;
+
+export const thumbprint = "P".repeat(43) as DeviceSessionPublicKeyThumbprint;
+export const intentSetDigest = "7".repeat(64) as StudentIntentSetDigest;
+export const elevatedIntentSetDigest = "6".repeat(64) as StudentIntentSetDigest;
+
+export function capabilityIntentAuthorityDigest(
+  authority: StudentCapabilityIntentAuthority,
+): StudentCapabilityIntentAuthorityDigest {
+  const payload = JSON.stringify([
+    STUDENT_AUTHORITY_DIGEST_DOMAINS.capabilityIntentAuthority,
+    [...authority.allowedIntents],
+    authority.allowedIntentSetDigest,
+    authority.capabilityDigest,
+    authority.capabilityIssuedAtMs,
+    authority.connectionKind,
+    authority.connectionLogicalOperationDigest,
+    authority.connectionRequestId,
+    authority.deviceSessionId,
+    authority.deviceSessionPublicKeyThumbprint,
+    authority.epoch,
+    authority.expiresAtMs,
+    authority.reconnectGrantDigest,
+    authority.reconnectGrantExpiresAtMs,
+    authority.schoolId,
+    authority.studentSessionId,
+    authority.testId,
+  ]);
+  return createHmac("sha256", "desmoslock-ticket-33-test-only-key")
+    .update(payload)
+    .digest("hex") as StudentCapabilityIntentAuthorityDigest;
+}
+
+export const intentAuthorityVerifier = {
+  async capabilityIntentAuthorityDigest({ authority, domain }) {
+    if (domain !== STUDENT_AUTHORITY_DIGEST_DOMAINS.capabilityIntentAuthority) {
+      throw new Error("unexpected intent authority digest domain");
+    }
+    return capabilityIntentAuthorityDigest(authority);
+  },
+} satisfies StudentCapabilityIntentAuthorityVerificationPort;
+
+export function capabilityDigest(character = "a"): StudentCapabilityDigest {
+  return character.repeat(64) as StudentCapabilityDigest;
+}
+
+export function reconnectDigest(character = "b"): StudentReconnectGrantDigest {
+  return character.repeat(64) as StudentReconnectGrantDigest;
+}
+
+export function logicalOperationDigest(
+  character = "c",
+): StudentLogicalOperationDigest {
+  return character.repeat(64) as StudentLogicalOperationDigest;
+}
+
+export function proofEnvelopeDigest(
+  character = "e",
+): StudentProofEnvelopeDigest {
+  return character.repeat(64) as StudentProofEnvelopeDigest;
+}
+
+export function issuance(
+  issuedAtMs = 1_200,
+  cap = capabilityDigest(),
+  reconnect = reconnectDigest(),
+): DeterministicStudentCredentialIssuance {
+  return {
+    capabilityDigest: cap,
+    capabilityExpiresAtMs: issuedAtMs + 60_000,
+    intentSetDigest,
+    receiptExpiresAtMs: issuedAtMs + 120_000,
+    reconnectGrantDigest: reconnect,
+    reconnectGrantExpiresAtMs: issuedAtMs + 120_000,
+    sealedReceipt: "S".repeat(43) as SealedStudentCredentialReceipt,
+  };
+}
+
+export function proof(input?: {
+  readonly antiReplayId?: string;
+  readonly challengeId?: string;
+  readonly deviceSessionId?: string;
+  readonly deviceSessionPublicKeyThumbprint?: DeviceSessionPublicKeyThumbprint;
+  readonly epoch?: number;
+  readonly expiresAtMs?: number;
+  readonly intent?: VerifiedDeviceSessionProof["intent"];
+  readonly logicalOperation?: StudentLogicalOperationDigest;
+  readonly operationKind?: VerifiedDeviceSessionProof["operationKind"];
+  readonly proofEnvelope?: StudentProofEnvelopeDigest;
+  readonly requestId?: string;
+  readonly schoolId?: string;
+  readonly studentSessionId?: string;
+  readonly testId?: string;
+}): VerifiedDeviceSessionProof {
+  return {
+    antiReplayId: input?.antiReplayId ?? ids.antiReplayA,
+    challengeId: input?.challengeId ?? ids.challenge,
+    deviceSessionId: input?.deviceSessionId ?? ids.deviceA,
+    deviceSessionPublicKeyThumbprint:
+      input?.deviceSessionPublicKeyThumbprint ?? thumbprint,
+    epoch: input?.epoch ?? 0,
+    expiresAtMs: input?.expiresAtMs ?? 5_000,
+    intent: input?.intent ?? null,
+    logicalOperationDigest: input?.logicalOperation ?? logicalOperationDigest(),
+    operationKind: input?.operationKind ?? "join",
+    proofEnvelopeDigest: input?.proofEnvelope ?? proofEnvelopeDigest(),
+    requestId: input?.requestId ?? ids.request,
+    schoolId: input?.schoolId ?? ids.schoolA,
+    studentSessionId: input?.studentSessionId ?? ids.sessionA,
+    testId: input?.testId ?? ids.testA,
+  } as unknown as VerifiedDeviceSessionProof;
+}
+
+export function acceptedSession(
+  decision: StudentConnectionDecision | StudentSessionMutationDecision,
+): AccountlessStudentSessionRecord {
+  if (decision.status !== "accepted") {
+    throw new Error("expected an accepted Student Session decision");
+  }
+  return decision.session;
+}
+
+export function createdSession(variant: "a" | "b" = "a") {
+  const decision = createAccountlessStudentSession({
+    createdAtMs: 1_000,
+    schoolId: variant === "a" ? ids.schoolA : ids.schoolB,
+    studentSessionId: variant === "a" ? ids.sessionA : ids.sessionB,
+    syntheticDisplayName: variant === "a" ? "Student A-01" : "Student B-01",
+    testId: variant === "a" ? ids.testA : ids.testB,
+  });
+  return acceptedSession(decision);
+}
+
+export function admittedSession(variant: "a" | "b" = "a") {
+  return acceptedSession(
+    admitAccountlessStudentSession(createdSession(variant), {
+      admittedAtMs: 1_100,
+    }),
+  );
+}
+
+export function joinInput(input?: {
+  readonly allowedIntents?: readonly StudentCapabilityIntent[];
+  readonly antiReplayId?: string;
+  readonly issuance?: DeterministicStudentCredentialIssuance;
+  readonly session?: AccountlessStudentSessionRecord;
+}) {
+  const session = input?.session ?? admittedSession();
+  const operation = logicalOperationDigest();
+  const allowedIntents = (
+    input?.allowedIntents ?? (["state.read"] as const)
+  ).toSorted();
+  const selectedIntentSetDigest =
+    allowedIntents.length === 1 && allowedIntents[0] === "state.read"
+      ? intentSetDigest
+      : elevatedIntentSetDigest;
+  const selectedIssuance =
+    input?.issuance ??
+    ({ ...issuance(), intentSetDigest: selectedIntentSetDigest } as const);
+  const intentAuthorityDigest = capabilityIntentAuthorityDigest({
+    allowedIntents,
+    allowedIntentSetDigest: selectedIntentSetDigest,
+    capabilityDigest: selectedIssuance.capabilityDigest,
+    capabilityIssuedAtMs: 1_200,
+    connectionKind: "join",
+    connectionLogicalOperationDigest: operation,
+    connectionRequestId: ids.request,
+    deviceSessionId: ids.deviceA,
+    deviceSessionPublicKeyThumbprint: thumbprint,
+    epoch: session.epoch,
+    expiresAtMs: selectedIssuance.capabilityExpiresAtMs,
+    reconnectGrantDigest: selectedIssuance.reconnectGrantDigest,
+    reconnectGrantExpiresAtMs: selectedIssuance.reconnectGrantExpiresAtMs,
+    schoolId: session.schoolId,
+    studentSessionId: session.studentSessionId,
+    testId: session.testId,
+  });
+  return {
+    allowedIntents,
+    challengeId: ids.challenge,
+    connectedAtMs: 1_200,
+    derivationKey: {
+      allowedIntents,
+      deviceSessionId: ids.deviceA,
+      epoch: session.epoch,
+      intentSetDigest: selectedIntentSetDigest,
+      issuedAtMs: 1_200,
+      logicalOperationDigest: operation,
+      schoolId: session.schoolId,
+      studentSessionId: session.studentSessionId,
+      testId: session.testId,
+    },
+    deviceSessionId: ids.deviceA,
+    intentAuthorityDigest,
+    issuance: selectedIssuance,
+    logicalOperationDigest: operation,
+    proof: proof({
+      ...(input?.antiReplayId === undefined
+        ? {}
+        : { antiReplayId: input.antiReplayId }),
+      epoch: session.epoch,
+      logicalOperation: operation,
+      schoolId: session.schoolId,
+      studentSessionId: session.studentSessionId,
+      testId: session.testId,
+    }),
+    requestId: ids.request,
+    scope: {
+      schoolId: session.schoolId,
+      studentSessionId: session.studentSessionId,
+      testId: session.testId,
+    },
+  } as const;
+}
+
+export function connectedSession(variant: "a" | "b" = "a") {
+  const admitted = admittedSession(variant);
+  const input = joinInput({ session: admitted });
+  return {
+    input,
+    session: acceptedSession(connectAccountlessStudentSession(admitted, input)),
+  };
+}
