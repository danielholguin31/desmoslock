+  return (
+    isStudentAuthorityDigest(issuance.capabilityDigest) &&
+    isStudentAuthorityDigest(issuance.reconnectGrantDigest) &&
+    String(issuance.capabilityDigest) !==
+      String(issuance.reconnectGrantDigest) &&
+    issuance.intentSetDigest === intentSetDigest &&
+    isSealedStudentCredentialReceipt(issuance.sealedReceipt) &&
+    isWithinStudentAuthorityTtl(
+      issuedAtMs,
+      issuance.capabilityExpiresAtMs,
+      MAX_STUDENT_CAPABILITY_TTL_MS,
+    ) &&
+    isWithinStudentAuthorityTtl(
+      issuedAtMs,
+      issuance.reconnectGrantExpiresAtMs,
+      MAX_STUDENT_RECONNECT_TTL_MS,
+    ) &&
+    isWithinStudentAuthorityTtl(
+      issuedAtMs,
+      issuance.receiptExpiresAtMs,
+      MAX_STUDENT_IDEMPOTENCY_TTL_MS,
+    ) &&
+    issuance.receiptExpiresAtMs ===
+      Math.max(
+        issuance.capabilityExpiresAtMs,
+        issuance.reconnectGrantExpiresAtMs,
+      )
+  );
+}
+
+function derivationKeyMatches(
+  key: StudentCredentialDerivationKey,
+  session: AccountlessStudentSessionRecord,
+  input: StudentConnectionProofContext,
+  allowedIntents: readonly StudentCapabilityIntent[],
+  intentSetDigest: StudentIntentSetDigest,
+  issuedAtMs: number,
+): boolean {
+  const keyIntents = snapshotAllowedIntents(key.allowedIntents);
+  return (
+    keyIntents !== null &&
+    sessionKeysEqual(key, session) &&
+    key.deviceSessionId === input.deviceSessionId &&
+    key.epoch === session.epoch &&
+    key.issuedAtMs === issuedAtMs &&
+    key.logicalOperationDigest === input.logicalOperationDigest &&
+    key.intentSetDigest === intentSetDigest &&
+    intentsEqual(keyIntents, allowedIntents)
+  );
+}
+
+function connectionAccepted(
+  session: AccountlessStudentSessionRecord,
+  decision: StudentConnectionDecisionRecord,
+  credentialDisposition: StudentConnectionReceipt["credentialDisposition"],
+): StudentConnectionAccepted {
+  if (decision.recovery.status !== "pending") {
+    throw new Error("acknowledged credentials cannot be returned");
+  }
+  const frozenSession = freezeSessionRecord(session);
+  const frozenScope = freezeCapabilityScope(decision.resultScope);
+  return Object.freeze({
+    code: "STUDENT_SESSION_ACCEPTED",
+    connection: Object.freeze({
+      credentialDisposition,
+      receiptExpiresAtMs: decision.recovery.expiresAtMs,
+      scope: frozenScope,
+      sealedReceipt: decision.recovery.sealedReceipt,
+    }),
+    session: frozenSession,
+    status: "accepted",
+  });
+}
+
+function mutationAccepted(
+  session: AccountlessStudentSessionRecord,
+): StudentSessionMutationAccepted {
+  return Object.freeze({
+    code: "STUDENT_SESSION_ACCEPTED",
+    session: freezeSessionRecord(session),
+    status: "accepted",
+  });
+}
+
+export function createAccountlessStudentSession(
+  value: unknown,
+): StudentSessionMutationDecision {
+  try {
+    const input = snapshotExactDataObject(value, [
+      "createdAtMs",
+      "schoolId",
+      "studentSessionId",
+      "syntheticDisplayName",
+      "testId",
+    ]);
+    if (
+      input === null ||
+      !isSafeTimestamp(input.createdAtMs) ||
+      !isCanonicalStudentIdentifier(input.schoolId) ||
+      !isCanonicalStudentIdentifier(input.studentSessionId) ||
+      !isSyntheticStudentDisplayName(input.syntheticDisplayName) ||
+      !isCanonicalStudentIdentifier(input.testId)
+    ) {
+      return STUDENT_SESSION_PUBLIC_DENIAL;
+    }
+    return mutationAccepted({
+      currentCapability: null,
+      currentReconnectGrant: null,
+      deviceSessionId: null,
+      deviceSessionPublicKeyThumbprint: null,
+      epoch: 0,
+      lastConnectionDecision: null,
+      lifecycle: "created",
+      lifecycleChangedAtMs: input.createdAtMs,
+      revision: 0,
+      schoolId: input.schoolId,
+      studentSessionId: input.studentSessionId,
+      syntheticDisplayName: input.syntheticDisplayName,
+      testId: input.testId,
+    });
+  } catch {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+}
+
+export async function generateAccountlessStudentSession(
+  input: { readonly createdAtMs: number; readonly scope: TestScope },
+  identityFactory: StudentSessionIdentityFactoryPort,
+): Promise<StudentSessionMutationDecision> {
+  if (
+    !isSafeTimestamp(input.createdAtMs) ||
+    !isCanonicalStudentIdentifier(input.scope.schoolId) ||
+    !isCanonicalStudentIdentifier(input.scope.testId)
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  try {
+    const identity = await identityFactory.generate(input.scope);
+    return createAccountlessStudentSession({
+      createdAtMs: input.createdAtMs,
+      schoolId: input.scope.schoolId,
+      studentSessionId: identity.studentSessionId,
+      syntheticDisplayName: identity.syntheticDisplayName,
+      testId: input.scope.testId,
+    });
+  } catch {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+}
+
+export function admitAccountlessStudentSession(
+  persisted: unknown,
+  input: { readonly admittedAtMs: number },
+): StudentSessionMutationDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  if (
+    session === null ||
+    session.lifecycle !== "created" ||
+    !canAdvanceRevision(session) ||
+    !isSafeTimestamp(input.admittedAtMs) ||
+    input.admittedAtMs < session.lifecycleChangedAtMs
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  return mutationAccepted({
+    ...session,
+    lifecycle: "admitted",
+    lifecycleChangedAtMs: input.admittedAtMs,
+    revision: session.revision + 1,
+  });
+}
+
+export function connectAccountlessStudentSession(
+  persisted: unknown,
+  input: StudentConnectionIssuanceInput & {
+    readonly allowedIntents?: readonly StudentCapabilityIntent[];
+    readonly connectedAtMs: number;
+  },
+): StudentConnectionDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  const allowedIntents = snapshotAllowedIntents(
+    input.allowedIntents ?? DEFAULT_STUDENT_CAPABILITY_INTENTS,
+  );
+  if (
+    session === null ||
+    allowedIntents === null ||
+    !isStudentAuthorityDigest(input.intentAuthorityDigest) ||
+    !sessionKeysEqual(session, input.scope) ||
+    !isSafeTimestamp(input.connectedAtMs) ||
+    input.connectedAtMs < session.lifecycleChangedAtMs ||
+    !proofMatches(
+      input.proof,
+      session,
+      input,
+      input.connectedAtMs,
+      "join",
+      null,
+    )
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+
+  const prior = session.lastConnectionDecision;
+  if (
+    session.lifecycle === "connected" &&
+    prior?.kind === "join" &&
+    prior.recovery.status === "pending" &&
+    input.connectedAtMs < prior.idempotencyExpiresAtMs &&
+    input.connectedAtMs < prior.recovery.expiresAtMs &&
+    prior.logicalOperationDigest === input.logicalOperationDigest &&
+    prior.requestId === input.requestId &&
+    prior.intentAuthorityDigest === input.intentAuthorityDigest &&
+    prior.resultScope.deviceSessionId === input.deviceSessionId &&
+    prior.deviceSessionPublicKeyThumbprint ===
+      input.proof.deviceSessionPublicKeyThumbprint &&
+    prior.acceptedProofAntiReplayId !== input.proof.antiReplayId &&
+    derivationKeyMatches(
+      input.derivationKey,
+      session,
+      input,
+      prior.allowedIntents,
+      prior.intentSetDigest,
+      prior.issuedAtMs,
+    ) &&
+    intentsEqual(prior.allowedIntents, allowedIntents)
+  ) {
+    return connectionAccepted(session, prior, "recover_winning_receipt");
+  }
+
+  if (
+    (session.lifecycle !== "admitted" && session.lifecycle !== "readmitted") ||
+    !canAdvanceRevision(session) ||
+    !derivationKeyMatches(
+      input.derivationKey,
+      session,
+      input,
+      allowedIntents,
+      input.issuance.intentSetDigest,
+      input.connectedAtMs,
+    ) ||
+    !issuanceValidAt(
+      input.issuance,
+      input.connectedAtMs,
+      input.derivationKey.intentSetDigest,
+    )
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+
+  const capabilityScope: StudentCapabilityScope = {
+    deviceSessionId: input.deviceSessionId,
+    epoch: session.epoch,
+    expiresAtMs: input.issuance.capabilityExpiresAtMs,
+    schoolId: session.schoolId,
+    studentSessionId: session.studentSessionId,
+    testId: session.testId,
+  };
+  const reconnectScope: StudentCapabilityScope = {
+    ...capabilityScope,
+    expiresAtMs: input.issuance.reconnectGrantExpiresAtMs,
+  };
+  const decision: StudentConnectionDecisionRecord = {
+    acceptedProofAntiReplayId: input.proof.antiReplayId,
+    allowedIntents,
+    deviceSessionPublicKeyThumbprint:
+      input.proof.deviceSessionPublicKeyThumbprint,
+    idempotencyExpiresAtMs: input.issuance.receiptExpiresAtMs,
+    issuedAtMs: input.connectedAtMs,
+    intentAuthorityDigest: input.intentAuthorityDigest,
+    kind: "join",
+    intentSetDigest: input.derivationKey.intentSetDigest,
+    recovery: {
+      acknowledgedAtMs: null,
+      acknowledgmentOperationDigest: null,
+      acknowledgmentRequestId: null,
+      capabilityDigest: input.issuance.capabilityDigest,
+      capabilityExpiresAtMs: input.issuance.capabilityExpiresAtMs,
+      expiresAtMs: input.issuance.receiptExpiresAtMs,
+      intentAuthorityDigest: input.intentAuthorityDigest,
+      intentSetDigest: input.derivationKey.intentSetDigest,
+      reconnectGrantDigest: input.issuance.reconnectGrantDigest,
+      reconnectGrantExpiresAtMs: input.issuance.reconnectGrantExpiresAtMs,
+      recoveredAtMs: null,
+      recoveryOperationDigest: null,
+      recoveryRequestId: null,
+      sealedReceipt: input.issuance.sealedReceipt,
+      status: "pending",
+    },
+    requestId: input.requestId,
+    logicalOperationDigest: input.logicalOperationDigest,
+    resultScope: capabilityScope,
+    sourceReconnectGrantDigest: null,
+    sourceReconnectGrantScope: null,
+  };
+  const connected: AccountlessStudentSessionRecord = {
+    ...session,
+    currentCapability: {
+      allowedIntents,
+      digest: input.issuance.capabilityDigest,
+      intentAuthorityDigest: input.intentAuthorityDigest,
+      intentSetDigest: input.derivationKey.intentSetDigest,
+      issuedAtMs: input.connectedAtMs,
+      scope: capabilityScope,
+    },
+    currentReconnectGrant: {
+      allowedIntents,
+      digest: input.issuance.reconnectGrantDigest,
+      intentAuthorityDigest: input.intentAuthorityDigest,
+      intentSetDigest: input.derivationKey.intentSetDigest,
+      issuedAtMs: input.connectedAtMs,
+      scope: reconnectScope,
+    },
+    deviceSessionId: input.deviceSessionId,
+    deviceSessionPublicKeyThumbprint:
+      input.proof.deviceSessionPublicKeyThumbprint,
+    lastConnectionDecision: decision,
+    lifecycle: "connected",
+    lifecycleChangedAtMs: input.connectedAtMs,
+    revision: session.revision + 1,
+  };
+  return connectionAccepted(connected, decision, "issued");
+}
+
+function capabilityIntentAuthorityFor(
+  session: AccountlessStudentSessionRecord,
+): StudentCapabilityIntentAuthority | null {
+  const capability = session.currentCapability;
+  const decision = session.lastConnectionDecision;
+  const reconnectGrant = session.currentReconnectGrant;
+  const deviceSessionPublicKeyThumbprint =
+    session.deviceSessionPublicKeyThumbprint;
+  if (
+    decision === null ||
+    reconnectGrant === null ||
+    deviceSessionPublicKeyThumbprint === null
+  ) {
+    return null;
+  }
+  return Object.freeze({
+    allowedIntents: freezeIntentSet(reconnectGrant.allowedIntents),
+    allowedIntentSetDigest: reconnectGrant.intentSetDigest,
+    capabilityDigest: capability?.digest ?? decision.recovery.capabilityDigest,
+    capabilityIssuedAtMs: decision.issuedAtMs,
+    connectionKind: decision.kind,
+    connectionLogicalOperationDigest: decision.logicalOperationDigest,
+    connectionRequestId: decision.requestId,
+    deviceSessionId: decision.resultScope.deviceSessionId,
+    deviceSessionPublicKeyThumbprint,
+    epoch: decision.resultScope.epoch,
+    expiresAtMs: decision.resultScope.expiresAtMs,
+    reconnectGrantDigest: reconnectGrant.digest,
+    reconnectGrantExpiresAtMs: reconnectGrant.scope.expiresAtMs,
+    schoolId: decision.resultScope.schoolId,
+    studentSessionId: decision.resultScope.studentSessionId,
+    testId: decision.resultScope.testId,
+  });
+}
+
+export async function authorizeStudentCapability(
+  persisted: unknown,
+  input: StudentConnectionProofContext & {
+    readonly capabilityDigest: StudentCapabilityDigest;
+    readonly intent: StudentCapabilityIntent;
+    readonly nowMs: number;
+    readonly scope: StudentCapabilityScope;
+  },
+  intentAuthorityVerifier: StudentCapabilityIntentAuthorityVerificationPort,
+): Promise<StudentCapabilityAuthorizationDecision> {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  const capability = session?.currentCapability ?? null;
+  const requestedIntent = input.intent;
+  if (
+    session === null ||
+    session.lifecycle !== "connected" ||
+    capability === null ||
+    session.deviceSessionId === null ||
+    session.deviceSessionPublicKeyThumbprint === null ||
+    !isStudentCapabilityIntent(requestedIntent) ||
+    !isSafeTimestamp(input.nowMs) ||
+    input.nowMs < session.lifecycleChangedAtMs ||
+    input.nowMs >= capability.scope.expiresAtMs ||
+    !capabilityScopesEqual(capability.scope, input.scope) ||
+    capability.scope.epoch !== session.epoch ||
+    capability.scope.deviceSessionId !== session.deviceSessionId ||
+    capability.digest !== input.capabilityDigest ||
+    !proofMatches(
+      input.proof,
+      session,
+      input,
+      input.nowMs,
+      "capability",
+      requestedIntent,
+    ) ||
+    input.proof.deviceSessionPublicKeyThumbprint !==
+      session.deviceSessionPublicKeyThumbprint
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  const intentAuthority = capabilityIntentAuthorityFor(session);
+  if (intentAuthority === null) return STUDENT_SESSION_PUBLIC_DENIAL;
+  const verifiedIntentAuthority = await verifyStudentCapabilityIntentAuthority(
+    intentAuthority,
+    capability.intentAuthorityDigest,
+    intentAuthorityVerifier,
+  );
+  if (
+    !verifiedStudentCapabilityIntentAuthorityAllows(
+      verifiedIntentAuthority,
+      intentAuthority,
+      capability.intentAuthorityDigest,
+      requestedIntent,
+    )
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  return STUDENT_CAPABILITY_ALLOWED;
+}
+
+export function leaveAccountlessStudentSession(
+  persisted: unknown,
+  input: { readonly leftAtMs: number },
+): StudentSessionMutationDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  if (
+    session === null ||
+    session.lifecycle !== "connected" ||
+    !canAdvanceRevision(session) ||
+    !isSafeTimestamp(input.leftAtMs) ||
+    input.leftAtMs < session.lifecycleChangedAtMs
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  return mutationAccepted({
+    ...session,
+    currentCapability: null,
+    lifecycle: "left",
+    lifecycleChangedAtMs: input.leftAtMs,
+    revision: session.revision + 1,
+  });
+}
+
+export async function reconnectAccountlessStudentSession(
+  persisted: unknown,
+  input: StudentConnectionIssuanceInput & {
+    readonly presentedReconnectGrantDigest: StudentReconnectGrantDigest;
+    readonly reconnectedAtMs: number;
+    readonly scope: StudentCapabilityScope;
+  },
+  intentAuthorityVerifier: StudentCapabilityIntentAuthorityVerificationPort,
+): Promise<StudentConnectionDecision> {
+  const reconnect = snapshotReconnectIssuanceInput(input);
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  if (
+    reconnect === null ||
+    session === null ||
+    !isStudentAuthorityDigest(reconnect.intentAuthorityDigest) ||
+    !isSafeTimestamp(reconnect.reconnectedAtMs) ||
+    reconnect.reconnectedAtMs < session.lifecycleChangedAtMs ||
+    !sessionKeysEqual(session, reconnect.scope) ||
+    !proofMatches(
+      reconnect.proof,
+      session,
+      reconnect,
+      reconnect.reconnectedAtMs,
+      "reconnect",
+      null,
+    )
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+
+  const grant = session.currentReconnectGrant;
+  if (
+    (session.lifecycle !== "connected" && session.lifecycle !== "left") ||
+    grant === null ||
+    session.deviceSessionId === null ||
+    session.deviceSessionPublicKeyThumbprint === null
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  const persistedIntentAuthority = capabilityIntentAuthorityFor(session);
+  if (persistedIntentAuthority === null) return STUDENT_SESSION_PUBLIC_DENIAL;
+  const verifiedPersistedIntentAuthority =
+    await verifyStudentCapabilityIntentAuthority(
+      persistedIntentAuthority,
+      grant.intentAuthorityDigest,
+      intentAuthorityVerifier,
+    );
+  if (
+    verifiedPersistedIntentAuthority === null ||
+    !grant.allowedIntents.every((intent) =>
+      verifiedStudentCapabilityIntentAuthorityAllows(
+        verifiedPersistedIntentAuthority,
+        persistedIntentAuthority,
+        grant.intentAuthorityDigest,
+        intent,
+      ),
+    )
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+
+  const prior = session.lastConnectionDecision;
+  if (
+    session.lifecycle === "connected" &&
+    prior?.kind === "reconnect" &&
+    prior.recovery.status === "pending" &&
+    prior.sourceReconnectGrantDigest !== null &&
+    prior.sourceReconnectGrantScope !== null &&
+    reconnect.reconnectedAtMs < prior.idempotencyExpiresAtMs &&
+    reconnect.reconnectedAtMs < prior.recovery.expiresAtMs &&
+    prior.logicalOperationDigest === reconnect.logicalOperationDigest &&
+    prior.requestId === reconnect.requestId &&
+    prior.intentAuthorityDigest === reconnect.intentAuthorityDigest &&
+    prior.sourceReconnectGrantDigest ===
+      reconnect.presentedReconnectGrantDigest &&
+    capabilityScopesEqual(prior.sourceReconnectGrantScope, reconnect.scope) &&
+    prior.resultScope.deviceSessionId === reconnect.deviceSessionId &&
+    prior.deviceSessionPublicKeyThumbprint ===
+      reconnect.proof.deviceSessionPublicKeyThumbprint &&
+    prior.acceptedProofAntiReplayId !== reconnect.proof.antiReplayId &&
+    derivationKeyMatches(
+      reconnect.derivationKey,
+      session,
+      reconnect,
+      prior.allowedIntents,
+      prior.intentSetDigest,
+      prior.issuedAtMs,
+    )
+  ) {
+    return connectionAccepted(session, prior, "recover_winning_receipt");
+  }
+
+  if (
+    !canAdvanceRevision(session) ||
+    !derivationKeyMatches(
+      reconnect.derivationKey,
+      session,
+      reconnect,
+      grant.allowedIntents,
+      grant.intentSetDigest,
+      reconnect.reconnectedAtMs,
+    ) ||
+    !capabilityScopesEqual(grant.scope, reconnect.scope) ||
+    grant.scope.epoch !== session.epoch ||
+    reconnect.reconnectedAtMs >= grant.scope.expiresAtMs ||
+    grant.digest !== reconnect.presentedReconnectGrantDigest ||
+    reconnect.proof.deviceSessionPublicKeyThumbprint !==
+      session.deviceSessionPublicKeyThumbprint ||
+    reconnect.deviceSessionId === session.deviceSessionId ||
+    !issuanceValidAt(
+      reconnect.issuance,
+      reconnect.reconnectedAtMs,
+      reconnect.derivationKey.intentSetDigest,
+    ) ||
+    reconnect.issuance.reconnectGrantDigest ===
+      reconnect.presentedReconnectGrantDigest ||
+    String(reconnect.issuance.capabilityDigest) ===
+      String(reconnect.presentedReconnectGrantDigest) ||
+    (session.currentCapability !== null &&
+      reconnect.issuance.capabilityDigest === session.currentCapability.digest)
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+
+  const capabilityScope: StudentCapabilityScope = {
+    deviceSessionId: reconnect.deviceSessionId,
+    epoch: session.epoch,
+    expiresAtMs: reconnect.issuance.capabilityExpiresAtMs,
+    schoolId: session.schoolId,
+    studentSessionId: session.studentSessionId,
+    testId: session.testId,
+  };
+  const reconnectScope: StudentCapabilityScope = {
+    ...capabilityScope,
+    expiresAtMs: reconnect.issuance.reconnectGrantExpiresAtMs,
+  };
+  const decision: StudentConnectionDecisionRecord = {
+    acceptedProofAntiReplayId: reconnect.proof.antiReplayId,
+    allowedIntents: grant.allowedIntents,
+    deviceSessionPublicKeyThumbprint:
+      reconnect.proof.deviceSessionPublicKeyThumbprint,
+    idempotencyExpiresAtMs: reconnect.issuance.receiptExpiresAtMs,
+    issuedAtMs: reconnect.reconnectedAtMs,
+    intentAuthorityDigest: reconnect.intentAuthorityDigest,
+    intentSetDigest: grant.intentSetDigest,
+    kind: "reconnect",
+    recovery: {
+      acknowledgedAtMs: null,
+      acknowledgmentOperationDigest: null,
+      acknowledgmentRequestId: null,
+      capabilityDigest: reconnect.issuance.capabilityDigest,
+      capabilityExpiresAtMs: reconnect.issuance.capabilityExpiresAtMs,
+      expiresAtMs: reconnect.issuance.receiptExpiresAtMs,
+      intentAuthorityDigest: reconnect.intentAuthorityDigest,
+      intentSetDigest: grant.intentSetDigest,
+      reconnectGrantDigest: reconnect.issuance.reconnectGrantDigest,
+      reconnectGrantExpiresAtMs: reconnect.issuance.reconnectGrantExpiresAtMs,
+      recoveredAtMs: null,
+      recoveryOperationDigest: null,
+      recoveryRequestId: null,
+      sealedReceipt: reconnect.issuance.sealedReceipt,
+      status: "pending",
+    },
+    requestId: reconnect.requestId,
+    logicalOperationDigest: reconnect.logicalOperationDigest,
+    resultScope: capabilityScope,
+    sourceReconnectGrantDigest: grant.digest,
+    sourceReconnectGrantScope: grant.scope,
+  };
+  const reconnected: AccountlessStudentSessionRecord = {
+    ...session,
+    currentCapability: {
+      allowedIntents: grant.allowedIntents,
+      digest: reconnect.issuance.capabilityDigest,
+      intentAuthorityDigest: reconnect.intentAuthorityDigest,
+      intentSetDigest: grant.intentSetDigest,
+      issuedAtMs: reconnect.reconnectedAtMs,
+      scope: capabilityScope,
+    },
+    currentReconnectGrant: {
+      allowedIntents: grant.allowedIntents,
+      digest: reconnect.issuance.reconnectGrantDigest,
+      intentAuthorityDigest: reconnect.intentAuthorityDigest,
+      intentSetDigest: grant.intentSetDigest,
+      issuedAtMs: reconnect.reconnectedAtMs,
+      scope: reconnectScope,
+    },
+    deviceSessionId: reconnect.deviceSessionId,
+    deviceSessionPublicKeyThumbprint:
+      reconnect.proof.deviceSessionPublicKeyThumbprint,
+    lastConnectionDecision: decision,
+    lifecycle: "connected",
+    lifecycleChangedAtMs: reconnect.reconnectedAtMs,
+    revision: session.revision + 1,
+  };
+  return connectionAccepted(reconnected, decision, "issued");
+}
+
+export function recoverStudentCredentialReceipt(
+  persisted: unknown,
+  input: StudentCredentialRecoveryInput,
+): StudentConnectionDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  const decision = session?.lastConnectionDecision ?? null;
+  if (
+    session === null ||
+    (session.lifecycle !== "connected" && session.lifecycle !== "left") ||
+    decision === null ||
+    decision.recovery.status !== "pending" ||
+    session.deviceSessionId === null ||
+    session.deviceSessionPublicKeyThumbprint === null ||
+    !isStudentAuthorityDigest(input.connectionOperationDigest) ||
+    input.connectionOperationDigest !== decision.logicalOperationDigest ||
+    !isSafeTimestamp(input.recoveredAtMs) ||
+    input.recoveredAtMs < session.lifecycleChangedAtMs ||
+    input.recoveredAtMs >= decision.recovery.expiresAtMs ||
+    input.deviceSessionId !== session.deviceSessionId ||
+    input.proof.deviceSessionPublicKeyThumbprint !==
+      session.deviceSessionPublicKeyThumbprint ||
+    !proofMatches(
+      input.proof,
+      session,
+      input,
+      input.recoveredAtMs,
+      "credential_recovery",
+      null,
+    )
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  if (decision.recovery.recoveryRequestId !== null) {
+    return decision.recovery.recoveryRequestId === input.requestId &&
+      decision.recovery.recoveryOperationDigest === input.logicalOperationDigest
+      ? connectionAccepted(session, decision, "recover_winning_receipt")
+      : STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  if (!canAdvanceRevision(session)) return STUDENT_SESSION_PUBLIC_DENIAL;
+  const recoveredDecision: StudentConnectionDecisionRecord = {
+    ...decision,
+    recovery: {
+      ...decision.recovery,
+      recoveredAtMs: input.recoveredAtMs,
+      recoveryOperationDigest: input.logicalOperationDigest,
+      recoveryRequestId: input.requestId,
+    },
+  };
+  const recoveredSession: AccountlessStudentSessionRecord = {
+    ...session,
+    lastConnectionDecision: recoveredDecision,
+    revision: session.revision + 1,
+  };
+  return connectionAccepted(
+    recoveredSession,
+    recoveredDecision,
+    "recover_winning_receipt",
+  );
+}
+
+export function acknowledgeStudentCredentialReceipt(
+  persisted: unknown,
+  input: StudentCredentialAcknowledgmentInput,
+): StudentSessionMutationDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  const decision = session?.lastConnectionDecision ?? null;
+  if (
+    session === null ||
+    (session.lifecycle !== "connected" && session.lifecycle !== "left") ||
+    decision === null ||
+    session.deviceSessionId === null ||
+    session.deviceSessionPublicKeyThumbprint === null ||
+    !isStudentAuthorityDigest(input.connectionOperationDigest) ||
+    input.connectionOperationDigest !== decision.logicalOperationDigest ||
+    !isSafeTimestamp(input.acknowledgedAtMs) ||
+    input.acknowledgedAtMs < session.lifecycleChangedAtMs ||
+    input.acknowledgedAtMs >= decision.recovery.expiresAtMs ||
+    input.deviceSessionId !== session.deviceSessionId ||
+    input.proof.deviceSessionPublicKeyThumbprint !==
+      session.deviceSessionPublicKeyThumbprint ||
+    !proofMatches(
+      input.proof,
+      session,
+      input,
+      input.acknowledgedAtMs,
+      "credential_acknowledgment",
+      null,
+    )
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  if (decision.recovery.status === "acknowledged") {
+    return decision.recovery.acknowledgmentRequestId === input.requestId &&
+      decision.recovery.acknowledgmentOperationDigest ===
+        input.logicalOperationDigest
+      ? mutationAccepted(session)
+      : STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  if (!canAdvanceRevision(session)) return STUDENT_SESSION_PUBLIC_DENIAL;
+  return mutationAccepted({
+    ...session,
+    lastConnectionDecision: {
+      ...decision,
+      recovery: {
+        ...decision.recovery,
+        acknowledgedAtMs: input.acknowledgedAtMs,
+        acknowledgmentOperationDigest: input.logicalOperationDigest,
+        acknowledgmentRequestId: input.requestId,
+        sealedReceipt: null,
+        status: "acknowledged",
+      },
+    },
+    revision: session.revision + 1,
+  });
+}
+
+function parseStudentSessionKey(value: unknown): StudentSessionKey | null {
+  try {
+    const key = snapshotExactDataObject(value, [
+      "schoolId",
+      "studentSessionId",
+      "testId",
+    ]);
+    return key !== null &&
+      isCanonicalStudentIdentifier(key.schoolId) &&
+      isCanonicalStudentIdentifier(key.studentSessionId) &&
+      isCanonicalStudentIdentifier(key.testId)
+      ? Object.freeze({
+          schoolId: key.schoolId,
+          studentSessionId: key.studentSessionId,
+          testId: key.testId,
+        })
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function acknowledgeStudentCredentialReceiptAtomically(
+  keyValue: unknown,
+  input: StudentCredentialAcknowledgmentInput,
+  storage: StudentSessionAuthorityStoragePort,
+): Promise<StudentSessionMutationDecision> {
+  const key = parseStudentSessionKey(keyValue);
+  if (key === null) return STUDENT_SESSION_PUBLIC_DENIAL;
+  for (
+    let attempt = 0;
+    attempt < STUDENT_CREDENTIAL_ACK_MAX_CAS_ATTEMPTS;
+    attempt += 1
+  ) {
+    try {
+      const current = decodeAccountlessStudentSessionRecord(
+        await storage.load(key),
+      );
+      if (current === null || !sessionKeysEqual(current, key)) {
+        return STUDENT_SESSION_PUBLIC_DENIAL;
+      }
+      const decision = acknowledgeStudentCredentialReceipt(current, input);
+      if (decision.status !== "accepted") return decision;
+      if (decision.session.revision === current.revision) return decision;
+      if (
+        (await storage.compareAndSwap({
+          expectedRevision: current.revision,
+          key,
+          next: decision.session,
+        })) === "committed"
+      ) {
+        return decision;
+      }
+    } catch {
+      return STUDENT_SESSION_PUBLIC_DENIAL;
+    }
+  }
+  return STUDENT_SESSION_PUBLIC_DENIAL;
+}
+
+export async function recoverStudentCredentialReceiptAtomically(
+  keyValue: unknown,
+  input: StudentCredentialRecoveryInput,
+  storage: StudentSessionAuthorityStoragePort,
+): Promise<StudentConnectionDecision> {
+  const key = parseStudentSessionKey(keyValue);
+  if (key === null) return STUDENT_SESSION_PUBLIC_DENIAL;
+  for (
+    let attempt = 0;
+    attempt < STUDENT_CREDENTIAL_RECOVERY_MAX_CAS_ATTEMPTS;
+    attempt += 1
+  ) {
+    try {
+      const current = decodeAccountlessStudentSessionRecord(
+        await storage.load(key),
+      );
+      if (current === null || !sessionKeysEqual(current, key)) {
+        return STUDENT_SESSION_PUBLIC_DENIAL;
+      }
+      const decision = recoverStudentCredentialReceipt(current, input);
+      if (decision.status !== "accepted") return decision;
+      if (decision.session.revision === current.revision) return decision;
+      if (
+        (await storage.compareAndSwap({
+          expectedRevision: current.revision,
+          key,
+          next: decision.session,
+        })) === "committed"
+      ) {
+        return decision;
+      }
+    } catch {
+      return STUDENT_SESSION_PUBLIC_DENIAL;
+    }
+  }
+  return STUDENT_SESSION_PUBLIC_DENIAL;
+}
+
+function invalidateStudentSessionAuthority(
+  session: AccountlessStudentSessionRecord,
+  lifecycle: "ended" | "forfeited" | "removed",
+  lifecycleChangedAtMs: number,
+): AccountlessStudentSessionRecord {
+  return freezeSessionRecord({
+    ...session,
+    currentCapability: null,
+    currentReconnectGrant: null,
+    deviceSessionId: null,
+    deviceSessionPublicKeyThumbprint: null,
+    lastConnectionDecision: null,
+    lifecycle,
+    lifecycleChangedAtMs,
+    revision: session.revision + 1,
+  });
+}
+
+export function removeAccountlessStudentSession(
+  persisted: unknown,
+  input: { readonly removedAtMs: number },
+): StudentSessionMutationDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  if (
+    session === null ||
+    session.lifecycle === "removed" ||
+    session.lifecycle === "forfeited" ||
+    session.lifecycle === "ended" ||
+    !canAdvanceRevision(session) ||
+    !isSafeTimestamp(input.removedAtMs) ||
+    input.removedAtMs < session.lifecycleChangedAtMs
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  return mutationAccepted(
+    invalidateStudentSessionAuthority(session, "removed", input.removedAtMs),
+  );
+}
+
+export function readmitAccountlessStudentSession(
+  persisted: unknown,
+  value: unknown,
+): StudentSessionMutationDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  let input: Record<string, unknown> | null;
+  try {
+    input = snapshotExactDataObject(value, ["readmittedAtMs"]);
+  } catch {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  if (
+    session === null ||
+    input === null ||
+    session.lifecycle !== "removed" ||
+    !canAdvanceRevision(session) ||
+    session.epoch === 2_147_483_647 ||
+    !isSafeTimestamp(input.readmittedAtMs) ||
+    input.readmittedAtMs < session.lifecycleChangedAtMs
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  return mutationAccepted({
+    ...session,
+    epoch: session.epoch + 1,
+    lifecycle: "readmitted",
+    lifecycleChangedAtMs: input.readmittedAtMs,
+    revision: session.revision + 1,
+  });
+}
+
+export function endAccountlessStudentSession(
+  persisted: unknown,
+  input: { readonly endedAtMs: number; readonly scope: TestScope },
+): StudentSessionMutationDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  if (
+    session === null ||
+    session.lifecycle === "ended" ||
+    !canAdvanceRevision(session) ||
+    session.schoolId !== input.scope.schoolId ||
+    session.testId !== input.scope.testId ||
+    !isSafeTimestamp(input.endedAtMs) ||
+    input.endedAtMs < session.lifecycleChangedAtMs
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  return mutationAccepted(
+    invalidateStudentSessionAuthority(session, "ended", input.endedAtMs),
+  );
+}
+
+export function forfeitAccountlessStudentSession(
+  persisted: unknown,
+  input: { readonly forfeitedAtMs: number },
+): StudentSessionMutationDecision {
+  const session = decodeAccountlessStudentSessionRecord(persisted);
+  if (
+    session === null ||
+    session.lifecycle === "removed" ||
+    session.lifecycle === "forfeited" ||
+    session.lifecycle === "ended" ||
+    !canAdvanceRevision(session) ||
+    !isSafeTimestamp(input.forfeitedAtMs) ||
+    input.forfeitedAtMs < session.lifecycleChangedAtMs
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+  return mutationAccepted(
+    invalidateStudentSessionAuthority(
+      session,
+      "forfeited",
+      input.forfeitedAtMs,
+    ),
+  );
+}
