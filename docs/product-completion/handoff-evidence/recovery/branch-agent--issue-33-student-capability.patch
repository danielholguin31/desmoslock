diff --git a/packages/domain/src/join-rate-limit.ts b/packages/domain/src/join-rate-limit.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44d66506a0b2e526964f83addde795aa88bd6f8d
--- /dev/null
+++ b/packages/domain/src/join-rate-limit.ts
@@ -0,0 +1,277 @@
+import {
+  STUDENT_SESSION_PUBLIC_DENIAL,
+  type StudentSessionPublicDenial,
+} from "./accountless-student-capability.js";
+import type { StudentRateLimitKeyDigest } from "./student-session-authority-ports.js";
+import { isStudentAuthorityDigest } from "./student-session-security.js";
+
+export const JOIN_RATE_LIMIT_MAX_CAS_ATTEMPTS = 3;
+
+export interface JoinRateLimitPolicy {
+  readonly maxAttempts: number;
+  readonly windowMs: number;
+}
+
+export interface JoinRateLimitSnapshot {
+  readonly attempts: number;
+  readonly keyDigest: StudentRateLimitKeyDigest;
+  readonly revision: number;
+  readonly windowStartedAtMs: number;
+}
+
+export interface JoinRateLimitReservation {
+  readonly expectedRevision: number | null;
+  readonly next: JoinRateLimitSnapshot;
+}
+
+export interface JoinRateLimitStoragePort {
+  load(keyDigest: StudentRateLimitKeyDigest): Promise<unknown>;
+  compareAndSwap(
+    reservation: JoinRateLimitReservation,
+  ): Promise<"committed" | "conflict">;
+}
+
+export interface JoinRateLimitReservationDecision {
+  readonly code: "JOIN_RATE_LIMIT_RESERVATION";
+  readonly reservation: JoinRateLimitReservation;
+  readonly status: "reservation_required";
+}
+
+export interface JoinRateLimitCommittedDecision {
+  readonly code: "JOIN_ATTEMPT_ALLOWED";
+  readonly status: "allowed";
+}
+
+export type JoinRateLimitCoordinatorDecision =
+  JoinRateLimitCommittedDecision | StudentSessionPublicDenial;
+
+export type JoinRateLimitDecision =
+  JoinRateLimitReservationDecision | StudentSessionPublicDenial;
+
+export type JoinRateLimitCommitDecision =
+  | {
+      readonly snapshot: JoinRateLimitSnapshot;
+      readonly status: "committed";
+    }
+  | { readonly status: "conflict" };
+
+function isSafeNonNegativeInteger(value: number): boolean {
+  return Number.isSafeInteger(value) && value >= 0;
+}
+
+function validPolicy(policy: JoinRateLimitPolicy): boolean {
+  return (
+    Number.isSafeInteger(policy.maxAttempts) &&
+    policy.maxAttempts >= 1 &&
+    policy.maxAttempts <= 1_000 &&
+    Number.isSafeInteger(policy.windowMs) &&
+    policy.windowMs >= 1_000 &&
+    policy.windowMs <= 86_400_000
+  );
+}
+
+function allow(
+  expectedRevision: number | null,
+  next: JoinRateLimitSnapshot,
+): JoinRateLimitReservationDecision {
+  const frozenNext = Object.freeze({
+    attempts: next.attempts,
+    keyDigest: next.keyDigest,
+    revision: next.revision,
+    windowStartedAtMs: next.windowStartedAtMs,
+  });
+  return Object.freeze({
+    code: "JOIN_RATE_LIMIT_RESERVATION",
+    reservation: Object.freeze({ expectedRevision, next: frozenNext }),
+    status: "reservation_required",
+  });
+}
+
+export function decideJoinRateLimit(input: {
+  readonly attemptedAtMs: number;
+  readonly keyDigest: StudentRateLimitKeyDigest;
+  readonly policy: JoinRateLimitPolicy;
+  readonly snapshot: JoinRateLimitSnapshot | null;
+}): JoinRateLimitDecision {
+  if (
+    !isStudentAuthorityDigest(input.keyDigest) ||
+    !isSafeNonNegativeInteger(input.attemptedAtMs) ||
+    !validPolicy(input.policy)
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+
+  const snapshot = input.snapshot;
+  if (snapshot === null) {
+    return allow(null, {
+      attempts: 1,
+      keyDigest: input.keyDigest,
+      revision: 0,
+      windowStartedAtMs: input.attemptedAtMs,
+    });
+  }
+
+  const windowEndsAtMs = snapshot.windowStartedAtMs + input.policy.windowMs;
+  if (
+    snapshot.keyDigest !== input.keyDigest ||
+    !isSafeNonNegativeInteger(snapshot.attempts) ||
+    snapshot.attempts === 0 ||
+    !isSafeNonNegativeInteger(snapshot.revision) ||
+    snapshot.revision === Number.MAX_SAFE_INTEGER ||
+    !isSafeNonNegativeInteger(snapshot.windowStartedAtMs) ||
+    !Number.isSafeInteger(windowEndsAtMs) ||
+    input.attemptedAtMs < snapshot.windowStartedAtMs
+  ) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+
+  if (input.attemptedAtMs >= windowEndsAtMs) {
+    return allow(snapshot.revision, {
+      attempts: 1,
+      keyDigest: input.keyDigest,
+      revision: snapshot.revision + 1,
+      windowStartedAtMs: input.attemptedAtMs,
+    });
+  }
+
+  if (snapshot.attempts >= input.policy.maxAttempts) {
+    return STUDENT_SESSION_PUBLIC_DENIAL;
+  }
+
+  return allow(snapshot.revision, {
+    ...snapshot,
+    attempts: snapshot.attempts + 1,
+    revision: snapshot.revision + 1,
+  });
+}
+
+export function commitJoinRateLimitReservation(
+  current: JoinRateLimitSnapshot | null,
+  reservation: JoinRateLimitReservation,
+): JoinRateLimitCommitDecision {
+  const { expectedRevision, next } = reservation;
+  const creating = expectedRevision === null;
+  if (
+    !isStudentAuthorityDigest(next.keyDigest) ||
+    !isSafeNonNegativeInteger(next.attempts) ||
+    next.attempts === 0 ||
+    !isSafeNonNegativeInteger(next.revision) ||
+    !isSafeNonNegativeInteger(next.windowStartedAtMs) ||
+    (creating && (current !== null || next.revision !== 0)) ||
+    (!creating &&
+      (current === null ||
+        expectedRevision === Number.MAX_SAFE_INTEGER ||
+        current.revision !== expectedRevision ||
+        current.keyDigest !== next.keyDigest ||
+        next.revision !== expectedRevision + 1 ||
+        next.windowStartedAtMs < current.windowStartedAtMs ||
+        (next.windowStartedAtMs === current.windowStartedAtMs &&
+          next.attempts !== current.attempts + 1) ||
+        (next.windowStartedAtMs > current.windowStartedAtMs &&
+          next.attempts !== 1)))
+  ) {
+    return Object.freeze({ status: "conflict" });
+  }
+
+  return Object.freeze({
+    snapshot: Object.freeze({
+      attempts: next.attempts,
+      keyDigest: next.keyDigest,
+      revision: next.revision,
+      windowStartedAtMs: next.windowStartedAtMs,
+    }),
+    status: "committed",
+  });
+}
+
+function decodeJoinRateLimitSnapshot(
+  value: unknown,
+): JoinRateLimitSnapshot | null {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return null;
+  }
+  try {
+    const prototype = Object.getPrototypeOf(value) as unknown;
+    if (prototype !== Object.prototype && prototype !== null) return null;
+    const keys = Reflect.ownKeys(value);
+    const expected = ["attempts", "keyDigest", "revision", "windowStartedAtMs"];
+    if (
+      keys.length !== expected.length ||
+      keys.some((key) => typeof key !== "string") ||
+      expected.some((key) => !keys.includes(key))
+    ) {
+      return null;
+    }
+    const snapshot: Record<string, unknown> = Object.create(null) as Record<
+      string,
+      unknown
+    >;
+    for (const key of expected) {
+      const descriptor = Object.getOwnPropertyDescriptor(value, key);
+      if (
+        descriptor === undefined ||
+        !descriptor.enumerable ||
+        !("value" in descriptor)
+      ) {
+        return null;
+      }
+      snapshot[key] = descriptor.value;
+    }
+    if (
+      !isSafeNonNegativeInteger(snapshot.attempts as number) ||
+      snapshot.attempts === 0 ||
+      !isStudentAuthorityDigest(snapshot.keyDigest) ||
+      !isSafeNonNegativeInteger(snapshot.revision as number) ||
+      !isSafeNonNegativeInteger(snapshot.windowStartedAtMs as number)
+    ) {
+      return null;
+    }
+    return Object.freeze({
+      attempts: snapshot.attempts as number,
+      keyDigest: snapshot.keyDigest as StudentRateLimitKeyDigest,
+      revision: snapshot.revision as number,
+      windowStartedAtMs: snapshot.windowStartedAtMs as number,
+    });
+  } catch {
+    return null;
+  }
+}
+
+export async function reserveJoinRateLimitCapacity(
+  input: {
+    readonly attemptedAtMs: number;
+    readonly keyDigest: StudentRateLimitKeyDigest;
+    readonly policy: JoinRateLimitPolicy;
+  },
+  storage: JoinRateLimitStoragePort,
+): Promise<JoinRateLimitCoordinatorDecision> {
+  for (
+    let attempt = 0;
+    attempt < JOIN_RATE_LIMIT_MAX_CAS_ATTEMPTS;
+    attempt += 1
+  ) {
+    try {
+      const loaded = await storage.load(input.keyDigest);
+      const snapshot =
+        loaded === null ? null : decodeJoinRateLimitSnapshot(loaded);
+      if (loaded !== null && snapshot === null) {
+        return STUDENT_SESSION_PUBLIC_DENIAL;
+      }
+      const decision = decideJoinRateLimit({ ...input, snapshot });
+      if (decision.status !== "reservation_required") {
+        return STUDENT_SESSION_PUBLIC_DENIAL;
+      }
+      if (
+        (await storage.compareAndSwap(decision.reservation)) === "committed"
+      ) {
+        return Object.freeze({
+          code: "JOIN_ATTEMPT_ALLOWED",
+          status: "allowed",
+        });
+      }
+    } catch {
+      return STUDENT_SESSION_PUBLIC_DENIAL;
+    }
+  }
+  return STUDENT_SESSION_PUBLIC_DENIAL;
+}
