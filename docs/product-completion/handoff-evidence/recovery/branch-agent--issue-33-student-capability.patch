+import type {
+  DeterministicStudentCredentialIssuance,
+  RecoveredStudentCredentialMaterial,
+  StudentCredentialDerivationKey,
+  StudentCredentialIssuancePort,
+  StudentSessionDeviceProofVerificationPort,
+  VerifiedDeviceSessionProof,
+  VerifiedDeviceSessionProofExpectation,
+} from "./student-session-authority-ports.js";
+
+export const MAX_STUDENT_CAPABILITY_TTL_MS = 5 * 60 * 1_000;
+export const MAX_STUDENT_RECONNECT_TTL_MS = 15 * 60 * 1_000;
+export const MAX_STUDENT_CREDENTIAL_RECOVERY_TTL_MS =
+  MAX_STUDENT_RECONNECT_TTL_MS;
+export const MAX_STUDENT_IDEMPOTENCY_TTL_MS =
+  MAX_STUDENT_CREDENTIAL_RECOVERY_TTL_MS;
+export const MAX_DEVICE_SESSION_PROOF_TTL_MS = 15 * 1_000;
+export const STUDENT_CREDENTIAL_DERIVATION_DOMAIN =
+  "desmoslock/student-credential-issuance/v1" as const;
+
+const canonicalUuid =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u;
+const sha256Digest = /^[0-9a-f]{64}$/u;
+const opaqueReceipt = /^[A-Za-z0-9_-]{43,2048}$/u;
+const publicKeyThumbprint = /^[A-Za-z0-9_-]{43,128}$/u;
+const opaqueCredential = /^[A-Za-z0-9_-]{43,512}$/u;
+
+function snapshotExactDataObject(
+  value: unknown,
+  expectedKeys: readonly string[],
+): Record<string, unknown> | null {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return null;
+  }
+  const prototype = Object.getPrototypeOf(value) as unknown;
+  if (prototype !== Object.prototype && prototype !== null) return null;
+  const ownKeys = Reflect.ownKeys(value);
+  if (
+    ownKeys.length !== expectedKeys.length ||
+    ownKeys.some((key) => typeof key !== "string")
+  ) {
+    return null;
+  }
+  const keySet = new Set(ownKeys as string[]);
+  if (expectedKeys.some((key) => !keySet.has(key))) return null;
+  const snapshot: Record<string, unknown> = Object.create(null) as Record<
+    string,
+    unknown
+  >;
+  for (const key of expectedKeys) {
+    const descriptor = Object.getOwnPropertyDescriptor(value, key);
+    if (
+      descriptor === undefined ||
+      !descriptor.enumerable ||
+      !("value" in descriptor)
+    ) {
+      return null;
+    }
+    snapshot[key] = descriptor.value;
+  }
+  return snapshot;
+}
+
+function snapshotAllowedIntents(
+  value: unknown,
+): readonly StudentCredentialDerivationKey["allowedIntents"][number][] | null {
+  if (!Array.isArray(value)) return null;
+  const lengthDescriptor = Object.getOwnPropertyDescriptor(value, "length");
+  if (
+    lengthDescriptor === undefined ||
+    !("value" in lengthDescriptor) ||
+    !Number.isSafeInteger(lengthDescriptor.value) ||
+    lengthDescriptor.value < 1 ||
+    lengthDescriptor.value > 4
+  ) {
+    return null;
+  }
+  const length = lengthDescriptor.value as number;
+  const expectedKeys = [
+    ...Array.from({ length }, (_, index) => String(index)),
+    "length",
+  ];
+  const ownKeys = Reflect.ownKeys(value);
+  if (
+    ownKeys.length !== expectedKeys.length ||
+    expectedKeys.some((key) => !ownKeys.includes(key))
+  ) {
+    return null;
+  }
+  const intents: unknown[] = [];
+  for (let index = 0; index < length; index += 1) {
+    const descriptor = Object.getOwnPropertyDescriptor(value, String(index));
+    if (
+      descriptor === undefined ||
+      !descriptor.enumerable ||
+      !("value" in descriptor)
+    ) {
+      return null;
+    }
+    intents.push(descriptor.value);
+  }
+  const intentOrder = [
+    "calculator.write",
+    "evidence.submit",
+    "release.request",
+    "state.read",
+  ] as const;
+  if (
+    intents.some(
+      (intent) =>
+        typeof intent !== "string" ||
+        !intentOrder.includes(intent as (typeof intentOrder)[number]),
+    ) ||
+    new Set(intents).size !== intents.length
+  ) {
+    return null;
+  }
+  return Object.freeze(
+    (intents as (typeof intentOrder)[number][]).toSorted(
+      (left, right) => intentOrder.indexOf(left) - intentOrder.indexOf(right),
+    ),
+  );
+}
+
+export function isCanonicalStudentIdentifier(value: unknown): value is string {
+  return typeof value === "string" && canonicalUuid.test(value);
+}
+
+export function isStudentAuthorityDigest(value: unknown): value is string {
+  return typeof value === "string" && sha256Digest.test(value);
+}
+
+export function isSealedStudentCredentialReceipt(
+  value: unknown,
+): value is DeterministicStudentCredentialIssuance["sealedReceipt"] {
+  return typeof value === "string" && opaqueReceipt.test(value);
+}
+
+export function isSyntheticStudentDisplayName(value: unknown): value is string {
+  return (
+    typeof value === "string" &&
+    /^Student [A-Z0-9][A-Z0-9-]{1,23}$/u.test(value)
+  );
+}
+
+export function isWithinStudentAuthorityTtl(
+  serverNowMs: number,
+  expiresAtMs: number,
+  maximumTtlMs: number,
+): boolean {
+  return (
+    Number.isSafeInteger(serverNowMs) &&
+    serverNowMs >= 0 &&
+    Number.isSafeInteger(expiresAtMs) &&
+    expiresAtMs > serverNowMs &&
+    Number.isSafeInteger(maximumTtlMs) &&
+    maximumTtlMs > 0 &&
+    expiresAtMs - serverNowMs <= maximumTtlMs
+  );
+}
+
+function proofMatchesExpectation(
+  value: unknown,
+  expected: VerifiedDeviceSessionProofExpectation,
+): VerifiedDeviceSessionProof | null {
+  const proof = snapshotExactDataObject(value, [
+    "antiReplayId",
+    "challengeId",
+    "deviceSessionId",
+    "deviceSessionPublicKeyThumbprint",
+    "epoch",
+    "expiresAtMs",
+    "intent",
+    "logicalOperationDigest",
+    "operationKind",
+    "proofEnvelopeDigest",
+    "requestId",
+    "schoolId",
+    "studentSessionId",
+    "testId",
+  ]);
+  if (
+    proof === null ||
+    !isCanonicalStudentIdentifier(proof.antiReplayId) ||
+    proof.antiReplayId !== expected.antiReplayId ||
+    proof.challengeId !== expected.challengeId ||
+    proof.deviceSessionId !== expected.deviceSessionId ||
+    proof.deviceSessionPublicKeyThumbprint !==
+      expected.deviceSessionPublicKeyThumbprint ||
+    proof.epoch !== expected.epoch ||
+    proof.expiresAtMs !== expected.expiresAtMs ||
+    proof.intent !== expected.intent ||
+    proof.logicalOperationDigest !== expected.logicalOperationDigest ||
+    proof.operationKind !== expected.operationKind ||
+    proof.proofEnvelopeDigest !== expected.proofEnvelopeDigest ||
+    proof.requestId !== expected.requestId ||
+    proof.schoolId !== expected.schoolId ||
+    proof.studentSessionId !== expected.studentSessionId ||
+    proof.testId !== expected.testId ||
+    typeof proof.deviceSessionPublicKeyThumbprint !== "string" ||
+    !publicKeyThumbprint.test(proof.deviceSessionPublicKeyThumbprint) ||
+    !isWithinStudentAuthorityTtl(
+      expected.serverNowMs,
+      typeof proof.expiresAtMs === "number" ? proof.expiresAtMs : Number.NaN,
+      MAX_DEVICE_SESSION_PROOF_TTL_MS,
+    )
+  ) {
+    return null;
+  }
+  return Object.freeze({
+    antiReplayId: proof.antiReplayId,
+    challengeId: proof.challengeId,
+    deviceSessionId: proof.deviceSessionId,
+    deviceSessionPublicKeyThumbprint: proof.deviceSessionPublicKeyThumbprint,
+    epoch: proof.epoch,
+    expiresAtMs: proof.expiresAtMs,
+    intent: proof.intent,
+    logicalOperationDigest: proof.logicalOperationDigest,
+    operationKind: proof.operationKind,
+    proofEnvelopeDigest: proof.proofEnvelopeDigest,
+    requestId: proof.requestId,
+    schoolId: proof.schoolId,
+    studentSessionId: proof.studentSessionId,
+    testId: proof.testId,
+  }) as unknown as VerifiedDeviceSessionProof;
+}
+
+function snapshotProofExpectation(
+  value: unknown,
+): VerifiedDeviceSessionProofExpectation | null {
+  try {
+    const expected = snapshotExactDataObject(value, [
+      "antiReplayId",
+      "challengeId",
+      "deviceSessionId",
+      "deviceSessionPublicKeyThumbprint",
+      "epoch",
+      "expiresAtMs",
+      "intent",
+      "logicalOperationDigest",
+      "operationKind",
+      "proofEnvelopeDigest",
+      "requestId",
+      "schoolId",
+      "serverNowMs",
+      "studentSessionId",
+      "testId",
+    ]);
+    if (
+      expected === null ||
+      !isCanonicalStudentIdentifier(expected.antiReplayId) ||
+      !isCanonicalStudentIdentifier(expected.challengeId) ||
+      !isCanonicalStudentIdentifier(expected.deviceSessionId) ||
+      typeof expected.deviceSessionPublicKeyThumbprint !== "string" ||
+      !publicKeyThumbprint.test(expected.deviceSessionPublicKeyThumbprint) ||
+      !isCanonicalStudentIdentifier(expected.requestId) ||
+      !isCanonicalStudentIdentifier(expected.schoolId) ||
+      !isCanonicalStudentIdentifier(expected.studentSessionId) ||
+      !isCanonicalStudentIdentifier(expected.testId) ||
+      !isStudentAuthorityDigest(expected.logicalOperationDigest) ||
+      !isStudentAuthorityDigest(expected.proofEnvelopeDigest) ||
+      (expected.operationKind !== "capability" &&
+        expected.operationKind !== "credential_acknowledgment" &&
+        expected.operationKind !== "credential_recovery" &&
+        expected.operationKind !== "join" &&
+        expected.operationKind !== "reconnect") ||
+      (expected.operationKind === "capability"
+        ? expected.intent !== "calculator.write" &&
+          expected.intent !== "evidence.submit" &&
+          expected.intent !== "release.request" &&
+          expected.intent !== "state.read"
+        : expected.intent !== null) ||
+      !Number.isSafeInteger(expected.epoch) ||
+      (expected.epoch as number) < 0 ||
+      (expected.epoch as number) > 2_147_483_647 ||
+      !Number.isSafeInteger(expected.serverNowMs) ||
+      (expected.serverNowMs as number) < 0 ||
+      !isWithinStudentAuthorityTtl(
+        expected.serverNowMs as number,
+        typeof expected.expiresAtMs === "number"
+          ? expected.expiresAtMs
+          : Number.NaN,
+        MAX_DEVICE_SESSION_PROOF_TTL_MS,
+      )
+    ) {
+      return null;
+    }
+    return Object.freeze({
+      antiReplayId: expected.antiReplayId,
+      challengeId: expected.challengeId,
+      deviceSessionId: expected.deviceSessionId,
+      deviceSessionPublicKeyThumbprint:
+        expected.deviceSessionPublicKeyThumbprint,
+      epoch: expected.epoch,
+      expiresAtMs: expected.expiresAtMs,
+      intent: expected.intent,
+      logicalOperationDigest: expected.logicalOperationDigest,
+      operationKind: expected.operationKind,
+      proofEnvelopeDigest: expected.proofEnvelopeDigest,
+      requestId: expected.requestId,
+      schoolId: expected.schoolId,
+      serverNowMs: expected.serverNowMs,
+      studentSessionId: expected.studentSessionId,
+      testId: expected.testId,
+    }) as VerifiedDeviceSessionProofExpectation;
+  } catch {
+    return null;
+  }
+}
+
+export async function verifyAndConsumeDeviceSessionProof<ProofMaterial>(
+  proofMaterial: ProofMaterial,
+  expected: VerifiedDeviceSessionProofExpectation,
+  port: StudentSessionDeviceProofVerificationPort<ProofMaterial>,
+): Promise<VerifiedDeviceSessionProof | null> {
+  const normalizedExpected = snapshotProofExpectation(expected);
+  if (normalizedExpected === null) return null;
+
+  try {
+    const verified = await port.verifyAndConsume({
+      expected: normalizedExpected,
+      proofMaterial,
+    });
+    return proofMatchesExpectation(verified, normalizedExpected);
+  } catch {
+    return null;
+  }
+}
+
+function snapshotIssuance(
+  value: unknown,
+  serverNowMs: number,
+  expectedIntentSetDigest: StudentCredentialDerivationKey["intentSetDigest"],
+): DeterministicStudentCredentialIssuance | null {
+  try {
+    const issuance = snapshotExactDataObject(value, [
+      "capabilityDigest",
+      "capabilityExpiresAtMs",
+      "intentSetDigest",
+      "receiptExpiresAtMs",
+      "reconnectGrantDigest",
+      "reconnectGrantExpiresAtMs",
+      "sealedReceipt",
+    ]);
+    if (
+      issuance === null ||
+      !isStudentAuthorityDigest(issuance.capabilityDigest) ||
+      !isStudentAuthorityDigest(issuance.reconnectGrantDigest) ||
+      String(issuance.capabilityDigest) ===
+        String(issuance.reconnectGrantDigest) ||
+      issuance.intentSetDigest !== expectedIntentSetDigest ||
+      !isSealedStudentCredentialReceipt(issuance.sealedReceipt) ||
+      !isWithinStudentAuthorityTtl(
+        serverNowMs,
+        typeof issuance.capabilityExpiresAtMs === "number"
+          ? issuance.capabilityExpiresAtMs
+          : Number.NaN,
+        MAX_STUDENT_CAPABILITY_TTL_MS,
+      ) ||
+      !isWithinStudentAuthorityTtl(
+        serverNowMs,
+        typeof issuance.reconnectGrantExpiresAtMs === "number"
+          ? issuance.reconnectGrantExpiresAtMs
+          : Number.NaN,
+        MAX_STUDENT_RECONNECT_TTL_MS,
+      ) ||
+      !isWithinStudentAuthorityTtl(
+        serverNowMs,
+        typeof issuance.receiptExpiresAtMs === "number"
+          ? issuance.receiptExpiresAtMs
+          : Number.NaN,
+        MAX_STUDENT_CREDENTIAL_RECOVERY_TTL_MS,
+      ) ||
+      issuance.receiptExpiresAtMs !==
+        Math.max(
+          issuance.capabilityExpiresAtMs as number,
+          issuance.reconnectGrantExpiresAtMs as number,
+        )
+    ) {
+      return null;
+    }
+    return Object.freeze({
+      capabilityDigest: issuance.capabilityDigest,
+      capabilityExpiresAtMs: issuance.capabilityExpiresAtMs,
+      intentSetDigest: issuance.intentSetDigest,
+      receiptExpiresAtMs: issuance.receiptExpiresAtMs,
+      reconnectGrantDigest: issuance.reconnectGrantDigest,
+      reconnectGrantExpiresAtMs: issuance.reconnectGrantExpiresAtMs,
+      sealedReceipt: issuance.sealedReceipt,
+    }) as DeterministicStudentCredentialIssuance;
+  } catch {
+    return null;
+  }
+}
+
+function normalizeCredentialDerivationKey(
+  value: unknown,
+): StudentCredentialDerivationKey | null {
+  try {
+    const key = snapshotExactDataObject(value, [
+      "allowedIntents",
+      "deviceSessionId",
+      "epoch",
+      "intentSetDigest",
+      "issuedAtMs",
+      "logicalOperationDigest",
+      "schoolId",
+      "studentSessionId",
+      "testId",
+    ]);
+    const allowedIntents = snapshotAllowedIntents(key?.allowedIntents);
+    if (
+      key === null ||
+      allowedIntents === null ||
+      !isCanonicalStudentIdentifier(key.schoolId) ||
+      !isCanonicalStudentIdentifier(key.testId) ||
+      !isCanonicalStudentIdentifier(key.studentSessionId) ||
+      !isCanonicalStudentIdentifier(key.deviceSessionId) ||
+      !Number.isSafeInteger(key.epoch) ||
+      (key.epoch as number) < 0 ||
+      (key.epoch as number) > 2_147_483_647 ||
+      !Number.isSafeInteger(key.issuedAtMs) ||
+      (key.issuedAtMs as number) < 0 ||
+      !isStudentAuthorityDigest(key.logicalOperationDigest) ||
+      !isStudentAuthorityDigest(key.intentSetDigest)
+    ) {
+      return null;
+    }
+    return Object.freeze({
+      allowedIntents,
+      deviceSessionId: key.deviceSessionId,
+      epoch: key.epoch,
+      intentSetDigest: key.intentSetDigest,
+      issuedAtMs: key.issuedAtMs,
+      logicalOperationDigest: key.logicalOperationDigest,
+      schoolId: key.schoolId,
+      studentSessionId: key.studentSessionId,
+      testId: key.testId,
+    }) as StudentCredentialDerivationKey;
+  } catch {
+    return null;
+  }
+}
+
+export async function deriveDeterministicStudentCredentialIssuance(
+  key: StudentCredentialDerivationKey,
+  serverNowMs: number,
+  port: StudentCredentialIssuancePort,
+): Promise<DeterministicStudentCredentialIssuance | null> {
+  const normalizedKey = normalizeCredentialDerivationKey(key);
+  if (
+    normalizedKey === null ||
+    !Number.isSafeInteger(serverNowMs) ||
+    serverNowMs < 0 ||
+    serverNowMs !== normalizedKey.issuedAtMs
+  ) {
+    return null;
+  }
+  try {
+    const issuance = await port.deriveDeterministic({
+      domain: STUDENT_CREDENTIAL_DERIVATION_DOMAIN,
+      key: normalizedKey,
+    });
+    return snapshotIssuance(
+      issuance,
+      serverNowMs,
+      normalizedKey.intentSetDigest,
+    );
+  } catch {
+    return null;
+  }
+}
+
+export async function recoverStudentCredentialMaterial(
+  key: StudentCredentialDerivationKey,
+  issuance: DeterministicStudentCredentialIssuance,
+  serverNowMs: number,
+  port: StudentCredentialIssuancePort,
+): Promise<RecoveredStudentCredentialMaterial | null> {
+  const normalizedKey = normalizeCredentialDerivationKey(key);
+  if (normalizedKey === null) return null;
+  const normalizedIssuance = snapshotIssuance(
+    issuance,
+    normalizedKey.issuedAtMs,
+    normalizedKey.intentSetDigest,
+  );
+  if (
+    normalizedIssuance === null ||
+    !Number.isSafeInteger(serverNowMs) ||
+    serverNowMs < normalizedKey.issuedAtMs ||
+    serverNowMs >= normalizedIssuance.receiptExpiresAtMs
+  ) {
+    return null;
+  }
+  try {
+    const recovered = await port.recoverForResponse({
+      domain: STUDENT_CREDENTIAL_DERIVATION_DOMAIN,
+      key: normalizedKey,
+      sealedReceipt: normalizedIssuance.sealedReceipt,
+    });
+    const snapshot = snapshotExactDataObject(recovered, [
+      "capability",
+      "reconnectGrant",
+    ]);
+    return snapshot !== null &&
+      typeof snapshot.capability === "string" &&
+      opaqueCredential.test(snapshot.capability) &&
+      typeof snapshot.reconnectGrant === "string" &&
+      opaqueCredential.test(snapshot.reconnectGrant) &&
+      snapshot.capability !== snapshot.reconnectGrant
+      ? (Object.freeze({
+          capability: snapshot.capability,
+          reconnectGrant: snapshot.reconnectGrant,
+        }) as RecoveredStudentCredentialMaterial)
+      : null;
+  } catch {
+    return null;
+  }
+}
