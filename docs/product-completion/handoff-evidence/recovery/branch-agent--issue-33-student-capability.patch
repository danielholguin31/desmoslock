+import { describe, expect, it } from "vitest";
+
+import {
+  authorizeStudentCapability,
+  endAccountlessStudentSession,
+  removeAccountlessStudentSession,
+} from "../src/index.js";
+import {
+  acceptedSession,
+  capabilityDigest,
+  connectedSession,
+  ids,
+  intentAuthorityVerifier,
+  logicalOperationDigest,
+  proof,
+} from "./student-capability-test-fixtures.js";
+
+const denial = { code: "STUDENT_SESSION_DENIED", status: "denied" } as const;
+
+function inputFor(
+  session: ReturnType<typeof connectedSession>["session"],
+  nowMs = 1_500,
+) {
+  const capability = session.currentCapability;
+  if (capability === null || session.deviceSessionId === null) {
+    throw new Error("connected fixture is missing capability authority");
+  }
+  const operation = logicalOperationDigest("d");
+  return {
+    capabilityDigest: capability.digest,
+    challengeId: ids.challenge,
+    deviceSessionId: session.deviceSessionId,
+    intent: "state.read" as const,
+    nowMs,
+    logicalOperationDigest: operation,
+    proof: proof({
+      antiReplayId: ids.antiReplayB,
+      deviceSessionId: session.deviceSessionId,
+      epoch: session.epoch,
+      expiresAtMs: nowMs + 100,
+      intent: "state.read",
+      operationKind: "capability",
+      logicalOperation: operation,
+      schoolId: session.schoolId,
+      studentSessionId: session.studentSessionId,
+      testId: session.testId,
+    }),
+    requestId: ids.request,
+    scope: capability.scope,
+  };
+}
+
+describe("uniform Student capability denial", () => {
+  it("denies cross-scope A-to-B and B-to-A attempts identically", async () => {
+    const a = connectedSession("a").session;
+    const b = connectedSession("b").session;
+
+    expect(
+      await authorizeStudentCapability(b, inputFor(a), intentAuthorityVerifier),
+    ).toEqual(denial);
+    expect(
+      await authorizeStudentCapability(a, inputFor(b), intentAuthorityVerifier),
+    ).toEqual(denial);
+  });
+
+  it("makes malformed, expired, rotated, removed, and ended failures equal", async () => {
+    const session = connectedSession().session;
+    const input = inputFor(session);
+    const removed = acceptedSession(
+      removeAccountlessStudentSession(session, { removedAtMs: 1_600 }),
+    );
+    const ended = acceptedSession(
+      endAccountlessStudentSession(session, {
+        endedAtMs: 1_600,
+        scope: { schoolId: session.schoolId, testId: session.testId },
+      }),
+    );
+    const decisions = await Promise.all([
+      authorizeStudentCapability(
+        session,
+        {
+          ...input,
+          capabilityDigest: capabilityDigest("f"),
+        },
+        intentAuthorityVerifier,
+      ),
+      authorizeStudentCapability(
+        session,
+        {
+          ...input,
+          nowMs: session.currentCapability?.scope.expiresAtMs ?? 0,
+          proof: proof({ expiresAtMs: 1_000 }),
+        },
+        intentAuthorityVerifier,
+      ),
+      authorizeStudentCapability(
+        session,
+        {
+          ...input,
+          proof: proof({ schoolId: ids.schoolB }),
+        },
+        intentAuthorityVerifier,
+      ),
+      authorizeStudentCapability(
+        { ...session, revision: Number.POSITIVE_INFINITY },
+        input,
+        intentAuthorityVerifier,
+      ),
+      authorizeStudentCapability(removed, input, intentAuthorityVerifier),
+      authorizeStudentCapability(ended, input, intentAuthorityVerifier),
+    ]);
+    expect(
+      new Set(decisions.map((decision) => JSON.stringify(decision))),
+    ).toEqual(new Set([JSON.stringify(denial)]));
+  });
+});
diff --git a/packages/domain/tests/student-capability-test-fixtures.ts b/packages/domain/tests/student-capability-test-fixtures.ts
