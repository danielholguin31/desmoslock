+            return "committed";
+          },
+          async load() {
+            throw new Error("storage unavailable");
+          },
+        },
+      ),
+    ).resolves.toEqual(denial);
+  });
+
+  it("fails closed for exhausted, malformed, or unsafe persisted counters", async () => {
+    expect(
+      decideJoinRateLimit({
+        attemptedAtMs: 10_001,
+        keyDigest,
+        policy: { maxAttempts: 1, windowMs: 60_000 },
+        snapshot: {
+          attempts: 1,
+          keyDigest,
+          revision: 0,
+          windowStartedAtMs: 10_000,
+        },
+      }),
+    ).toEqual(denial);
+
+    await expect(
+      reserveJoinRateLimitCapacity(
+        {
+          attemptedAtMs: 10_001,
+          keyDigest,
+          policy: { maxAttempts: 2, windowMs: 60_000 },
+        },
+        {
+          async compareAndSwap() {
+            return "committed";
+          },
+          async load() {
+            return {
+              attempts: Number.NaN,
+              keyDigest,
+              revision: 0,
+              windowStartedAtMs: 10_000,
+            };
+          },
+        },
+      ),
+    ).resolves.toEqual(denial);
+  });
+});
