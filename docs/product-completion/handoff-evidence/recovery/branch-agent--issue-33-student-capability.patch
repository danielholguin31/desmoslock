+      { ...valid, reconnectGrantExpiresAtMs: 1_200 + 900_001 },
+      { ...valid, receiptExpiresAtMs: 1_200 + 900_001 },
+      { ...valid, receiptExpiresAtMs: valid.capabilityExpiresAtMs },
+      { ...valid, intentSetDigest: "8".repeat(64) as typeof intentSetDigest },
+      { ...valid, capabilityExpiresAtMs: Number.NaN },
+      { ...valid, receiptExpiresAtMs: Number.POSITIVE_INFINITY },
+      { ...valid, reconnectGrantExpiresAtMs: Number.MAX_SAFE_INTEGER + 1 },
+    ];
+    for (const invalid of invalidIssuances) {
+      expect(
+        await deriveDeterministicStudentCredentialIssuance(
+          derivationKey(),
+          1_200,
+          {
+            async deriveDeterministic() {
+              return invalid;
+            },
+            async recoverForResponse() {
+              return null;
+            },
+          },
+        ),
+      ).toBeNull();
+    }
+  });
+});
