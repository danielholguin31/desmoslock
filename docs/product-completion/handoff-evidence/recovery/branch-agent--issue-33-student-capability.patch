@@ -0,0 +1,339 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  createPreAdmissionJoinAuditRecord,
+  createStudentSessionAuditRecord,
+  generateAccountlessStudentSession,
+  STUDENT_AUTHORITY_DIGEST_DOMAINS,
+  verifiedStudentCapabilityIntentAuthorityAllows,
+  verifyStudentCapabilityIntentAuthority,
+  type PreAdmissionRateLimitSubject,
+  type DeviceSessionPublicKeyThumbprint,
+  type StudentCapabilityDigest,
+  type StudentCapabilityIntentAuthority,
+  type StudentCapabilityIntentAuthorityDigest,
+  type StudentIntentSetDigest,
+  type StudentCapabilityIntentAuthorityVerificationPort,
+  type StudentJoinMaterialDigest,
+  type StudentLogicalOperationDigest,
+  type StudentProofEnvelopeDigest,
+  type StudentRateLimitKeyDigest,
+  type StudentReconnectGrantDigest,
+  type StudentSessionAuthorityBackendPort,
+  type StudentSessionAuthorityStoragePort,
+  type StudentSessionDeviceProofVerificationPort,
+  type StudentSessionDigestFactoryPort,
+} from "../src/index.js";
+import { connectedSession, ids } from "./student-capability-test-fixtures.js";
+
+describe("Student Session authority ports", () => {
+  it("keeps keyed digest, proof verification, storage, and backend ownership explicit", async () => {
+    const digestFactory = {
+      async capabilityDigest() {
+        return "a".repeat(64) as StudentCapabilityDigest;
+      },
+      async capabilityIntentAuthorityDigest() {
+        return "8".repeat(64) as StudentCapabilityIntentAuthorityDigest;
+      },
+      async joinMaterialDigest() {
+        return "b".repeat(64) as StudentJoinMaterialDigest;
+      },
+      async logicalOperationDigest() {
+        return "c".repeat(64) as StudentLogicalOperationDigest;
+      },
+      async proofEnvelopeDigest() {
+        return "9".repeat(64) as StudentProofEnvelopeDigest;
+      },
+      async intentSetDigest() {
+        return "f".repeat(64) as StudentIntentSetDigest;
+      },
+      async rateLimitKeyDigest() {
+        return "d".repeat(64) as StudentRateLimitKeyDigest;
+      },
+      async reconnectGrantDigest() {
+        return "e".repeat(64) as StudentReconnectGrantDigest;
+      },
+    } satisfies StudentSessionDigestFactoryPort;
+    const verifier = {
+      async verifyAndConsume() {
+        return null;
+      },
+    } satisfies StudentSessionDeviceProofVerificationPort<string>;
+    const storage = {
+      async compareAndSwap() {
+        return "committed" as const;
+      },
+      async load() {
+        return null;
+      },
+    } satisfies StudentSessionAuthorityStoragePort;
+    const backend = {
+      async resolveAdmission() {
+        return null;
+      },
+    } satisfies StudentSessionAuthorityBackendPort;
+
+    expect(digestFactory.capabilityDigest).toBeTypeOf("function");
+    expect(new Set(Object.values(STUDENT_AUTHORITY_DIGEST_DOMAINS)).size).toBe(
+      8,
+    );
+    expect(verifier.verifyAndConsume).toBeTypeOf("function");
+    expect(storage.load).toBeTypeOf("function");
+    expect(backend.resolveAdmission).toBeTypeOf("function");
+  });
+
+  it("keeps verified intent authority opaque and identity-bound", async () => {
+    const expectedDigest = "7".repeat(
+      64,
+    ) as StudentCapabilityIntentAuthorityDigest;
+    const authority: StudentCapabilityIntentAuthority = {
+      allowedIntents: ["state.read"],
+      allowedIntentSetDigest: "6".repeat(64) as StudentIntentSetDigest,
+      capabilityDigest: "a".repeat(64) as StudentCapabilityDigest,
+      capabilityIssuedAtMs: 1_200,
+      connectionKind: "join",
+      connectionLogicalOperationDigest: "c".repeat(
+        64,
+      ) as StudentLogicalOperationDigest,
+      connectionRequestId: ids.request,
+      deviceSessionId: ids.deviceA,
+      deviceSessionPublicKeyThumbprint: "P".repeat(
+        43,
+      ) as DeviceSessionPublicKeyThumbprint,
+      epoch: 0,
+      expiresAtMs: 61_200,
+      reconnectGrantDigest: "b".repeat(64) as StudentReconnectGrantDigest,
+      reconnectGrantExpiresAtMs: 121_200,
+      schoolId: ids.schoolA,
+      studentSessionId: ids.sessionA,
+      testId: ids.testA,
+    };
+    const verifier = {
+      async capabilityIntentAuthorityDigest({ domain, authority: input }) {
+        expect(domain).toBe(
+          STUDENT_AUTHORITY_DIGEST_DOMAINS.capabilityIntentAuthority,
+        );
+        expect(Object.isFrozen(input)).toBe(true);
+        expect(Object.isFrozen(input.allowedIntents)).toBe(true);
+        return expectedDigest;
+      },
+    } satisfies StudentCapabilityIntentAuthorityVerificationPort;
+    const verified = await verifyStudentCapabilityIntentAuthority(
+      authority,
+      expectedDigest,
+      verifier,
+    );
+    expect(Object.isFrozen(verified)).toBe(true);
+    expect(Reflect.ownKeys(verified ?? {})).toEqual([]);
+    expect(
+      verifiedStudentCapabilityIntentAuthorityAllows(
+        verified,
+        authority,
+        expectedDigest,
+        "state.read",
+      ),
+    ).toBe(true);
+
+    const candidates = [
+      { ...verified },
+      structuredClone(verified),
+      Object.freeze(Object.create(null) as object),
+    ];
+    for (const candidate of candidates) {
+      expect(
+        verifiedStudentCapabilityIntentAuthorityAllows(
+          candidate,
+          authority,
+          expectedDigest,
+          "state.read",
+        ),
+      ).toBe(false);
+    }
+  });
+
+  it("separates pre-admission audit/rate data from roster-backed sessions", () => {
+    const sentinels = [
+      "student@example.invalid",
+      "RAW-JOIN-CODE",
+      "203.0.113.40",
+      "SyntheticBrowser/1.0",
+      "raw-hardware-serial",
+    ];
+    const preAdmission = createPreAdmissionJoinAuditRecord({
+      attemptId: ids.antiReplayA,
+      event: "join.rate_limited",
+      occurredAtMs: 2_000,
+      rateLimitKeyDigest: "d".repeat(64) as StudentRateLimitKeyDigest,
+      schoolId: ids.schoolA,
+      testId: ids.testA,
+    });
+    if (preAdmission === null) throw new Error("valid audit was rejected");
+    expect(Object.isFrozen(preAdmission)).toBe(true);
+    expect(Object.keys(preAdmission).sort()).toEqual([
+      "attemptId",
+      "event",
+      "occurredAtMs",
+      "rateLimitKeyDigest",
+      "schoolId",
+      "testId",
+    ]);
+    expect(preAdmission).not.toHaveProperty("studentSessionId");
+    expect(preAdmission).not.toHaveProperty("syntheticDisplayName");
+    const serialized = JSON.stringify(preAdmission);
+    for (const sentinel of sentinels)
+      expect(serialized).not.toContain(sentinel);
+    expect(
+      createPreAdmissionJoinAuditRecord({
+        ...preAdmission,
+        attemptId: "student@example.invalid",
+      }),
+    ).toBeNull();
+
+    const opaqueSubject =
+      "server-owned-subject" as PreAdmissionRateLimitSubject;
+    expect(typeof opaqueSubject).toBe("string");
+  });
+
+  it("keeps post-admission audit minimal and session scoped", () => {
+    const audit = createStudentSessionAuditRecord({
+      auditId: ids.antiReplayA,
+      epoch: 2,
+      event: "student_session.readmitted",
+      occurredAtMs: 2_000,
+      schoolId: ids.schoolA,
+      studentSessionId: ids.sessionA,
+      testId: ids.testA,
+    });
+    if (audit === null) throw new Error("valid audit was rejected");
+    expect(Object.isFrozen(audit)).toBe(true);
+    expect(Object.keys(audit).sort()).toEqual([
+      "auditId",
+      "epoch",
+      "event",
+      "occurredAtMs",
+      "schoolId",
+      "studentSessionId",
+      "testId",
+    ]);
+  });
+
+  it("snapshots exact audit descriptors once and rejects hostile or disclosing input", () => {
+    expect(createPreAdmissionJoinAuditRecord(null as never)).toBeNull();
+
+    let accessorReads = 0;
+    const accessor = {
+      get attemptId() {
+        accessorReads += 1;
+        return ids.antiReplayA;
+      },
+      event: "join.rate_limited",
+      occurredAtMs: 2_000,
+      rateLimitKeyDigest: "d".repeat(64),
+      schoolId: ids.schoolA,
+      testId: ids.testA,
+    };
+    expect(createPreAdmissionJoinAuditRecord(accessor as never)).toBeNull();
+    expect(accessorReads).toBe(0);
+
+    const exact = {
+      attemptId: ids.antiReplayA,
+      event: "join.rate_limited",
+      occurredAtMs: 2_000,
+      rateLimitKeyDigest: "d".repeat(64),
