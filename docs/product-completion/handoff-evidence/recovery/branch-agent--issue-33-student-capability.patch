--- /dev/null
+++ b/packages/contracts/src/student-session-wire.ts
@@ -0,0 +1,564 @@
+import type {
+  DeviceSessionPublicKeyThumbprint,
+  OpaqueStudentCapabilityMaterial,
+  OpaqueStudentJoinMaterial,
+  OpaqueStudentReconnectMaterial,
+  StudentAuthorityOperationKind,
+  StudentCapabilityIntent,
+} from "@desmoslock/domain";
+
+export interface DeviceSessionProofMaterial {
+  readonly antiReplayId: string;
+  readonly challengeId: string;
+  readonly deviceSessionId: string;
+  readonly epoch: number;
+  readonly expiresAtMs: number;
+  readonly intent: StudentCapabilityIntent | null;
+  readonly logicalOperationDigest: string;
+  readonly operationKind: StudentAuthorityOperationKind;
+  readonly proof: string;
+  readonly proofEnvelopeDigest: string;
+  readonly publicKeyThumbprint: DeviceSessionPublicKeyThumbprint;
+  readonly requestId: string;
+  readonly schoolId: string;
+  readonly studentSessionId: string;
+  readonly testId: string;
+}
+
+export interface StudentSessionJoinRequest {
+  readonly deviceProof: DeviceSessionProofMaterial;
+  readonly joinCode: OpaqueStudentJoinMaterial;
+  readonly kind: "join";
+  readonly requestId: string;
+  readonly schoolId: string;
+  readonly testId: string;
+}
+
+export interface StudentSessionReconnectRequest {
+  readonly deviceProof: DeviceSessionProofMaterial;
+  readonly epoch: number;
+  readonly kind: "reconnect";
+  readonly reconnectGrant: OpaqueStudentReconnectMaterial;
+  readonly requestId: string;
+  readonly schoolId: string;
+  readonly studentSessionId: string;
+  readonly testId: string;
+}
+
+export interface StudentSessionCapabilityRequest {
+  readonly capabilityToken: OpaqueStudentCapabilityMaterial;
+  readonly deviceProof: DeviceSessionProofMaterial;
+  readonly epoch: number;
+  readonly expiresAtMs: number;
+  readonly intent: StudentCapabilityIntent;
+  readonly kind: "capability";
+  readonly requestId: string;
+  readonly schoolId: string;
+  readonly studentSessionId: string;
+  readonly testId: string;
+}
+
+export interface StudentCredentialRecoveryRequest {
+  readonly connectionOperationDigest: string;
+  readonly deviceProof: DeviceSessionProofMaterial;
+  readonly epoch: number;
+  readonly kind: "credential_recovery";
+  readonly requestId: string;
+  readonly schoolId: string;
+  readonly studentSessionId: string;
+  readonly testId: string;
+}
+
+export interface StudentCredentialAcknowledgmentRequest {
+  readonly connectionOperationDigest: string;
+  readonly deviceProof: DeviceSessionProofMaterial;
+  readonly epoch: number;
+  readonly kind: "credential_acknowledgment";
+  readonly requestId: string;
+  readonly schoolId: string;
+  readonly studentSessionId: string;
+  readonly testId: string;
+}
+
+export type StudentSessionRequest =
+  | StudentCredentialAcknowledgmentRequest
+  | StudentCredentialRecoveryRequest
+  | StudentSessionCapabilityRequest
+  | StudentSessionJoinRequest
+  | StudentSessionReconnectRequest;
+
+export interface StudentSessionDeniedResponse {
+  readonly code: "STUDENT_SESSION_DENIED";
+  readonly status: "denied";
+}
+
+export interface StudentSessionAcceptedResponse {
+  readonly capabilityToken: OpaqueStudentCapabilityMaterial;
+  readonly code: "STUDENT_SESSION_ACCEPTED";
+  readonly deviceSessionId: string;
+  readonly epoch: number;
+  readonly expiresAtMs: number;
+  readonly reconnectGrant: OpaqueStudentReconnectMaterial;
+  readonly schoolId: string;
+  readonly status: "accepted";
+  readonly studentSessionId: string;
+  readonly testId: string;
+}
+
+export type StudentSessionResponse =
+  StudentSessionAcceptedResponse | StudentSessionDeniedResponse;
+
+export const STUDENT_SESSION_DENIED_RESPONSE: StudentSessionDeniedResponse =
+  Object.freeze({
+    code: "STUDENT_SESSION_DENIED",
+    status: "denied",
+  });
+
+export type StudentSessionRequestParseDecision =
+  | {
+      readonly request: StudentSessionRequest;
+      readonly status: "valid";
+    }
+  | StudentSessionDeniedResponse;
+
+const canonicalUuid =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u;
+const opaqueCredential = /^[A-Za-z0-9_-]{43,512}$/u;
+const boundedJoinCode = /^[A-Z0-9]{6,12}$/u;
+const opaqueProof = /^[A-Za-z0-9_-]{43,2048}$/u;
+const publicKeyThumbprint = /^[A-Za-z0-9_-]{43,128}$/u;
+const keyedDigest = /^[0-9a-f]{64}$/u;
+
+function snapshotExactDataObject(
+  value: unknown,
+  expectedKeys: readonly string[],
+): Record<string, unknown> | null {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return null;
+  }
+  const prototype = Object.getPrototypeOf(value) as unknown;
+  if (prototype !== Object.prototype && prototype !== null) return null;
+  const ownKeys = Reflect.ownKeys(value);
+  if (
+    ownKeys.length !== expectedKeys.length ||
+    ownKeys.some((key) => typeof key !== "string")
+  ) {
+    return null;
+  }
+  const actualKeySet = new Set(ownKeys as string[]);
+  if (expectedKeys.some((key) => !actualKeySet.has(key))) return null;
+
+  const snapshot: Record<string, unknown> = Object.create(null) as Record<
+    string,
+    unknown
+  >;
+  for (const key of expectedKeys) {
+    const descriptor = Object.getOwnPropertyDescriptor(value, key);
+    if (
+      descriptor === undefined ||
+      !descriptor.enumerable ||
+      !("value" in descriptor)
+    ) {
+      return null;
+    }
+    snapshot[key] = descriptor.value;
+  }
+  return snapshot;
+}
+
+function isCanonicalUuid(value: unknown): value is string {
+  return typeof value === "string" && canonicalUuid.test(value);
+}
+
+function isOpaqueCredential(value: unknown): value is string {
+  return typeof value === "string" && opaqueCredential.test(value);
+}
+
+function isEpoch(value: unknown): value is number {
+  return (
+    typeof value === "number" &&
+    Number.isSafeInteger(value) &&
+    value >= 0 &&
+    value <= 2_147_483_647
+  );
+}
+
+function isTimestamp(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+}
+
+function isCapabilityIntent(value: unknown): value is StudentCapabilityIntent {
+  return (
+    value === "calculator.write" ||
+    value === "evidence.submit" ||
+    value === "release.request" ||
+    value === "state.read"
+  );
+}
+
+function parseDeviceSessionProofMaterial(
+  value: unknown,
+): DeviceSessionProofMaterial | null {
+  const proofMaterial = snapshotExactDataObject(value, [
+    "antiReplayId",
+    "challengeId",
+    "deviceSessionId",
+    "epoch",
+    "expiresAtMs",
+    "intent",
+    "logicalOperationDigest",
+    "operationKind",
+    "proof",
+    "proofEnvelopeDigest",
+    "publicKeyThumbprint",
+    "requestId",
+    "schoolId",
+    "studentSessionId",
+    "testId",
+  ]);
+  if (
+    proofMaterial === null ||
+    !isCanonicalUuid(proofMaterial.antiReplayId) ||
+    !isCanonicalUuid(proofMaterial.challengeId) ||
+    !isCanonicalUuid(proofMaterial.deviceSessionId) ||
+    !isEpoch(proofMaterial.epoch) ||
+    !isTimestamp(proofMaterial.expiresAtMs) ||
+    (proofMaterial.intent !== null &&
+      !isCapabilityIntent(proofMaterial.intent)) ||
+    (proofMaterial.operationKind !== "capability" &&
+      proofMaterial.operationKind !== "credential_acknowledgment" &&
+      proofMaterial.operationKind !== "credential_recovery" &&
+      proofMaterial.operationKind !== "join" &&
+      proofMaterial.operationKind !== "reconnect") ||
+    (proofMaterial.operationKind === "capability"
+      ? !isCapabilityIntent(proofMaterial.intent)
+      : proofMaterial.intent !== null) ||
+    typeof proofMaterial.proof !== "string" ||
+    !opaqueProof.test(proofMaterial.proof) ||
+    typeof proofMaterial.logicalOperationDigest !== "string" ||
+    !keyedDigest.test(proofMaterial.logicalOperationDigest) ||
+    typeof proofMaterial.proofEnvelopeDigest !== "string" ||
+    !keyedDigest.test(proofMaterial.proofEnvelopeDigest) ||
+    typeof proofMaterial.publicKeyThumbprint !== "string" ||
+    !publicKeyThumbprint.test(proofMaterial.publicKeyThumbprint) ||
+    !isCanonicalUuid(proofMaterial.requestId) ||
+    !isCanonicalUuid(proofMaterial.schoolId) ||
+    !isCanonicalUuid(proofMaterial.studentSessionId) ||
+    !isCanonicalUuid(proofMaterial.testId)
+  ) {
+    return null;
+  }
+  return Object.freeze({
+    antiReplayId: proofMaterial.antiReplayId,
+    challengeId: proofMaterial.challengeId,
+    deviceSessionId: proofMaterial.deviceSessionId,
+    epoch: proofMaterial.epoch,
+    expiresAtMs: proofMaterial.expiresAtMs,
+    intent: proofMaterial.intent,
+    logicalOperationDigest: proofMaterial.logicalOperationDigest,
+    operationKind: proofMaterial.operationKind,
+    proof: proofMaterial.proof,
+    proofEnvelopeDigest: proofMaterial.proofEnvelopeDigest,
+    publicKeyThumbprint:
+      proofMaterial.publicKeyThumbprint as DeviceSessionPublicKeyThumbprint,
+    requestId: proofMaterial.requestId,
+    schoolId: proofMaterial.schoolId,
+    studentSessionId: proofMaterial.studentSessionId,
+    testId: proofMaterial.testId,
+  });
+}
+
+function proofMatchesRoot(
+  proof: DeviceSessionProofMaterial,
+  root: {
+    readonly epoch?: number;
+    readonly intent: StudentCapabilityIntent | null;
+    readonly operationKind: StudentAuthorityOperationKind;
+    readonly requestId: string;
+    readonly schoolId: string;
+    readonly studentSessionId?: string;
+    readonly testId: string;
+  },
+): boolean {
+  return (
+    proof.requestId === root.requestId &&
+    proof.operationKind === root.operationKind &&
+    proof.intent === root.intent &&
+    proof.schoolId === root.schoolId &&
+    proof.testId === root.testId &&
+    (root.studentSessionId === undefined ||
+      proof.studentSessionId === root.studentSessionId) &&
+    (root.epoch === undefined || proof.epoch === root.epoch)
+  );
+}
+
+function parseStudentSessionRequestUnsafe(
+  value: unknown,
+): StudentSessionRequest | null {
+  const joinRequest = snapshotExactDataObject(value, [
+    "deviceProof",
+    "joinCode",
+    "kind",
+    "requestId",
+    "schoolId",
+    "testId",
+  ]);
+  const joinProof = parseDeviceSessionProofMaterial(joinRequest?.deviceProof);
+  if (
+    joinRequest !== null &&
+    joinRequest.kind === "join" &&
+    joinProof !== null &&
+    typeof joinRequest.joinCode === "string" &&
+    boundedJoinCode.test(joinRequest.joinCode) &&
+    isCanonicalUuid(joinRequest.requestId) &&
+    isCanonicalUuid(joinRequest.schoolId) &&
+    isCanonicalUuid(joinRequest.testId) &&
+    proofMatchesRoot(joinProof, {
+      intent: null,
+      operationKind: "join",
+      requestId: joinRequest.requestId,
+      schoolId: joinRequest.schoolId,
+      testId: joinRequest.testId,
+    })
+  ) {
+    return Object.freeze({
+      deviceProof: joinProof,
+      joinCode: joinRequest.joinCode as OpaqueStudentJoinMaterial,
+      kind: "join",
+      requestId: joinRequest.requestId,
+      schoolId: joinRequest.schoolId,
+      testId: joinRequest.testId,
+    });
+  }
+
+  const credentialOperationRequest = snapshotExactDataObject(value, [
+    "connectionOperationDigest",
+    "deviceProof",
+    "epoch",
+    "kind",
+    "requestId",
+    "schoolId",
+    "studentSessionId",
+    "testId",
+  ]);
+  const credentialOperationProof = parseDeviceSessionProofMaterial(
+    credentialOperationRequest?.deviceProof,
+  );
+  if (
+    credentialOperationRequest !== null &&
+    (credentialOperationRequest.kind === "credential_acknowledgment" ||
+      credentialOperationRequest.kind === "credential_recovery") &&
+    credentialOperationProof !== null &&
+    typeof credentialOperationRequest.connectionOperationDigest === "string" &&
+    keyedDigest.test(credentialOperationRequest.connectionOperationDigest) &&
+    isEpoch(credentialOperationRequest.epoch) &&
+    isCanonicalUuid(credentialOperationRequest.requestId) &&
+    isCanonicalUuid(credentialOperationRequest.schoolId) &&
+    isCanonicalUuid(credentialOperationRequest.studentSessionId) &&
+    isCanonicalUuid(credentialOperationRequest.testId) &&
+    proofMatchesRoot(credentialOperationProof, {
+      epoch: credentialOperationRequest.epoch,
+      intent: null,
+      operationKind: credentialOperationRequest.kind,
+      requestId: credentialOperationRequest.requestId,
+      schoolId: credentialOperationRequest.schoolId,
+      studentSessionId: credentialOperationRequest.studentSessionId,
+      testId: credentialOperationRequest.testId,
+    })
+  ) {
+    return Object.freeze({
+      connectionOperationDigest:
+        credentialOperationRequest.connectionOperationDigest,
+      deviceProof: credentialOperationProof,
+      epoch: credentialOperationRequest.epoch,
+      kind: credentialOperationRequest.kind,
+      requestId: credentialOperationRequest.requestId,
+      schoolId: credentialOperationRequest.schoolId,
+      studentSessionId: credentialOperationRequest.studentSessionId,
+      testId: credentialOperationRequest.testId,
+    });
+  }
+
+  const reconnectRequest = snapshotExactDataObject(value, [
+    "deviceProof",
+    "epoch",
+    "kind",
+    "reconnectGrant",
+    "requestId",
+    "schoolId",
+    "studentSessionId",
+    "testId",
+  ]);
+  const reconnectProof = parseDeviceSessionProofMaterial(
+    reconnectRequest?.deviceProof,
+  );
+  if (
+    reconnectRequest !== null &&
+    reconnectRequest.kind === "reconnect" &&
+    reconnectProof !== null &&
+    isEpoch(reconnectRequest.epoch) &&
+    isOpaqueCredential(reconnectRequest.reconnectGrant) &&
+    isCanonicalUuid(reconnectRequest.requestId) &&
+    isCanonicalUuid(reconnectRequest.schoolId) &&
+    isCanonicalUuid(reconnectRequest.studentSessionId) &&
+    isCanonicalUuid(reconnectRequest.testId) &&
+    proofMatchesRoot(reconnectProof, {
+      epoch: reconnectRequest.epoch,
+      intent: null,
+      operationKind: "reconnect",
+      requestId: reconnectRequest.requestId,
+      schoolId: reconnectRequest.schoolId,
+      studentSessionId: reconnectRequest.studentSessionId,
+      testId: reconnectRequest.testId,
+    })
+  ) {
+    return Object.freeze({
+      deviceProof: reconnectProof,
+      epoch: reconnectRequest.epoch,
+      kind: "reconnect",
+      reconnectGrant:
+        reconnectRequest.reconnectGrant as OpaqueStudentReconnectMaterial,
+      requestId: reconnectRequest.requestId,
+      schoolId: reconnectRequest.schoolId,
+      studentSessionId: reconnectRequest.studentSessionId,
+      testId: reconnectRequest.testId,
+    });
+  }
+
+  const capabilityRequest = snapshotExactDataObject(value, [
+    "capabilityToken",
+    "deviceProof",
+    "epoch",
+    "expiresAtMs",
+    "intent",
+    "kind",
+    "requestId",
+    "schoolId",
+    "studentSessionId",
+    "testId",
+  ]);
+  const capabilityProof = parseDeviceSessionProofMaterial(
+    capabilityRequest?.deviceProof,
+  );
+  if (
+    capabilityRequest !== null &&
+    capabilityRequest.kind === "capability" &&
+    isOpaqueCredential(capabilityRequest.capabilityToken) &&
+    capabilityProof !== null &&
+    isEpoch(capabilityRequest.epoch) &&
+    isTimestamp(capabilityRequest.expiresAtMs) &&
+    isCapabilityIntent(capabilityRequest.intent) &&
+    isCanonicalUuid(capabilityRequest.requestId) &&
+    isCanonicalUuid(capabilityRequest.schoolId) &&
+    isCanonicalUuid(capabilityRequest.studentSessionId) &&
+    isCanonicalUuid(capabilityRequest.testId) &&
+    proofMatchesRoot(capabilityProof, {
+      epoch: capabilityRequest.epoch,
+      intent: capabilityRequest.intent,
+      operationKind: "capability",
+      requestId: capabilityRequest.requestId,
+      schoolId: capabilityRequest.schoolId,
+      studentSessionId: capabilityRequest.studentSessionId,
+      testId: capabilityRequest.testId,
+    })
+  ) {
+    return Object.freeze({
+      capabilityToken:
+        capabilityRequest.capabilityToken as OpaqueStudentCapabilityMaterial,
+      deviceProof: capabilityProof,
+      epoch: capabilityRequest.epoch,
+      expiresAtMs: capabilityRequest.expiresAtMs,
+      intent: capabilityRequest.intent,
+      kind: "capability",
+      requestId: capabilityRequest.requestId,
+      schoolId: capabilityRequest.schoolId,
+      studentSessionId: capabilityRequest.studentSessionId,
+      testId: capabilityRequest.testId,
+    });
+  }
+  return null;
+}
+
+export function parseStudentSessionRequest(
+  value: unknown,
+): StudentSessionRequest | null {
+  try {
+    return parseStudentSessionRequestUnsafe(value);
+  } catch {
+    return null;
+  }
+}
+
+export function parseStudentSessionRequestOrDeny(
+  value: unknown,
+): StudentSessionRequestParseDecision {
+  const request = parseStudentSessionRequest(value);
+  return request === null
+    ? STUDENT_SESSION_DENIED_RESPONSE
+    : Object.freeze({ request, status: "valid" });
+}
+
+function parseStudentSessionResponseUnsafe(
+  value: unknown,
+): StudentSessionResponse | null {
+  const denied = snapshotExactDataObject(value, ["code", "status"]);
+  if (
+    denied !== null &&
+    denied.code === "STUDENT_SESSION_DENIED" &&
+    denied.status === "denied"
+  ) {
+    return STUDENT_SESSION_DENIED_RESPONSE;
+  }
+
+  const accepted = snapshotExactDataObject(value, [
+    "capabilityToken",
+    "code",
+    "deviceSessionId",
+    "epoch",
+    "expiresAtMs",
+    "reconnectGrant",
+    "schoolId",
+    "status",
+    "studentSessionId",
+    "testId",
+  ]);
+  if (
+    accepted === null ||
+    accepted.code !== "STUDENT_SESSION_ACCEPTED" ||
+    accepted.status !== "accepted" ||
+    !isOpaqueCredential(accepted.capabilityToken) ||
+    !isCanonicalUuid(accepted.deviceSessionId) ||
+    !isEpoch(accepted.epoch) ||
+    !isTimestamp(accepted.expiresAtMs) ||
+    !isOpaqueCredential(accepted.reconnectGrant) ||
+    accepted.capabilityToken === accepted.reconnectGrant ||
+    !isCanonicalUuid(accepted.schoolId) ||
+    !isCanonicalUuid(accepted.studentSessionId) ||
+    !isCanonicalUuid(accepted.testId)
+  ) {
+    return null;
+  }
+  return Object.freeze({
+    capabilityToken:
+      accepted.capabilityToken as OpaqueStudentCapabilityMaterial,
+    code: "STUDENT_SESSION_ACCEPTED",
+    deviceSessionId: accepted.deviceSessionId,
+    epoch: accepted.epoch,
+    expiresAtMs: accepted.expiresAtMs,
+    reconnectGrant: accepted.reconnectGrant as OpaqueStudentReconnectMaterial,
+    schoolId: accepted.schoolId,
+    status: "accepted",
+    studentSessionId: accepted.studentSessionId,
+    testId: accepted.testId,
+  });
+}
+
+export function parseStudentSessionResponse(
+  value: unknown,
+): StudentSessionResponse | null {
+  try {
+    return parseStudentSessionResponseUnsafe(value);
+  } catch {
+    return null;
+  }
+}
diff --git a/packages/contracts/tests/student-session-wire.test.ts b/packages/contracts/tests/student-session-wire.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..344891c068137821666ce18d6e5a9da9ba6d758c
--- /dev/null
+++ b/packages/contracts/tests/student-session-wire.test.ts
@@ -0,0 +1,271 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  parseStudentSessionRequest,
+  parseStudentSessionRequestOrDeny,
+  parseStudentSessionResponse,
+} from "../src/index.js";
+
+const ids = {
+  antiReplay: "70000000-0000-4000-8000-000000000001",
+  challenge: "60000000-0000-4000-8000-000000000001",
+  device: "40000000-0000-4000-8000-000000000001",
+  request: "50000000-0000-4000-8000-000000000001",
+  school: "10000000-0000-4000-8000-000000000001",
+  session: "30000000-0000-4000-8000-000000000001",
+  test: "20000000-0000-4000-8000-000000000001",
+} as const;
+
+const deviceProof = {
+  antiReplayId: ids.antiReplay,
+  challengeId: ids.challenge,
+  deviceSessionId: ids.device,
+  epoch: 0,
+  expiresAtMs: 2_000,
+  intent: null,
+  logicalOperationDigest: "d".repeat(64),
+  operationKind: "join",
+  proof: "s".repeat(64),
+  proofEnvelopeDigest: "e".repeat(64),
+  publicKeyThumbprint: "p".repeat(43),
+  requestId: ids.request,
+  schoolId: ids.school,
+  studentSessionId: ids.session,
+  testId: ids.test,
+} as const;
+
+const validJoinRequest = {
+  deviceProof,
+  joinCode: "A1B2C3",
+  kind: "join",
+  requestId: ids.request,
+  schoolId: ids.school,
+  testId: ids.test,
+} as const;
+
+describe("accountless Student Session wire contract", () => {
+  it("accepts only the exact bounded join shape with proof material", () => {
+    const parsed = parseStudentSessionRequest(validJoinRequest);
+    expect(parsed).toEqual(validJoinRequest);
+    expect(Object.isFrozen(parsed)).toBe(true);
+    expect(Object.isFrozen(parsed?.deviceProof)).toBe(true);
+    expect(
+      parseStudentSessionRequest({
+        ...validJoinRequest,
+        roster: [{ studentSessionId: "must-not-leak" }],
+      }),
+    ).toBeNull();
+    expect(
+      parseStudentSessionRequest({
+        ...validJoinRequest,
+        joinCode: "too-short",
+      }),
+    ).toBeNull();
+    expect(
+      parseStudentSessionRequest({
+        ...validJoinRequest,
+        deviceProof: { ...deviceProof, rawHardwareId: "sentinel" },
+      }),
+    ).toBeNull();
+    expect(
+      parseStudentSessionRequest({
+        ...validJoinRequest,
+        deviceProof: { ...deviceProof, operationKind: "reconnect" },
+      }),
+    ).toBeNull();
+    expect(
+      parseStudentSessionRequest({
+        ...validJoinRequest,
+        deviceProof: {
+          ...deviceProof,
+          logicalOperationDigest: "malformed",
+        },
+      }),
+    ).toBeNull();
+    expect(
+      parseStudentSessionRequest({
+        ...validJoinRequest,
+        deviceProof: { ...deviceProof, proofEnvelopeDigest: "malformed" },
+      }),
+    ).toBeNull();
+  });
+
+  it("turns malformed requests into one non-disclosing denial", () => {
+    const sentinel = "student-a@example.invalid";
+    const decision = parseStudentSessionRequestOrDeny({
+      ...validJoinRequest,
+      email: sentinel,
+      joinCode: "not valid",
+    });
+    expect(decision).toEqual({
+      code: "STUDENT_SESSION_DENIED",
+      status: "denied",
+    });
+    expect(JSON.stringify(decision)).not.toContain(sentinel);
+  });
+
+  it("fails closed for hostile traps and snapshots every descriptor once", () => {
