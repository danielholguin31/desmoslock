+            attempts: 1,
+            keyDigest,
+            revision: 0,
+            windowStartedAtMs: 10_000,
+          };
+          return "conflict";
+        }
+        const commit = commitJoinRateLimitReservation(snapshot, reservation);
+        if (commit.status !== "committed") return "conflict";
+        snapshot = commit.snapshot;
+        return "committed";
+      },
+      async load() {
+        return snapshot;
+      },
+    };
+
+    await expect(
+      reserveJoinRateLimitCapacity(
