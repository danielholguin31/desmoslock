+    const concurrentB = allowedReservation(decideJoinRateLimit(input));
+    expect(Object.isFrozen(concurrentA)).toBe(true);
+    expect(Object.isFrozen(concurrentA.next)).toBe(true);
+    const first = commitJoinRateLimitReservation(null, concurrentA);
+    if (first.status !== "committed") throw new Error("first must commit");
