--- /dev/null
+++ b/supabase/functions/_shared/config-contract.test.ts
@@ -0,0 +1,40 @@
+import configToml from "../../config.toml" with { type: "text" };
+
+function assertEquals(actual: unknown, expected: unknown): void {
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+    throw new Error(
+      `Expected ${JSON.stringify(expected)}, received ${JSON.stringify(actual)}`,
+    );
+  }
+}
+
+function functionSection(name: string): string[] {
+  const escapedName = name.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&");
+  const matches = [
+    ...configToml.matchAll(
+      new RegExp(
+        `^\\[functions\\.${escapedName}\\]\\n([^[]*)(?=^\\[|\\s*$)`,
+        "gmu",
+      ),
+    ),
+  ];
+  assertEquals(matches.length, 1);
+  return matches[0][1]
+    .split("\n")
+    .map((line) => line.trim())
+    .filter((line) => line !== "");
+}
+
+Deno.test(
+  "account recovery explicitly disables gateway JWT verification",
+  () => {
+    assertEquals(functionSection("account-recovery"), ["verify_jwt = false"]);
+  },
+);
+
+Deno.test(
+  "staff invitations explicitly enables gateway JWT verification",
+  () => {
+    assertEquals(functionSection("staff-invitations"), ["verify_jwt = true"]);
+  },
+);
diff --git a/supabase/functions/_shared/http.ts b/supabase/functions/_shared/http.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7cdf1e803c719231d4075030fbf6b682a58377a0
--- /dev/null
+++ b/supabase/functions/_shared/http.ts
@@ -0,0 +1,378 @@
+export const MAX_REQUEST_BODY_BYTES = 4_096;
+
+export interface CorsPolicy {
+  readonly allowedHeaders: readonly string[];
+  readonly allowedOrigin: string;
+}
+
+export type JsonRecord = Record<string, unknown>;
+
+const jsonContentType = "application/json; charset=utf-8";
+const canonicalEmailPattern =
+  /^[a-z0-9!#$%&'*+/=?^_{}|~-]+(?:\.[a-z0-9!#$%&'*+/=?^_{}|~-]+)*@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/u;
+
+function baseHeaders(allowedOrigin?: string): Headers {
+  const headers = new Headers({
+    "cache-control": "no-store",
+    "content-type": jsonContentType,
+  });
+  if (allowedOrigin !== undefined) {
+    headers.set("access-control-allow-origin", allowedOrigin);
+    headers.set("vary", "Origin");
+  }
+  return headers;
+}
+
+export function codeResponse(
+  code: string,
+  status: number,
+  allowedOrigin?: string,
+): Response {
+  return Response.json(
+    { code, ok: status >= 200 && status < 300 },
+    {
+      headers: baseHeaders(allowedOrigin),
+      status,
+    },
+  );
+}
+
+export function methodNotAllowedResponse(allowedOrigin: string): Response {
+  const headers = baseHeaders(allowedOrigin);
+  headers.set("allow", "POST, OPTIONS");
+  return new Response(JSON.stringify({ code: "invalid_request", ok: false }), {
+    headers,
+    status: 405,
+  });
+}
+
+export function isExactRecord(
+  value: unknown,
+  expectedKeys: readonly string[],
+): value is JsonRecord {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return false;
+  }
+  const observedKeys = Object.keys(value);
+  return (
+    observedKeys.length === expectedKeys.length &&
+    expectedKeys.every((key) =>
+      Object.prototype.hasOwnProperty.call(value, key),
+    )
+  );
+}
+
+export function parseExactOrigin(value: unknown): string | null {
+  if (typeof value !== "string" || value.length === 0 || value.length > 2_048) {
+    return null;
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(value);
+  } catch {
+    return null;
+  }
+  const localHost =
+    parsed.hostname === "127.0.0.1" ||
+    parsed.hostname === "[::1]" ||
+    parsed.hostname === "localhost";
+  const allowedProtocol =
+    parsed.protocol === "https:" || (parsed.protocol === "http:" && localHost);
+  if (
+    !allowedProtocol ||
+    parsed.username !== "" ||
+    parsed.password !== "" ||
+    parsed.pathname !== "/" ||
+    parsed.search !== "" ||
+    parsed.hash !== "" ||
+    parsed.origin !== value
+  ) {
+    return null;
+  }
+  return parsed.origin;
+}
+
+export function parseExactCallback(
+  value: unknown,
+  expectedOrigin: string,
+): string | null {
+  if (typeof value !== "string" || value.length === 0 || value.length > 2_048) {
+    return null;
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(value);
+  } catch {
+    return null;
+  }
+  if (
+    parsed.origin !== expectedOrigin ||
+    parsed.username !== "" ||
+    parsed.password !== "" ||
+    parsed.pathname === "/" ||
+    parsed.search !== "" ||
+    parsed.hash !== "" ||
+    parsed.href !== value
+  ) {
+    return null;
+  }
+  return parsed.href;
+}
+
+export function parseExactRootCallback(
+  value: unknown,
+  expectedOrigin: string,
+): string | null {
+  if (typeof value !== "string" || value.length === 0 || value.length > 2_048) {
+    return null;
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(value);
+  } catch {
+    return null;
+  }
+  return parsed.origin === expectedOrigin &&
+    parsed.username === "" &&
+    parsed.password === "" &&
+    parsed.pathname === "/" &&
+    parsed.search === "" &&
+    parsed.hash === "" &&
+    parsed.href === value
+    ? parsed.href
+    : null;
+}
+
+function parseRequestedHeaders(value: string | null): string[] | null {
+  if (value === null || value.length === 0 || value.length > 1_024) {
+    return null;
+  }
+  const headers = value.split(",").map((header) => header.trim().toLowerCase());
+  if (headers.some((header) => !/^[a-z0-9-]+$/u.test(header))) {
+    return null;
+  }
+  if (new Set(headers).size !== headers.length) {
+    return null;
+  }
+  return headers.sort();
+}
+
+export function validateRequestOrigin(
+  request: Request,
+  allowedOrigin: string,
+): boolean {
+  return request.headers.get("origin") === allowedOrigin;
+}
+
+export function handlePreflight(
+  request: Request,
+  policy: CorsPolicy,
+): Response {
+  if (!validateRequestOrigin(request, policy.allowedOrigin)) {
+    return codeResponse("invalid_request", 403);
+  }
+  if (request.headers.get("access-control-request-method") !== "POST") {
+    return codeResponse("invalid_request", 400, policy.allowedOrigin);
+  }
+  const requestedHeaders = parseRequestedHeaders(
+    request.headers.get("access-control-request-headers"),
+  );
+  const allowedHeaders = [...policy.allowedHeaders]
+    .map((header) => header.toLowerCase())
+    .sort();
+  if (
+    requestedHeaders === null ||
+    requestedHeaders.length !== allowedHeaders.length ||
+    requestedHeaders.some((header, index) => header !== allowedHeaders[index])
+  ) {
+    return codeResponse("invalid_request", 400, policy.allowedOrigin);
+  }
+  return new Response(null, {
+    headers: {
+      "access-control-allow-headers": allowedHeaders.join(", "),
+      "access-control-allow-methods": "POST",
+      "access-control-allow-origin": policy.allowedOrigin,
+      "access-control-max-age": "600",
+      "cache-control": "no-store",
+      vary: "Origin",
+    },
+    status: 204,
+  });
+}
+
+function isJsonContentType(value: string | null): boolean {
+  if (value === null) {
+    return false;
+  }
+  return /^application\/json(?:;[\t ]*charset=utf-8)?$/iu.test(value);
+}
+
+async function readBoundedBody(
+  request: Request,
+  maximumBytes: number,
+): Promise<Uint8Array | null> {
+  const contentLength = request.headers.get("content-length");
+  if (contentLength !== null) {
+    if (!/^(0|[1-9][0-9]*)$/u.test(contentLength)) {
+      return null;
+    }
+    const announcedLength = Number(contentLength);
+    if (
+      !Number.isSafeInteger(announcedLength) ||
+      announcedLength > maximumBytes
+    ) {
+      return null;
+    }
+  }
+  if (request.body === null) {
+    return null;
+  }
+  let reader: ReadableStreamDefaultReader<Uint8Array>;
+  try {
+    reader = request.body.getReader();
+  } catch {
+    return null;
+  }
+  const chunks: Uint8Array[] = [];
+  let totalBytes = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) {
+        break;
+      }
+      totalBytes += value.byteLength;
+      if (totalBytes > maximumBytes) {
+        await reader.cancel();
+        return null;
+      }
+      chunks.push(value);
+    }
+  } catch {
+    return null;
+  }
+  if (totalBytes === 0) {
+    return null;
+  }
+  const body = new Uint8Array(totalBytes);
+  let offset = 0;
+  for (const chunk of chunks) {
+    body.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return body;
+}
+
+export async function readStrictJson(
+  request: Request,
+  maximumBytes = MAX_REQUEST_BODY_BYTES,
+): Promise<JsonRecord | null> {
+  if (!isJsonContentType(request.headers.get("content-type"))) {
+    return null;
+  }
+  const body = await readBoundedBody(request, maximumBytes);
+  if (body === null) {
+    return null;
+  }
+  let text: string;
+  try {
+    text = new TextDecoder("utf-8", { fatal: true }).decode(body);
+  } catch {
+    return null;
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text);
+  } catch {
+    return null;
+  }
+  return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
+    ? (parsed as JsonRecord)
+    : null;
+}
+
+export function parseEmail(value: unknown): string | null {
+  if (
+    typeof value !== "string" ||
+    value.length < 3 ||
+    value.length > 254 ||
+    value.trim() !== value
+  ) {
+    return null;
+  }
+  if (!/^[\x21-\x7e]+$/u.test(value)) {
+    return null;
+  }
+  const atIndex = value.lastIndexOf("@");
+  if (atIndex <= 0 || atIndex !== value.indexOf("@")) {
+    return null;
+  }
+  const local = value.slice(0, atIndex);
+  const domain = value.slice(atIndex + 1);
+  if (
+    local.length > 64 ||
+    local.startsWith(".") ||
+    local.endsWith(".") ||
+    local.includes("..") ||
+    !/^[A-Za-z0-9.!#$%&'*+\/=?^_`{|}~-]+$/u.test(local) ||
+    domain.length > 253
+  ) {
+    return null;
+  }
+  const labels = domain.split(".");
+  if (
+    labels.length < 2 ||
+    labels.some(
+      (label) =>
+        label.length === 0 ||
+        label.length > 63 ||
+        label.startsWith("-") ||
+        label.endsWith("-") ||
+        !/^[A-Za-z0-9-]+$/u.test(label),
+    ) ||
+    !/[A-Za-z]/u.test(labels.at(-1) ?? "")
+  ) {
+    return null;
+  }
+  return `${local.toLowerCase()}@${domain.toLowerCase()}`;
+}
+
+export function parseCanonicalEmail(value: unknown): string | null {
+  return typeof value === "string" &&
+    value.length <= 254 &&
+    value === value.trim() &&
+    value === value.toLowerCase() &&
+    canonicalEmailPattern.test(value)
+    ? value
+    : null;
+}
+
+export function parseUuid(value: unknown): string | null {
+  if (
+    typeof value !== "string" ||
+    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/iu.test(
+      value,
+    )
+  ) {
+    return null;
+  }
+  return value.toLowerCase();
+}
+
+export function parseCanonicalUuid(value: unknown): string | null {
+  return typeof value === "string" &&
+    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u.test(
+      value,
+    )
+    ? value
+    : null;
+}
+
+export function parseBearerJwt(value: string | null): string | null {
+  if (value === null || value.length > 4_103) {
+    return null;
+  }
+  const match =
+    /^Bearer ([A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+)$/u.exec(value);
+  return match?.[1] ?? null;
+}
diff --git a/supabase/functions/_shared/supabase-http.test.ts b/supabase/functions/_shared/supabase-http.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fabe6afff16b9da8bf07b8339a45b3842f86ae06
--- /dev/null
+++ b/supabase/functions/_shared/supabase-http.test.ts
@@ -0,0 +1,192 @@
+// deno-lint-ignore-file require-await
+
+import {
+  createSupabaseHttpClient,
+  parseAuthActionLinkOrigin,
+  resolveSupabaseEgressOrigin,
+} from "./supabase-http.ts";
+
+function assertEquals(actual: unknown, expected: unknown): void {
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+    throw new Error(
+      `Expected ${JSON.stringify(expected)}, received ${JSON.stringify(actual)}`,
+    );
+  }
+}
+
+async function assertRejects(action: () => Promise<unknown>): Promise<void> {
+  try {
+    await action();
+  } catch {
+    return;
+  }
+  throw new Error("Expected action to reject");
+}
+
+Deno.test(
+  "Supabase HTTP client rejects cross-origin egress before fetch",
+  async () => {
+    let requests = 0;
+    const client = createSupabaseHttpClient(
+      {
+        expectedOrigin: "https://abcdefghijklmnopqrst.supabase.co",
+        publishableKey: "synthetic-publishable-sentinel",
+        supabaseUrl: "https://abcdefghijklmnopqrst.supabase.co",
+      },
+      async () => {
+        requests += 1;
+        return new Response(null, { status: 200 });
+      },
+    );
+    await assertRejects(() =>
+      client.request("https://attacker.invalid/auth/v1/recover", {
+        method: "POST",
+      }),
+    );
+    assertEquals(requests, 0);
+  },
+);
+
+Deno.test(
+  "Supabase HTTP client pins the configured origin and disables redirects",
+  async () => {
+    const requests: Array<{ init?: RequestInit; url: string }> = [];
+    const client = createSupabaseHttpClient(
+      {
+        expectedOrigin: "https://abcdefghijklmnopqrst.supabase.co",
+        publishableKey: "synthetic-publishable-sentinel",
+        supabaseUrl: "https://abcdefghijklmnopqrst.supabase.co",
+      },
+      async (input, init) => {
+        requests.push({ init, url: String(input) });
+        return new Response(null, { status: 200 });
+      },
+    );
+    await client.request("/rest/v1/rpc/example", { method: "POST" });
+    assertEquals(
+      requests[0].url,
+      "https://abcdefghijklmnopqrst.supabase.co/rest/v1/rpc/example",
+    );
+    assertEquals(requests[0].init?.redirect, "error");
+  },
+);
+
+Deno.test(
+  "Supabase HTTP client rejects a matching arbitrary HTTPS origin",
+  () => {
+    let requests = 0;
+    try {
+      createSupabaseHttpClient(
+        {
+          expectedOrigin: "https://attacker.invalid",
+          publishableKey: "synthetic-publishable-sentinel",
+          supabaseUrl: "https://attacker.invalid",
+        },
+        async () => {
+          requests += 1;
+          return new Response(null, { status: 200 });
+        },
+      );
+    } catch {
+      assertEquals(requests, 0);
+      return;
+    }
+    throw new Error("Expected arbitrary HTTPS origin to be rejected");
+  },
+);
+
+Deno.test(
+  "Supabase HTTP client accepts every pinned local runtime host",
+  () => {
+    for (const origin of [
+      "http://127.0.0.1:54321",
+      "http://[::1]:54321",
+      "http://host.docker.internal:54321",
+      "http://kong:8000",
+    ]) {
+      const client = createSupabaseHttpClient(
+        {
+          expectedOrigin: origin,
+          publishableKey: "synthetic-publishable-sentinel",
+          supabaseUrl: origin,
+        },
+        async () => new Response(null, { status: 200 }),
+      );
+      assertEquals(client.origin, origin);
+    }
+  },
+);
+
+Deno.test(
+  "Supabase HTTP client accepts only canonical CLI kong without an independent pin",
+  () => {
+    const client = createSupabaseHttpClient(
+      {
+        publishableKey: "synthetic-publishable-sentinel",
+        supabaseUrl: "http://kong:8000",
+      },
+      async () => new Response(null, { status: 200 }),
+    );
+    assertEquals(client.origin, "http://kong:8000");
+    assertEquals(
+      resolveSupabaseEgressOrigin("http://kong:8000", undefined),
+      "http://kong:8000",
+    );
+  },
+);
+
+Deno.test(
+  "absent egress pin rejects every canonical-kong near miss and other origin",
+  () => {
+    for (const origin of [
+      "http://kong:8000/",
+      "http://KONG:8000",
+      "http://kong:8001",
+      "http://kong:08000",
+      "http://kong.:8000",
+      "http://kong:8000/path",
+      "http://kong:8000?query=value",
+      "http://kong:8000#fragment",
+      "http://user:password@kong:8000",
+      "http://127.0.0.1:54321",
+      "http://[::1]:54321",
+      "http://host.docker.internal:54321",
+      "https://abcdefghijklmnopqrst.supabase.co",
+    ]) {
+      assertEquals(resolveSupabaseEgressOrigin(origin, undefined), null);
+    }
+    for (const nonAbsentPin of [null, "", "undefined"]) {
+      assertEquals(
+        resolveSupabaseEgressOrigin("http://kong:8000", nonAbsentPin),
+        null,
+      );
+    }
+  },
+);
+
+Deno.test(
+  "Auth action links accept only hosted or loopback public origins",
+  () => {
+    for (const origin of [
+      "https://abcdefghijklmnopqrst.supabase.co",
+      "http://127.0.0.1:54321",
+      "http://[::1]:54321",
+    ]) {
+      assertEquals(parseAuthActionLinkOrigin(origin), origin);
+    }
+    for (const origin of [
+      undefined,
+      "http://kong:8000",
+      "http://host.docker.internal:54321",
+      "http://localhost:54321",
+      "http://attacker.invalid",
+      "https://attacker.invalid",
+      "https://abcdefghijklmnopqrst.supabase.co/path",
+      "https://abcdefghijklmnopqrst.supabase.co?query=value",
+      "https://abcdefghijklmnopqrst.supabase.co#fragment",
+      "https://user:password@abcdefghijklmnopqrst.supabase.co",
+    ]) {
+      assertEquals(parseAuthActionLinkOrigin(origin), null);
+    }
+  },
+);
diff --git a/supabase/functions/_shared/supabase-http.ts b/supabase/functions/_shared/supabase-http.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f743c580224e9e21ef6355f95a450dd9c2d63463
--- /dev/null
+++ b/supabase/functions/_shared/supabase-http.ts
@@ -0,0 +1,224 @@
+import { isExactRecord, type JsonRecord } from "./http.ts";
+
+export type ServiceFetch = (
+  input: RequestInfo | URL,
+  init?: RequestInit,
+) => Promise<Response>;
+
+export interface SupabaseRuntimeConfiguration {
+  readonly expectedOrigin?: string;
+  readonly publishableKey: string;
+  readonly serviceRoleKey?: string;
+  readonly supabaseUrl: string;
+}
+
+export interface SupabaseHttpClient {
+  request(path: string, init: RequestInit): Promise<Response>;
+  readonly origin: string;
+  readonly publishableKey: string;
+  readonly serviceRoleKey?: string;
+}
+
+function isServerValue(value: unknown): value is string {
+  return (
+    typeof value === "string" &&
+    value.length >= 16 &&
+    value.length <= 16_384 &&
+    /^[\x21-\x7e]+$/u.test(value)
+  );
+}
+
+function parseSupabaseOrigin(value: unknown): string | null {
+  if (typeof value !== "string" || value.length === 0 || value.length > 2_048) {
+    return null;
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(value);
+  } catch {
+    return null;
+  }
+  const localHost =
+    parsed.hostname === "127.0.0.1" ||
+    parsed.hostname === "[::1]" ||
+    parsed.hostname === "host.docker.internal" ||
+    parsed.hostname === "kong";
+  const hostedProject =
+    parsed.protocol === "https:" &&
+    parsed.port === "" &&
+    /^[a-z0-9]{20}\.supabase\.co$/u.test(parsed.hostname);
+  if (
+    (!hostedProject && !(parsed.protocol === "http:" && localHost)) ||
+    parsed.username !== "" ||
+    parsed.password !== "" ||
+    parsed.pathname !== "/" ||
+    parsed.search !== "" ||
+    parsed.hash !== "" ||
+    parsed.origin !== value
+  ) {
+    return null;
+  }
+  return parsed.origin;
+}
+
+const CANONICAL_LOCAL_EDGE_RUNTIME_ORIGIN = "http://kong:8000";
+
+/**
+ * Resolves the sole permitted Supabase egress origin. Hosted and externally
+ * reachable local origins require an independent exact pin. The only absent-pin
+ * exception is the byte-exact URL injected inside Supabase's local Edge runtime.
+ */
+export function resolveSupabaseEgressOrigin(
+  supabaseUrl: unknown,
+  expectedOrigin: unknown,
+): string | null {
+  const suppliedOrigin = parseSupabaseOrigin(supabaseUrl);
+  if (suppliedOrigin === null) {
+    return null;
+  }
+  if (expectedOrigin === undefined) {
+    return supabaseUrl === CANONICAL_LOCAL_EDGE_RUNTIME_ORIGIN
+      ? suppliedOrigin
+      : null;
+  }
+  const pinnedOrigin = parseSupabaseOrigin(expectedOrigin);
+  return pinnedOrigin !== null && pinnedOrigin === suppliedOrigin
+    ? suppliedOrigin
+    : null;
+}
+
+export function parseAuthActionLinkOrigin(value: unknown): string | null {
+  if (typeof value !== "string" || value.length === 0 || value.length > 2_048) {
+    return null;
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(value);
+  } catch {
+    return null;
+  }
+  const localLoopback =
+    parsed.hostname === "127.0.0.1" || parsed.hostname === "[::1]";
+  const hostedProject =
+    parsed.protocol === "https:" &&
+    parsed.port === "" &&
+    /^[a-z0-9]{20}\.supabase\.co$/u.test(parsed.hostname);
+  if (
+    (!hostedProject && !(parsed.protocol === "http:" && localLoopback)) ||
+    parsed.username !== "" ||
+    parsed.password !== "" ||
+    parsed.pathname !== "/" ||
+    parsed.search !== "" ||
+    parsed.hash !== "" ||
+    parsed.origin !== value
+  ) {
+    return null;
+  }
+  return parsed.origin;
+}
+
+export function createSupabaseHttpClient(
+  configuration: SupabaseRuntimeConfiguration,
+  serviceFetch: ServiceFetch,
+): SupabaseHttpClient {
+  const suppliedOrigin = resolveSupabaseEgressOrigin(
+    configuration.supabaseUrl,
+    configuration.expectedOrigin,
+  );
+  if (
+    suppliedOrigin === null ||
+    !isServerValue(configuration.publishableKey) ||
+    (configuration.serviceRoleKey !== undefined &&
+      !isServerValue(configuration.serviceRoleKey))
+  ) {
+    throw new Error("Backend configuration is invalid");
+  }
+  return {
+    origin: suppliedOrigin,
+    publishableKey: configuration.publishableKey,
+    serviceRoleKey: configuration.serviceRoleKey,
+    async request(path, init) {
+      let target: URL;
+      try {
+        target = new URL(path, `${suppliedOrigin}/`);
+      } catch {
+        throw new Error("Backend target is invalid");
+      }
+      if (
+        target.origin !== suppliedOrigin ||
+        target.username !== "" ||
+        target.password !== "" ||
+        !target.pathname.startsWith("/") ||
+        target.hash !== ""
+      ) {
+        throw new Error("Backend target is invalid");
+      }
+      return await serviceFetch(target, {
+        ...init,
+        redirect: "error",
+        signal: init.signal ?? AbortSignal.timeout(5_000),
+      });
+    },
+  };
+}
+
+export async function readBoundedJsonResponse(
+  response: Response,
+  maximumBytes = 65_536,
+): Promise<unknown> {
+  const contentLength = response.headers.get("content-length");
+  if (contentLength !== null) {
+    if (
+      !/^(0|[1-9][0-9]*)$/u.test(contentLength) ||
+      Number(contentLength) > maximumBytes
+    ) {
+      throw new Error("Backend response is invalid");
+    }
+  }
+  if (response.body === null) {
+    throw new Error("Backend response is invalid");
+  }
+  const reader = response.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let totalBytes = 0;
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) {
+      break;
+    }
+    totalBytes += value.byteLength;
+    if (totalBytes > maximumBytes) {
+      await reader.cancel();
+      throw new Error("Backend response is invalid");
+    }
+    chunks.push(value);
+  }
+  const bytes = new Uint8Array(totalBytes);
+  let offset = 0;
+  for (const chunk of chunks) {
+    bytes.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  let text: string;
+  try {
+    text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+  } catch {
+    throw new Error("Backend response is invalid");
+  }
+  try {
+    return JSON.parse(text);
+  } catch {
+    throw new Error("Backend response is invalid");
+  }
+}
+
+export function readExactSingleRow(
+  value: unknown,
+  expectedKeys: readonly string[],
+): JsonRecord | null {
+  if (!Array.isArray(value) || value.length !== 1) {
+    return null;
+  }
+  const [row] = value;
+  return isExactRecord(row, expectedKeys) ? row : null;
+}
