+            sequence: 2,
+            eventId: uuid(703),
+            attemptId: failure!.attemptId,
+            scope: failure!.scope,
+          },
+        ]),
+      ).toBeNull();
+    }
+    for (const change of [
+      { phase: "ended" },
+      { cause: "application_policy" },
+      { nativeSequence: 1 },
+      {
+        categories: {
+          ...cleanup!.categories,
+          aac: { status: "confirmed", code: "none" },
+        },
+      },
+      { scope: { ...cleanup!.scope, epoch: 1 } },
+      { attemptId: uuid(900) },
+      { sequence: 1 },
+      { eventId: failure!.eventId },
