+    expect(writePlan.leaseCandidate).toMatchObject({
+      authorizationRoundTripElapsedMilliseconds: 10_000,
+      authorizedRemainingDurationMilliseconds: 580_000,
+    });
+  });
+
+  it("uses monotonic elapsed evidence and ignores wall-clock jumps", () => {
