+  testId: "test-1",
+  studentSessionId: "student-session-1",
+  deviceSessionId: "device-session-1",
+};
+
+function observation(
+  monotonicMilliseconds: number,
+  overrides: Partial<OfflineLeaseObservation> = {},
+): OfflineLeaseObservation {
+  return {
+    identity,
+    bootId: "boot-a",
+    monotonicMilliseconds,
+    trust: "trusted",
+    ...overrides,
+  };
+}
+
+function emptyLedger(): OfflineLeaseAuthorizationLedger {
+  const result = createOfflineLeaseAuthorizationLedger(identity);
+  expect(result.status).toBe("created");
+  if (result.status !== "created") throw new Error(result.reason);
+  return result.ledger;
+}
+
+function challenge(
+  overrides: Partial<OfflineLeaseAuthorizationChallenge> = {},
+): OfflineLeaseAuthorizationChallenge {
+  return {
+    schemaVersion: 1,
+    challengeId: "challenge-1",
+    identity,
+    bootId: "boot-a",
+    monotonicRequestedMilliseconds: 20_000,
+    ...overrides,
+  };
+}
+
+type AuthorizationOverrides = {
+  readonly authorizationId?: string;
+  readonly challenge?: OfflineLeaseAuthorizationChallenge;
+  readonly serverAuthorizedAtMilliseconds?: number;
+  readonly serverObservedAtMilliseconds?: number;
+  readonly serverExpiresAtMilliseconds?: number;
+  readonly verification?: TrustedOfflineLeaseAuthorization["verification"];
+};
+
+function authorization(
+  overrides: AuthorizationOverrides = {},
+): TrustedOfflineLeaseAuthorization {
+  return {
+    verification:
+      overrides.verification ??
+      ({
+        status: "trusted",
+        kind: "verified-server-signature",
+        issuer: "desmoslock-backend",
+        keyId: "lease-signing-key-1",
+        signatureId: "signature-1",
+      } as const),
+    claims: {
+      schemaVersion: 1,
+      authorizationId: overrides.authorizationId ?? "authorization-1",
+      challenge: overrides.challenge ?? challenge(),
+      serverAuthorizedAtMilliseconds:
+        overrides.serverAuthorizedAtMilliseconds ?? 1_000_000,
+      serverObservedAtMilliseconds:
+        overrides.serverObservedAtMilliseconds ?? 1_010_000,
+      serverExpiresAtMilliseconds:
+        overrides.serverExpiresAtMilliseconds ?? 1_600_000,
+    },
+  };
+}
+
+function request(
+  overrides: Partial<OfflineLeaseAuthorizationRequest> = {},
+): OfflineLeaseAuthorizationRequest {
+  return {
+    ledger: emptyLedger(),
+    authorization: authorization(),
+    observation: observation(25_000),
+    ...overrides,
+  };
+}
+
+function plan(
+  input: OfflineLeaseAuthorizationRequest = request(),
+): OfflineLeaseAuthorizationWritePlan {
+  const result = planOfflineLeaseAuthorization(input);
+  expect(result.status).toBe("write-required");
+  if (result.status !== "write-required") throw new Error(result.reason);
+  return result;
+}
+
+function commit(writePlan: OfflineLeaseAuthorizationWritePlan): {
+  readonly lease: OfflineLease;
+  readonly ledger: OfflineLeaseAuthorizationLedger;
+} {
+  const result = settleOfflineLeaseAuthorization(writePlan, {
+    status: "committed",
+    expectedRevision: writePlan.expectedLedgerRevision,
+    ledger: writePlan.ledger,
+  });
+  expect(result.status).toBe("accepted");
+  if (result.status !== "accepted") throw new Error(result.failure.code);
+  return result;
+}
+
+function lease(): OfflineLease {
+  return commit(plan()).lease;
+}
+
+describe("offline lease", () => {
