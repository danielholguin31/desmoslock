+++ b/packages/domain/src/evidence-outbox.ts
@@ -0,0 +1,812 @@
+export interface EvidenceScopeIdentity {
+  readonly schoolId: string;
+  readonly testId: string;
+  readonly studentSessionId: string;
+  readonly deviceSessionId: string;
+  readonly releaseId: string;
+  readonly buildId: string;
+}
+
+export const evidenceOutboxMaximumPendingEvents = 4_096;
+export const evidenceOutboxMaximumAcknowledgedTombstones = 65_536;
+
+export type EvidencePayload =
+  | null
+  | boolean
+  | number
+  | string
+  | readonly EvidencePayload[]
+  | { readonly [key: string]: EvidencePayload };
+
+export interface EvidenceAcknowledgement {
+  readonly eventId: string;
+  readonly identity: EvidenceScopeIdentity;
+  readonly sequence: number;
+  readonly payloadDigest: string;
+}
+
+export interface PreparedEvidenceEvent extends EvidenceAcknowledgement {
+  readonly payload: EvidencePayload;
+}
+
+export interface PendingEvidenceEvent extends EvidenceAcknowledgement {
+  readonly canonicalPayload: string;
+}
+
+export interface EvidenceOutbox {
+  readonly schemaVersion: 1;
+  readonly identity: EvidenceScopeIdentity;
+  readonly capacity: number;
+  readonly tombstoneCapacity: number;
+  /** Active outboxes never discard exact tombstones; exhaustion is explicit. */
+  readonly acknowledgementRetention: "exact-until-session-archive";
+  readonly revision: number;
+  readonly nextSequence: number;
+  readonly pending: readonly PendingEvidenceEvent[];
+  readonly acknowledged: readonly EvidenceAcknowledgement[];
+}
+
+export type EvidenceOutboxCreation =
+  | { readonly status: "created"; readonly outbox: EvidenceOutbox }
+  | {
+      readonly status: "rejected";
+      readonly reason:
+        "invalid-capacity" | "invalid-identity" | "invalid-tombstone-capacity";
+    };
+
+export type EvidenceEventPreparation =
+  | { readonly status: "prepared"; readonly event: PreparedEvidenceEvent }
+  | {
+      readonly status: "rejected";
+      readonly reason: "invalid-outbox" | "invalid-payload";
+    };
+
+interface EvidenceOutboxCommandBase {
+  readonly operationId: string;
+  readonly expectedRevision: number;
+}
+
+export type EvidenceOutboxCommand =
+  | (EvidenceOutboxCommandBase & {
+      readonly type: "enqueue";
+      readonly event: PreparedEvidenceEvent;
+    })
+  | (EvidenceOutboxCommandBase & {
+      readonly type: "acknowledge";
+      readonly acknowledgements: readonly EvidenceAcknowledgement[];
+    });
+
+export type EvidenceOutboxRejectionCode =
+  | "acknowledgement-collision"
+  | "event-identity-collision"
+  | "identity-mismatch"
+  | "invalid-command"
+  | "invalid-event"
+  | "invalid-outbox"
+  | "queue-exhausted"
+  | "revision-mismatch"
+  | "sequence-exhausted"
+  | "tombstone-capacity-exhausted"
+  | "unknown-event";
+
+export type EvidenceOutboxOutcome =
+  | { readonly kind: "enqueued"; readonly sequence: number }
+  | { readonly kind: "already-enqueued"; readonly sequence: number }
+  | { readonly kind: "already-acknowledged"; readonly count: number }
+  | {
+      readonly kind: "acknowledged";
+      readonly count: number;
+      readonly alreadyAcknowledgedCount: number;
+    };
+
+export interface EvidenceOutboxWritePlan {
+  readonly status: "write-required";
+  readonly operationId: string;
+  readonly previousState: EvidenceOutbox;
+  readonly state: EvidenceOutbox;
+  readonly outcome: EvidenceOutboxOutcome;
+}
+
+export type EvidenceOutboxPlan =
+  | EvidenceOutboxWritePlan
+  | {
+      readonly status: "unchanged";
+      readonly state: EvidenceOutbox;
+      readonly outcome: EvidenceOutboxOutcome;
+    }
+  | {
+      readonly status: "rejected";
+      readonly state: EvidenceOutbox;
+      readonly rejection: { readonly code: EvidenceOutboxRejectionCode };
+    };
+
+export type EvidenceOutboxWriteResult =
+  | {
+      readonly status: "applied";
+      readonly state: EvidenceOutbox;
+      readonly outcome: EvidenceOutboxOutcome;
+    }
+  | {
+      readonly status: "write-failed";
+      readonly state: EvidenceOutbox;
+      readonly failure: {
+        readonly code: "storage-write-failed";
+        readonly cause: string;
+        readonly operationId: string;
+      };
+    };
+
+export type EvidenceOutboxWriteOutcome =
+  | { readonly status: "stored" }
+  | { readonly status: "failed"; readonly failureCode: string };
+
+const sha256DigestPattern = /^sha256:[0-9a-f]{64}$/;
+const evidenceEventIdPattern =
+  /^evidence-v1:[1-9][0-9]*:[0-9a-f]{64}:[0-9a-f]{64}$/;
+const evidencePayloadMaximumUtf8Bytes = 262_144;
+const evidencePayloadMaximumDepth = 64;
+
+const sha256RoundConstants = [
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
+  0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
+  0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
+  0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+  0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
+  0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+] as const;
+
+function hasText(value: string): boolean {
+  return value.trim().length > 0;
+}
+
+function isRecord(value: unknown): value is Readonly<Record<string, unknown>> {
+  return typeof value === "object" && value !== null;
+}
+
+function isPositiveSafeInteger(value: number): boolean {
+  return Number.isSafeInteger(value) && value > 0;
+}
+
+function identityIsValid(value: unknown): value is EvidenceScopeIdentity {
+  return (
+    isRecord(value) &&
+    typeof value.schoolId === "string" &&
+    typeof value.testId === "string" &&
+    typeof value.studentSessionId === "string" &&
+    typeof value.deviceSessionId === "string" &&
+    typeof value.releaseId === "string" &&
+    typeof value.buildId === "string" &&
+    hasText(value.schoolId) &&
+    hasText(value.testId) &&
+    hasText(value.studentSessionId) &&
+    hasText(value.deviceSessionId) &&
+    hasText(value.releaseId) &&
+    hasText(value.buildId)
+  );
+}
+
+function identitiesMatch(
+  left: EvidenceScopeIdentity,
+  right: EvidenceScopeIdentity,
+): boolean {
+  return (
+    left.schoolId === right.schoolId &&
+    left.testId === right.testId &&
+    left.studentSessionId === right.studentSessionId &&
+    left.deviceSessionId === right.deviceSessionId &&
+    left.releaseId === right.releaseId &&
+    left.buildId === right.buildId
+  );
+}
+
+function copyIdentity(identity: EvidenceScopeIdentity): EvidenceScopeIdentity {
+  return {
+    schoolId: identity.schoolId,
+    testId: identity.testId,
+    studentSessionId: identity.studentSessionId,
+    deviceSessionId: identity.deviceSessionId,
+    releaseId: identity.releaseId,
+    buildId: identity.buildId,
+  };
+}
+
+function rotateRight(value: number, shift: number): number {
+  return (value >>> shift) | (value << (32 - shift));
+}
+
+function sha256(value: string): string {
+  const input = new TextEncoder().encode(value);
+  const paddedLength = Math.ceil((input.length + 9) / 64) * 64;
+  const padded = new Uint8Array(paddedLength);
+  padded.set(input);
+  padded[input.length] = 0x80;
+  const dataView = new DataView(padded.buffer);
+  const bitLength = input.length * 8;
+  dataView.setUint32(paddedLength - 8, Math.floor(bitLength / 0x1_0000_0000));
+  dataView.setUint32(paddedLength - 4, bitLength >>> 0);
+
+  let hash0 = 0x6a09e667;
+  let hash1 = 0xbb67ae85;
+  let hash2 = 0x3c6ef372;
+  let hash3 = 0xa54ff53a;
+  let hash4 = 0x510e527f;
+  let hash5 = 0x9b05688c;
+  let hash6 = 0x1f83d9ab;
+  let hash7 = 0x5be0cd19;
+  const words = new Uint32Array(64);
+
+  for (let offset = 0; offset < paddedLength; offset += 64) {
+    for (let index = 0; index < 16; index += 1) {
+      words[index] = dataView.getUint32(offset + index * 4);
+    }
+    for (let index = 16; index < 64; index += 1) {
+      const word15 = words[index - 15] ?? 0;
+      const word2 = words[index - 2] ?? 0;
+      const sigma0 =
+        rotateRight(word15, 7) ^ rotateRight(word15, 18) ^ (word15 >>> 3);
+      const sigma1 =
+        rotateRight(word2, 17) ^ rotateRight(word2, 19) ^ (word2 >>> 10);
+      words[index] =
+        ((words[index - 16] ?? 0) +
+          sigma0 +
+          (words[index - 7] ?? 0) +
+          sigma1) >>>
+        0;
+    }
+
+    let a = hash0;
+    let b = hash1;
+    let c = hash2;
+    let d = hash3;
+    let e = hash4;
+    let f = hash5;
+    let g = hash6;
+    let h = hash7;
+    for (let index = 0; index < 64; index += 1) {
+      const sum1 = rotateRight(e, 6) ^ rotateRight(e, 11) ^ rotateRight(e, 25);
+      const choice = (e & f) ^ (~e & g);
+      const temporary1 =
+        (h +
+          sum1 +
+          choice +
+          (sha256RoundConstants[index] ?? 0) +
+          (words[index] ?? 0)) >>>
+        0;
+      const sum0 = rotateRight(a, 2) ^ rotateRight(a, 13) ^ rotateRight(a, 22);
+      const majority = (a & b) ^ (a & c) ^ (b & c);
+      const temporary2 = (sum0 + majority) >>> 0;
+      h = g;
+      g = f;
+      f = e;
+      e = (d + temporary1) >>> 0;
+      d = c;
+      c = b;
+      b = a;
+      a = (temporary1 + temporary2) >>> 0;
+    }
+    hash0 = (hash0 + a) >>> 0;
+    hash1 = (hash1 + b) >>> 0;
+    hash2 = (hash2 + c) >>> 0;
+    hash3 = (hash3 + d) >>> 0;
+    hash4 = (hash4 + e) >>> 0;
+    hash5 = (hash5 + f) >>> 0;
+    hash6 = (hash6 + g) >>> 0;
+    hash7 = (hash7 + h) >>> 0;
+  }
+
+  return [hash0, hash1, hash2, hash3, hash4, hash5, hash6, hash7]
+    .map((word) => word.toString(16).padStart(8, "0"))
+    .join("");
+}
+
+function canonicalize(
+  value: unknown,
+  ancestors: ReadonlySet<object>,
+  depth: number,
+): string | null {
+  if (depth > evidencePayloadMaximumDepth) return null;
+  if (value === null) return "null";
+  if (typeof value === "string" || typeof value === "boolean") {
+    return JSON.stringify(value);
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value)
+      ? JSON.stringify(Object.is(value, -0) ? 0 : value)
+      : null;
+  }
+  if (typeof value !== "object" || ancestors.has(value)) return null;
+
+  const nextAncestors = new Set(ancestors);
+  nextAncestors.add(value);
+  if (Array.isArray(value)) {
+    if (
+      value.length > evidencePayloadMaximumUtf8Bytes ||
+      Object.getOwnPropertySymbols(value).length > 0
+    ) {
+      return null;
+    }
+    const descriptors = Object.getOwnPropertyDescriptors(value);
+    // `length` plus exactly one own data property for every array index.
+    // This rejects holes, accessors, and extra properties without invoking a
+    // caller-controlled getter during canonicalization.
+    if (Object.keys(descriptors).length !== value.length + 1) return null;
+    const entries: string[] = [];
+    for (let index = 0; index < value.length; index += 1) {
+      const descriptor = descriptors[String(index)];
+      if (
+        descriptor === undefined ||
+        !descriptor.enumerable ||
+        !("value" in descriptor)
+      ) {
+        return null;
+      }
+      const canonicalValue = canonicalize(
+        descriptor.value,
+        nextAncestors,
+        depth + 1,
+      );
+      if (canonicalValue === null) return null;
+      entries.push(canonicalValue);
+    }
+    return `[${entries.join(",")}]`;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  if (prototype !== Object.prototype && prototype !== null) return null;
+  if (Object.getOwnPropertySymbols(value).length > 0) return null;
+  const descriptors = Object.getOwnPropertyDescriptors(value);
+  const keys = Object.keys(descriptors).sort();
+  const entries: string[] = [];
+  for (const key of keys) {
+    const descriptor = descriptors[key];
+    if (
+      descriptor === undefined ||
+      !descriptor.enumerable ||
+      !("value" in descriptor)
+    ) {
+      return null;
+    }
+    const canonicalValue = canonicalize(
+      descriptor.value,
+      nextAncestors,
+      depth + 1,
+    );
+    if (canonicalValue === null) return null;
+    entries.push(`${JSON.stringify(key)}:${canonicalValue}`);
+  }
+  return `{${entries.join(",")}}`;
+}
+
+function canonicalPayload(value: unknown): string | null {
+  const canonical = canonicalize(value, new Set(), 0);
+  if (canonical === null) return null;
+  return new TextEncoder().encode(canonical).length <=
+    evidencePayloadMaximumUtf8Bytes
+    ? canonical
+    : null;
+}
+
+function scopeDigest(identity: EvidenceScopeIdentity): string {
+  const canonical = canonicalize(identity, new Set(), 0);
+  if (canonical === null) throw new Error("Evidence identity is malformed");
+  return sha256(canonical);
+}
+
+function eventIdFor(
+  identity: EvidenceScopeIdentity,
+  sequence: number,
+  payloadDigest: string,
+): string {
+  return `evidence-v1:${sequence}:${scopeDigest(identity)}:${payloadDigest.slice(7)}`;
+}
+
+function acknowledgementIsValid(
+  value: unknown,
+): value is EvidenceAcknowledgement {
+  return (
+    isRecord(value) &&
+    identityIsValid(value.identity) &&
+    typeof value.sequence === "number" &&
+    isPositiveSafeInteger(value.sequence) &&
+    typeof value.payloadDigest === "string" &&
+    sha256DigestPattern.test(value.payloadDigest) &&
+    typeof value.eventId === "string" &&
+    evidenceEventIdPattern.test(value.eventId) &&
+    value.eventId ===
+      eventIdFor(value.identity, value.sequence, value.payloadDigest)
+  );
+}
+
+function acknowledgementIdentitiesMatch(
+  left: EvidenceAcknowledgement,
+  right: EvidenceAcknowledgement,
+): boolean {
+  return (
+    left.eventId === right.eventId &&
+    identitiesMatch(left.identity, right.identity) &&
+    left.sequence === right.sequence &&
+    left.payloadDigest === right.payloadDigest
+  );
+}
+
+function pendingEventIsValid(event: unknown): event is PendingEvidenceEvent {
+  if (!isRecord(event) || typeof event.canonicalPayload !== "string") {
+    return false;
+  }
+  const recanonicalized = (() => {
+    try {
+      return canonicalPayload(JSON.parse(event.canonicalPayload));
+    } catch {
+      return null;
+    }
+  })();
+  return (
+    acknowledgementIsValid(event) &&
+    recanonicalized === event.canonicalPayload &&
+    event.payloadDigest === `sha256:${sha256(event.canonicalPayload)}`
+  );
+}
+
+function outboxIsValid(outbox: EvidenceOutbox): boolean {
+  if (
+    outbox.schemaVersion !== 1 ||
+    !identityIsValid(outbox.identity) ||
+    !isPositiveSafeInteger(outbox.capacity) ||
+    outbox.capacity > evidenceOutboxMaximumPendingEvents ||
+    !isPositiveSafeInteger(outbox.tombstoneCapacity) ||
+    outbox.tombstoneCapacity > evidenceOutboxMaximumAcknowledgedTombstones ||
+    outbox.acknowledgementRetention !== "exact-until-session-archive" ||
+    !Number.isSafeInteger(outbox.revision) ||
+    outbox.revision < 0 ||
+    !isPositiveSafeInteger(outbox.nextSequence) ||
+    !Array.isArray(outbox.pending) ||
+    !Array.isArray(outbox.acknowledged) ||
+    outbox.pending.length > outbox.capacity ||
+    outbox.acknowledged.length > outbox.tombstoneCapacity
+  ) {
+    return false;
+  }
+
+  const records: readonly EvidenceAcknowledgement[] = [
+    ...outbox.pending,
+    ...outbox.acknowledged,
+  ];
+  if (
+    records.length !== outbox.nextSequence - 1 ||
+    outbox.pending.some(
+      (record) =>
+        !pendingEventIsValid(record) ||
+        !identitiesMatch(record.identity, outbox.identity),
+    ) ||
+    outbox.acknowledged.some(
+      (record) =>
+        !acknowledgementIsValid(record) ||
+        !identitiesMatch(record.identity, outbox.identity),
+    ) ||
+    records.some((record) => record.sequence >= outbox.nextSequence)
+  ) {
+    return false;
+  }
+  const sequences = new Set(records.map((record) => record.sequence));
+  const eventIds = new Set(records.map((record) => record.eventId));
+  if (sequences.size !== records.length || eventIds.size !== records.length) {
+    return false;
+  }
+  for (let sequence = 1; sequence < outbox.nextSequence; sequence += 1) {
+    if (!sequences.has(sequence)) return false;
+  }
+  return true;
+}
+
+function reject(
+  state: EvidenceOutbox,
+  code: EvidenceOutboxRejectionCode,
+): EvidenceOutboxPlan {
+  return { status: "rejected", state, rejection: { code } };
+}
+
+function unchanged(
+  state: EvidenceOutbox,
+  outcome: EvidenceOutboxOutcome,
+): EvidenceOutboxPlan {
+  return { status: "unchanged", state, outcome };
+}
+
+function writePlan(
+  previousState: EvidenceOutbox,
+  state: EvidenceOutbox,
+  operationId: string,
+  outcome: EvidenceOutboxOutcome,
+): EvidenceOutboxWritePlan {
+  return {
+    status: "write-required",
+    operationId,
+    previousState,
+    state,
+    outcome,
+  };
+}
+
+function commandIsValid(command: unknown): boolean {
+  return (
+    isRecord(command) &&
+    typeof command.operationId === "string" &&
+    hasText(command.operationId) &&
+    typeof command.expectedRevision === "number" &&
+    Number.isSafeInteger(command.expectedRevision) &&
+    command.expectedRevision >= 0
+  );
+}
+
+export function createEvidenceOutbox(input: {
+  readonly identity: EvidenceScopeIdentity;
+  readonly capacity: number;
+  readonly tombstoneCapacity: number;
+}): EvidenceOutboxCreation {
+  if (!identityIsValid(input.identity)) {
+    return { status: "rejected", reason: "invalid-identity" };
+  }
+  if (!isPositiveSafeInteger(input.capacity)) {
+    return { status: "rejected", reason: "invalid-capacity" };
+  }
+  if (input.capacity > evidenceOutboxMaximumPendingEvents) {
+    return { status: "rejected", reason: "invalid-capacity" };
+  }
+  if (
+    !isPositiveSafeInteger(input.tombstoneCapacity) ||
+    input.tombstoneCapacity > evidenceOutboxMaximumAcknowledgedTombstones
+  ) {
+    return { status: "rejected", reason: "invalid-tombstone-capacity" };
+  }
+  return {
+    status: "created",
+    outbox: {
+      schemaVersion: 1,
+      identity: copyIdentity(input.identity),
+      capacity: input.capacity,
+      tombstoneCapacity: input.tombstoneCapacity,
+      acknowledgementRetention: "exact-until-session-archive",
+      revision: 0,
+      nextSequence: 1,
+      pending: [],
+      acknowledged: [],
+    },
+  };
+}
+
+export function prepareEvidenceEvent(
+  outbox: EvidenceOutbox,
+  payload: EvidencePayload,
+): EvidenceEventPreparation {
+  if (!outboxIsValid(outbox)) {
+    return { status: "rejected", reason: "invalid-outbox" };
+  }
+  const canonical = canonicalPayload(payload);
+  if (canonical === null) {
+    return { status: "rejected", reason: "invalid-payload" };
+  }
+  const payloadDigest = `sha256:${sha256(canonical)}`;
+  return {
+    status: "prepared",
+    event: {
+      eventId: eventIdFor(outbox.identity, outbox.nextSequence, payloadDigest),
+      identity: copyIdentity(outbox.identity),
+      sequence: outbox.nextSequence,
+      payloadDigest,
+      payload,
+    },
+  };
+}
+
+function planEnqueue(
+  state: EvidenceOutbox,
+  command: Extract<EvidenceOutboxCommand, { readonly type: "enqueue" }>,
+): EvidenceOutboxPlan {
+  if (
+    !identityIsValid(command.event.identity) ||
+    !identitiesMatch(command.event.identity, state.identity)
+  ) {
+    return reject(state, "identity-mismatch");
+  }
+  const canonical = canonicalPayload(command.event.payload);
+  if (canonical === null) return reject(state, "invalid-event");
+  const computedPayloadDigest = `sha256:${sha256(canonical)}`;
+  const computedEventId = eventIdFor(
+    state.identity,
+    command.event.sequence,
+    computedPayloadDigest,
+  );
+  if (
+    command.event.payloadDigest !== computedPayloadDigest ||
+    command.event.eventId !== computedEventId
+  ) {
+    return reject(state, "event-identity-collision");
+  }
+
+  const existingBySequence = [...state.pending, ...state.acknowledged].find(
+    (event) => event.sequence === command.event.sequence,
+  );
+  if (existingBySequence !== undefined) {
+    if (!acknowledgementIdentitiesMatch(existingBySequence, command.event)) {
+      return reject(state, "event-identity-collision");
+    }
+    return state.pending.includes(existingBySequence as PendingEvidenceEvent)
+      ? unchanged(state, {
+          kind: "already-enqueued",
+          sequence: existingBySequence.sequence,
+        })
+      : unchanged(state, { kind: "already-acknowledged", count: 1 });
+  }
+  if (command.event.sequence !== state.nextSequence) {
+    return reject(state, "invalid-event");
+  }
+  if (command.expectedRevision !== state.revision) {
+    return reject(state, "revision-mismatch");
+  }
+  if (state.acknowledged.length >= state.tombstoneCapacity) {
+    return reject(state, "tombstone-capacity-exhausted");
+  }
+  if (state.pending.length >= state.capacity) {
+    return reject(state, "queue-exhausted");
+  }
+  if (state.nextSequence >= Number.MAX_SAFE_INTEGER) {
+    return reject(state, "sequence-exhausted");
+  }
+
+  const event: PendingEvidenceEvent = {
+    eventId: command.event.eventId,
+    identity: state.identity,
+    sequence: command.event.sequence,
+    payloadDigest: computedPayloadDigest,
+    canonicalPayload: canonical,
+  };
+  return writePlan(
+    state,
+    {
+      ...state,
+      revision: state.revision + 1,
+      nextSequence: state.nextSequence + 1,
+      pending: [...state.pending, event],
+    },
+    command.operationId,
+    { kind: "enqueued", sequence: event.sequence },
+  );
+}
+
+function planAcknowledgement(
+  state: EvidenceOutbox,
+  command: Extract<EvidenceOutboxCommand, { readonly type: "acknowledge" }>,
+): EvidenceOutboxPlan {
+  if (command.acknowledgements.length === 0) {
+    return reject(state, "invalid-command");
+  }
+
+  const acknowledgementsByEventId = new Map<string, EvidenceAcknowledgement>();
+  for (const acknowledgement of command.acknowledgements) {
+    if (!acknowledgementIsValid(acknowledgement)) {
+      return reject(state, "invalid-command");
+    }
+    if (!identitiesMatch(acknowledgement.identity, state.identity)) {
+      return reject(state, "identity-mismatch");
+    }
+    const duplicate = acknowledgementsByEventId.get(acknowledgement.eventId);
+    if (
+      duplicate !== undefined &&
+      !acknowledgementIdentitiesMatch(duplicate, acknowledgement)
+    ) {
+      return reject(state, "acknowledgement-collision");
+    }
+    acknowledgementsByEventId.set(acknowledgement.eventId, acknowledgement);
+  }
+
+  const pendingToAcknowledge = new Set<string>();
+  let alreadyAcknowledgedCount = 0;
+  for (const acknowledgement of acknowledgementsByEventId.values()) {
+    const existingBySequence = [...state.pending, ...state.acknowledged].find(
+      (event) => event.sequence === acknowledgement.sequence,
+    );
+    if (existingBySequence === undefined) {
+      return reject(state, "unknown-event");
+    }
+    if (!acknowledgementIdentitiesMatch(existingBySequence, acknowledgement)) {
+      return reject(state, "acknowledgement-collision");
+    }
+    if (
+      state.pending.some((event) => event.eventId === acknowledgement.eventId)
+    ) {
+      pendingToAcknowledge.add(acknowledgement.eventId);
+    } else {
+      alreadyAcknowledgedCount += 1;
+    }
+  }
+
+  if (pendingToAcknowledge.size === 0) {
+    return unchanged(state, {
+      kind: "already-acknowledged",
+      count: alreadyAcknowledgedCount,
+    });
+  }
+  if (command.expectedRevision !== state.revision) {
+    return reject(state, "revision-mismatch");
+  }
+  if (
+    state.acknowledged.length + pendingToAcknowledge.size >
+    state.tombstoneCapacity
+  ) {
+    return reject(state, "tombstone-capacity-exhausted");
+  }
+
+  const newlyAcknowledged = state.pending
+    .filter((event) => pendingToAcknowledge.has(event.eventId))
+    .map(({ eventId, identity, sequence, payloadDigest }) => ({
+      eventId,
+      identity,
+      sequence,
+      payloadDigest,
+    }));
+  return writePlan(
+    state,
+    {
+      ...state,
+      revision: state.revision + 1,
+      pending: state.pending.filter(
+        (event) => !pendingToAcknowledge.has(event.eventId),
+      ),
+      acknowledged: [...state.acknowledged, ...newlyAcknowledged],
+    },
+    command.operationId,
+    {
+      kind: "acknowledged",
+      count: newlyAcknowledged.length,
+      alreadyAcknowledgedCount,
+    },
+  );
+}
+
+export function planEvidenceOutboxCommand(
+  state: EvidenceOutbox,
+  command: EvidenceOutboxCommand,
+): EvidenceOutboxPlan {
+  if (!outboxIsValid(state)) {
+    return reject(state, "invalid-outbox");
+  }
+  if (!commandIsValid(command)) {
+    return reject(state, "invalid-command");
+  }
+  switch (command.type) {
+    case "enqueue":
+      if (!isRecord(command.event)) {
+        return reject(state, "invalid-command");
+      }
+      return planEnqueue(state, command);
+    case "acknowledge":
+      if (!Array.isArray(command.acknowledgements)) {
+        return reject(state, "invalid-command");
+      }
+      return planAcknowledgement(state, command);
+    default:
+      return reject(state, "invalid-command");
+  }
+}
+
+export function settleEvidenceOutboxWrite(
+  plan: EvidenceOutboxWritePlan,
+  outcome: EvidenceOutboxWriteOutcome,
+): EvidenceOutboxWriteResult {
+  if (outcome.status === "stored") {
+    return { status: "applied", state: plan.state, outcome: plan.outcome };
+  }
+  return {
+    status: "write-failed",
+    state: plan.previousState,
+    failure: {
+      code: "storage-write-failed",
+      cause: hasText(outcome.failureCode) ? outcome.failureCode : "unspecified",
+      operationId: plan.operationId,
+    },
+  };
+}
