index 0000000000000000000000000000000000000000..52c373529ac240b1899d8487ed62b2186825b056
--- /dev/null
+++ b/packages/domain/tests/evidence-outbox.test.ts
@@ -0,0 +1,520 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  createEvidenceOutbox,
+  evidenceOutboxMaximumAcknowledgedTombstones,
+  evidenceOutboxMaximumPendingEvents,
+  planEvidenceOutboxCommand,
+  prepareEvidenceEvent,
+  settleEvidenceOutboxWrite,
+  type EvidenceAcknowledgement,
+  type EvidenceOutbox,
+  type EvidenceOutboxCommand,
+  type EvidenceOutboxWritePlan,
+  type EvidencePayload,
+  type EvidenceScopeIdentity,
+  type PreparedEvidenceEvent,
+} from "../src/index.js";
+
+const identity: EvidenceScopeIdentity = {
+  schoolId: "school-1",
+  testId: "test-1",
+  studentSessionId: "student-session-1",
+  deviceSessionId: "device-session-1",
+  releaseId: "release-1",
+  buildId: "build-1",
+};
+
+function emptyOutbox(capacity = 3, tombstoneCapacity = 8): EvidenceOutbox {
+  const result = createEvidenceOutbox({
+    identity,
+    capacity,
+    tombstoneCapacity,
+  });
+  expect(result.status).toBe("created");
+  if (result.status !== "created") throw new Error(result.reason);
+  return result.outbox;
+}
+
+function preparedEvent(
+  state: EvidenceOutbox,
+  eventName: string,
+): PreparedEvidenceEvent {
+  const result = prepareEvidenceEvent(state, {
+    kind: "lock-transition",
+    eventId: eventName,
+  });
+  expect(result.status).toBe("prepared");
+  if (result.status !== "prepared") throw new Error(result.reason);
+  return result.event;
+}
+
+function enqueueCommand(
+  state: EvidenceOutbox,
+  event: PreparedEvidenceEvent,
+): Extract<EvidenceOutboxCommand, { readonly type: "enqueue" }> {
+  return {
+    type: "enqueue",
+    operationId: `enqueue-${event.eventId}`,
+    expectedRevision: state.revision,
+    event,
+  };
+}
+
+function ackCommand(
+  state: EvidenceOutbox,
+  acknowledgements: readonly EvidenceAcknowledgement[],
+): Extract<EvidenceOutboxCommand, { readonly type: "acknowledge" }> {
+  return {
+    type: "acknowledge",
+    operationId: `ack-${state.revision}`,
+    expectedRevision: state.revision,
+    acknowledgements,
+  };
+}
+
+function stored(
+  state: EvidenceOutbox,
+  command: EvidenceOutboxCommand,
+): EvidenceOutbox {
+  const plan = planEvidenceOutboxCommand(state, command);
+  expect(plan.status).toBe("write-required");
+  if (plan.status !== "write-required") {
+    throw new Error(
+      plan.status === "rejected" ? plan.rejection.code : "unexpected no-op",
+    );
+  }
+  const result = settleEvidenceOutboxWrite(plan, { status: "stored" });
+  expect(result.status).toBe("applied");
+  return result.state;
+}
+
+function enqueue(state: EvidenceOutbox, eventName: string): EvidenceOutbox {
+  const event = preparedEvent(state, eventName);
+  return stored(state, enqueueCommand(state, event));
+}
+
+function ackFor(
+  state: EvidenceOutbox,
+  sequence: number,
+): EvidenceAcknowledgement {
+  const event = state.pending.find(
+    (candidate) => candidate.sequence === sequence,
+  );
+  if (event === undefined) throw new Error(`missing sequence ${sequence}`);
+  return {
+    eventId: event.eventId,
+    identity: event.identity,
+    sequence: event.sequence,
+    payloadDigest: event.payloadDigest,
+  };
+}
+
+describe("evidence outbox", () => {
+  it("binds every event to the full product identity and assigns per-device-session sequences", () => {
+    let state = emptyOutbox();
+    state = enqueue(state, "event-1");
+    state = enqueue(state, "event-2");
+    expect(state).toMatchObject({
+      identity,
+      revision: 2,
+      nextSequence: 3,
+      pending: [
+        { identity, sequence: 1 },
+        { identity, sequence: 2 },
+      ],
+    });
+  });
+
+  it("computes a known SHA-256 digest from canonical immutable payload", () => {
+    const first = prepareEvidenceEvent(emptyOutbox(), {
+      kind: "lock-transition",
+      eventId: "event-1",
+    });
+    const reordered = prepareEvidenceEvent(emptyOutbox(), {
+      eventId: "event-1",
+      kind: "lock-transition",
+    });
+    expect(first).toMatchObject({
+      status: "prepared",
+      event: {
+        payloadDigest:
+          "sha256:277186e6414cbbbb7aaca974927e322435f3a53c464974922559e5ff6bdacd61",
+      },
+    });
+    expect(reordered).toEqual(first);
+  });
+
+  it("makes an exact enqueue retry idempotent without consuming a sequence", () => {
+    const empty = emptyOutbox();
+    const event = preparedEvent(empty, "event-1");
+    const state = stored(empty, enqueueCommand(empty, event));
+    const retry = planEvidenceOutboxCommand(state, {
+      ...enqueueCommand(state, event),
+      expectedRevision: 0,
+    });
+    expect(retry).toMatchObject({
+      status: "unchanged",
+      state,
+      outcome: { kind: "already-enqueued", sequence: 1 },
+    });
+  });
+
+  it("rejects the same event identity when its payload changes after preparation", () => {
+    const empty = emptyOutbox();
+    const event = preparedEvent(empty, "event-1");
+    const state = stored(empty, enqueueCommand(empty, event));
+    const collision = planEvidenceOutboxCommand(
+      state,
+      enqueueCommand(state, {
+        ...event,
+        payload: { kind: "release", eventId: "changed" },
+      }),
+    );
+    expect(collision).toMatchObject({
+      status: "rejected",
+      rejection: { code: "event-identity-collision" },
+    });
+    expect(collision.state).toBe(state);
+  });
+
+  it("rejects a different canonical event claiming an issued sequence", () => {
+    const empty = emptyOutbox();
+    const event = preparedEvent(empty, "event-1");
+    const alternative = preparedEvent(empty, "different-event");
+    const state = stored(empty, enqueueCommand(empty, event));
+    expect(
+      planEvidenceOutboxCommand(state, enqueueCommand(state, alternative)),
+    ).toMatchObject({
+      status: "rejected",
+      rejection: { code: "event-identity-collision" },
+    });
+  });
+
+  it("acknowledges only exact event identities and leaves a partial queue intact", () => {
+    let state = emptyOutbox();
+    state = enqueue(state, "event-1");
+    state = enqueue(state, "event-2");
+    const event1Ack = ackFor(state, 1);
+    state = stored(state, ackCommand(state, [event1Ack]));
+    expect(state.pending.map((event) => event.sequence)).toEqual([2]);
+    expect(state.acknowledged).toEqual([event1Ack]);
+  });
+
+  it("makes an exact acknowledgement retry idempotent", () => {
+    let state = enqueue(emptyOutbox(), "event-1");
+    const acknowledgement = ackFor(state, 1);
+    state = stored(state, ackCommand(state, [acknowledgement]));
+    const retry = planEvidenceOutboxCommand(state, {
+      ...ackCommand(state, [acknowledgement]),
+      expectedRevision: 1,
+    });
+    expect(retry).toMatchObject({
+      status: "unchanged",
+      state,
+      outcome: { kind: "already-acknowledged", count: 1 },
+    });
+  });
+
+  it("supports a mixed partial acknowledgement with exact duplicate receipts", () => {
+    let state = enqueue(emptyOutbox(), "event-1");
+    const firstAck = ackFor(state, 1);
+    state = stored(state, ackCommand(state, [firstAck]));
+    state = enqueue(state, "event-2");
+    const secondAck = ackFor(state, 2);
+
+    const plan = planEvidenceOutboxCommand(
+      state,
+      ackCommand(state, [firstAck, firstAck, secondAck]),
+    );
+    expect(plan).toMatchObject({
+      status: "write-required",
+      outcome: {
+        kind: "acknowledged",
+        count: 1,
+        alreadyAcknowledgedCount: 1,
+      },
+      state: { pending: [] },
+    });
+  });
+
+  it("rejects mismatched and unknown acknowledgements atomically", () => {
+    let state = emptyOutbox();
+    const firstEvent = preparedEvent(state, "event-1");
+    const alternativeFirstEvent = preparedEvent(state, "alternative-event");
+    state = stored(state, enqueueCommand(state, firstEvent));
+    const unknownEvent = preparedEvent(state, "not-enqueued");
+    const mismatch = planEvidenceOutboxCommand(
+      state,
+      ackCommand(state, [alternativeFirstEvent]),
+    );
+    const unknown = planEvidenceOutboxCommand(
+      state,
+      ackCommand(state, [unknownEvent]),
+    );
+    expect(mismatch).toMatchObject({
+      status: "rejected",
+      rejection: { code: "acknowledgement-collision" },
+    });
+    expect(unknown).toMatchObject({
+      status: "rejected",
+      rejection: { code: "unknown-event" },
+    });
+    expect(mismatch.state).toBe(state);
+    expect(unknown.state).toBe(state);
+    expect(state.pending).toHaveLength(1);
+  });
+
+  it.each([
+    "schoolId",
+    "testId",
+    "studentSessionId",
+    "deviceSessionId",
+    "releaseId",
+    "buildId",
+  ] as const)("rejects evidence with a different %s", (field) => {
+    const state = emptyOutbox();
+    const otherIdentity = { ...identity, [field]: `other-${field}` };
+    const otherOutboxResult = createEvidenceOutbox({
+      identity: otherIdentity,
+      capacity: 3,
+      tombstoneCapacity: 8,
+    });
+    if (otherOutboxResult.status !== "created") {
+      throw new Error(otherOutboxResult.reason);
+    }
+    const otherEvent = preparedEvent(otherOutboxResult.outbox, "event-1");
+    expect(
+      planEvidenceOutboxCommand(state, enqueueCommand(state, otherEvent)),
+    ).toMatchObject({
+      status: "rejected",
+      rejection: { code: "identity-mismatch" },
+    });
+  });
+
+  it("reports queue exhaustion without evicting pending evidence", () => {
+    let state = emptyOutbox(1);
+    state = enqueue(state, "event-1");
+    const event2 = preparedEvent(state, "event-2");
+    const result = planEvidenceOutboxCommand(
+      state,
+      enqueueCommand(state, event2),
+    );
+    expect(result).toMatchObject({
+      status: "rejected",
+      rejection: { code: "queue-exhausted" },
+    });
+    expect(result.state).toBe(state);
+    expect(state.pending.map((event) => event.sequence)).toEqual([1]);
+  });
+
+  it("bounds exact tombstone retention and never silently compacts identities", () => {
+    let state = enqueue(emptyOutbox(2, 1), "event-1");
+    const event = state.pending[0];
+    if (event === undefined) throw new Error("missing event");
+    const acknowledgement = ackFor(state, 1);
+    state = stored(state, ackCommand(state, [acknowledgement]));
+    const nextEvent = preparedEvent(state, "event-2");
+    const exhausted = planEvidenceOutboxCommand(
+      state,
+      enqueueCommand(state, nextEvent),
+    );
+    const exactRetry = planEvidenceOutboxCommand(
+      state,
+      enqueueCommand(state, {
+        ...event,
+        payload: JSON.parse(event.canonicalPayload),
+      }),
+    );
+    expect(exhausted).toMatchObject({
+      status: "rejected",
+      rejection: { code: "tombstone-capacity-exhausted" },
+    });
+    expect(state).toMatchObject({
+      acknowledgementRetention: "exact-until-session-archive",
+      acknowledged: [acknowledgement],
+    });
+    expect(exactRetry).toMatchObject({
+      status: "unchanged",
+      outcome: { kind: "already-acknowledged", count: 1 },
+    });
+  });
+
+  it("makes storage write failure visible and keeps the last durable state", () => {
+    const state = emptyOutbox();
+    const event = preparedEvent(state, "event-1");
+    const plan = planEvidenceOutboxCommand(state, enqueueCommand(state, event));
+    expect(plan.status).toBe("write-required");
+    if (plan.status !== "write-required")
+      throw new Error("expected write plan");
+    const failed = settleEvidenceOutboxWrite(plan, {
+      status: "failed",
+      failureCode: "disk-full",
+    });
+    expect(failed).toMatchObject({
+      status: "write-failed",
+      state,
+      failure: { code: "storage-write-failed", cause: "disk-full" },
+    });
+    expect(failed.state).toBe(state);
+    expect(state.pending).toEqual([]);
+  });
+
+  it("keeps the last durable state separate until storage succeeds", () => {
+    const state = emptyOutbox();
+    const event = preparedEvent(state, "event-1");
+    const plan = planEvidenceOutboxCommand(state, enqueueCommand(state, event));
+    expect(plan.status).toBe("write-required");
+    if (plan.status !== "write-required")
+      throw new Error("expected write plan");
+    expect(plan.previousState).toBe(state);
+    expect(plan.state.pending).toHaveLength(1);
+    expect(state.pending).toHaveLength(0);
+  });
+
+  it("rejects invalid payloads before assigning identity", () => {
+    const state = emptyOutbox();
+    const cyclic: Record<string, unknown> = {};
+    cyclic.self = cyclic;
+    const invalidPayloads: readonly unknown[] = [
+      { value: Number.NaN },
+      { value: undefined },
+      new Date(0),
+      cyclic,
+    ];
+    for (const payload of invalidPayloads) {
+      expect(
+        prepareEvidenceEvent(state, payload as EvidencePayload),
+      ).toMatchObject({ status: "rejected", reason: "invalid-payload" });
+    }
+  });
+
+  it("rejects sparse and accessor arrays without invoking getters", () => {
+    const state = emptyOutbox();
+    const sparse = Array(1) as EvidencePayload;
+    let getterInvoked = false;
+    const accessor: unknown[] = [];
+    Object.defineProperty(accessor, "0", {
+      enumerable: true,
+      get() {
+        getterInvoked = true;
+        throw new Error("canonicalization must not invoke array accessors");
+      },
+    });
+
+    expect(prepareEvidenceEvent(state, [])).toMatchObject({
+      status: "prepared",
+    });
+    expect(prepareEvidenceEvent(state, sparse)).toMatchObject({
+      status: "rejected",
+      reason: "invalid-payload",
+    });
+    expect(
+      prepareEvidenceEvent(state, accessor as EvidencePayload),
+    ).toMatchObject({
+      status: "rejected",
+      reason: "invalid-payload",
+    });
+    expect(getterInvoked).toBe(false);
+  });
+
+  it("rejects unknown command discriminants instead of treating them as acknowledgements", () => {
+    const state = enqueue(emptyOutbox(), "event-1");
+    const unknown = planEvidenceOutboxCommand(state, {
+      type: "delete",
+      operationId: "malicious-delete",
+      expectedRevision: state.revision,
+      acknowledgements: [ackFor(state, 1)],
+    } as unknown as EvidenceOutboxCommand);
+    const malformedEnqueue = planEvidenceOutboxCommand(state, {
+      type: "enqueue",
+      operationId: "missing-event",
+      expectedRevision: state.revision,
+    } as unknown as EvidenceOutboxCommand);
+    const malformedAcknowledgement = planEvidenceOutboxCommand(state, {
+      type: "acknowledge",
+      operationId: "missing-acknowledgements",
+      expectedRevision: state.revision,
+    } as unknown as EvidenceOutboxCommand);
+    for (const result of [
+      unknown,
+      malformedEnqueue,
+      malformedAcknowledgement,
+    ]) {
+      expect(result).toMatchObject({
+        status: "rejected",
+        rejection: { code: "invalid-command" },
+      });
+      expect(result.state).toBe(state);
+    }
+    expect(state.pending).toHaveLength(1);
+  });
+
+  it("rejects stale mutations and fail-closes corrupt persisted state", () => {
+    const state = emptyOutbox();
+    const event = preparedEvent(state, "event-1");
+    const stale = planEvidenceOutboxCommand(state, {
+      ...enqueueCommand(state, event),
+      expectedRevision: 2,
+    });
+    const corrupt = { ...state, nextSequence: 2 } as EvidenceOutbox;
+    const corruptResult = planEvidenceOutboxCommand(
+      corrupt,
+      enqueueCommand(corrupt, event),
+    );
+    expect(stale).toMatchObject({
+      status: "rejected",
+      rejection: { code: "revision-mismatch" },
+    });
+    expect(corruptResult).toMatchObject({
+      status: "rejected",
+      rejection: { code: "invalid-outbox" },
+    });
+  });
+
+  it("rejects invalid identity and capacities instead of creating a lossy queue", () => {
+    expect(
+      createEvidenceOutbox({
+        identity: { ...identity, releaseId: "" },
+        capacity: 2,
+        tombstoneCapacity: 2,
+      }),
+    ).toMatchObject({ status: "rejected", reason: "invalid-identity" });
+    expect(
+      createEvidenceOutbox({ identity, capacity: 0, tombstoneCapacity: 2 }),
+    ).toMatchObject({ status: "rejected", reason: "invalid-capacity" });
+    expect(
+      createEvidenceOutbox({ identity, capacity: 2, tombstoneCapacity: 0 }),
+    ).toMatchObject({
+      status: "rejected",
+      reason: "invalid-tombstone-capacity",
+    });
+    expect(
+      createEvidenceOutbox({
+        identity,
+        capacity: evidenceOutboxMaximumPendingEvents + 1,
+        tombstoneCapacity: 2,
+      }),
+    ).toMatchObject({ status: "rejected", reason: "invalid-capacity" });
+    expect(
+      createEvidenceOutbox({
+        identity,
+        capacity: 2,
+        tombstoneCapacity: evidenceOutboxMaximumAcknowledgedTombstones + 1,
+      }),
+    ).toMatchObject({
+      status: "rejected",
+      reason: "invalid-tombstone-capacity",
+    });
+  });
+
+  it("exposes the pending-write plan type only for explicit settlement", () => {
+    const state = emptyOutbox();
+    const event = preparedEvent(state, "event-1");
+    const plan = planEvidenceOutboxCommand(state, enqueueCommand(state, event));
+    expect(plan.status).toBe("write-required");
+    const typedPlan: EvidenceOutboxWritePlan | null =
+      plan.status === "write-required" ? plan : null;
+    expect(typedPlan?.operationId).toBe(`enqueue-${event.eventId}`);
+  });
+});
diff --git a/packages/domain/tests/lock-lifecycle.test.ts b/packages/domain/tests/lock-lifecycle.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..02ba8de653aee6de5b1ce40d9c1f4e3375dd8646
--- /dev/null
+++ b/packages/domain/tests/lock-lifecycle.test.ts
@@ -0,0 +1,589 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  createLockLifecycle,
+  initializeLockLifecycle,
+  lockEngagementProtections,
+  reduceLockLifecycle,
+  settleLockLifecycleWrite,
+  type EngagementProtection,
+  type LockIdentity,
+  type LockLifecycleCommand,
+  type LockLifecycleState,
+} from "../src/index.js";
+
+const identity: LockIdentity = {
+  schoolId: "school-1",
+  testId: "test-1",
+  studentSessionId: "student-session-1",
+  deviceSessionId: "device-session-1",
+};
+
+type LockLifecycleCommandInput = LockLifecycleCommand extends infer Command
+  ? Command extends LockLifecycleCommand
+    ? Omit<Command, "expectedRevision" | "identity" | "transitionId">
+    : never
+  : never;
+
+function command(
+  state: LockLifecycleState,
+  value: LockLifecycleCommandInput,
+  transitionId = `transition-${state.revision + 1}`,
+): LockLifecycleCommand {
+  return {
+    ...value,
+    expectedRevision: state.revision,
+    identity,
+    transitionId,
+  } as LockLifecycleCommand;
+}
+
+function accept(
+  state: LockLifecycleState,
+  value: LockLifecycleCommandInput,
+  transitionId?: string,
+): LockLifecycleState {
+  const result = reduceLockLifecycle(
+    state,
+    command(state, value, transitionId),
+  );
+  if (result.status === "write-required") {
+    return settleLockLifecycleWrite(result, { status: "stored" }).state;
+  }
+  if (result.status === "rejected") {
+    throw new Error(`transition rejected: ${result.rejection.code}`);
+  }
+  return result.state;
