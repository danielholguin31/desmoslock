diff --git a/packages/domain/src/lock-lifecycle.ts b/packages/domain/src/lock-lifecycle.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a68a4c66cc27063f53c76b9057a3ddcb28b3ed3b
--- /dev/null
+++ b/packages/domain/src/lock-lifecycle.ts
@@ -0,0 +1,734 @@
+export const lockEngagementProtections = [
+  "shortcut-registration",
+  "application-scan",
+  "persistence",
+  "window",
+  "network",
+] as const;
+
+export type EngagementProtection = (typeof lockEngagementProtections)[number];
+
+export interface LockIdentity {
+  readonly schoolId: string;
+  readonly testId: string;
+  readonly studentSessionId: string;
+  readonly deviceSessionId: string;
+}
+
+export interface EngagementProof {
+  readonly protection: EngagementProtection;
+  readonly proofId: string;
+}
+
+interface LockLifecycleBase {
+  readonly schemaVersion: 1;
+  readonly identity: LockIdentity;
+  readonly revision: number;
+  readonly appliedTransitionIds: readonly string[];
+}
+
+export interface LockPreflightState extends LockLifecycleBase {
+  readonly phase: "preflight";
+}
+
+export interface LockEngagingState extends LockLifecycleBase {
+  readonly phase: "engaging";
+  readonly confirmedProtections: readonly EngagementProof[];
+}
+
+export interface LockLockedState extends LockLifecycleBase {
+  readonly phase: "locked";
+  readonly engagementProofs: readonly EngagementProof[];
+}
+
+export type LockRecoveryReason =
+  | "application-crash"
+  | "backend-outage"
+  | "corrupt-state"
+  | "engagement-failure"
+  | "identity-mismatch"
+  | "incompatible-state"
+  | "lease-untrusted"
+  | "operating-system-reboot"
+  | "partial-state"
+  | "persistence-write-failure"
+  | "process-crash"
+  | "renderer-reload"
+  | "startup-interrupted";
+
+export interface LockRecoveryState extends LockLifecycleBase {
+  readonly phase: "recovery";
+  readonly reason: LockRecoveryReason;
+  readonly lastKnownPhase: LockLifecycleState["phase"] | "unknown";
+  readonly confirmedProtections: readonly EngagementProof[];
+  readonly failure?:
+    | {
+        readonly kind: "engagement-protection";
+        readonly protection: EngagementProtection;
+        readonly code: string;
+      }
+    | {
+        readonly kind: "persistence-write";
+        readonly code: string;
+      };
+}
+
+export type ReleaseAuthorization =
+  | {
+      readonly kind: "teacher-capability";
+      readonly authorizationId: string;
+      readonly identity: LockIdentity;
+      readonly provenance: {
+        readonly kind: "validated-server-capability";
+        readonly issuer: "desmoslock-backend";
+        readonly capabilityId: string;
+      };
+    }
+  | {
+      readonly kind: "documented-emergency-action";
+      readonly actionId: string;
+      readonly identity: LockIdentity;
+      readonly provenance: {
+        readonly kind: "trusted-local-procedure";
+        readonly procedureId: string;
+        readonly invocationId: string;
+      };
+    };
+
+export interface LockReleasingState extends LockLifecycleBase {
+  readonly phase: "releasing";
+  readonly authorization: ReleaseAuthorization;
+}
+
+export interface LocalReleaseProof {
+  readonly persistenceClearedProofId: string;
+  readonly shortcutsRestoredProofId: string;
+  readonly windowReleasedProofId: string;
+  readonly networkRestoredProofId: string;
+}
+
+export interface LockReleasedState extends LockLifecycleBase {
+  readonly phase: "released";
+  readonly authorization: ReleaseAuthorization;
+  readonly releaseProof: LocalReleaseProof;
+}
+
+export interface LockTerminalFailureState extends LockLifecycleBase {
+  readonly phase: "terminal-failure";
+  readonly failureCode: string;
+  readonly lockDisposition: "not-engaged" | "unknown-must-recover";
+}
+
+export type LockLifecycleState =
+  | LockPreflightState
+  | LockEngagingState
+  | LockLockedState
+  | LockRecoveryState
+  | LockReleasingState
+  | LockReleasedState
+  | LockTerminalFailureState;
+
+interface LockLifecycleCommandBase {
+  readonly identity: LockIdentity;
+  readonly expectedRevision: number;
+  readonly transitionId: string;
+}
+
+export type LockLifecycleCommand =
+  | (LockLifecycleCommandBase & { readonly type: "begin-engagement" })
+  | (LockLifecycleCommandBase & {
+      readonly type: "confirm-protection";
+      readonly proof: EngagementProof;
+    })
+  | (LockLifecycleCommandBase & {
+      readonly type: "report-engagement-failure";
+      readonly protection: EngagementProtection;
+      readonly failureCode: string;
+    })
+  | (LockLifecycleCommandBase & {
+      readonly type: "request-recovery";
+      readonly reason: Exclude<
+        LockRecoveryReason,
+        | "corrupt-state"
+        | "engagement-failure"
+        | "identity-mismatch"
+        | "incompatible-state"
+        | "partial-state"
+        | "persistence-write-failure"
+        | "startup-interrupted"
+      >;
+    })
+  | (LockLifecycleCommandBase & {
+      readonly type: "authorize-release";
+      readonly authorization: ReleaseAuthorization;
+    })
+  | (LockLifecycleCommandBase & {
+      readonly type: "confirm-release";
+      readonly proof: LocalReleaseProof;
+    })
+  | (LockLifecycleCommandBase & {
+      readonly type: "declare-terminal-failure";
+      readonly failureCode: string;
+    });
+
+export type LockLifecycleRejectionCode =
+  | "duplicate-protection"
+  | "identity-mismatch"
+  | "invalid-command"
+  | "invalid-transition"
+  | "proof-id-collision"
+  | "release-authority-mismatch"
+  | "revision-mismatch"
+  | "transition-replay";
+
+export type LockEngagementOutcome =
+  | "not-confirmed"
+  | "pending-durability"
+  | "confirmed"
+  | "recovery-required"
+  | "released";
+
+export interface LockLifecycleWritePlan {
+  readonly status: "write-required";
+  readonly previousState: LockEngagingState | LockRecoveryState;
+  readonly state: LockLockedState;
+  readonly engagement: "pending-durability";
+  readonly transitionId: string;
+}
+
+export type LockLifecycleTransition =
+  | {
+      readonly status: "accepted";
+      readonly state: LockLifecycleState;
+      readonly engagement: LockEngagementOutcome;
+    }
+  | {
+      readonly status: "rejected";
+      readonly state: LockLifecycleState;
+      readonly engagement: LockEngagementOutcome;
+      readonly rejection: {
+        readonly code: LockLifecycleRejectionCode;
+      };
+    }
+  | LockLifecycleWritePlan;
+
+export type LockLifecycleWriteOutcome =
+  | { readonly status: "stored" }
+  | { readonly status: "failed"; readonly failureCode: string };
+
+export type LockLifecycleWriteResult =
+  | {
+      readonly status: "accepted";
+      readonly state: LockLockedState;
+      readonly engagement: "confirmed";
+    }
+  | {
+      readonly status: "write-failed";
+      readonly state: LockRecoveryState;
+      readonly engagement: "recovery-required";
+      readonly failure: {
+        readonly code: "storage-write-failed";
+        readonly cause: string;
+      };
+    };
+
+export type LockStartupRecord =
+  | { readonly kind: "absent" }
+  | { readonly kind: "corrupt" }
+  | { readonly kind: "partial" }
+  | { readonly kind: "incompatible" }
+  | { readonly kind: "verified"; readonly state: LockLifecycleState };
+
+function hasText(value: string): boolean {
+  return value.trim().length > 0;
+}
+
+function isRecord(value: unknown): value is Readonly<Record<string, unknown>> {
+  return typeof value === "object" && value !== null;
+}
+
+function isRuntimeLockIdentity(value: unknown): value is LockIdentity {
+  return (
+    isRecord(value) &&
+    typeof value.schoolId === "string" &&
+    typeof value.testId === "string" &&
+    typeof value.studentSessionId === "string" &&
+    typeof value.deviceSessionId === "string" &&
+    hasText(value.schoolId) &&
+    hasText(value.testId) &&
+    hasText(value.studentSessionId) &&
+    hasText(value.deviceSessionId)
+  );
+}
+
+function isIdentityValid(identity: LockIdentity): boolean {
+  return (
+    hasText(identity.schoolId) &&
+    hasText(identity.testId) &&
+    hasText(identity.studentSessionId) &&
+    hasText(identity.deviceSessionId)
+  );
+}
+
+function identitiesMatch(left: LockIdentity, right: LockIdentity): boolean {
+  return (
+    left.schoolId === right.schoolId &&
+    left.testId === right.testId &&
+    left.studentSessionId === right.studentSessionId &&
+    left.deviceSessionId === right.deviceSessionId
+  );
+}
+
+function engagementFor(state: LockLifecycleState): LockEngagementOutcome {
+  switch (state.phase) {
+    case "locked":
+    case "releasing":
+      return "confirmed";
+    case "recovery":
+      return "recovery-required";
+    case "released":
+      return "released";
+    case "engaging":
+    case "preflight":
+    case "terminal-failure":
+      return "not-confirmed";
+  }
+}
+
+function reject(
+  state: LockLifecycleState,
+  code: LockLifecycleRejectionCode,
+): LockLifecycleTransition {
+  return {
+    status: "rejected",
+    state,
+    engagement: engagementFor(state),
+    rejection: { code },
+  };
+}
+
+function nextBase(
+  state: LockLifecycleState,
+  command: LockLifecycleCommand,
+): LockLifecycleBase {
+  return {
+    schemaVersion: 1,
+    identity: state.identity,
+    revision: state.revision + 1,
+    appliedTransitionIds: [...state.appliedTransitionIds, command.transitionId],
+  };
+}
+
+function accepted(state: LockLifecycleState): LockLifecycleTransition {
+  return {
+    status: "accepted",
+    state,
+    engagement: engagementFor(state),
+  };
+}
+
+function orderedProofs(
+  proofs: readonly EngagementProof[],
+): readonly EngagementProof[] {
+  return lockEngagementProtections.flatMap((protection) => {
+    const proof = proofs.find(
+      (candidate) => candidate.protection === protection,
+    );
+    return proof === undefined ? [] : [proof];
+  });
+}
+
+function isEngagementProtection(value: unknown): value is EngagementProtection {
+  return lockEngagementProtections.some((protection) => protection === value);
+}
+
+const commandRecoveryReasons = [
+  "application-crash",
+  "backend-outage",
+  "lease-untrusted",
+  "operating-system-reboot",
+  "process-crash",
+  "renderer-reload",
+] as const;
+
+function isCommandRecoveryReason(
+  value: unknown,
+): value is (typeof commandRecoveryReasons)[number] {
+  return commandRecoveryReasons.some((reason) => reason === value);
+}
+
+function isReleaseProofValid(proof: unknown): proof is LocalReleaseProof {
+  if (!isRecord(proof)) return false;
+  const ids = [
+    proof.persistenceClearedProofId,
+    proof.shortcutsRestoredProofId,
+    proof.windowReleasedProofId,
+    proof.networkRestoredProofId,
+  ];
+  return (
+    ids.every((value) => typeof value === "string" && hasText(value)) &&
+    new Set(ids).size === ids.length
+  );
+}
+
+function isReleaseAuthorizationValid(
+  authorization: unknown,
+  identity: LockIdentity,
+): boolean {
+  if (
+    !isRecord(authorization) ||
+    !isRuntimeLockIdentity(authorization.identity) ||
+    !identitiesMatch(authorization.identity, identity) ||
+    !isRecord(authorization.provenance)
+  ) {
+    return false;
+  }
+  switch (authorization.kind) {
+    case "teacher-capability":
+      return (
+        typeof authorization.authorizationId === "string" &&
+        hasText(authorization.authorizationId) &&
+        authorization.provenance.kind === "validated-server-capability" &&
+        authorization.provenance.issuer === "desmoslock-backend" &&
+        authorization.provenance.capabilityId === authorization.authorizationId
+      );
+    case "documented-emergency-action":
+      return (
+        typeof authorization.actionId === "string" &&
+        hasText(authorization.actionId) &&
+        authorization.provenance.kind === "trusted-local-procedure" &&
+        typeof authorization.provenance.procedureId === "string" &&
+        hasText(authorization.provenance.procedureId) &&
+        authorization.provenance.invocationId === authorization.actionId
+      );
+    default:
+      return false;
+  }
+}
+
+function releaseAuthorizationHasShape(value: unknown): boolean {
+  if (
+    !isRecord(value) ||
+    !isRuntimeLockIdentity(value.identity) ||
+    !isRecord(value.provenance)
+  ) {
+    return false;
+  }
+  switch (value.kind) {
+    case "teacher-capability":
+      return (
+        typeof value.authorizationId === "string" &&
+        hasText(value.authorizationId) &&
+        typeof value.provenance.kind === "string" &&
+        typeof value.provenance.issuer === "string" &&
+        typeof value.provenance.capabilityId === "string"
+      );
+    case "documented-emergency-action":
+      return (
+        typeof value.actionId === "string" &&
+        hasText(value.actionId) &&
+        typeof value.provenance.kind === "string" &&
+        typeof value.provenance.procedureId === "string" &&
+        typeof value.provenance.invocationId === "string"
+      );
+    default:
+      return false;
+  }
+}
+
+function lockLifecycleCommandIsValid(
+  value: unknown,
+): value is LockLifecycleCommand {
+  if (
+    !isRecord(value) ||
+    !isRuntimeLockIdentity(value.identity) ||
+    typeof value.transitionId !== "string" ||
+    !hasText(value.transitionId) ||
+    typeof value.expectedRevision !== "number" ||
+    !Number.isSafeInteger(value.expectedRevision) ||
+    value.expectedRevision < 0
+  ) {
+    return false;
+  }
+  switch (value.type) {
+    case "begin-engagement":
+      return true;
+    case "confirm-protection":
+      return (
+        isRecord(value.proof) &&
+        isEngagementProtection(value.proof.protection) &&
+        typeof value.proof.proofId === "string" &&
+        hasText(value.proof.proofId)
+      );
+    case "report-engagement-failure":
+      return (
+        isEngagementProtection(value.protection) &&
+        typeof value.failureCode === "string" &&
+        hasText(value.failureCode)
+      );
+    case "request-recovery":
+      return isCommandRecoveryReason(value.reason);
+    case "authorize-release":
+      return releaseAuthorizationHasShape(value.authorization);
+    case "confirm-release":
+      return isReleaseProofValid(value.proof);
+    case "declare-terminal-failure":
+      return (
+        typeof value.failureCode === "string" && hasText(value.failureCode)
+      );
+    default:
+      return false;
+  }
+}
+
+export function createLockLifecycle(
+  identity: LockIdentity,
+): LockPreflightState {
+  if (!isIdentityValid(identity)) {
+    throw new Error("Lock lifecycle identity is malformed");
+  }
+  return {
+    schemaVersion: 1,
+    identity,
+    phase: "preflight",
+    revision: 0,
+    appliedTransitionIds: [],
+  };
+}
+
+export function initializeLockLifecycle(
+  identity: LockIdentity,
+  record: LockStartupRecord,
+): LockLifecycleState {
+  const fresh = createLockLifecycle(identity);
+  if (record.kind === "absent") return fresh;
+
+  if (record.kind === "verified") {
+    if (!identitiesMatch(record.state.identity, identity)) {
+      return {
+        ...fresh,
+        phase: "recovery",
+        reason: "identity-mismatch",
+        lastKnownPhase: record.state.phase,
+        confirmedProtections: [],
+      };
+    }
+    if (
+      record.state.phase === "released" ||
+      (record.state.phase === "terminal-failure" &&
+        record.state.lockDisposition === "not-engaged")
+    ) {
+      return record.state;
+    }
+    return {
+      schemaVersion: 1,
+      identity,
+      phase: "recovery",
+      revision: record.state.revision + 1,
+      appliedTransitionIds: record.state.appliedTransitionIds,
+      reason: "startup-interrupted",
+      lastKnownPhase: record.state.phase,
+      confirmedProtections: [],
+    };
+  }
+
+  const reason = {
+    corrupt: "corrupt-state",
+    partial: "partial-state",
+    incompatible: "incompatible-state",
+  }[record.kind] as Extract<
+    LockRecoveryReason,
+    "corrupt-state" | "partial-state" | "incompatible-state"
+  >;
+  return {
+    ...fresh,
+    phase: "recovery",
+    reason,
+    lastKnownPhase: "unknown",
+    confirmedProtections: [],
+  };
+}
+
+export function reduceLockLifecycle(
+  state: LockLifecycleState,
+  command: LockLifecycleCommand,
+): LockLifecycleTransition {
+  if (!lockLifecycleCommandIsValid(command)) {
+    return reject(state, "invalid-command");
+  }
+  if (!identitiesMatch(state.identity, command.identity)) {
+    return reject(state, "identity-mismatch");
+  }
+  if (state.appliedTransitionIds.includes(command.transitionId)) {
+    return reject(state, "transition-replay");
+  }
+  if (state.revision !== command.expectedRevision) {
+    return reject(state, "revision-mismatch");
+  }
+  switch (command.type) {
+    case "begin-engagement": {
+      if (state.phase !== "preflight") {
+        return reject(state, "invalid-transition");
+      }
+      return accepted({
+        ...nextBase(state, command),
+        phase: "engaging",
+        confirmedProtections: [],
+      });
+    }
+    case "confirm-protection": {
+      if (state.phase !== "engaging" && state.phase !== "recovery") {
+        return reject(state, "invalid-transition");
+      }
+      if (
+        state.confirmedProtections.some(
+          (proof) => proof.protection === command.proof.protection,
+        )
+      ) {
+        return reject(state, "duplicate-protection");
+      }
+      if (
+        state.confirmedProtections.some(
+          (proof) => proof.proofId === command.proof.proofId,
+        )
+      ) {
+        return reject(state, "proof-id-collision");
+      }
+      const confirmedProtections = orderedProofs([
+        ...state.confirmedProtections,
+        command.proof,
+      ]);
+      if (confirmedProtections.length === lockEngagementProtections.length) {
+        return {
+          status: "write-required",
+          previousState: state,
+          state: {
+            ...nextBase(state, command),
+            phase: "locked",
+            engagementProofs: confirmedProtections,
+          },
+          engagement: "pending-durability",
+          transitionId: command.transitionId,
+        };
+      }
+      if (state.phase === "engaging") {
+        return accepted({
+          ...nextBase(state, command),
+          phase: "engaging",
+          confirmedProtections,
+        });
+      }
+      return accepted({
+        ...nextBase(state, command),
+        phase: "recovery",
+        reason: state.reason,
+        lastKnownPhase: state.lastKnownPhase,
+        confirmedProtections,
+        ...(state.failure === undefined ? {} : { failure: state.failure }),
+      });
+    }
+    case "report-engagement-failure": {
+      if (state.phase !== "engaging") {
+        return reject(state, "invalid-transition");
+      }
+      return accepted({
+        ...nextBase(state, command),
+        phase: "recovery",
+        reason: "engagement-failure",
+        lastKnownPhase: state.phase,
+        confirmedProtections: [],
+        failure: {
+          kind: "engagement-protection",
+          protection: command.protection,
+          code: command.failureCode,
+        },
+      });
+    }
+    case "request-recovery": {
+      if (
+        state.phase !== "engaging" &&
+        state.phase !== "locked" &&
+        state.phase !== "releasing"
+      ) {
+        return reject(state, "invalid-transition");
+      }
+      return accepted({
+        ...nextBase(state, command),
+        phase: "recovery",
+        reason: command.reason,
+        lastKnownPhase: state.phase,
+        confirmedProtections: [],
+      });
+    }
+    case "authorize-release": {
+      if (state.phase !== "locked" && state.phase !== "recovery") {
+        return reject(state, "invalid-transition");
+      }
+      if (!isReleaseAuthorizationValid(command.authorization, state.identity)) {
+        return reject(state, "release-authority-mismatch");
+      }
+      return accepted({
+        ...nextBase(state, command),
+        phase: "releasing",
+        authorization: command.authorization,
+      });
+    }
+    case "confirm-release": {
+      if (state.phase !== "releasing") {
+        return reject(state, "invalid-transition");
+      }
+      return accepted({
+        ...nextBase(state, command),
+        phase: "released",
+        authorization: state.authorization,
+        releaseProof: command.proof,
+      });
+    }
+    case "declare-terminal-failure": {
+      if (state.phase !== "preflight" && state.phase !== "recovery") {
+        return reject(state, "invalid-transition");
+      }
+      return accepted({
+        ...nextBase(state, command),
+        phase: "terminal-failure",
+        failureCode: command.failureCode,
+        lockDisposition:
+          state.phase === "preflight" ? "not-engaged" : "unknown-must-recover",
+      });
+    }
+    default:
+      return reject(state, "invalid-command");
+  }
+}
+
+export function settleLockLifecycleWrite(
+  plan: LockLifecycleWritePlan,
+  outcome: LockLifecycleWriteOutcome,
+): LockLifecycleWriteResult {
+  if (outcome.status === "stored") {
+    return {
+      status: "accepted",
+      state: plan.state,
+      engagement: "confirmed",
+    };
+  }
+  const cause = hasText(outcome.failureCode)
+    ? outcome.failureCode
+    : "unspecified";
+  return {
+    status: "write-failed",
+    state: {
+      schemaVersion: 1,
+      identity: plan.previousState.identity,
+      phase: "recovery",
+      revision: plan.previousState.revision,
+      appliedTransitionIds: plan.previousState.appliedTransitionIds,
+      reason: "persistence-write-failure",
+      lastKnownPhase: plan.previousState.phase,
+      confirmedProtections: [],
+      failure: { kind: "persistence-write", code: cause },
+    },
+    engagement: "recovery-required",
+    failure: { code: "storage-write-failed", cause },
+  };
+}
diff --git a/packages/domain/src/offline-lease.ts b/packages/domain/src/offline-lease.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f872a8eefe34e494c8fba4e9fbcfa7d9ad2eb2cf
--- /dev/null
+++ b/packages/domain/src/offline-lease.ts
@@ -0,0 +1,696 @@
+import type { LockIdentity } from "./lock-lifecycle.js";
+
+export const offlineLeaseAuthorizationFreshnessMaximumMilliseconds = 60_000;
+export const offlineLeaseAuthorizationLedgerMaximumEntries = 1_024;
+
+export interface OfflineLeaseObservation {
+  readonly identity: LockIdentity;
+  readonly bootId: string;
+  readonly monotonicMilliseconds: number;
+  readonly trust: "trusted" | "untrusted";
+  /** Deliberately excluded from all lease calculations. */
+  readonly wallClockMilliseconds?: number;
+}
+
+/**
+ * A client-generated, single-use challenge sent to the authorization server.
+ * The server-signed authorization claims must contain this complete value.
+ */
+export interface OfflineLeaseAuthorizationChallenge {
+  readonly schemaVersion: 1;
+  readonly challengeId: string;
+  readonly identity: LockIdentity;
+  readonly bootId: string;
+  readonly monotonicRequestedMilliseconds: number;
+}
+
+/**
+ * Output of the trusted signature-verification adapter. The adapter may produce
+ * this tag only after verifying that the signature covers all `claims`,
+ * including the complete client challenge.
+ */
+export interface TrustedOfflineLeaseAuthorization {
+  readonly verification: {
+    readonly status: "trusted";
+    readonly kind: "verified-server-signature";
+    readonly issuer: "desmoslock-backend";
+    readonly keyId: string;
+    readonly signatureId: string;
+  };
+  readonly claims: {
+    readonly schemaVersion: 1;
+    readonly authorizationId: string;
+    readonly challenge: OfflineLeaseAuthorizationChallenge;
+    readonly serverAuthorizedAtMilliseconds: number;
+    readonly serverObservedAtMilliseconds: number;
+    readonly serverExpiresAtMilliseconds: number;
+  };
+}
+
+/** Durable, independent replay protection for server authorizations. */
+export interface OfflineLeaseAuthorizationLedger {
+  readonly schemaVersion: 1;
+  readonly identity: LockIdentity;
+  readonly revision: number;
+  readonly consumedAuthorizationIds: readonly string[];
+}
+
+export interface OfflineLease {
+  readonly schemaVersion: 1;
+  readonly identity: LockIdentity;
+  readonly authorizationId: string;
+  readonly challengeId: string;
+  readonly serverAuthorizedAtMilliseconds: number;
+  readonly serverObservedAtMilliseconds: number;
+  readonly serverExpiresAtMilliseconds: number;
+  /** Conservative request-to-verification elapsed evidence. */
+  readonly authorizationRoundTripElapsedMilliseconds: number;
+  readonly authorizedRemainingDurationMilliseconds: number;
+  readonly bootId: string;
+  readonly monotonicRequestedMilliseconds: number;
+  readonly monotonicStartedMilliseconds: number;
+  readonly monotonicLastObservedMilliseconds: number;
+}
+
+export interface OfflineLeaseAuthorizationRequest {
+  readonly ledger: OfflineLeaseAuthorizationLedger;
+  readonly authorization: TrustedOfflineLeaseAuthorization;
+  readonly observation: OfflineLeaseObservation;
+}
+
+/** Compatibility name for the now ledger-backed authorization request. */
+export type OfflineLeaseAuthorization = OfflineLeaseAuthorizationRequest;
+
+export type OfflineLeaseAuthorizationRejectionReason =
+  | "authorization-history-exhausted"
+  | "authorization-replay"
+  | "expired-server-authorization"
+  | "identity-mismatch"
+  | "invalid-authorization-challenge"
+  | "invalid-authorization-id"
+  | "invalid-authorization-ledger"
+  | "invalid-boot-identity"
+  | "invalid-monotonic-evidence"
+  | "invalid-server-authorization"
+  | "stale-authorization-response"
+  | "stale-server-authorization"
+  | "untrusted-authorization-verification"
+  | "untrusted-time-evidence";
+
+export interface OfflineLeaseAuthorizationWritePlan {
+  readonly status: "write-required";
+  readonly expectedLedgerRevision: number;
+  readonly previousLedger: OfflineLeaseAuthorizationLedger;
+  readonly ledger: OfflineLeaseAuthorizationLedger;
+  /** This is not an accepted lease until the ledger CAS is settled. */
+  readonly leaseCandidate: OfflineLease;
+}
+
+export type OfflineLeaseAuthorizationPlan =
+  | OfflineLeaseAuthorizationWritePlan
+  | {
+      readonly status: "rejected";
+      readonly reason: OfflineLeaseAuthorizationRejectionReason;
+    };
+
+/** Compatibility name; authorization now deliberately returns a write plan. */
+export type OfflineLeaseCreation = OfflineLeaseAuthorizationPlan;
+
+export type OfflineLeaseAuthorizationWriteOutcome =
+  | {
+      readonly status: "committed";
+      readonly expectedRevision: number;
+      readonly ledger: OfflineLeaseAuthorizationLedger;
+    }
+  | { readonly status: "conflict"; readonly actualRevision: number }
+  | { readonly status: "failed"; readonly failureCode: string };
+
+export type OfflineLeaseAuthorizationWriteResult =
+  | {
+      readonly status: "accepted";
+      readonly lease: OfflineLease;
+      readonly ledger: OfflineLeaseAuthorizationLedger;
+    }
+  | {
+      readonly status: "write-failed";
+      readonly lease: null;
+      readonly ledger: OfflineLeaseAuthorizationLedger;
+      readonly failure: {
+        readonly code:
+          | "authorization-ledger-cas-conflict"
+          | "authorization-ledger-write-failed";
+        readonly cause: string;
+      };
+    };
+
+export type OfflineLeaseRecoveryReason =
+  | "boot-identity-changed"
+  | "identity-mismatch"
+  | "invalid-lease"
+  | "invalid-monotonic-evidence"
+  | "monotonic-regression"
+  | "untrusted-time-evidence";
+
+export type OfflineLeaseEvaluation =
+  | {
+      readonly status: "active";
+      readonly lease: OfflineLease;
+      readonly elapsedMilliseconds: number;
+      readonly remainingMilliseconds: number;
+    }
+  | {
+      readonly status: "expired";
+      readonly lease: OfflineLease;
+      readonly elapsedMilliseconds: number;
+    }
+  | {
+      readonly status: "recovery";
+      readonly lease: OfflineLease;
+      readonly reason: OfflineLeaseRecoveryReason;
+    };
+
+export type OfflineLeaseChallengeCreation =
+  | {
+      readonly status: "created";
+      readonly challenge: OfflineLeaseAuthorizationChallenge;
+    }
+  | {
+      readonly status: "rejected";
+      readonly reason:
+        | "identity-mismatch"
+        | "invalid-boot-identity"
+        | "invalid-challenge-id"
+        | "invalid-identity"
+        | "invalid-monotonic-evidence"
+        | "untrusted-time-evidence";
+    };
+
+export type OfflineLeaseAuthorizationLedgerCreation =
+  | {
+      readonly status: "created";
+      readonly ledger: OfflineLeaseAuthorizationLedger;
+    }
+  | { readonly status: "rejected"; readonly reason: "invalid-identity" };
+
+function hasText(value: string): boolean {
+  return value.trim().length > 0;
+}
+
+function isRecord(value: unknown): value is Readonly<Record<string, unknown>> {
+  return typeof value === "object" && value !== null;
+}
+
+function isRuntimeLockIdentity(value: unknown): value is LockIdentity {
+  return (
+    isRecord(value) &&
+    typeof value.schoolId === "string" &&
+    typeof value.testId === "string" &&
+    typeof value.studentSessionId === "string" &&
+    typeof value.deviceSessionId === "string" &&
+    hasText(value.schoolId) &&
+    hasText(value.testId) &&
+    hasText(value.studentSessionId) &&
+    hasText(value.deviceSessionId)
+  );
+}
+
+function copyIdentity(identity: LockIdentity): LockIdentity {
+  return {
+    schoolId: identity.schoolId,
+    testId: identity.testId,
+    studentSessionId: identity.studentSessionId,
+    deviceSessionId: identity.deviceSessionId,
+  };
+}
+
+function identitiesMatch(left: LockIdentity, right: LockIdentity): boolean {
+  return (
+    left.schoolId === right.schoolId &&
+    left.testId === right.testId &&
+    left.studentSessionId === right.studentSessionId &&
+    left.deviceSessionId === right.deviceSessionId
+  );
+}
+
+function isNonnegativeSafeInteger(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+}
+
+function isDenseTextArray(value: unknown): value is readonly string[] {
+  if (
+    !Array.isArray(value) ||
+    value.length > offlineLeaseAuthorizationLedgerMaximumEntries ||
+    Object.getOwnPropertySymbols(value).length > 0
+  ) {
+    return false;
+  }
+  const descriptors = Object.getOwnPropertyDescriptors(value);
+  if (Object.keys(descriptors).length !== value.length + 1) return false;
+  for (let index = 0; index < value.length; index += 1) {
+    const descriptor = descriptors[String(index)];
+    if (
+      descriptor === undefined ||
+      !descriptor.enumerable ||
+      !("value" in descriptor) ||
+      typeof descriptor.value !== "string" ||
+      !hasText(descriptor.value)
+    ) {
+      return false;
+    }
+  }
+  return true;
+}
+
+function ledgerIsValid(
+  value: unknown,
+): value is OfflineLeaseAuthorizationLedger {
+  if (
+    !isRecord(value) ||
+    value.schemaVersion !== 1 ||
+    !isRuntimeLockIdentity(value.identity) ||
+    !isNonnegativeSafeInteger(value.revision) ||
+    !isDenseTextArray(value.consumedAuthorizationIds)
+  ) {
+    return false;
+  }
+  const consumedAuthorizationIds = value.consumedAuthorizationIds;
+  return (
+    value.revision === consumedAuthorizationIds.length &&
+    new Set(consumedAuthorizationIds).size === consumedAuthorizationIds.length
+  );
+}
+
+function challengeIsValid(
+  value: unknown,
+): value is OfflineLeaseAuthorizationChallenge {
+  return (
+    isRecord(value) &&
+    value.schemaVersion === 1 &&
+    typeof value.challengeId === "string" &&
+    hasText(value.challengeId) &&
+    isRuntimeLockIdentity(value.identity) &&
+    typeof value.bootId === "string" &&
+    hasText(value.bootId) &&
+    isNonnegativeSafeInteger(value.monotonicRequestedMilliseconds)
+  );
+}
+
+function trustedVerificationIsValid(value: unknown): boolean {
+  return (
+    isRecord(value) &&
+    value.status === "trusted" &&
+    value.kind === "verified-server-signature" &&
+    value.issuer === "desmoslock-backend" &&
+    typeof value.keyId === "string" &&
+    hasText(value.keyId) &&
+    typeof value.signatureId === "string" &&
+    hasText(value.signatureId)
+  );
+}
+
+function serverAuthorizationIsValid(input: {
+  readonly authorizedAt: unknown;
+  readonly observedAt: unknown;
+  readonly expiresAt: unknown;
+}): input is {
+  readonly authorizedAt: number;
+  readonly observedAt: number;
+  readonly expiresAt: number;
+} {
+  return (
+    isNonnegativeSafeInteger(input.authorizedAt) &&
+    isNonnegativeSafeInteger(input.observedAt) &&
+    isNonnegativeSafeInteger(input.expiresAt) &&
+    input.observedAt >= input.authorizedAt &&
+    input.expiresAt > input.observedAt &&
+    Number.isSafeInteger(input.observedAt - input.authorizedAt) &&
+    Number.isSafeInteger(input.expiresAt - input.observedAt)
+  );
+}
+
+function leaseIsValid(value: unknown): value is OfflineLease {
+  if (
+    !isRecord(value) ||
+    value.schemaVersion !== 1 ||
+    !isRuntimeLockIdentity(value.identity) ||
+    typeof value.authorizationId !== "string" ||
+    !hasText(value.authorizationId) ||
+    typeof value.challengeId !== "string" ||
+    !hasText(value.challengeId) ||
+    typeof value.serverAuthorizedAtMilliseconds !== "number" ||
+    typeof value.serverObservedAtMilliseconds !== "number" ||
+    typeof value.serverExpiresAtMilliseconds !== "number" ||
+    !isNonnegativeSafeInteger(
+      value.authorizationRoundTripElapsedMilliseconds,
+    ) ||
+    !isNonnegativeSafeInteger(value.authorizedRemainingDurationMilliseconds) ||
+    typeof value.bootId !== "string" ||
+    !hasText(value.bootId) ||
+    !isNonnegativeSafeInteger(value.monotonicRequestedMilliseconds) ||
+    !isNonnegativeSafeInteger(value.monotonicStartedMilliseconds) ||
+    !isNonnegativeSafeInteger(value.monotonicLastObservedMilliseconds)
+  ) {
+    return false;
+  }
+  const lease = value as unknown as OfflineLease;
+  const roundTripElapsed =
+    lease.monotonicStartedMilliseconds - lease.monotonicRequestedMilliseconds;
+  const remainingAtServerObservation =
+    lease.serverExpiresAtMilliseconds - lease.serverObservedAtMilliseconds;
+  return (
+    serverAuthorizationIsValid({
+      authorizedAt: lease.serverAuthorizedAtMilliseconds,
+      observedAt: lease.serverObservedAtMilliseconds,
+      expiresAt: lease.serverExpiresAtMilliseconds,
+    }) &&
+    lease.serverObservedAtMilliseconds - lease.serverAuthorizedAtMilliseconds <=
+      offlineLeaseAuthorizationFreshnessMaximumMilliseconds &&
+    roundTripElapsed === lease.authorizationRoundTripElapsedMilliseconds &&
+    roundTripElapsed <= offlineLeaseAuthorizationFreshnessMaximumMilliseconds &&
+    lease.authorizedRemainingDurationMilliseconds ===
+      remainingAtServerObservation - roundTripElapsed &&
+    lease.authorizedRemainingDurationMilliseconds > 0 &&
+    lease.monotonicLastObservedMilliseconds >=
+      lease.monotonicStartedMilliseconds
+  );
+}
+
+function ledgersMatch(
+  left: OfflineLeaseAuthorizationLedger,
+  right: OfflineLeaseAuthorizationLedger,
+): boolean {
+  return (
+    ledgerIsValid(left) &&
+    ledgerIsValid(right) &&
+    identitiesMatch(left.identity, right.identity) &&
+    left.revision === right.revision &&
+    left.consumedAuthorizationIds.length ===
+      right.consumedAuthorizationIds.length &&
+    left.consumedAuthorizationIds.every(
+      (authorizationId, index) =>
+        authorizationId === right.consumedAuthorizationIds[index],
+    )
+  );
+}
+
+export function createOfflineLeaseAuthorizationLedger(
+  identity: LockIdentity,
+): OfflineLeaseAuthorizationLedgerCreation {
+  if (!isRuntimeLockIdentity(identity)) {
+    return { status: "rejected", reason: "invalid-identity" };
+  }
+  return {
+    status: "created",
+    ledger: {
+      schemaVersion: 1,
+      identity: copyIdentity(identity),
+      revision: 0,
+      consumedAuthorizationIds: [],
+    },
+  };
+}
+
+export function createOfflineLeaseAuthorizationChallenge(input: {
+  readonly challengeId: string;
+  readonly identity: LockIdentity;
+  readonly observation: OfflineLeaseObservation;
+}): OfflineLeaseChallengeCreation {
+  if (!isRecord(input) || !isRuntimeLockIdentity(input.identity)) {
+    return { status: "rejected", reason: "invalid-identity" };
+  }
+  if (!hasText(input.challengeId)) {
+    return { status: "rejected", reason: "invalid-challenge-id" };
+  }
+  if (
+    !isRecord(input.observation) ||
+    !isRuntimeLockIdentity(input.observation.identity)
+  ) {
+    return { status: "rejected", reason: "identity-mismatch" };
+  }
+  if (!identitiesMatch(input.identity, input.observation.identity)) {
+    return { status: "rejected", reason: "identity-mismatch" };
+  }
+  if (input.observation.trust !== "trusted") {
+    return { status: "rejected", reason: "untrusted-time-evidence" };
+  }
+  if (!hasText(input.observation.bootId)) {
+    return { status: "rejected", reason: "invalid-boot-identity" };
+  }
+  if (!isNonnegativeSafeInteger(input.observation.monotonicMilliseconds)) {
+    return { status: "rejected", reason: "invalid-monotonic-evidence" };
+  }
+  return {
+    status: "created",
+    challenge: {
+      schemaVersion: 1,
+      challengeId: input.challengeId,
+      identity: copyIdentity(input.identity),
+      bootId: input.observation.bootId,
+      monotonicRequestedMilliseconds: input.observation.monotonicMilliseconds,
+    },
+  };
+}
+
+export function planOfflineLeaseAuthorization(
+  input: OfflineLeaseAuthorizationRequest,
+): OfflineLeaseAuthorizationPlan {
+  if (!isRecord(input) || !ledgerIsValid(input.ledger)) {
+    return { status: "rejected", reason: "invalid-authorization-ledger" };
+  }
+  if (
+    !isRecord(input.authorization) ||
+    !trustedVerificationIsValid(input.authorization.verification)
+  ) {
+    return {
+      status: "rejected",
+      reason: "untrusted-authorization-verification",
+    };
+  }
+  if (!isRecord(input.authorization.claims)) {
+    return { status: "rejected", reason: "invalid-server-authorization" };
+  }
+  const claims = input.authorization.claims;
+  if (claims.schemaVersion !== 1) {
+    return { status: "rejected", reason: "invalid-server-authorization" };
+  }
+  if (
+    typeof claims.authorizationId !== "string" ||
+    !hasText(claims.authorizationId)
+  ) {
+    return { status: "rejected", reason: "invalid-authorization-id" };
+  }
+  if (!challengeIsValid(claims.challenge)) {
+    return { status: "rejected", reason: "invalid-authorization-challenge" };
+  }
+  if (!isRecord(input.observation)) {
+    return { status: "rejected", reason: "untrusted-time-evidence" };
+  }
+  if (!isRuntimeLockIdentity(input.observation.identity)) {
+    return { status: "rejected", reason: "identity-mismatch" };
+  }
+  if (
+    !identitiesMatch(input.ledger.identity, claims.challenge.identity) ||
+    !identitiesMatch(input.ledger.identity, input.observation.identity)
+  ) {
+    return { status: "rejected", reason: "identity-mismatch" };
+  }
+  if (input.observation.trust !== "trusted") {
+    return { status: "rejected", reason: "untrusted-time-evidence" };
+  }
+  if (!hasText(input.observation.bootId)) {
+    return { status: "rejected", reason: "invalid-boot-identity" };
+  }
+  if (claims.challenge.bootId !== input.observation.bootId) {
+    return { status: "rejected", reason: "invalid-authorization-challenge" };
+  }
+  if (!isNonnegativeSafeInteger(input.observation.monotonicMilliseconds)) {
+    return { status: "rejected", reason: "invalid-monotonic-evidence" };
+  }
+  if (
+    input.observation.monotonicMilliseconds <
+    claims.challenge.monotonicRequestedMilliseconds
+  ) {
+    return { status: "rejected", reason: "invalid-monotonic-evidence" };
+  }
+  const serverTimes = {
+    authorizedAt: claims.serverAuthorizedAtMilliseconds,
+    observedAt: claims.serverObservedAtMilliseconds,
+    expiresAt: claims.serverExpiresAtMilliseconds,
+  };
+  if (!serverAuthorizationIsValid(serverTimes)) {
+    return { status: "rejected", reason: "invalid-server-authorization" };
+  }
+  if (
+    serverTimes.observedAt - serverTimes.authorizedAt >
+    offlineLeaseAuthorizationFreshnessMaximumMilliseconds
+  ) {
+    return { status: "rejected", reason: "stale-server-authorization" };
+  }
+  const roundTripElapsed =
+    input.observation.monotonicMilliseconds -
+    claims.challenge.monotonicRequestedMilliseconds;
+  if (
+    roundTripElapsed > offlineLeaseAuthorizationFreshnessMaximumMilliseconds
+  ) {
+    return { status: "rejected", reason: "stale-authorization-response" };
+  }
+  if (input.ledger.consumedAuthorizationIds.includes(claims.authorizationId)) {
+    return { status: "rejected", reason: "authorization-replay" };
+  }
+  if (
+    input.ledger.consumedAuthorizationIds.length >=
+    offlineLeaseAuthorizationLedgerMaximumEntries
+  ) {
+    return { status: "rejected", reason: "authorization-history-exhausted" };
+  }
+  const remainingAtServerObservation =
+    serverTimes.expiresAt - serverTimes.observedAt;
+  const authorizedRemainingDurationMilliseconds =
+    remainingAtServerObservation - roundTripElapsed;
+  if (authorizedRemainingDurationMilliseconds <= 0) {
+    return { status: "rejected", reason: "expired-server-authorization" };
+  }
+
+  const previousLedger: OfflineLeaseAuthorizationLedger = {
+    ...input.ledger,
+    identity: copyIdentity(input.ledger.identity),
+    consumedAuthorizationIds: [...input.ledger.consumedAuthorizationIds],
+  };
+  const ledger: OfflineLeaseAuthorizationLedger = {
+    ...previousLedger,
+    revision: previousLedger.revision + 1,
+    consumedAuthorizationIds: [
+      ...previousLedger.consumedAuthorizationIds,
+      claims.authorizationId,
+    ],
+  };
+  const leaseCandidate: OfflineLease = {
+    schemaVersion: 1,
+    identity: copyIdentity(input.ledger.identity),
+    authorizationId: claims.authorizationId,
+    challengeId: claims.challenge.challengeId,
+    serverAuthorizedAtMilliseconds: serverTimes.authorizedAt,
+    serverObservedAtMilliseconds: serverTimes.observedAt,
+    serverExpiresAtMilliseconds: serverTimes.expiresAt,
+    authorizationRoundTripElapsedMilliseconds: roundTripElapsed,
+    authorizedRemainingDurationMilliseconds,
+    bootId: claims.challenge.bootId,
+    monotonicRequestedMilliseconds:
+      claims.challenge.monotonicRequestedMilliseconds,
+    monotonicStartedMilliseconds: input.observation.monotonicMilliseconds,
+    monotonicLastObservedMilliseconds: input.observation.monotonicMilliseconds,
+  };
+  return {
+    status: "write-required",
+    expectedLedgerRevision: previousLedger.revision,
+    previousLedger,
+    ledger,
+    leaseCandidate,
+  };
+}
+
+/**
+ * Compatibility entry point. Callers must settle the returned plan before
+ * treating its lease candidate as accepted.
+ */
+export function createOfflineLease(
+  input: OfflineLeaseAuthorizationRequest,
+): OfflineLeaseCreation {
+  return planOfflineLeaseAuthorization(input);
+}
+
+export function settleOfflineLeaseAuthorization(
+  plan: OfflineLeaseAuthorizationWritePlan,
+  outcome: OfflineLeaseAuthorizationWriteOutcome,
+): OfflineLeaseAuthorizationWriteResult {
+  if (
+    outcome.status === "committed" &&
+    outcome.expectedRevision === plan.expectedLedgerRevision &&
+    ledgersMatch(outcome.ledger, plan.ledger)
+  ) {
+    return {
+      status: "accepted",
+      lease: plan.leaseCandidate,
+      ledger: plan.ledger,
+    };
+  }
+  if (outcome.status === "failed") {
+    return {
+      status: "write-failed",
+      lease: null,
+      ledger: plan.previousLedger,
+      failure: {
+        code: "authorization-ledger-write-failed",
+        cause: hasText(outcome.failureCode)
+          ? outcome.failureCode
+          : "unspecified",
+      },
+    };
+  }
+  const actualRevision =
+    outcome.status === "conflict"
+      ? outcome.actualRevision
+      : outcome.ledger.revision;
+  return {
+    status: "write-failed",
+    lease: null,
+    ledger: plan.previousLedger,
+    failure: {
+      code: "authorization-ledger-cas-conflict",
+      cause: `expected revision ${plan.expectedLedgerRevision}; observed ${actualRevision}`,
+    },
+  };
+}
+
+export function evaluateOfflineLease(
+  lease: OfflineLease,
+  observation: OfflineLeaseObservation,
+): OfflineLeaseEvaluation {
+  if (!leaseIsValid(lease)) {
+    return { status: "recovery", lease, reason: "invalid-lease" };
+  }
+  if (!isRecord(observation)) {
+    return { status: "recovery", lease, reason: "untrusted-time-evidence" };
+  }
+  if (
+    !isRuntimeLockIdentity(observation.identity) ||
+    !identitiesMatch(lease.identity, observation.identity)
+  ) {
+    return { status: "recovery", lease, reason: "identity-mismatch" };
+  }
+  if (observation.trust !== "trusted") {
+    return { status: "recovery", lease, reason: "untrusted-time-evidence" };
+  }
+  if (!isNonnegativeSafeInteger(observation.monotonicMilliseconds)) {
+    return {
+      status: "recovery",
+      lease,
+      reason: "invalid-monotonic-evidence",
+    };
+  }
+  if (lease.bootId !== observation.bootId) {
+    return { status: "recovery", lease, reason: "boot-identity-changed" };
+  }
+  if (
+    observation.monotonicMilliseconds < lease.monotonicLastObservedMilliseconds
+  ) {
+    return { status: "recovery", lease, reason: "monotonic-regression" };
+  }
+
+  const elapsedMilliseconds =
+    observation.monotonicMilliseconds - lease.monotonicStartedMilliseconds;
+  const updatedLease: OfflineLease = {
+    ...lease,
+    monotonicLastObservedMilliseconds: observation.monotonicMilliseconds,
+  };
+  if (elapsedMilliseconds >= lease.authorizedRemainingDurationMilliseconds) {
+    return { status: "expired", lease: updatedLease, elapsedMilliseconds };
+  }
+  return {
+    status: "active",
+    lease: updatedLease,
+    elapsedMilliseconds,
+    remainingMilliseconds:
+      lease.authorizedRemainingDurationMilliseconds - elapsedMilliseconds,
+  };
+}
diff --git a/packages/domain/tests/evidence-outbox.test.ts b/packages/domain/tests/evidence-outbox.test.ts
