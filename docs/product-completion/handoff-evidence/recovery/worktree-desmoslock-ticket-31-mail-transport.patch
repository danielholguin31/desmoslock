+++ b/supabase/functions/staff-invitations/delivery-orchestrator.ts
@@ -0,0 +1,420 @@
+import { parseCanonicalEmail, parseCanonicalUuid } from '../_shared/http.ts'
+import {
+  parseResendProviderMessageId,
+  type PreparedResendInvitationDelivery,
+  type ResendInvitationTransport,
+} from '../_shared/resend-invitation-transport.ts'
+
+const DATABASE_ATTEMPTS = 2
+const MINIMUM_INVITATION_LIFETIME_SECONDS = 60
+const MAXIMUM_INVITATION_LIFETIME_SECONDS = 86_400
+
+export interface GeneratedInvitationResult {
+  readonly callbackUrl?: string
+  readonly code:
+    | 'dependency_unavailable'
+    | 'existing_user_conflict'
+    | 'link_generated'
+    | 'rate_limited'
+  readonly userId?: string
+}
+
+type InvitationTerminalCode =
+  | 'existing_confirmed_user_unsupported'
+  | 'invitation_expired'
+  | 'invitation_not_found'
+  | 'rate_limited'
+
+export type InvitationDeliveryReconciliation =
+  | {
+    readonly attemptId: string
+    readonly attemptStartedAt: string
+    readonly kind: 'claim_granted'
+  }
+  | { readonly kind: 'in_progress' }
+  | {
+    readonly attempt: PreparedResendInvitationDelivery
+    readonly kind: 'ready'
+  }
+  | {
+    readonly attemptId: string
+    readonly kind: 'provider_accepted'
+    readonly providerMessageId: string
+  }
+  | {
+    readonly attemptId: string
+    readonly kind: 'published'
+    readonly providerMessageId: string
+  }
+  | { readonly code: InvitationTerminalCode; readonly kind: 'terminal' }
+  | { readonly kind: 'conflict' }
+  | { readonly kind: 'dependency_unavailable' }
+
+export interface StaffInvitationDeliveryDependencies {
+  failInvitationMaterialization(
+    invitationId: string,
+    requestKey: string,
+    claimKey: string,
+    attemptId: string,
+    reasonCode: 'dependency_unavailable' | 'invalid_request' | 'rate_limited',
+  ): Promise<InvitationDeliveryReconciliation>
+  generateInviteLink(email: string): Promise<GeneratedInvitationResult>
+  readonly inviteLifetimeSeconds: number
+  newClaimKey(): string
+  now(): number
+  prepareInvitationDelivery(
+    invitationId: string,
+    requestKey: string,
+    claimKey: string,
+    userId: string,
+    attempt: PreparedResendInvitationDelivery,
+  ): Promise<InvitationDeliveryReconciliation>
+  publishInvitationDelivery(
+    invitationId: string,
+    requestKey: string,
+    attemptId: string,
+    providerMessageId: string,
+  ): Promise<InvitationDeliveryReconciliation>
+  reconcileInvitationDelivery(
+    invitationId: string,
+    requestKey: string,
+    claimKey: string,
+  ): Promise<InvitationDeliveryReconciliation>
+  recordInvitationDeliveryAcceptance(
+    invitationId: string,
+    requestKey: string,
+    attemptId: string,
+    providerMessageId: string,
+  ): Promise<InvitationDeliveryReconciliation>
+  readonly transport: ResendInvitationTransport
+}
+
+export interface StaffInvitationDeliveryContext {
+  readonly invitationId: string
+  readonly recipientEmail: string
+  readonly requestKey: string
+}
+
+export type StaffInvitationDeliveryOutcome =
+  | 'existing_confirmed_user_unsupported'
+  | 'invitation_created'
+  | 'invitation_expired'
+  | 'invitation_not_found'
+  | 'rate_limited'
+  | 'service_unavailable'
+
+function canonicalTimestamp(value: unknown): boolean {
+  if (typeof value !== 'string') return false
+  const timestamp = Date.parse(value)
+  return (
+    Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value
+  )
+}
+
+function validReceipt(attemptId: unknown, providerMessageId: unknown): boolean {
+  return (
+    parseCanonicalUuid(attemptId) !== null &&
+    parseResendProviderMessageId({ id: providerMessageId }) !== null
+  )
+}
+
+function validState(
+  value: InvitationDeliveryReconciliation,
+): InvitationDeliveryReconciliation {
+  switch (value.kind) {
+    case 'claim_granted':
+      return parseCanonicalUuid(value.attemptId) !== null &&
+          canonicalTimestamp(value.attemptStartedAt)
+        ? value
+        : { kind: 'dependency_unavailable' }
+    case 'provider_accepted':
+    case 'published':
+      return validReceipt(value.attemptId, value.providerMessageId)
+        ? value
+        : { kind: 'dependency_unavailable' }
+    case 'ready':
+      return typeof value.attempt === 'object' && value.attempt !== null
+        ? value
+        : { kind: 'dependency_unavailable' }
+    case 'terminal':
+      return [
+          'existing_confirmed_user_unsupported',
+          'invitation_expired',
+          'invitation_not_found',
+          'rate_limited',
+        ].includes(value.code)
+        ? value
+        : { kind: 'dependency_unavailable' }
+    case 'conflict':
+    case 'dependency_unavailable':
+    case 'in_progress':
+      return value
+  }
+}
+
+async function retryDatabaseTransition(
+  transition: () => Promise<InvitationDeliveryReconciliation>,
+): Promise<InvitationDeliveryReconciliation> {
+  for (let attempt = 0; attempt < DATABASE_ATTEMPTS; attempt += 1) {
+    try {
+      const state = validState(await transition())
+      if (state.kind !== 'dependency_unavailable') return state
+    } catch {
+      // Retry the exact tuple only. Never generate new delivery material here.
+    }
+  }
+  return { kind: 'dependency_unavailable' }
+}
+
+function invitationExpiration(
+  dependencies: StaffInvitationDeliveryDependencies,
+): string | null {
+  try {
+    const now = dependencies.now()
+    const lifetimeMilliseconds = dependencies.inviteLifetimeSeconds * 1_000
+    if (
+      !Number.isSafeInteger(now) ||
+      now < 0 ||
+      !Number.isSafeInteger(lifetimeMilliseconds) ||
+      dependencies.inviteLifetimeSeconds <
+        MINIMUM_INVITATION_LIFETIME_SECONDS ||
+      dependencies.inviteLifetimeSeconds >
+        MAXIMUM_INVITATION_LIFETIME_SECONDS ||
+      now > 8_640_000_000_000_000 - lifetimeMilliseconds
+    ) {
+      return null
+    }
+    return new Date(now + lifetimeMilliseconds).toISOString()
+  } catch {
+    return null
+  }
+}
+
+function generatedFailure(
+  code: GeneratedInvitationResult['code'],
+): {
+  readonly outcome: StaffInvitationDeliveryOutcome
+  readonly reason: 'dependency_unavailable' | 'invalid_request' | 'rate_limited'
+} {
+  if (code === 'existing_user_conflict') {
+    return {
+      outcome: 'existing_confirmed_user_unsupported',
+      reason: 'invalid_request',
+    }
+  }
+  if (code === 'rate_limited') {
+    return { outcome: 'rate_limited', reason: 'rate_limited' }
+  }
+  return { outcome: 'service_unavailable', reason: 'dependency_unavailable' }
+}
+
+function terminalOutcome(
+  state: Extract<InvitationDeliveryReconciliation, { kind: 'terminal' }>,
+): StaffInvitationDeliveryOutcome {
+  return state.code
+}
+
+async function publishAccepted(
+  context: StaffInvitationDeliveryContext,
+  attemptId: string,
+  providerMessageId: string,
+  dependencies: StaffInvitationDeliveryDependencies,
+): Promise<StaffInvitationDeliveryOutcome> {
+  const state = await retryDatabaseTransition(() =>
+    dependencies.publishInvitationDelivery(
+      context.invitationId,
+      context.requestKey,
+      attemptId,
+      providerMessageId,
+    )
+  )
+  if (
+    state.kind === 'published' &&
+    state.attemptId === attemptId &&
+    state.providerMessageId === providerMessageId
+  ) {
+    return 'invitation_created'
+  }
+  return state.kind === 'terminal' ? terminalOutcome(state) : 'service_unavailable'
+}
+
+async function deliverReady(
+  context: StaffInvitationDeliveryContext,
+  attempt: PreparedResendInvitationDelivery,
+  dependencies: StaffInvitationDeliveryDependencies,
+): Promise<StaffInvitationDeliveryOutcome> {
+  if (
+    attempt.invitationId !== context.invitationId ||
+    attempt.recipientEmail !== context.recipientEmail ||
+    parseCanonicalUuid(attempt.attemptId) === null
+  ) {
+    return 'service_unavailable'
+  }
+  let providerMessageId: string | null = null
+  try {
+    const delivery = await dependencies.transport.deliver(attempt)
+    providerMessageId = delivery.kind === 'provider_accepted'
+      ? parseResendProviderMessageId({ id: delivery.providerMessageId })
+      : null
+  } catch {
+    return 'service_unavailable'
+  }
+  if (providerMessageId === null) {
+    return 'service_unavailable'
+  }
+  const recorded = await retryDatabaseTransition(() =>
+    dependencies.recordInvitationDeliveryAcceptance(
+      context.invitationId,
+      context.requestKey,
+      attempt.attemptId,
+      providerMessageId,
+    )
+  )
+  if (
+    recorded.kind === 'provider_accepted' &&
+    recorded.attemptId === attempt.attemptId &&
+    recorded.providerMessageId === providerMessageId
+  ) {
+    return await publishAccepted(
+      context,
+      recorded.attemptId,
+      recorded.providerMessageId,
+      dependencies,
+    )
+  }
+  if (
+    recorded.kind === 'published' &&
+    recorded.attemptId === attempt.attemptId &&
+    recorded.providerMessageId === providerMessageId
+  ) {
+    return 'invitation_created'
+  }
+  return recorded.kind === 'terminal' ? terminalOutcome(recorded) : 'service_unavailable'
+}
+
+async function continueFromState(
+  context: StaffInvitationDeliveryContext,
+  state: InvitationDeliveryReconciliation,
+  dependencies: StaffInvitationDeliveryDependencies,
+): Promise<StaffInvitationDeliveryOutcome> {
+  switch (state.kind) {
+    case 'ready':
+      return await deliverReady(context, state.attempt, dependencies)
+    case 'provider_accepted':
+      return await publishAccepted(
+        context,
+        state.attemptId,
+        state.providerMessageId,
+        dependencies,
+      )
+    case 'published':
+      return 'invitation_created'
+    case 'terminal':
+      return terminalOutcome(state)
+    case 'claim_granted':
+    case 'conflict':
+    case 'dependency_unavailable':
+    case 'in_progress':
+      return 'service_unavailable'
+  }
+}
+
+async function materializeClaim(
+  context: StaffInvitationDeliveryContext,
+  claimKey: string,
+  claim: Extract<InvitationDeliveryReconciliation, { kind: 'claim_granted' }>,
+  dependencies: StaffInvitationDeliveryDependencies,
+): Promise<StaffInvitationDeliveryOutcome> {
+  const expiresAt = invitationExpiration(dependencies)
+  let generatedCode: GeneratedInvitationResult['code'] = 'dependency_unavailable'
+  let generatedUserId: string | null = null
+  let prepared: PreparedResendInvitationDelivery | null = null
+  if (expiresAt !== null) {
+    try {
+      const generated = await dependencies.generateInviteLink(
+        context.recipientEmail,
+      )
+      generatedCode = [
+          'dependency_unavailable',
+          'existing_user_conflict',
+          'link_generated',
+          'rate_limited',
+        ].includes(generated.code)
+        ? generated.code
+        : 'dependency_unavailable'
+      generatedUserId = generatedCode === 'link_generated'
+        ? parseCanonicalUuid(generated.userId)
+        : null
+      prepared = generatedCode === 'link_generated' &&
+          typeof generated.callbackUrl === 'string' &&
+          generatedUserId !== null
+        ? dependencies.transport.prepare({
+          attemptId: claim.attemptId,
+          attemptStartedAt: claim.attemptStartedAt,
+          callbackUrl: generated.callbackUrl,
+          expiresAt,
+          invitationId: context.invitationId,
+          recipientEmail: context.recipientEmail,
+        })
+        : null
+    } catch {
+      // The exact claim is terminalized below; a retry may never replace the
+      // potentially generated one-time Auth material.
+    }
+  }
+  if (prepared === null || generatedUserId === null) {
+    const failure = generatedFailure(generatedCode)
+    const state = await retryDatabaseTransition(() =>
+      dependencies.failInvitationMaterialization(
+        context.invitationId,
+        context.requestKey,
+        claimKey,
+        claim.attemptId,
+        failure.reason,
+      )
+    )
+    return state.kind === 'terminal' ? terminalOutcome(state) : 'service_unavailable'
+  }
+
+  const state = await retryDatabaseTransition(() =>
+    dependencies.prepareInvitationDelivery(
+      context.invitationId,
+      context.requestKey,
+      claimKey,
+      generatedUserId,
+      prepared,
+    )
+  )
+  return await continueFromState(context, state, dependencies)
+}
+
+export async function orchestrateStaffInvitationDelivery(
+  context: StaffInvitationDeliveryContext,
+  dependencies: StaffInvitationDeliveryDependencies,
+): Promise<StaffInvitationDeliveryOutcome> {
+  if (
+    parseCanonicalUuid(context.invitationId) === null ||
+    parseCanonicalUuid(context.requestKey) === null ||
+    parseCanonicalEmail(context.recipientEmail) === null
+  ) {
+    return 'service_unavailable'
+  }
+  let claimKey: string | null = null
+  try {
+    claimKey = parseCanonicalUuid(dependencies.newClaimKey())
+  } catch {
+    // Runtime entropy failure is local and cannot authorize side effects.
+  }
+  if (claimKey === null) return 'service_unavailable'
+
+  const state = await retryDatabaseTransition(() =>
+    dependencies.reconcileInvitationDelivery(
+      context.invitationId,
+      context.requestKey,
+      claimKey,
+    )
+  )
+  return state.kind === 'claim_granted'
+    ? await materializeClaim(context, claimKey, state, dependencies)
+    : await continueFromState(context, state, dependencies)
+}
diff --git a/supabase/functions/staff-invitations/recipient-publication-continuation.test.ts b/supabase/functions/staff-invitations/recipient-publication-continuation.test.ts
