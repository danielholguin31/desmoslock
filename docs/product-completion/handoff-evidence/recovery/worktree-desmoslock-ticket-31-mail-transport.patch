@@ -0,0 +1,175 @@
+import { isExactRecord, parseCanonicalEmail, parseCanonicalUuid } from '../_shared/http.ts'
+
+/**
+ * Schema-neutral reference contract for the DB/web lanes. The mail runtime does
+ * not call this module and it defines neither storage nor a public route.
+ *
+ * The continuation is created only after one explicit-human invitation
+ * verification succeeds. The whole record is confidential and service-only;
+ * it includes recipient identity but never the callback credential. The opaque
+ * continuation ID alone authorizes nothing: user, canonical email, and session
+ * binding must all match, and no field may be logged or publicly projected.
+ */
+export interface RecipientPublicationContinuation {
+  readonly continuationId: string
+  readonly expiresAt: string
+  readonly invitationId: string
+  readonly invitedUserId: string
+  readonly recipientEmail: string
+  readonly sessionBindingId: string
+}
+
+export type RecipientInvitationDeliveryPhase =
+  | 'delivery_ready'
+  | 'provider_accepted'
+  | 'published'
+  | 'terminal'
+
+export type RecipientPublicationContinuationDecision =
+  | {
+    readonly kind: 'invitation_ready'
+    readonly performProviderExchange: false
+    readonly retainContinuation: true
+  }
+  | {
+    readonly kind: 'publication_pending'
+    readonly performProviderExchange: false
+    readonly retainContinuation: true
+  }
+  | {
+    readonly kind: 'not_found'
+    readonly performProviderExchange: false
+    readonly retainContinuation: boolean
+  }
+
+function canonicalTimestamp(value: unknown): number | null {
+  if (typeof value !== 'string') return null
+  const timestamp = Date.parse(value)
+  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value
+    ? timestamp
+    : null
+}
+
+function parseContinuation(
+  value: unknown,
+): RecipientPublicationContinuation | null {
+  if (
+    !isExactRecord(value, [
+      'continuationId',
+      'expiresAt',
+      'invitationId',
+      'invitedUserId',
+      'recipientEmail',
+      'sessionBindingId',
+    ])
+  ) {
+    return null
+  }
+  const continuationId = parseCanonicalUuid(value.continuationId)
+  const invitationId = parseCanonicalUuid(value.invitationId)
+  const invitedUserId = parseCanonicalUuid(value.invitedUserId)
+  const recipientEmail = parseCanonicalEmail(value.recipientEmail)
+  const sessionBindingId = parseCanonicalUuid(value.sessionBindingId)
+  return continuationId !== null &&
+      invitationId !== null &&
+      invitedUserId !== null &&
+      recipientEmail !== null &&
+      sessionBindingId !== null &&
+      canonicalTimestamp(value.expiresAt) !== null
+    ? {
+      continuationId,
+      expiresAt: value.expiresAt as string,
+      invitationId,
+      invitedUserId,
+      recipientEmail,
+      sessionBindingId,
+    }
+    : null
+}
+
+/**
+ * Reference transition after provider verification. A binding mismatch is a
+ * generic miss but must not let an unrelated session erase the rightful,
+ * unexpired durable continuation.
+ */
+export function reconcileRecipientPublicationContinuation(value: {
+  readonly continuation: unknown
+  readonly currentEmail: unknown
+  readonly currentSessionBindingId: unknown
+  readonly currentUserId: unknown
+  readonly deliveryPhase: unknown
+  readonly now: unknown
+}): RecipientPublicationContinuationDecision {
+  try {
+    const continuation = parseContinuation(value.continuation)
+    const currentSessionBindingId = parseCanonicalUuid(
+      value.currentSessionBindingId,
+    )
+    const currentEmail = parseCanonicalEmail(value.currentEmail)
+    const currentUserId = parseCanonicalUuid(value.currentUserId)
+    const now = value.now
+    if (
+      continuation === null ||
+      currentEmail === null ||
+      currentSessionBindingId === null ||
+      currentUserId === null ||
+      typeof now !== 'number' ||
+      !Number.isSafeInteger(now) ||
+      now < 0
+    ) {
+      return {
+        kind: 'not_found',
+        performProviderExchange: false,
+        retainContinuation: true,
+      }
+    }
+    if (
+      currentUserId !== continuation.invitedUserId ||
+      currentEmail !== continuation.recipientEmail ||
+      currentSessionBindingId !== continuation.sessionBindingId
+    ) {
+      return {
+        kind: 'not_found',
+        performProviderExchange: false,
+        retainContinuation: true,
+      }
+    }
+    if (
+      now >= Date.parse(continuation.expiresAt) ||
+      value.deliveryPhase === 'terminal'
+    ) {
+      return {
+        kind: 'not_found',
+        performProviderExchange: false,
+        retainContinuation: false,
+      }
+    }
+    if (
+      value.deliveryPhase === 'delivery_ready' ||
+      value.deliveryPhase === 'provider_accepted'
+    ) {
+      return {
+        kind: 'publication_pending',
+        performProviderExchange: false,
+        retainContinuation: true,
+      }
+    }
+    return value.deliveryPhase === 'published'
+      ? {
+        kind: 'invitation_ready',
+        performProviderExchange: false,
+        retainContinuation: true,
+      }
+      : {
+        kind: 'not_found',
+        performProviderExchange: false,
+        retainContinuation: true,
+      }
+  } catch {
+    return {
+      kind: 'not_found',
+      performProviderExchange: false,
+      retainContinuation: true,
+    }
+  }
+}
