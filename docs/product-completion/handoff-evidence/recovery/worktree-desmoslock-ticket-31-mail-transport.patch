index 0000000000000000000000000000000000000000..b4aefedd83f3f7daeb6dfee084a92b74c004653c
--- /dev/null
+++ b/supabase/functions/staff-invitations/recipient-publication-continuation.test.ts
@@ -0,0 +1,209 @@
+// deno-lint-ignore-file require-await
+
+import {
+  type RecipientInvitationDeliveryPhase,
+  type RecipientPublicationContinuation,
+  reconcileRecipientPublicationContinuation,
+} from './recipient-publication-continuation.ts'
+import type { PreparedResendInvitationDelivery } from '../_shared/resend-invitation-transport.ts'
+import {
+  orchestrateStaffInvitationDelivery,
+  type StaffInvitationDeliveryDependencies,
+} from './delivery-orchestrator.ts'
+
+const CONTINUATION: RecipientPublicationContinuation = {
+  continuationId: '11111111-1111-4111-8111-111111111111',
+  expiresAt: '2026-09-04T13:00:00.000Z',
+  invitationId: '22222222-2222-4222-8222-222222222222',
+  invitedUserId: '33333333-3333-4333-8333-333333333333',
+  recipientEmail: 'teacher@example.invalid',
+  sessionBindingId: '44444444-4444-4444-8444-444444444444',
+}
+const NOW = Date.parse('2026-09-04T12:00:00.000Z')
+const REQUEST_KEY = '55555555-5555-4555-8555-555555555555'
+const ATTEMPT_ID = '66666666-6666-4666-8666-666666666666'
+const CLAIM_KEY = '77777777-7777-4777-8777-777777777777'
+const PROVIDER_MESSAGE_ID = '88888888-8888-4888-8888-888888888888'
+const RECIPIENT = 'teacher@example.invalid'
+const PREPARED_ATTEMPT: PreparedResendInvitationDelivery = {
+  attemptId: ATTEMPT_ID,
+  attemptStartedAt: '2026-09-04T12:00:00.000Z',
+  callbackUrl: `https://staff.desmoslock.invalid/?auth=invite&token_hash=${'0'.repeat(56)}`,
+  copyVersion: 'staff-invitation-v1',
+  expiresAt: CONTINUATION.expiresAt,
+  from: 'DesmosLock <mail@example.invalid>',
+  idempotencyKey: `desmoslock.staff-invitation.${CONTINUATION.invitationId}.${ATTEMPT_ID}`,
+  invitationId: CONTINUATION.invitationId,
+  providerRequestBody: 'opaque-confidential-provider-request',
+  recipientEmail: RECIPIENT,
+  replyTo: 'support@example.invalid',
+}
+
+function decide(
+  deliveryPhase: RecipientInvitationDeliveryPhase,
+  overrides: Record<string, unknown> = {},
+) {
+  return reconcileRecipientPublicationContinuation({
+    continuation: CONTINUATION,
+    currentEmail: CONTINUATION.recipientEmail,
+    currentSessionBindingId: CONTINUATION.sessionBindingId,
+    currentUserId: CONTINUATION.invitedUserId,
+    deliveryPhase,
+    now: NOW,
+    ...overrides,
+  })
+}
+
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) throw new Error(message)
+}
+
+Deno.test('verified recipient waits for publication then resumes the same bound session without another provider exchange', () => {
+  const providerVerificationCalls = 1
+  const whileReady = decide('delivery_ready')
+  const afterProviderAcceptance = decide('provider_accepted')
+  const afterPublication = decide('published')
+
+  for (const pending of [whileReady, afterProviderAcceptance]) {
+    assert(pending.kind === 'publication_pending', 'continuation was stranded')
+    assert(pending.retainContinuation, 'bound continuation was discarded')
+    assert(!pending.performProviderExchange, 'provider verification was repeated')
+  }
+  assert(afterPublication.kind === 'invitation_ready', 'publication did not resume')
+  assert(afterPublication.retainContinuation, 'published continuation disappeared')
+  assert(
+    !afterPublication.performProviderExchange,
+    'published resume attempted provider verification',
+  )
+  assert(providerVerificationCalls === 1, 'one-time provider exchange was reused')
+})
+
+Deno.test('paused publication preserves the verified continuation while sender retry publishes without new Auth material or mail', async () => {
+  let providerVerificationCalls = 0
+  let reconcileCalls = 0
+  let publicationCalls = 0
+  let deliveryCalls = 0
+  let generationCalls = 0
+  const dependencies: StaffInvitationDeliveryDependencies = {
+    async failInvitationMaterialization() {
+      throw new Error('unexpected materialization failure')
+    },
+    async generateInviteLink() {
+      generationCalls += 1
+      throw new Error('unexpected replacement Auth material')
+    },
+    inviteLifetimeSeconds: 3_600,
+    newClaimKey: () => CLAIM_KEY,
+    now: () => NOW,
+    async prepareInvitationDelivery() {
+      throw new Error('unexpected replacement attempt')
+    },
+    async publishInvitationDelivery(
+      _invitationId,
+      _requestKey,
+      attemptId,
+      providerMessageId,
+    ) {
+      publicationCalls += 1
+      return publicationCalls <= 2
+        ? { kind: 'dependency_unavailable' }
+        : { attemptId, kind: 'published', providerMessageId }
+    },
+    async reconcileInvitationDelivery() {
+      reconcileCalls += 1
+      return reconcileCalls === 1 ? { attempt: PREPARED_ATTEMPT, kind: 'ready' } : {
+        attemptId: ATTEMPT_ID,
+        kind: 'provider_accepted',
+        providerMessageId: PROVIDER_MESSAGE_ID,
+      }
+    },
+    async recordInvitationDeliveryAcceptance(
+      _invitationId,
+      _requestKey,
+      attemptId,
+      providerMessageId,
+    ) {
+      return { attemptId, kind: 'provider_accepted', providerMessageId }
+    },
+    transport: {
+      prepare() {
+        throw new Error('unexpected replacement attempt')
+      },
+      async deliver(attempt) {
+        deliveryCalls += 1
+        assert(attempt === PREPARED_ATTEMPT, 'sender changed frozen attempt')
+        return {
+          kind: 'provider_accepted',
+          providerMessageId: PROVIDER_MESSAGE_ID,
+        }
+      },
+    },
+  }
+  const context = {
+    invitationId: CONTINUATION.invitationId,
+    recipientEmail: RECIPIENT,
+    requestKey: REQUEST_KEY,
+  } as const
+
+  const paused = await orchestrateStaffInvitationDelivery(context, dependencies)
+  assert(paused === 'service_unavailable', 'paused publication escaped')
+
+  providerVerificationCalls += 1
+  const waiting = decide('provider_accepted')
+  assert(waiting.kind === 'publication_pending', 'verified session was stranded')
+  assert(!waiting.performProviderExchange, 'waiting state reused verification')
+
+  const published = await orchestrateStaffInvitationDelivery(context, dependencies)
+  assert(published === 'invitation_created', 'sender retry did not publish')
+  const resumed = decide('published')
+  assert(resumed.kind === 'invitation_ready', 'same session did not resume')
+  assert(!resumed.performProviderExchange, 'resume reused one-time verification')
+  assert(providerVerificationCalls === 1, 'provider verification count changed')
+  assert(deliveryCalls === 1, 'accepted sender retry duplicated mail')
+  assert(generationCalls === 0, 'sender retry generated replacement Auth material')
+})
+
+Deno.test('wrong user or session sees only a generic miss without erasing the rightful continuation', () => {
+  for (
+    const overrides of [
+      { currentUserId: '55555555-5555-4555-8555-555555555555' },
+      { currentEmail: 'other@example.invalid' },
+      { currentSessionBindingId: '66666666-6666-4666-8666-666666666666' },
+    ]
+  ) {
+    const decision = decide('provider_accepted', overrides)
+    assert(decision.kind === 'not_found', 'binding mismatch disclosed state')
+    assert(decision.retainContinuation, 'wrong session erased rightful state')
+    assert(!decision.performProviderExchange, 'wrong session could verify again')
+  }
+})
+
+Deno.test('only authoritative expiry or terminal state retires a continuation', () => {
+  const decisions = [
+    decide('provider_accepted', { now: Date.parse(CONTINUATION.expiresAt) }),
+    decide('terminal'),
+  ]
+  for (const decision of decisions) {
+    assert(decision.kind === 'not_found', 'unusable state was exposed')
+    assert(!decision.retainContinuation, 'unusable continuation was retained')
+    assert(!decision.performProviderExchange, 'unusable state could verify again')
+  }
+})
+
+Deno.test('malformed or unknown context fails closed without erasing recoverable continuation state', () => {
+  const decisions = [
+    decide('provider_accepted', {
+      continuation: { ...CONTINUATION, extra: true },
+    }),
+    decide('provider_accepted', { currentEmail: 'not-canonical' }),
+    decide('provider_accepted', { currentSessionBindingId: 'malformed' }),
+    decide('provider_accepted', { currentUserId: 'malformed' }),
+    decide('provider_accepted', { now: Number.NaN }),
+    decide('unknown' as RecipientInvitationDeliveryPhase),
+  ]
+  for (const decision of decisions) {
+    assert(decision.kind === 'not_found', 'malformed state disclosed detail')
+    assert(decision.retainContinuation, 'malformed state erased continuation')
+    assert(!decision.performProviderExchange, 'malformed state could verify again')
+  }
+})
