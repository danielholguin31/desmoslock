+
+function isManagementRpcFailureCode(
+  value: unknown,
+): value is ManagementRpcFailureCode {
+  return (
+    typeof value === "string" &&
+    managementRpcFailureCodes.some((code) => code === value)
+  );
+}
+
+function mapManagementRpcFailure(
+  code: ManagementRpcFailureCode,
