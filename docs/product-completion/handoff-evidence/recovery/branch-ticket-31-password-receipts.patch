+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { randomBytes, randomUUID } from "node:crypto";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import test from "node:test";
+
+import { createClient } from "@supabase/supabase-js";
+
+const repositoryRoot = path.resolve(
+  path.dirname(fileURLToPath(import.meta.url)),
+  "../..",
+);
+const supabaseExecutable = path.join(
+  repositoryRoot,
+  "node_modules",
+  ".bin",
+  process.platform === "win32" ? "supabase.cmd" : "supabase",
+);
+const authContainerName = "supabase_auth_desmoslock-v2";
+const databaseContainerName = "supabase_db_desmoslock-v2";
+const expectedApiOrigin = "http://127.0.0.1:54321";
+const markerKey = "desmoslock_password_commit_receipt";
+const observerSchema = "desmoslock_gotrue_conformance";
+const observerTrigger = "000_desmoslock_gotrue_conformance_observer";
+const exactAuthImage =
+  /^(?:public\.ecr\.aws\/supabase\/|ghcr\.io\/supabase\/|supabase\/)gotrue:v2\.195\.0(?:@sha256:[0-9a-f]{64})?$/u;
+const uuidPattern =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/u;
+
+function runSanitizedCommand(executable, arguments_, { input, label }) {
+  const result = spawnSync(executable, arguments_, {
+    cwd: repositoryRoot,
+    encoding: "utf8",
+    input,
+    killSignal: "SIGKILL",
+    maxBuffer: 1024 * 1024,
+    shell: false,
+    stdio: ["pipe", "pipe", "ignore"],
+    timeout: 30_000,
+    windowsHide: true,
+  });
+
+  if (result.error !== undefined || result.status !== 0) {
+    throw new Error(`${label} failed; subprocess details were redacted`);
+  }
+  return result.stdout;
+}
+
+function readLocalStackAccess() {
+  const output = runSanitizedCommand(
+    supabaseExecutable,
+    ["status", "--output", "json"],
+    { label: "Reading disposable Supabase status" },
+  );
+
+  let status;
+  try {
+    status = JSON.parse(output);
+  } catch {
+    throw new Error(
+      "Disposable Supabase status was not valid JSON; output was redacted",
+    );
+  }
+
+  let apiUrl;
+  try {
+    apiUrl = new URL(status.API_URL);
+  } catch {
+    throw new Error(
+      "Disposable Supabase status did not contain a valid API URL",
+    );
+  }
+  if (apiUrl.origin !== expectedApiOrigin || apiUrl.pathname !== "/") {
+    throw new Error(
+      "Refusing to run the Auth conformance probe outside the exact loopback stack",
+    );
+  }
+
+  const publishableKey = status.PUBLISHABLE_KEY ?? status.ANON_KEY;
+  const secretKey = status.SECRET_KEY ?? status.SERVICE_ROLE_KEY;
+  if (
+    typeof publishableKey !== "string" ||
+    publishableKey.length < 20 ||
+    typeof secretKey !== "string" ||
+    secretKey.length < 20
+  ) {
+    throw new Error(
+      "Disposable Supabase status omitted a required ephemeral API key",
+    );
+  }
+
+  return { apiUrl: apiUrl.origin, publishableKey, secretKey };
+}
+
+function assertPinnedAuthImage() {
+  const image = runSanitizedCommand(
+    "docker",
+    ["inspect", "--format", "{{.Config.Image}}", authContainerName],
+    { label: "Inspecting disposable Auth image" },
+  ).trim();
+  assert.equal(
+    exactAuthImage.test(image),
+    true,
+    "Disposable Auth must run the GoTrue v2.195.0 image pinned by Supabase CLI 2.115.0",
+  );
+}
+
+function createLoopbackFetch(apiOrigin) {
+  return async function loopbackFetch(input, init = {}) {
+    let endpoint;
+    try {
+      endpoint = new URL(
+        typeof input === "string" || input instanceof URL ? input : input.url,
+      );
+    } catch {
+      throw new Error("Local Auth attempted a request with an invalid URL");
+    }
+    if (endpoint.origin !== apiOrigin) {
+      throw new Error(
+        "Refusing to send Auth material outside the disposable loopback stack",
+      );
+    }
+
+    const signals = [AbortSignal.timeout(10_000)];
+    if (init.signal !== undefined && init.signal !== null) {
+      signals.push(init.signal);
+    }
+
+    let response;
+    try {
+      response = await fetch(input, {
+        ...init,
+        redirect: "manual",
+        signal: AbortSignal.any(signals),
+      });
+    } catch {
+      throw new Error(
+        "Disposable local Auth request failed; details were redacted",
+      );
+    }
+    if (response.status >= 300 && response.status < 400) {
+      await response.body?.cancel();
+      throw new Error(
+        "Refusing to follow a redirect from disposable local Auth",
+      );
+    }
+    return response;
+  };
+}
+
+function createEphemeralClient(apiUrl, apiKey) {
+  return createClient(apiUrl, apiKey, {
+    auth: {
+      autoRefreshToken: false,
+      detectSessionInUrl: false,
+      persistSession: false,
+    },
+    global: { fetch: createLoopbackFetch(apiUrl) },
+  });
+}
+
+async function requireAuthSuccess(label, operation) {
+  let result;
+  try {
+    result = await operation();
+  } catch {
+    throw new Error(`${label} did not complete; Auth details were redacted`);
+  }
+  if (result === null || typeof result !== "object" || result.error !== null) {
+    throw new Error(`${label} failed; Auth details were redacted`);
+  }
+  return result.data;
+}
+
+async function requireAuthFailure(label, operation) {
+  let result;
+  try {
+    result = await operation();
+  } catch {
+    throw new Error(`${label} did not complete; Auth details were redacted`);
+  }
+  if (result === null || typeof result !== "object" || result.error === null) {
+    throw new Error(`${label} unexpectedly succeeded`);
+  }
+  return {
+    code: typeof result.error.code === "string" ? result.error.code : null,
+    status: Number.isInteger(result.error.status) ? result.error.status : null,
+  };
+}
+
+function requireUuid(value, label) {
+  if (typeof value !== "string" || !uuidPattern.test(value)) {
+    throw new Error(`${label} was not a UUID`);
+  }
+  return value;
+}
+
+function sqlUuid(value, label) {
+  return `'${requireUuid(value, label)}'::uuid`;
+}
+
+function runSql(sql, label) {
+  return runSanitizedCommand(
+    "docker",
+    [
+      "exec",
+      "-i",
+      databaseContainerName,
+      "psql",
+      "--no-psqlrc",
+      "--quiet",
+      "--tuples-only",
+      "--no-align",
+      "--set",
+      "ON_ERROR_STOP=1",
+      "--username",
+      "postgres",
+      "--dbname",
+      "postgres",
+    ],
+    { input: sql, label },
+  ).trim();
+}
+
+function installObserver(userId) {
+  const observedUser = sqlUuid(userId, "Observed Auth user ID");
+  const result = runSql(
+    `
+begin;
+create schema ${observerSchema};
+revoke all on schema ${observerSchema} from public;
+
+create table ${observerSchema}.auth_user_updates (
+  ordinal bigint generated always as identity primary key,
+  password_changed boolean not null,
+  marker_present boolean not null,
+  transaction_id text not null
+);
+revoke all on table ${observerSchema}.auth_user_updates from public;
+
+create function ${observerSchema}.observe_auth_user_update()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  if new.id = ${observedUser} then
+    insert into ${observerSchema}.auth_user_updates (
+      password_changed,
+      marker_present,
+      transaction_id
+    ) values (
+      new.encrypted_password is distinct from old.encrypted_password,
+      coalesce(new.raw_user_meta_data, '{}'::jsonb) ? '${markerKey}',
+      pg_current_xact_id()::text
+    );
+  end if;
+  return new;
+end;
+$$;
+revoke all on function ${observerSchema}.observe_auth_user_update() from public;
+
+create trigger "${observerTrigger}"
+before update of encrypted_password, raw_user_meta_data on auth.users
+for each row execute function ${observerSchema}.observe_auth_user_update();
+commit;
+select 'ready';
+`,
+    "Installing the disposable Auth UPDATE observer",
+  );
+  assert.equal(
+    result,
+    "ready",
+    "Disposable Auth UPDATE observer must install atomically",
+  );
+}
+
+function createPreparedReceipt({ profileId, receiptId, userId }) {
+  const profile = sqlUuid(profileId, "Fixture profile ID");
+  const receipt = sqlUuid(receiptId, "Fixture receipt ID");
+  const user = sqlUuid(userId, "Fixture Auth user ID");
+  const result = runSql(
+    `
+begin;
+insert into desmoslock_v2.profiles (
+  id,
+  display_name,
+  seed_key,
+  auth_user_id
+) values (
+  ${profile},
+  'Disposable GoTrue conformance user',
+  null,
+  ${user}
+);
+
+with current_session as (
+  select auth_session.id
+  from auth.sessions as auth_session
+  where auth_session.user_id = ${user}
+  order by auth_session.created_at desc, auth_session.id
+  limit 1
+)
+insert into desmoslock_v2.staff_password_recovery_operations (
+  id,
+  auth_user_id,
+  auth_session_id,
+  profile_id,
+  status,
+  started_at,
+  expires_at
+)
+select
+  ${receipt},
+  ${user},
+  current_session.id,
+  ${profile},
+  'sessions_revoked',
+  clock_timestamp(),
+  clock_timestamp() + interval '10 minutes'
+from current_session;
+
+insert into desmoslock_v2.staff_password_commit_receipts (
+  id,
+  auth_user_id,
+  auth_session_id,
+  purpose,
+  recovery_operation_id,
+  status,
+  prepared_at,
+  commit_deadline,
+  revision
+)
+select
+  ${receipt},
+  ${user},
+  recovery.auth_session_id,
+  'password_recovery',
+  recovery.id,
+  'prepared',
+  clock_timestamp(),
+  clock_timestamp() + interval '5 minutes',
+  1
+from desmoslock_v2.staff_password_recovery_operations as recovery
+where recovery.id = ${receipt};
+commit;
+
+select case when exists (
+  select 1
+  from desmoslock_v2.staff_password_commit_receipts
+  where id = ${receipt}
+    and auth_user_id = ${user}
+    and status = 'prepared'
+) then 'ready' else 'missing' end;
+`,
+    "Creating the disposable prepared password receipt",
+  );
+  assert.equal(
+    result,
+    "ready",
+    "Disposable password receipt fixture must be prepared",
+  );
+}
+
+function readObservations() {
+  const output = runSql(
+    `
+select concat_ws(
+  '|',
+  password_changed::integer,
+  marker_present::integer,
+  transaction_id
+)
+from ${observerSchema}.auth_user_updates
+order by ordinal;
+`,
+    "Reading sanitized Auth UPDATE observations",
+  );
+  if (output === "") return [];
+
+  return output.split("\n").map((line) => {
+    const fields = line.split("|");
+    if (
+      fields.length !== 3 ||
+      !/^[01]$/u.test(fields[0]) ||
+      !/^[01]$/u.test(fields[1]) ||
+      !/^\d+$/u.test(fields[2])
+    ) {
+      throw new Error("Sanitized Auth UPDATE observation had an invalid shape");
+    }
+    return {
+      markerPresent: fields[1] === "1",
+      passwordChanged: fields[0] === "1",
+      transactionId: fields[2],
+    };
+  });
+}
+
+function clearObservations() {
+  runSql(
+    `truncate table ${observerSchema}.auth_user_updates;`,
+    "Clearing sanitized Auth UPDATE observations",
+  );
+}
+
+function readReceipt(receiptId) {
+  const receipt = sqlUuid(receiptId, "Receipt status ID");
+  const output = runSql(
+    `
+select concat_ws(
+  '|',
+  status,
+  (password_committed_at is not null)::integer,
+  revision
+)
+from desmoslock_v2.staff_password_commit_receipts
+where id = ${receipt};
+`,
+    "Reading sanitized password receipt status",
+  );
+  const fields = output.split("|");
+  if (
+    fields.length !== 3 ||
+    !/^[a-z_]+$/u.test(fields[0]) ||
+    !/^[01]$/u.test(fields[1]) ||
+    !/^\d+$/u.test(fields[2])
+  ) {
+    throw new Error("Sanitized password receipt status had an invalid shape");
+  }
+  return {
+    passwordCommittedAtPresent: fields[1] === "1",
+    revision: Number(fields[2]),
+    status: fields[0],
+  };
+}
+
+function readDatabaseMarkerPresence(userId) {
+  const user = sqlUuid(userId, "Marker-check Auth user ID");
+  const output = runSql(
+    `
+select case
+  when coalesce(raw_user_meta_data, '{}'::jsonb) ? '${markerKey}' then '1'
+  else '0'
+end
+from auth.users
+where id = ${user};
+`,
+    "Reading sanitized database marker presence",
+  );
+  if (!/^[01]$/u.test(output)) {
+    throw new Error("Sanitized database marker check had an invalid shape");
+  }
+  return output === "1";
+}
+
+function isMarkerAbsentFromUser(user) {
+  return (
+    user !== null &&
+    typeof user === "object" &&
+    user.user_metadata !== null &&
+    typeof user.user_metadata === "object" &&
+    !Object.hasOwn(user.user_metadata, markerKey)
+  );
+}
+
+function cleanupDatabaseFixture({ profileId, receiptId }) {
+  const profile = sqlUuid(profileId, "Cleanup profile ID");
+  const receipt = sqlUuid(receiptId, "Cleanup receipt ID");
+  runSql(
+    `
+begin;
+drop trigger if exists "${observerTrigger}" on auth.users;
+drop schema if exists ${observerSchema} cascade;
+delete from desmoslock_v2.staff_password_commit_receipts where id = ${receipt};
+delete from desmoslock_v2.staff_password_recovery_operations where id = ${receipt};
+delete from desmoslock_v2.profiles where id = ${profile};
+commit;
+`,
+    "Removing the disposable GoTrue conformance fixture",
+  );
+}
+
+function ephemeralPassword() {
+  return `Aa1!${randomBytes(24).toString("base64url")}`;
+}
+
+test(
+  "pinned GoTrue commits a password receipt in the same transaction and strips its marker",
+  { timeout: 90_000 },
+  async () => {
+    assertPinnedAuthImage();
+    const { apiUrl, publishableKey, secretKey } = readLocalStackAccess();
+    const adminClient = createEphemeralClient(apiUrl, secretKey);
+    const userClient = createEphemeralClient(apiUrl, publishableKey);
+    const email = `gotrue-conformance-${randomUUID()}@example.invalid`;
+    const initialPassword = ephemeralPassword();
+    const passwordWithoutMarker = ephemeralPassword();
+    const committedPassword = ephemeralPassword();
+    const profileId = randomUUID();
+    const receiptId = randomUUID();
+    let databaseFixtureCreated = false;
+    let userId = null;
+
+    try {
+      const created = await requireAuthSuccess(
+        "Creating disposable Auth user",
+        () =>
+          adminClient.auth.admin.createUser({
+            email,
+            email_confirm: true,
+            password: initialPassword,
+            user_metadata: { conformance_control: "preserved" },
+          }),
+      );
+      userId = requireUuid(created.user?.id, "Created Auth user ID");
+
+      const signedInUserId = await requireAuthSuccess(
+        "Signing in disposable Auth user",
+        async () => {
+          const result = await userClient.auth.signInWithPassword({
+            email,
+            password: initialPassword,
+          });
+          return result.error === null
+            ? { data: result.data.user?.id ?? null, error: null }
+            : { data: null, error: result.error };
+        },
+      );
+      assert.equal(
+        signedInUserId === userId,
+        true,
+        "Disposable Auth sign-in must resolve the created user",
+      );
+
+      createPreparedReceipt({ profileId, receiptId, userId });
+      databaseFixtureCreated = true;
+      installObserver(userId);
+
+      await requireAuthSuccess(
+        "Updating password without a receipt marker",
+        () => userClient.auth.updateUser({ password: passwordWithoutMarker }),
+      );
+      await requireAuthSuccess(
+        "Submitting a receipt marker without a password",
+        () =>
+          userClient.auth.updateUser({
+            data: { [markerKey]: receiptId },
+          }),
+      );
+
+      const separatedUpdates = readObservations();
+      assert.deepEqual(
+        separatedUpdates.map(({ markerPresent, passwordChanged }) => ({
+          markerPresent,
+          passwordChanged,
+        })),
+        [
+          { markerPresent: false, passwordChanged: true },
+          { markerPresent: true, passwordChanged: false },
+        ],
+        "Separate password and marker requests must remain separate Auth UPDATEs",
+      );
+      assert.notEqual(
+        separatedUpdates[0].transactionId,
+        separatedUpdates[1].transactionId,
+        "Separate Auth requests must not share a top-level transaction",
+      );
+      assert.deepEqual(readReceipt(receiptId), {
+        passwordCommittedAtPresent: false,
+        revision: 1,
+        status: "prepared",
+      });
+      assert.equal(
+        readDatabaseMarkerPresence(userId),
+        false,
+        "A marker-only update must be stripped without advancing its receipt",
+      );
+
+      clearObservations();
+      const updated = await requireAuthSuccess(
+        "Updating password with its prepared receipt marker",
+        () =>
+          userClient.auth.updateUser({
+            data: { [markerKey]: receiptId },
+            password: committedPassword,
+          }),
+      );
+      assert.equal(
+        updated.user?.id === userId,
+        true,
+        "Correlated Auth update must return the same user",
+      );
+
+      const correlatedUpdates = readObservations();
+      assert.deepEqual(
+        correlatedUpdates.map(({ markerPresent, passwordChanged }) => ({
+          markerPresent,
+          passwordChanged,
+        })),
+        [
+          { markerPresent: false, passwordChanged: true },
+          { markerPresent: true, passwordChanged: false },
+        ],
+        "Pinned GoTrue must update encrypted_password before raw_user_meta_data",
+      );
+      assert.equal(
+        correlatedUpdates[0].transactionId ===
+          correlatedUpdates[1].transactionId,
+        true,
+        "Password and metadata UPDATEs from one Auth request must share a transaction",
+      );
+
+      const committedReceipt = readReceipt(receiptId);
+      assert.deepEqual(committedReceipt, {
+        passwordCommittedAtPresent: true,
+        revision: 2,
+        status: "password_committed",
+      });
+      assert.equal(
+        readDatabaseMarkerPresence(userId),
+        false,
+        "The reserved receipt marker must not persist in auth.users",
+      );
+
+      const fresh = await requireAuthSuccess(
+        "Reading freshly persisted Auth user",
+        () => adminClient.auth.admin.getUserById(userId),
+      );
+      assert.equal(
+        isMarkerAbsentFromUser(fresh.user),
+        true,
+        "A fresh Auth read must not expose the stripped receipt marker",
+      );
+      assert.equal(
+        fresh.user?.user_metadata?.conformance_control === "preserved",
+        true,
+        "Stripping the reserved marker must preserve unrelated user metadata",
+      );
+
+      const retry = await requireAuthFailure(
+        "Repeating the already committed password",
+        () =>
+          userClient.auth.updateUser({
+            data: { [markerKey]: receiptId },
+            password: committedPassword,
+          }),
+      );
+      assert.deepEqual(retry, { code: "same_password", status: 422 });
+      assert.equal(
+        readObservations().length,
+        2,
+        "A same-password rejection must happen before either Auth UPDATE",
+      );
+      assert.deepEqual(
+        readReceipt(receiptId),
+        committedReceipt,
+        "A same-password retry must not advance the receipt again",
+      );
+    } finally {
+      if (databaseFixtureCreated) {
+        try {
+          cleanupDatabaseFixture({ profileId, receiptId });
+        } catch {
+          // The CI job destroys the disposable stack in an always() step.
+        }
+      }
+      if (userId !== null) {
+        try {
+          await requireAuthSuccess("Deleting disposable Auth user", () =>
+            adminClient.auth.admin.deleteUser(userId),
+          );
+        } catch {
+          // The CI job destroys the disposable stack in an always() step.
+        }
+      }
+    }
+  },
+);
