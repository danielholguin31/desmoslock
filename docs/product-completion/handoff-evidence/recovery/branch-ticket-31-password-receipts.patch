+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  marker_key constant text := 'desmoslock_password_commit_receipt';
+  marker_value jsonb;
+  marker_text text;
+  transaction_user_key text;
+  changed_user_key text;
+  marker_user_key text;
+  marker_receipt_id text;
+  prior_marker_user_key text;
+  password_changed boolean;
+  marker_was_supplied boolean := false;
+  marker_is_valid boolean := false;
+  receipt_row desmoslock_v2.staff_password_commit_receipts%rowtype;
+  witnessed_at timestamp with time zone;
+  witnessed_rows bigint;
+begin
+  transaction_user_key := pg_current_xact_id()::text || ':' || new.id::text;
+  password_changed := new.encrypted_password is distinct from old.encrypted_password;
+  prior_marker_user_key := current_setting(
+    'desmoslock.password_receipt_marker_user',
+    true
+  );
+
+  -- The pinned GoTrue contract is password first, then a distinct metadata
+  -- UPDATE in the same transaction. A marker-first or combined-row mutation
+  -- is not that attested path, even if it targets the same user and receipt.
+  if password_changed and coalesce(prior_marker_user_key, '') <> '' then
+    perform set_config('desmoslock.password_receipt_changed_user', '', true);
+    perform set_config('desmoslock.password_receipt_marker_user', '', true);
+    perform set_config('desmoslock.password_receipt_marker_id', '', true);
+    raise exception using
+      errcode = '22023',
+      message = 'password receipt rejected';
+  end if;
+
+  if password_changed then
+    perform set_config(
+      'desmoslock.password_receipt_changed_user',
+      transaction_user_key,
+      true
+    );
+  end if;
+
+  if coalesce(new.raw_user_meta_data, '{}'::jsonb) ? marker_key then
+    marker_value := new.raw_user_meta_data -> marker_key;
+    marker_was_supplied :=
+      old.raw_user_meta_data -> marker_key is distinct from marker_value;
+    new.raw_user_meta_data := new.raw_user_meta_data - marker_key;
+
+    -- Any marker-bearing update consumes the transaction-local password
+    -- witness, even when the marker is malformed. That makes one actual
+    -- password mutation usable for at most one exact receipt attempt.
+    perform set_config('desmoslock.password_receipt_marker_user', '', true);
+    perform set_config('desmoslock.password_receipt_marker_id', '', true);
+
+    if marker_was_supplied and password_changed then
+      perform set_config('desmoslock.password_receipt_changed_user', '', true);
+      raise exception using
+        errcode = '22023',
+        message = 'password receipt rejected';
+    end if;
+
+    if marker_was_supplied
+      and jsonb_typeof(marker_value) = 'string'
+    then
+      marker_text := marker_value #>> '{}';
+      if marker_text ~
+        '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
+      then
+        marker_is_valid := true;
+        perform set_config(
+          'desmoslock.password_receipt_marker_user',
+          transaction_user_key,
+          true
+        );
+        perform set_config(
+          'desmoslock.password_receipt_marker_id',
+          marker_text,
+          true
+        );
+      end if;
+    end if;
+
+    if marker_was_supplied
+      and not marker_is_valid
+      and current_setting(
+        'desmoslock.password_receipt_changed_user',
+        true
+      ) = transaction_user_key
+    then
+      perform set_config('desmoslock.password_receipt_changed_user', '', true);
+      perform set_config('desmoslock.password_receipt_marker_user', '', true);
+      perform set_config('desmoslock.password_receipt_marker_id', '', true);
+      raise exception using
+        errcode = '22023',
+        message = 'password receipt rejected';
+    end if;
+
+    if marker_was_supplied and coalesce(
+      current_setting('desmoslock.password_receipt_marker_user', true),
+      ''
+    ) = '' then
+      perform set_config('desmoslock.password_receipt_changed_user', '', true);
+    end if;
+  end if;
+
+  changed_user_key := current_setting(
+    'desmoslock.password_receipt_changed_user',
+    true
+  );
+  marker_user_key := current_setting(
+    'desmoslock.password_receipt_marker_user',
+    true
+  );
+  marker_receipt_id := current_setting(
+    'desmoslock.password_receipt_marker_id',
+    true
+  );
+
+  if coalesce(changed_user_key, '') <> ''
+    and coalesce(marker_user_key, '') <> ''
+    and coalesce(marker_receipt_id, '') <> ''
+  then
+    -- Clear before attempting the state change so a failed, foreign, or stale
+    -- marker cannot be retried against the same password mutation.
+    perform set_config('desmoslock.password_receipt_changed_user', '', true);
+    perform set_config('desmoslock.password_receipt_marker_user', '', true);
+    perform set_config('desmoslock.password_receipt_marker_id', '', true);
+
+    if changed_user_key <> marker_user_key
+      or changed_user_key <> transaction_user_key
+    then
+      raise exception using
+        errcode = '22023',
+        message = 'password receipt rejected';
+    end if;
+
+    select *
+    into receipt_row
+    from desmoslock_v2.staff_password_commit_receipts as receipt
+    where receipt.id = marker_receipt_id::uuid
+      and receipt.auth_user_id = new.id
+    for update;
+
+    if not found
+      or receipt_row.purpose not in (
+        'invitation_acceptance',
+        'password_recovery'
+      )
+      or receipt_row.status <> 'prepared'
+    then
+      raise exception using
+        errcode = '22023',
+        message = 'password receipt rejected';
+    end if;
+
+    -- A receipt-lock wait may cross the commit deadline. The witness time is
+    -- sampled only after that lock so stale pre-wait time cannot commit proof.
+    witnessed_at := clock_timestamp();
+
+    update desmoslock_v2.staff_password_commit_receipts
+    set
+      status = 'password_committed',
+      password_committed_at = witnessed_at,
+      revision = revision + 1
+    where id = marker_receipt_id::uuid
+      and auth_user_id = new.id
+      and purpose = receipt_row.purpose
+      and status = 'prepared'
+      and revision = receipt_row.revision
+      and witnessed_at < commit_deadline;
+
+    get diagnostics witnessed_rows = row_count;
+    if witnessed_rows <> 1 then
+      raise exception using
+        errcode = '22023',
+        message = 'password receipt rejected';
+    end if;
+  end if;
+
+  return new;
+end;
+$$;
+
+revoke all on function desmoslock_v2.internal_witness_staff_password_commit()
+  from public, anon, authenticated, service_role;
+
+create trigger auth_users_witness_staff_password_commit
+before update of encrypted_password, raw_user_meta_data on auth.users
+for each row execute function desmoslock_v2.internal_witness_staff_password_commit();
