+create function pg_temp.skip_recovery_receipt_finish()
+returns trigger
+language plpgsql
+as $$
+begin
+  return null;
+end;
+$$;
+create trigger skip_recovery_receipt_finish
+before update on desmoslock_v2.staff_password_commit_receipts
+for each row
+when (
+  old.status = 'password_committed'
+  and new.status = 'finished'
+)
+execute function pg_temp.skip_recovery_receipt_finish();
+
+select throws_ok(
+  $$
+    select *
+    from desmoslock_v2.finish_staff_password_recovery(
+      pg_temp.test_operation_id('password-recovery')
+    )
+  $$,
+  '40001',
+  'recovery receipt state changed',
+  'a recovery receipt CAS failure aborts every completion side effect'
+);
