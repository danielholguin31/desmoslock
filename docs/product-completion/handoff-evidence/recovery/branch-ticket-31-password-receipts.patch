+  auth_session_id uuid not null,
+  purpose text not null,
+  invitation_id uuid references desmoslock_v2.staff_invitations (id) on delete restrict,
+  recovery_operation_id uuid unique
+    references desmoslock_v2.staff_password_recovery_operations (id)
+    on delete restrict,
+  display_name text,
+  status text not null default 'prepared',
+  prepared_at timestamp with time zone not null,
+  commit_deadline timestamp with time zone not null,
+  password_committed_at timestamp with time zone,
+  finished_at timestamp with time zone,
+  revision bigint not null default 1,
+  constraint staff_password_commit_receipts_purpose_check
+    check (purpose in ('invitation_acceptance', 'password_recovery')),
+  constraint staff_password_commit_receipts_status_check
+    check (status in ('prepared', 'password_committed', 'finished', 'expired')),
+  constraint staff_password_commit_receipts_revision_check
+    check (revision > 0),
+  constraint staff_password_commit_receipts_deadline_check
+    check (commit_deadline > prepared_at),
+  constraint staff_password_commit_receipts_target_check
+    check (
+      (
+        purpose = 'invitation_acceptance'
+        and invitation_id is not null
+        and recovery_operation_id is null
+        and display_name is not null
+        and octet_length(display_name) between 1 and 160
+        and display_name = btrim(display_name)
+        and display_name !~ '[[:cntrl:]]'
+      )
+      or (
+        purpose = 'password_recovery'
+        and invitation_id is null
+        and recovery_operation_id is not null
+        and id = recovery_operation_id
+        and display_name is null
+      )
+    ),
+  constraint staff_password_commit_receipts_lifecycle_check
+    check (
+      (
+        status = 'prepared'
+        and password_committed_at is null
+        and finished_at is null
+      )
+      or (
+        status = 'password_committed'
+        and password_committed_at is not null
+        and password_committed_at >= prepared_at
+        and password_committed_at < commit_deadline
+        and finished_at is null
+      )
+      or (
+        status = 'finished'
+        and password_committed_at is not null
+        and password_committed_at >= prepared_at
+        and password_committed_at < commit_deadline
+        and finished_at is not null
+        and finished_at >= password_committed_at
+      )
+      or (
+        status = 'expired'
+        and password_committed_at is null
+        and finished_at is null
+      )
+    )
+);
+
