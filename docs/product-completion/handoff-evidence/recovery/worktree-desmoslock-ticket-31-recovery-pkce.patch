--- /dev/null
+++ b/supabase/functions/_shared/email-action-pkce-broker.ts
@@ -0,0 +1,240 @@
+import { parseCanonicalEmail, parseExactOrigin } from './http.ts'
+import {
+  deriveEmailActionPkceMaterial,
+  matchesEmailActionPkceState,
+  type EmailActionPkceContext,
+  type EmailActionPkcePurpose,
+} from './recovery-pkce.ts'
+import type { EmailActionPkceProvider } from './recovery-pkce-provider.ts'
+
+const FLOW_LIFETIME_SECONDS = 900
+
+export interface EmailActionFlowRepository {
+  activate(input: {
+    readonly flowId: string
+    readonly purpose: EmailActionPkcePurpose
+  }): Promise<'ready' | 'unavailable'>
+  begin(input: {
+    readonly flowId: string
+    readonly intendedOrigin: string
+    readonly lifetimeSeconds: number
+    readonly purpose: EmailActionPkcePurpose
+  }): Promise<
+    | {
+        readonly context: EmailActionPkceContext
+        readonly status: 'initiating'
+      }
+    | { readonly status: 'unavailable' }
+  >
+  claim(input: {
+    readonly flowId: string
+    readonly purpose: EmailActionPkcePurpose
+  }): Promise<
+    | {
+        readonly context: EmailActionPkceContext
+        readonly status: 'claimed'
+      }
+    | { readonly status: 'rejected' | 'unavailable' }
+  >
+}
+
+export interface EmailActionPkceBroker {
+  exchangeEmailAction(input: {
+    readonly authorizationCode: string
+    readonly flowId: string
+    readonly purpose: EmailActionPkcePurpose
+    readonly state: string
+  }): Promise<
+    | {
+        readonly session: {
+          readonly accessToken: string
+          readonly refreshToken: string
+        }
+        readonly status: 'ready'
+      }
+    | { readonly status: 'rejected' | 'unavailable' }
+  >
+  requestEmailAction(input: {
+    readonly email: string
+    readonly purpose: EmailActionPkcePurpose
+  }): Promise<void>
+}
+
+export function createEmailActionPkceBroker(dependencies: {
+  readonly allowedOrigin: string
+  readonly derivationSecret: string
+  readonly flowRepository: EmailActionFlowRepository
+  readonly newFlowId?: () => string
+  readonly now?: () => number
+  readonly provider: EmailActionPkceProvider
+}): EmailActionPkceBroker {
+  const allowedOrigin = parseExactOrigin(dependencies.allowedOrigin)
+  if (
+    allowedOrigin === null ||
+    !/^[A-Za-z0-9_-]{43}$/u.test(dependencies.derivationSecret)
+  ) {
+    throw new Error('Email-action PKCE broker configuration is invalid')
+  }
+  const newFlowId = dependencies.newFlowId ?? createRandomFlowId
+  const now = dependencies.now ?? Date.now
+
+  return {
+    async exchangeEmailAction(input) {
+      if (
+        !isPurpose(input.purpose) ||
+        !/^[A-Za-z0-9_-]{22}$/u.test(input.flowId) ||
+        !/^[A-Za-z0-9_-]{43}$/u.test(input.state) ||
+        !isOpaqueAscii(input.authorizationCode, 2_048)
+      ) {
+        return { status: 'rejected' }
+      }
+
+      let claim: Awaited<
+        ReturnType<EmailActionFlowRepository['claim']>
+      >
+      try {
+        claim = await dependencies.flowRepository.claim({
+          flowId: input.flowId,
+          purpose: input.purpose,
+        })
+      } catch {
+        return { status: 'unavailable' }
+      }
+      if (claim.status !== 'claimed') return claim
+      const contextStatus = validateClaimedContext(
+        claim.context,
+        {
+          flowId: input.flowId,
+          intendedOrigin: allowedOrigin,
+          purpose: input.purpose,
+        },
+        Math.floor(now() / 1_000),
+      )
+      if (contextStatus !== 'ready') return { status: contextStatus }
+
+      let stateMatches: boolean
+      let material: Awaited<ReturnType<typeof deriveEmailActionPkceMaterial>>
+      try {
+        ;[stateMatches, material] = await Promise.all([
+          matchesEmailActionPkceState(dependencies.derivationSecret, {
+            context: claim.context,
+            state: input.state,
+          }),
+          deriveEmailActionPkceMaterial(
+            dependencies.derivationSecret,
+            claim.context,
+          ),
+        ])
+      } catch {
+        return { status: 'unavailable' }
+      }
+      if (!stateMatches) return { status: 'rejected' }
+
+      try {
+        return await dependencies.provider.exchangeCode({
+          authorizationCode: input.authorizationCode,
+          purpose: input.purpose,
+          verifier: material.verifier,
+        })
+      } catch {
+        return { status: 'unavailable' }
+      }
+    },
+
+    async requestEmailAction(input) {
+      if (!isPurpose(input.purpose) || parseCanonicalEmail(input.email) === null) {
+        throw new Error('Email-action PKCE request is invalid')
+      }
+      const flowId = newFlowId()
+      if (!/^[A-Za-z0-9_-]{22}$/u.test(flowId)) {
+        throw new Error('Email-action PKCE flow identity is invalid')
+      }
+      const begin = await dependencies.flowRepository.begin({
+        flowId,
+        intendedOrigin: allowedOrigin,
+        lifetimeSeconds: FLOW_LIFETIME_SECONDS,
+        purpose: input.purpose,
+      })
+      if (
+        begin.status !== 'initiating' ||
+        validateClaimedContext(
+          begin.context,
+          { flowId, intendedOrigin: allowedOrigin, purpose: input.purpose },
+          Math.floor(now() / 1_000),
+        ) !== 'ready'
+      ) {
+        throw new Error('Email-action PKCE flow is unavailable')
+      }
+      const material = await deriveEmailActionPkceMaterial(
+        dependencies.derivationSecret,
+        begin.context,
+      )
+      const providerInput = {
+        codeChallenge: material.codeChallenge,
+        email: input.email,
+        flowId,
+        state: material.state,
+      }
+      if (input.purpose === 'password_recovery') {
+        await dependencies.provider.requestRecovery(providerInput)
+      } else {
+        await dependencies.provider.requestEmailVerification(providerInput)
+      }
+      if (
+        await dependencies.flowRepository.activate({
+          flowId,
+          purpose: input.purpose,
+        }) !== 'ready'
+      ) {
+        throw new Error('Email-action PKCE flow is unavailable')
+      }
+    },
+  }
+}
+
+function createRandomFlowId(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(16))
+  let binary = ''
+  for (const byte of bytes) binary += String.fromCharCode(byte)
+  return btoa(binary)
+    .replace(/=+$/u, '')
+    .replace(/\+/gu, '-')
+    .replace(/\//gu, '_')
+}
+
+function isOpaqueAscii(value: unknown, maximumLength: number): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length <= maximumLength &&
+    value === value.trim() &&
+    /^[\x21-\x7e]+$/u.test(value)
+  )
+}
+
+function isPurpose(value: unknown): value is EmailActionPkcePurpose {
+  return value === 'password_recovery' || value === 'email_verification'
+}
+
+function validateClaimedContext(
+  context: EmailActionPkceContext,
+  expected: {
+    readonly flowId: string
+    readonly intendedOrigin: string
+    readonly purpose: EmailActionPkcePurpose
+  },
+  now: number,
+): 'ready' | 'rejected' | 'unavailable' {
+  if (
+    context.flowId !== expected.flowId ||
+    context.intendedOrigin !== expected.intendedOrigin ||
+    context.purpose !== expected.purpose ||
+    !Number.isSafeInteger(context.issuedAt) ||
+    !Number.isSafeInteger(context.expiresAt) ||
+    context.expiresAt - context.issuedAt !== FLOW_LIFETIME_SECONDS ||
+    context.issuedAt > now + 30
+  ) {
+    return 'unavailable'
+  }
+  return context.expiresAt <= now ? 'rejected' : 'ready'
+}
diff --git a/supabase/functions/_shared/email-action-pkce-repository.test.ts b/supabase/functions/_shared/email-action-pkce-repository.test.ts
