+      },
+      async (input) => {
+        calls += 1
+        const response = Response.json(
+          { forbidden_detail: 'must-not-escape' },
+          { status: scenario.status },
+        )
+        Object.defineProperty(response, 'url', { value: String(input) })
+        return response
+      },
+    )
+    assertEquals(
+      await provider.exchangeCode({
+        authorizationCode: 'synthetic-authorization-code',
+        purpose: 'email_verification',
+        verifier: 'SL-MTH5RQWHUVE3rmqg_ohVuzxGCnYTDCOISCCAgaM0',
+      }),
+      { status: scenario.expected },
