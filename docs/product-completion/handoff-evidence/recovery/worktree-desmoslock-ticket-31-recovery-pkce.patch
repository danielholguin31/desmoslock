+++ b/supabase/functions/_shared/email-action-pkce-broker.test.ts
@@ -0,0 +1,271 @@
+// deno-lint-ignore-file require-await
+
+import {
+  createEmailActionPkceBroker,
+  type EmailActionFlowRepository,
+} from './email-action-pkce-broker.ts'
+import type { EmailActionPkceProvider } from './recovery-pkce-provider.ts'
+
+const ORIGIN = 'https://staff.desmoslock.invalid'
+const SECRET = 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8'
+const FLOW_ID = 'ABEiM0RVZneImaq7zN3u_w'
+
+function assertEquals(actual: unknown, expected: unknown): void {
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+    throw new Error(
+      `Expected ${JSON.stringify(expected)}, received ${JSON.stringify(actual)}`,
+    )
+  }
+}
+
+function flowRepository(
+  calls: unknown[],
+  overrides: Partial<EmailActionFlowRepository> = {},
+): EmailActionFlowRepository {
+  return {
+    async activate(input) {
+      calls.push(['activate', input])
+      return 'ready'
+    },
+    async begin(input) {
+      calls.push(['begin', input])
+      return {
+        context: {
+          expiresAt: 1_780_000_900,
+          flowId: input.flowId,
+          intendedOrigin: input.intendedOrigin,
+          issuedAt: 1_780_000_000,
+          purpose: input.purpose,
+        },
+        status: 'initiating',
+      }
+    },
+    async claim(input) {
+      calls.push(['claim', input])
+      return {
+        context: {
+          expiresAt: 1_780_000_900,
+          flowId: input.flowId,
+          intendedOrigin: ORIGIN,
+          issuedAt: 1_780_000_000,
+          purpose: input.purpose,
+        },
+        status: 'claimed',
+      }
+    },
+    ...overrides,
+  }
+}
+
+function provider(
+  calls: unknown[],
+  overrides: Partial<EmailActionPkceProvider> = {},
+): EmailActionPkceProvider {
+  return {
+    async exchangeCode(input) {
+      calls.push(['exchange', input])
+      return {
+        session: {
+          accessToken: 'synthetic-access-value',
+          refreshToken: 'synthetic-refresh-value',
+        },
+        status: 'ready',
+      }
+    },
+    async requestEmailVerification(input) {
+      calls.push(['verification', input])
+    },
+    async requestRecovery(input) {
+      calls.push(['recovery', input])
+    },
+    ...overrides,
+  }
+}
+
+Deno.test('broker begins and activates password recovery without persisting derivation material', async () => {
+  const calls: unknown[] = []
+  const broker = createEmailActionPkceBroker({
+    allowedOrigin: ORIGIN,
+    derivationSecret: SECRET,
+    flowRepository: flowRepository(calls),
+    newFlowId: () => FLOW_ID,
+    now: () => 1_780_000_100_000,
+    provider: provider(calls),
+  })
+
+  await broker.requestEmailAction({
+    email: 'owner@example.com',
+    purpose: 'password_recovery',
+  })
+
+  assertEquals(calls, [
+    ['begin', {
+      flowId: FLOW_ID,
+      intendedOrigin: ORIGIN,
+      lifetimeSeconds: 900,
+      purpose: 'password_recovery',
+    }],
+    ['recovery', {
+      codeChallenge: '_wXrViLS-RXLg1gJPUe-4zeoJoIg7dI3zb9iUgrDg1o',
+      email: 'owner@example.com',
+      flowId: FLOW_ID,
+      state: 'VmwQ-TLidXAtSEscvyc4s3o53n_zRIMpr58NMzGxBiE',
+    }],
+    ['activate', { flowId: FLOW_ID, purpose: 'password_recovery' }],
+  ])
+})
+
+Deno.test('broker sends signup resend with independently derived email-verification material', async () => {
+  const calls: unknown[] = []
+  const broker = createEmailActionPkceBroker({
+    allowedOrigin: ORIGIN,
+    derivationSecret: SECRET,
+    flowRepository: flowRepository(calls),
+    newFlowId: () => FLOW_ID,
+    now: () => 1_780_000_100_000,
+    provider: provider(calls),
+  })
+
+  await broker.requestEmailAction({
+    email: 'owner@example.com',
+    purpose: 'email_verification',
+  })
+
+  assertEquals(calls[1], ['verification', {
+    codeChallenge: 'kGdI0dF8ONoLc3VxahH3qyACDIT8vv3Ieo99Ir4ItRU',
+    email: 'owner@example.com',
+    flowId: FLOW_ID,
+    state: 'wOEhI2hMGykbY7yIKclpMWfcx5KLPS6sdK-AoJld7aU',
+  }])
+  assertEquals(calls[2], [
+    'activate',
+    { flowId: FLOW_ID, purpose: 'email_verification' },
+  ])
+})
+
+Deno.test('broker irreversibly claims before recomputing and exchanging a recovery code', async () => {
+  const calls: unknown[] = []
+  const broker = createEmailActionPkceBroker({
+    allowedOrigin: ORIGIN,
+    derivationSecret: SECRET,
+    flowRepository: flowRepository(calls),
+    newFlowId: () => FLOW_ID,
+    now: () => 1_780_000_100_000,
+    provider: provider(calls),
+  })
+
+  assertEquals(
+    await broker.exchangeEmailAction({
+      authorizationCode: 'synthetic-authorization-code',
+      flowId: FLOW_ID,
+      purpose: 'password_recovery',
+      state: 'VmwQ-TLidXAtSEscvyc4s3o53n_zRIMpr58NMzGxBiE',
+    }),
+    {
+      session: {
+        accessToken: 'synthetic-access-value',
+        refreshToken: 'synthetic-refresh-value',
+      },
+      status: 'ready',
+    },
+  )
+  assertEquals(calls, [
+    ['claim', { flowId: FLOW_ID, purpose: 'password_recovery' }],
+    ['exchange', {
+      authorizationCode: 'synthetic-authorization-code',
+      purpose: 'password_recovery',
+      verifier: 'LJamG9H31kYG-QMFogiTmxjJ5LHNHQBfZx4ibhqAOVk',
+    }],
+  ])
+})
+
+Deno.test('invalid state burns the claimed flow without sending a provider request', async () => {
+  const calls: unknown[] = []
+  const broker = createEmailActionPkceBroker({
+    allowedOrigin: ORIGIN,
+    derivationSecret: SECRET,
+    flowRepository: flowRepository(calls),
+    newFlowId: () => FLOW_ID,
+    now: () => 1_780_000_100_000,
+    provider: provider(calls),
+  })
+
+  assertEquals(
+    await broker.exchangeEmailAction({
+      authorizationCode: 'synthetic-authorization-code',
+      flowId: FLOW_ID,
+      purpose: 'password_recovery',
+      state: 'x'.repeat(43),
+    }),
+    { status: 'rejected' },
+  )
+  assertEquals(calls, [
+    ['claim', { flowId: FLOW_ID, purpose: 'password_recovery' }],
+  ])
+})
+
+Deno.test('wrong-purpose, replay, stale, and ambiguous claims never reach the provider', async () => {
+  for (const claimResult of [
+    { status: 'rejected' },
+    { status: 'unavailable' },
+  ] as const) {
+    const calls: unknown[] = []
+    const broker = createEmailActionPkceBroker({
+      allowedOrigin: ORIGIN,
+      derivationSecret: SECRET,
+      flowRepository: flowRepository(calls, {
+        claim: async (input) => {
+          calls.push(['claim', input])
+          return claimResult
+        },
+      }),
+      newFlowId: () => FLOW_ID,
+      now: () => 1_780_000_100_000,
+      provider: provider(calls),
+    })
+    assertEquals(
+      await broker.exchangeEmailAction({
+        authorizationCode: 'synthetic-authorization-code',
+        flowId: FLOW_ID,
+        purpose: 'email_verification',
+        state: 'wOEhI2hMGykbY7yIKclpMWfcx5KLPS6sdK-AoJld7aU',
+      }),
+      claimResult,
+    )
+    assertEquals(calls, [
+      ['claim', { flowId: FLOW_ID, purpose: 'email_verification' }],
+    ])
+  }
+})
+
+Deno.test('provider ambiguity consumes the lease and is never retried', async () => {
+  const calls: unknown[] = []
+  const broker = createEmailActionPkceBroker({
+    allowedOrigin: ORIGIN,
+    derivationSecret: SECRET,
+    flowRepository: flowRepository(calls),
+    newFlowId: () => FLOW_ID,
+    now: () => 1_780_000_100_000,
+    provider: provider(calls, {
+      exchangeCode: async (input) => {
+        calls.push(['exchange', input])
+        return { status: 'unavailable' }
+      },
+    }),
+  })
+
+  assertEquals(
+    await broker.exchangeEmailAction({
+      authorizationCode: 'synthetic-authorization-code',
+      flowId: FLOW_ID,
+      purpose: 'email_verification',
+      state: 'wOEhI2hMGykbY7yIKclpMWfcx5KLPS6sdK-AoJld7aU',
+    }),
+    { status: 'unavailable' },
+  )
+  assertEquals(calls.length, 2)
+  assertEquals(calls[0], [
+    'claim',
+    { flowId: FLOW_ID, purpose: 'email_verification' },
+  ])
+})
