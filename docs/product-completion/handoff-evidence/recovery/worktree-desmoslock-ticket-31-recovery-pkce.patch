+// deno-lint-ignore-file require-await
+
+import {
+  buildEmailActionVerificationUrl,
+  createEmailActionPkceProvider,
+} from './recovery-pkce-provider.ts'
+
+const WEB_ORIGIN = 'https://staff.desmoslock.invalid'
+const BACKEND_ORIGIN = 'https://abcdefghijklmnopqrst.supabase.co'
+const FLOW_ID = 'ABEiM0RVZneImaq7zN3u_w'
+const STATE = 'VmwQ-TLidXAtSEscvyc4s3o53n_zRIMpr58NMzGxBiE'
+const CODE_CHALLENGE = '_wXrViLS-RXLg1gJPUe-4zeoJoIg7dI3zb9iUgrDg1o'
+const TOKEN_HASH = `pkce_${'a'.repeat(56)}`
+
+function assertEquals(actual: unknown, expected: unknown): void {
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+    throw new Error(
+      `Expected ${JSON.stringify(expected)}, received ${JSON.stringify(actual)}`,
+    )
+  }
+}
+
+Deno.test('recovery provider registers only the server-derived S256 challenge and clean callback', async () => {
+  const requests: Array<{
+    readonly body: string
+    readonly headers: Headers
+    readonly init?: RequestInit
+    readonly url: string
+  }> = []
+  const provider = createEmailActionPkceProvider(
+    {
+      callback: `${WEB_ORIGIN}/`,
+      expectedSupabaseOrigin: BACKEND_ORIGIN,
+      publishableKey: 'synthetic-publishable-sentinel',
+      supabaseUrl: BACKEND_ORIGIN,
+    },
+    async (input, init) => {
+      requests.push({
+        body: String(init?.body ?? ''),
+        headers: new Headers(init?.headers),
+        init,
+        url: String(input),
+      })
+      const response = new Response('{}', {
+        headers: { 'content-type': 'application/json' },
+        status: 200,
+      })
+      Object.defineProperty(response, 'url', { value: String(input) })
+      return response
+    },
+  )
+
+  await provider.requestRecovery({
+    codeChallenge: CODE_CHALLENGE,
+    email: 'owner@example.com',
+    flowId: FLOW_ID,
+    state: STATE,
+  })
+
+  assertEquals(requests.length, 1)
+  const request = requests[0]
+  const url = new URL(request.url)
+  assertEquals(url.origin, BACKEND_ORIGIN)
+  assertEquals(url.pathname, '/auth/v1/recover')
+  assertEquals([...url.searchParams.keys()], ['redirect_to'])
+  assertEquals(
+    url.searchParams.get('redirect_to'),
+    `${WEB_ORIGIN}/?auth=recovery&flow=${FLOW_ID}&state=${STATE}`,
+  )
+  assertEquals(request.init?.method, 'POST')
+  assertEquals(request.init?.redirect, 'error')
+  assertEquals(request.headers.get('apikey'), 'synthetic-publishable-sentinel')
+  assertEquals(
+    request.headers.get('authorization'),
+    'Bearer synthetic-publishable-sentinel',
