+
+Deno.test('email-action provider exchanges once and returns only a validated session pair', async () => {
+  const requests: Array<{
+    readonly body: string
+    readonly headers: Headers
+    readonly init?: RequestInit
+    readonly url: string
+  }> = []
+  const provider = createEmailActionPkceProvider(
