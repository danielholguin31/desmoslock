index 0000000000000000000000000000000000000000..43ba09eb92d1def3790b8fdfb1261d05736a1353
--- /dev/null
+++ b/supabase/functions/_shared/recovery-pkce-provider.ts
@@ -0,0 +1,312 @@
+import {
+  isExactRecord,
+  parseCanonicalEmail,
+  parseExactRootCallback,
+} from './http.ts'
+import type { EmailActionPkcePurpose } from './recovery-pkce.ts'
+import {
+  createSupabaseHttpClient,
+  parseAuthActionLinkOrigin,
+  readBoundedJsonResponse,
+  type ServiceFetch,
+} from './supabase-http.ts'
+
+export type EmailActionProviderType = 'recovery' | 'signup'
+
+export interface EmailActionPkceProviderConfiguration {
+  readonly callback: string
+  readonly expectedSupabaseOrigin?: string
+  readonly publishableKey: string
+  readonly supabaseUrl: string
+}
+
+export interface EmailActionPkceProvider {
+  exchangeCode(input: {
+    readonly authorizationCode: string
+    readonly purpose: EmailActionPkcePurpose
+    readonly verifier: string
+  }): Promise<
+    | {
+        readonly session: {
+          readonly accessToken: string
+          readonly refreshToken: string
+        }
+        readonly status: 'ready'
+      }
+    | { readonly status: 'rejected' | 'unavailable' }
+  >
+  requestRecovery(input: {
+    readonly codeChallenge: string
+    readonly email: string
+    readonly flowId: string
+    readonly state: string
+  }): Promise<void>
+  requestEmailVerification(input: {
+    readonly codeChallenge: string
+    readonly email: string
+    readonly flowId: string
+    readonly state: string
+  }): Promise<void>
+}
+
+export function createEmailActionPkceProvider(
+  configuration: EmailActionPkceProviderConfiguration,
+  serviceFetch: ServiceFetch = globalThis.fetch,
+): EmailActionPkceProvider {
+  let callbackOrigin: string
+  try {
+    callbackOrigin = new URL(configuration.callback).origin
+  } catch {
+    throw new Error('Recovery provider configuration is invalid')
+  }
+  const callback = parseExactRootCallback(
+    configuration.callback,
+    callbackOrigin,
+  )
+  if (callback === null) {
+    throw new Error('Recovery provider configuration is invalid')
+  }
+  const client = createSupabaseHttpClient(
+    {
+      expectedOrigin: configuration.expectedSupabaseOrigin,
+      publishableKey: configuration.publishableKey,
+      supabaseUrl: configuration.supabaseUrl,
+    },
+    serviceFetch,
+  )
+
+  return {
+    async exchangeCode(input) {
+      if (
+        !isBoundedOpaqueValue(input.authorizationCode, 2_048) ||
+        (input.purpose !== 'password_recovery' &&
+          input.purpose !== 'email_verification') ||
+        !/^[A-Za-z0-9_-]{43}$/u.test(input.verifier)
+      ) {
+        return { status: 'rejected' }
+      }
+      const tokenUrl = new URL(
+        '/auth/v1/token?grant_type=pkce',
+        `${client.origin}/`,
+      ).href
+      try {
+        const response = await client.request(tokenUrl, {
+          body: JSON.stringify({
+            auth_code: input.authorizationCode,
+            code_verifier: input.verifier,
+          }),
+          headers: {
+            apikey: client.publishableKey,
+            'content-type': 'application/json',
+          },
+          method: 'POST',
+        })
+        if (
+          response.redirected ||
+          response.url !== tokenUrl ||
+          response.status !== 200
+        ) {
+          return {
+            status:
+              response.status >= 400 &&
+                response.status < 500 &&
+                response.status !== 429
+                ? 'rejected'
+                : 'unavailable',
+          }
+        }
+        const contentType = response.headers.get('content-type')
+        if (
+          contentType === null ||
+          !/^application\/json(?:;[\t ]*charset=utf-8)?$/iu.test(contentType)
+        ) {
+          return { status: 'unavailable' }
+        }
+        const session = parseProviderSession(
+          await readBoundedJsonResponse(response, 65_536),
+        )
+        return session === null
+          ? { status: 'unavailable' }
+          : { session, status: 'ready' }
+      } catch {
+        return { status: 'unavailable' }
+      }
+    },
+    async requestEmailVerification(input) {
+      await requestEmailAction({
+        callback,
+        client,
+        input,
+        kind: 'email-verification',
+      })
+    },
+    async requestRecovery(input) {
+      await requestEmailAction({ callback, client, input, kind: 'recovery' })
+    },
+  }
+}
+
+export function buildEmailActionVerificationUrl(input: {
+  readonly callback: string
+  readonly providerOrigin: string
+  readonly providerType: EmailActionProviderType
+  readonly tokenHash: string
+}): string | null {
+  const providerOrigin = parseAuthActionLinkOrigin(input.providerOrigin)
+  if (
+    providerOrigin === null ||
+    !/^pkce_[0-9a-f]{56}$/u.test(input.tokenHash) ||
+    (input.providerType !== 'recovery' && input.providerType !== 'signup') ||
+    !isExactEmailActionCallback(input.callback, input.providerType)
+  ) {
+    return null
+  }
+  const providerUrl = new URL('/auth/v1/verify', `${providerOrigin}/`)
+  providerUrl.searchParams.append('token', input.tokenHash)
+  providerUrl.searchParams.append('type', input.providerType)
+  providerUrl.searchParams.append('redirect_to', input.callback)
+  return providerUrl.href
+}
+
+async function requestEmailAction(input: {
+  readonly callback: string
+  readonly client: ReturnType<typeof createSupabaseHttpClient>
+  readonly input: {
+    readonly codeChallenge: string
+    readonly email: string
+    readonly flowId: string
+    readonly state: string
+  }
+  readonly kind: 'email-verification' | 'recovery'
+}): Promise<void> {
+  if (
+    parseCanonicalEmail(input.input.email) === null ||
+    !/^[A-Za-z0-9_-]{22}$/u.test(input.input.flowId) ||
+    !/^[A-Za-z0-9_-]{43}$/u.test(input.input.state) ||
+    !/^[A-Za-z0-9_-]{43}$/u.test(input.input.codeChallenge)
+  ) {
+    throw new Error('Email-action provider input is invalid')
+  }
+  const targetCallback = new URL(input.callback)
+  targetCallback.searchParams.append('auth', input.kind)
+  targetCallback.searchParams.append('flow', input.input.flowId)
+  targetCallback.searchParams.append('state', input.input.state)
+  const providerUrl = new URL(
+    input.kind === 'recovery' ? '/auth/v1/recover' : '/auth/v1/resend',
+    `${input.client.origin}/`,
+  )
+  providerUrl.searchParams.set('redirect_to', targetCallback.href)
+  const body = input.kind === 'recovery'
+    ? {
+        code_challenge: input.input.codeChallenge,
+        code_challenge_method: 's256',
+        email: input.input.email,
+      }
+    : {
+        code_challenge: input.input.codeChallenge,
+        code_challenge_method: 's256',
+        email: input.input.email,
+        type: 'signup',
+      }
+  const response = await input.client.request(providerUrl.href, {
+    body: JSON.stringify(body),
+    headers: {
+      apikey: input.client.publishableKey,
+      authorization: `Bearer ${input.client.publishableKey}`,
+      'content-type': 'application/json',
+    },
+    method: 'POST',
+  })
+  if (
+    response.status !== 200 ||
+    response.redirected ||
+    response.url !== providerUrl.href
+  ) {
+    throw new Error('Email-action provider request is unavailable')
+  }
+}
+
+function isExactEmailActionCallback(
+  value: string,
+  providerType: EmailActionProviderType,
+): boolean {
+  let callback: URL
+  try {
+    callback = new URL(value)
+  } catch {
+    return false
+  }
+  const entries = [...callback.searchParams.entries()]
+  const expectedAuth = providerType === 'recovery'
+    ? 'recovery'
+    : 'email-verification'
+  return (
+    parseExactRootCallback(`${callback.origin}/`, callback.origin) !== null &&
+    callback.pathname === '/' &&
+    callback.hash === '' &&
+    entries.length === 3 &&
+    entries[0]?.[0] === 'auth' &&
+    entries[0]?.[1] === expectedAuth &&
+    entries[1]?.[0] === 'flow' &&
+    /^[A-Za-z0-9_-]{22}$/u.test(entries[1]?.[1] ?? '') &&
+    entries[2]?.[0] === 'state' &&
+    /^[A-Za-z0-9_-]{43}$/u.test(entries[2]?.[1] ?? '')
+  )
+}
+
+function isBoundedOpaqueValue(value: unknown, maximumLength: number): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length <= maximumLength &&
+    value === value.trim() &&
+    [...value].every((character) => {
+      const codePoint = character.codePointAt(0)
+      return codePoint !== undefined && codePoint >= 0x21 && codePoint <= 0x7e
+    })
+  )
+}
+
+function parseProviderSession(value: unknown): {
+  readonly accessToken: string
+  readonly refreshToken: string
+} | null {
+  if (
+    !isExactRecord(value, [
+      'access_token',
+      'expires_at',
+      'expires_in',
+      'refresh_token',
+      'token_type',
+      'user',
+    ]) &&
+    !isExactRecord(value, [
+      'access_token',
+      'expires_in',
+      'refresh_token',
+      'token_type',
+      'user',
+    ])
+  ) {
+    return null
+  }
+  if (
+    !isBoundedOpaqueValue(value.access_token, 16_384) ||
+    !isBoundedOpaqueValue(value.refresh_token, 16_384) ||
+    value.token_type !== 'bearer' ||
+    !Number.isSafeInteger(value.expires_in) ||
+    (value.expires_in as number) <= 0 ||
+    (Object.hasOwn(value, 'expires_at') &&
+      (!Number.isSafeInteger(value.expires_at) ||
+        (value.expires_at as number) <= 0)) ||
+    typeof value.user !== 'object' ||
+    value.user === null ||
+    Array.isArray(value.user)
+  ) {
+    return null
+  }
+  return {
+    accessToken: value.access_token,
+    refreshToken: value.refresh_token,
+  }
+}
