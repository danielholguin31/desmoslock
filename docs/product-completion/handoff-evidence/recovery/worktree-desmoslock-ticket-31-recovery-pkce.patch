+    `${BACKEND_ORIGIN}/auth/v1/verify?token=${TOKEN_HASH}&type=recovery&redirect_to=${encodeURIComponent(`${WEB_ORIGIN}/?auth=recovery&flow=${FLOW_ID}&state=${STATE}`)}`,
+  )
+  assertEquals(
+    buildEmailActionVerificationUrl({
