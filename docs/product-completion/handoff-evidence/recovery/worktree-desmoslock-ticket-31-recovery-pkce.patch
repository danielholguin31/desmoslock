+  const request = requests[0]
+  const url = new URL(request.url)
+  assertEquals(url.origin, BACKEND_ORIGIN)
+  assertEquals(url.pathname, '/auth/v1/token')
+  assertEquals([...url.searchParams.entries()], [['grant_type', 'pkce']])
+  assertEquals(request.init?.method, 'POST')
+  assertEquals(request.init?.redirect, 'error')
+  assertEquals(request.headers.get('apikey'), 'synthetic-publishable-sentinel')
+  assertEquals(request.headers.get('authorization'), null)
+  assertEquals(request.headers.get('content-type'), 'application/json')
+  assertEquals(JSON.parse(request.body), {
+    auth_code: 'synthetic-authorization-code',
+    code_verifier: 'LJamG9H31kYG-QMFogiTmxjJ5LHNHQBfZx4ibhqAOVk',
+  })
+})
+
+Deno.test('provider failures fail closed without a retry or response detail', async () => {
+  for (const scenario of [
+    { expected: 'rejected', status: 400 },
