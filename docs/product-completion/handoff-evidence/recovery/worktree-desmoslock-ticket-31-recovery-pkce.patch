index 0000000000000000000000000000000000000000..10e5b4a120488bad2525a2a1a733df9652647048
--- /dev/null
+++ b/supabase/functions/_shared/recovery-pkce.ts
@@ -0,0 +1,142 @@
+import { parseExactOrigin } from './http.ts'
+
+export type EmailActionPkcePurpose =
+  | 'email_verification'
+  | 'password_recovery'
+
+export interface EmailActionPkceContext {
+  readonly expiresAt: number
+  readonly flowId: string
+  readonly intendedOrigin: string
+  readonly issuedAt: number
+  readonly purpose: EmailActionPkcePurpose
+}
+
+export interface EmailActionPkceMaterial {
+  readonly codeChallenge: string
+  readonly state: string
+  readonly verifier: string
+}
+
+const textEncoder = new TextEncoder()
+const derivationVersion = 'desmoslock.staff-email-action-pkce.v1'
+
+export async function createS256Challenge(verifier: string): Promise<string> {
+  const digest = await crypto.subtle.digest(
+    'SHA-256',
+    textEncoder.encode(verifier),
+  )
+  return encodeBase64Url(new Uint8Array(digest))
+}
+
+export async function deriveEmailActionPkceMaterial(
+  encodedSecret: string,
+  context: EmailActionPkceContext,
+): Promise<EmailActionPkceMaterial> {
+  if (!/^[A-Za-z0-9_-]{43}$/u.test(encodedSecret)) {
+    throw new Error('Recovery PKCE configuration is invalid')
+  }
+  if (!isEmailActionPkceContext(context)) {
+    throw new Error('Recovery PKCE context is invalid')
+  }
+  const secret = decodeBase64Url(encodedSecret)
+  if (secret.length !== 32 || encodeBase64Url(secret) !== encodedSecret) {
+    throw new Error('Recovery PKCE configuration is invalid')
+  }
+  const key = await crypto.subtle.importKey(
+    'raw',
+    secret,
+    'HKDF',
+    false,
+    ['deriveBits'],
+  )
+  const derive = async (use: 'state' | 'verifier'): Promise<string> => {
+    const contextInput = [
+      derivationVersion,
+      `flow=${context.flowId}`,
+      `origin=${context.intendedOrigin}`,
+      `purpose=${context.purpose}`,
+      `issued=${context.issuedAt}`,
+      `expires=${context.expiresAt}`,
+    ].join('\n')
+    const bits = await crypto.subtle.deriveBits(
+      {
+        hash: 'SHA-256',
+        info: textEncoder.encode(`${contextInput}\nuse=${use}`),
+        name: 'HKDF',
+        salt: textEncoder.encode(
+          `${derivationVersion}\npurpose=${context.purpose}`,
+        ),
+      },
+      key,
+      256,
+    )
+    return encodeBase64Url(new Uint8Array(bits))
+  }
+  const [state, verifier] = await Promise.all([
+    derive('state'),
+    derive('verifier'),
+  ])
+  return {
+    codeChallenge: await createS256Challenge(verifier),
+    state,
+    verifier,
+  }
+}
+
+export async function matchesEmailActionPkceState(
+  encodedSecret: string,
+  input: {
+    readonly context: EmailActionPkceContext
+    readonly state: string
+  },
+): Promise<boolean> {
+  if (!/^[A-Za-z0-9_-]{43}$/u.test(input.state)) return false
+  const expected = await deriveEmailActionPkceMaterial(
+    encodedSecret,
+    input.context,
+  )
+  const actualBytes = decodeBase64Url(input.state)
+  const expectedBytes = decodeBase64Url(expected.state)
+  let difference = actualBytes.length ^ expectedBytes.length
+  for (let index = 0; index < expectedBytes.length; index += 1) {
+    difference |= (actualBytes[index] ?? 0) ^ expectedBytes[index]
+  }
+  return difference === 0
+}
+
+function isEmailActionPkceContext(
+  context: EmailActionPkceContext,
+): boolean {
+  const lifetime = context.expiresAt - context.issuedAt
+  return (
+    /^[A-Za-z0-9_-]{22}$/u.test(context.flowId) &&
+    parseExactOrigin(context.intendedOrigin) === context.intendedOrigin &&
+    (context.purpose === 'password_recovery' ||
+      context.purpose === 'email_verification') &&
+    Number.isSafeInteger(context.issuedAt) &&
+    context.issuedAt >= 0 &&
+    Number.isSafeInteger(context.expiresAt) &&
+    lifetime >= 60 &&
+    lifetime <= 900
+  )
+}
+
+function decodeBase64Url(value: string): Uint8Array<ArrayBuffer> {
+  const standard = value.replace(/-/gu, '+').replace(/_/gu, '/')
+  const decoded = atob(`${standard}=`)
+  const bytes = new Uint8Array(decoded.length)
+  for (let index = 0; index < decoded.length; index += 1) {
+    bytes[index] = decoded.charCodeAt(index)
+  }
+  return bytes
+}
+
+function encodeBase64Url(bytes: Uint8Array): string {
+  let binary = ''
+  for (const byte of bytes) binary += String.fromCharCode(byte)
+  return btoa(binary)
+    .replace(/=+$/u, '')
+    .replace(/\+/gu, '-')
+    .replace(/\//gu, '_')
+}
