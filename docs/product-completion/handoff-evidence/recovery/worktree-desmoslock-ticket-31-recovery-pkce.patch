index 0000000000000000000000000000000000000000..52ba3d251c0136eeaf040155fcf8047e99d73cea
--- /dev/null
+++ b/supabase/functions/_shared/email-action-pkce-repository.test.ts
@@ -0,0 +1,211 @@
+// deno-lint-ignore-file require-await
+
+import { createEmailActionFlowRepository } from './email-action-pkce-repository.ts'
+
+const BACKEND_ORIGIN = 'https://abcdefghijklmnopqrst.supabase.co'
+const FLOW_ID = 'ABEiM0RVZneImaq7zN3u_w'
+
+function assertEquals(actual: unknown, expected: unknown): void {
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+    throw new Error(
+      `Expected ${JSON.stringify(expected)}, received ${JSON.stringify(actual)}`,
+    )
+  }
+}
+
+Deno.test('flow repository calls the three exact service-only lifecycle RPCs', async () => {
+  const requests: Array<{
+    body: unknown
+    headers: Headers
+    url: string
+  }> = []
+  const results = [
+    [{
+      code: 'flow_initiating',
+      expires_at_epoch: 1_780_000_900,
+      intended_origin: 'https://staff.desmoslock.invalid',
+      issued_at_epoch: 1_780_000_000,
+      purpose: 'password_recovery',
+    }],
+    [{ code: 'flow_ready' }],
+    [{
+      code: 'flow_claimed',
+      expires_at_epoch: 1_780_000_900,
+      intended_origin: 'https://staff.desmoslock.invalid',
+      issued_at_epoch: 1_780_000_000,
+      purpose: 'password_recovery',
+    }],
+  ]
+  const repository = createEmailActionFlowRepository(
+    {
+      expectedSupabaseOrigin: BACKEND_ORIGIN,
+      serviceRoleKey: 'synthetic-service-role-sentinel',
+      supabaseUrl: BACKEND_ORIGIN,
+    },
+    async (input, init) => {
+      const url = String(input)
+      requests.push({
+        body: JSON.parse(String(init?.body)),
+        headers: new Headers(init?.headers),
+        url,
+      })
+      const response = Response.json(results[requests.length - 1], {
+        status: 200,
+      })
+      Object.defineProperty(response, 'url', { value: url })
+      return response
+    },
+  )
+
+  assertEquals(
+    await repository.begin({
+      flowId: FLOW_ID,
+      intendedOrigin: 'https://staff.desmoslock.invalid',
+      lifetimeSeconds: 900,
+      purpose: 'password_recovery',
+    }),
+    {
+      context: {
+        expiresAt: 1_780_000_900,
+        flowId: FLOW_ID,
+        intendedOrigin: 'https://staff.desmoslock.invalid',
+        issuedAt: 1_780_000_000,
+        purpose: 'password_recovery',
+      },
+      status: 'initiating',
+    },
+  )
+  assertEquals(
+    await repository.activate({
+      flowId: FLOW_ID,
+      purpose: 'password_recovery',
+    }),
+    'ready',
+  )
+  assertEquals(
+    await repository.claim({
+      flowId: FLOW_ID,
+      purpose: 'password_recovery',
+    }),
+    {
+      context: {
+        expiresAt: 1_780_000_900,
+        flowId: FLOW_ID,
+        intendedOrigin: 'https://staff.desmoslock.invalid',
+        issuedAt: 1_780_000_000,
+        purpose: 'password_recovery',
+      },
+      status: 'claimed',
+    },
+  )
+
+  assertEquals(
+    requests.map((request) => ({
+      body: request.body,
+      path: new URL(request.url).pathname,
+    })),
+    [
+      {
+        body: {
+          flow_id: FLOW_ID,
+          intended_origin: 'https://staff.desmoslock.invalid',
+          lifetime_seconds: 900,
+          purpose: 'password_recovery',
+        },
+        path:
+          '/rest/v1/rpc/internal_begin_staff_email_action_pkce_flow',
+      },
+      {
+        body: { flow_id: FLOW_ID, purpose: 'password_recovery' },
+        path:
+          '/rest/v1/rpc/internal_activate_staff_email_action_pkce_flow',
+      },
+      {
+        body: { flow_id: FLOW_ID, purpose: 'password_recovery' },
+        path:
+          '/rest/v1/rpc/internal_claim_staff_email_action_pkce_flow',
+      },
+    ],
+  )
+  for (const request of requests) {
+    assertEquals(request.headers.get('accept-profile'), 'desmoslock_v2')
+    assertEquals(request.headers.get('content-profile'), 'desmoslock_v2')
+    assertEquals(request.headers.get('content-type'), 'application/json')
+    assertEquals(request.headers.get('apikey'), 'synthetic-service-role-sentinel')
+    assertEquals(
+      request.headers.get('authorization'),
+      'Bearer synthetic-service-role-sentinel',
+    )
+  }
+})
+
+Deno.test('repository maps every denied claim to one opaque rejection', async () => {
+  let calls = 0
+  const repository = createEmailActionFlowRepository(
+    {
+      expectedSupabaseOrigin: BACKEND_ORIGIN,
+      serviceRoleKey: 'synthetic-service-role-sentinel',
+      supabaseUrl: BACKEND_ORIGIN,
+    },
+    async (input) => {
+      calls += 1
+      const response = Response.json([{
+        code: 'flow_rejected',
+        expires_at_epoch: null,
+        intended_origin: null,
+        issued_at_epoch: null,
+        purpose: null,
+      }])
+      Object.defineProperty(response, 'url', { value: String(input) })
+      return response
+    },
+  )
+
+  assertEquals(
+    await repository.claim({
+      flowId: FLOW_ID,
+      purpose: 'email_verification',
+    }),
+    { status: 'rejected' },
+  )
+  assertEquals(calls, 1)
+})
+
+Deno.test('repository fails malformed, redirected, and ambiguous responses closed', async () => {
+  const responses = [
+    Response.json([{
+      code: 'flow_claimed',
+      expires_at_epoch: 1_780_000_900,
+      intended_origin: 'https://staff.desmoslock.invalid',
+      issued_at_epoch: 1_780_000_000,
+      leaked: 'forbidden',
+      purpose: 'password_recovery',
+    }]),
+    new Response('{}', { status: 503 }),
+    Response.json([]),
+  ]
+  let calls = 0
+  const repository = createEmailActionFlowRepository(
+    {
+      expectedSupabaseOrigin: BACKEND_ORIGIN,
+      serviceRoleKey: 'synthetic-service-role-sentinel',
+      supabaseUrl: BACKEND_ORIGIN,
+    },
+    async (input) => {
