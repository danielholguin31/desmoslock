+++ b/supabase/functions/_shared/recovery-pkce.test.ts
@@ -0,0 +1,146 @@
+import {
+  createS256Challenge,
+  deriveEmailActionPkceMaterial,
+  matchesEmailActionPkceState,
+  type EmailActionPkceContext,
+} from './recovery-pkce.ts'
+
+function assertEquals(actual: unknown, expected: unknown): void {
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+    throw new Error(
+      `Expected ${JSON.stringify(expected)}, received ${JSON.stringify(actual)}`,
+    )
+  }
+}
+
+async function assertRejects(action: () => Promise<unknown>): Promise<void> {
+  try {
+    await action()
+  } catch {
+    return
+  }
+  throw new Error('Expected action to reject')
+}
+
+Deno.test('email-action PKCE derivation matches the password-recovery synthetic HKDF vector', async () => {
+  const result = await deriveEmailActionPkceMaterial(
+    'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8',
+    {
+      expiresAt: 1_780_000_900,
+      flowId: 'ABEiM0RVZneImaq7zN3u_w',
+      intendedOrigin: 'https://staff.desmoslock.invalid',
+      issuedAt: 1_780_000_000,
+      purpose: 'password_recovery',
+    },
+  )
+
+  assertEquals(result, {
+    codeChallenge: '_wXrViLS-RXLg1gJPUe-4zeoJoIg7dI3zb9iUgrDg1o',
+    state: 'VmwQ-TLidXAtSEscvyc4s3o53n_zRIMpr58NMzGxBiE',
+    verifier: 'LJamG9H31kYG-QMFogiTmxjJ5LHNHQBfZx4ibhqAOVk',
+  })
+})
+
+Deno.test('S256 challenge matches RFC 7636 Appendix B', async () => {
+  assertEquals(
+    await createS256Challenge(
+      'dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk',
+    ),
+    'E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM',
+  )
+})
+
+Deno.test('email-action PKCE derivation rejects every noncanonical server secret', async () => {
+  const context = {
+    expiresAt: 1_780_000_900,
+    flowId: 'ABEiM0RVZneImaq7zN3u_w',
+    intendedOrigin: 'https://staff.desmoslock.invalid',
+    issuedAt: 1_780_000_000,
+    purpose: 'password_recovery',
+  } as const
+  for (const secret of [
+    '',
+    'A'.repeat(42),
+    'A'.repeat(44),
+    `${'A'.repeat(42)}=`,
+    `${'A'.repeat(42)}+`,
+    `${'A'.repeat(42)}/`,
+  ]) {
+    await assertRejects(() => deriveEmailActionPkceMaterial(secret, context))
+  }
+})
+
+Deno.test('email-action PKCE derivation rejects ambiguous or stale flow context', async () => {
+  const secret = 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8'
+  const valid = {
+    expiresAt: 1_780_000_900,
+    flowId: 'ABEiM0RVZneImaq7zN3u_w',
+    intendedOrigin: 'https://staff.desmoslock.invalid',
+    issuedAt: 1_780_000_000,
+    purpose: 'password_recovery',
+  } as const
+  const invalid: unknown[] = [
+    { ...valid, flowId: 'f'.repeat(21) },
+    { ...valid, flowId: `${'f'.repeat(21)}=` },
+    { ...valid, intendedOrigin: 'http://staff.desmoslock.invalid' },
+    { ...valid, intendedOrigin: `${valid.intendedOrigin}/` },
+    { ...valid, purpose: 'recovery' },
+    { ...valid, issuedAt: -1 },
+    { ...valid, issuedAt: valid.issuedAt + 0.5 },
+    { ...valid, expiresAt: valid.issuedAt },
+    { ...valid, expiresAt: valid.issuedAt + 59 },
+    { ...valid, expiresAt: valid.issuedAt + 901 },
+  ]
+  for (const context of invalid) {
+    await assertRejects(() =>
+      deriveEmailActionPkceMaterial(secret, context as EmailActionPkceContext),
+    )
+  }
+})
+
+Deno.test('email verification is a closed, cryptographically separated purpose', async () => {
+  const secret = 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8'
+  const recovery = await deriveEmailActionPkceMaterial(secret, {
+    expiresAt: 1_780_000_900,
+    flowId: 'ABEiM0RVZneImaq7zN3u_w',
+    intendedOrigin: 'https://staff.desmoslock.invalid',
+    issuedAt: 1_780_000_000,
+    purpose: 'password_recovery',
+  })
+  const verification = await deriveEmailActionPkceMaterial(secret, {
+    expiresAt: 1_780_000_900,
+    flowId: 'ABEiM0RVZneImaq7zN3u_w',
+    intendedOrigin: 'https://staff.desmoslock.invalid',
+    issuedAt: 1_780_000_000,
+    purpose: 'email_verification',
+  })
+
+  assertEquals(verification, {
+    codeChallenge: 'kGdI0dF8ONoLc3VxahH3qyACDIT8vv3Ieo99Ir4ItRU',
+    state: 'wOEhI2hMGykbY7yIKclpMWfcx5KLPS6sdK-AoJld7aU',
+    verifier: 'SL-MTH5RQWHUVE3rmqg_ohVuzxGCnYTDCOISCCAgaM0',
+  })
+  assertEquals(await matchesEmailActionPkceState(secret, {
+    context: {
+      expiresAt: 1_780_000_900,
+      flowId: 'ABEiM0RVZneImaq7zN3u_w',
+      intendedOrigin: 'https://staff.desmoslock.invalid',
+      issuedAt: 1_780_000_000,
+      purpose: 'password_recovery',
+    },
+    state: recovery.state,
+  }), true)
+  assertEquals(await matchesEmailActionPkceState(secret, {
+    context: {
+      expiresAt: 1_780_000_900,
+      flowId: 'ABEiM0RVZneImaq7zN3u_w',
+      intendedOrigin: 'https://staff.desmoslock.invalid',
+      issuedAt: 1_780_000_000,
+      purpose: 'email_verification',
+    },
+    state: recovery.state,
+  }), false)
+  assertEquals(recovery.state === verification.state, false)
+  assertEquals(recovery.verifier === verification.verifier, false)
+  assertEquals(recovery.codeChallenge === verification.codeChallenge, false)
+})
