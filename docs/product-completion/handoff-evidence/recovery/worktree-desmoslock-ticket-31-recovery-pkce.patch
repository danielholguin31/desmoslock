+  assertEquals(request.init?.redirect, 'error')
+  assertEquals(request.headers.get('apikey'), 'synthetic-publishable-sentinel')
+  assertEquals(
+    request.headers.get('authorization'),
+    'Bearer synthetic-publishable-sentinel',
+  )
+  assertEquals(request.headers.get('content-type'), 'application/json')
+  assertEquals(JSON.parse(request.body), {
+    code_challenge: CODE_CHALLENGE,
+    code_challenge_method: 's256',
+    email: 'owner@example.com',
+    type: 'signup',
+  })
+})
+
+Deno.test('verification navigation preserves the exact PKCE-prefixed template token', () => {
+  assertEquals(
+    buildEmailActionVerificationUrl({
+      callback: `${WEB_ORIGIN}/?auth=recovery&flow=${FLOW_ID}&state=${STATE}`,
+      providerOrigin: BACKEND_ORIGIN,
+      providerType: 'recovery',
