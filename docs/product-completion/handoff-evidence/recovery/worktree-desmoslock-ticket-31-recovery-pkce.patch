+
+Deno.test('provider rejects malformed, redirected, cross-purpose, and overbroad session data', async () => {
+  const responses: Response[] = [
+    Response.json({
+      access_token: 'synthetic-access-value',
+      expires_in: 3_600,
+      refresh_token: 'synthetic-refresh-value',
+      token_type: 'bearer',
+      unexpected: true,
+      user: {},
+    }),
+    new Response('{', { headers: { 'content-type': 'application/json' } }),
+    new Response('{}', { headers: { 'content-type': 'text/plain' } }),
+  ]
+  let calls = 0
+  const provider = createEmailActionPkceProvider(
+    {
+      callback: `${WEB_ORIGIN}/`,
+      expectedSupabaseOrigin: BACKEND_ORIGIN,
