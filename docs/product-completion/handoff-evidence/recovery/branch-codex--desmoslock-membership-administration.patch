+      }));
+      const perform = vi.spyOn(adapter, "perform");
+      const order: string[] = [];
+      const controller = createController(adapter, {
+        clear: () => {
+          order.push("clear");
+        },
+      });
+      await controller.dispatch({ type: "bootstrap" });
+      await controller.dispatch({
+        profileId: "profile-target-teacher",
