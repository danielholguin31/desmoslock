diff --git a/packages/contracts/src/authorization-command.ts b/packages/contracts/src/authorization-command.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e9c65081b6b37b3a1b57a7f84af888eac1da5881
--- /dev/null
+++ b/packages/contracts/src/authorization-command.ts
@@ -0,0 +1,297 @@
+import {
+  schoolSettingKeys,
+  staffAuthorizationActions,
+  type AuthoritativeStaffActor,
+  type MembershipRole,
+  type MembershipStatus,
+  type StaffAuthorizationAuditIntent,
+  type StaffAuthorizationRequest,
+} from "@desmoslock/domain";
+
+export const authorizationCommandActions = staffAuthorizationActions;
+
+export type StaffAuthorizationCommand =
+  | {
+      readonly action: "school.list" | "school.read";
+      readonly schoolId: string;
+    }
+  | { readonly action: "school.settings.list"; readonly schoolId: string }
+  | {
+      readonly action: "school.setting.read" | "school.setting.update";
+      readonly schoolId: string;
+      readonly settingKey: (typeof schoolSettingKeys)[number];
+    }
+  | {
+      readonly action: "membership.list";
+      readonly schoolId: string;
+      readonly targetRole: MembershipRole;
+      readonly targetStatus: MembershipStatus;
+    }
+  | {
+      readonly action: "membership.read";
+      readonly membershipId: string;
+    }
+  | {
+      readonly action: "membership.invite";
+      readonly requestedRole: MembershipRole;
+      readonly schoolId: string;
+    }
+  | {
+      readonly action: "membership.change-role";
+      readonly membershipId: string;
+      readonly requestedRole: MembershipRole;
+    }
+  | {
+      readonly action:
+        "membership.suspend" | "membership.reactivate" | "membership.remove";
+      readonly membershipId: string;
+    }
+  | { readonly action: "test.list"; readonly schoolId: string }
+  | { readonly action: "test.create"; readonly schoolId: string }
+  | {
+      readonly action:
+        | "test.read"
+        | "test.update"
+        | "test.start"
+        | "test.end"
+        | "test.archive";
+      readonly testId: string;
+    };
+
+export type StaffAuthorizationCommandParseCode =
+  | "malformed-command"
+  | "unsupported-action"
+  | "unexpected-fields"
+  | "invalid-identifier"
+  | "invalid-target-role"
+  | "invalid-target-status"
+  | "invalid-setting";
+
+export type StaffAuthorizationCommandParseResult =
+  | { readonly ok: true; readonly value: StaffAuthorizationCommand }
+  | { readonly code: StaffAuthorizationCommandParseCode; readonly ok: false };
+
+export interface StaffAuthorizationContextResolver {
+  /**
+   * Backend-only adapter seam. Resolve the current session's Membership and
+   * every target field from authoritative storage on each call; never accept
+   * actor authority from the command or reuse a cached role/status snapshot.
+   * Collection adapters must constrain results to the resolved role, status,
+   * ownership, School, and exported School-setting allowlist.
+   */
+  resolveForCurrentSession(command: StaffAuthorizationCommand): Promise<{
+    readonly actor: AuthoritativeStaffActor | null;
+    readonly request: StaffAuthorizationRequest;
+  }>;
+}
+
+export interface StaffAuthorizationAuditWriter {
+  /** Persist only the evaluator's minimized, immutable audit intent. */
+  append(intent: StaffAuthorizationAuditIntent): Promise<void>;
+}
+
+const identifierPattern =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+const roleSet = new Set<MembershipRole>(["owner", "administrator", "teacher"]);
+const statusSet = new Set<MembershipStatus>(["active", "suspended", "removed"]);
+const actionSet = new Set<string>(authorizationCommandActions);
+const settingSet = new Set<string>(schoolSettingKeys);
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value) as unknown;
+  return prototype === Object.prototype || prototype === null;
+}
+
+function hasExactKeys(
+  value: Record<string, unknown>,
+  expectedKeys: readonly string[],
+): boolean {
+  const actualKeys = Object.keys(value);
+  return (
+    actualKeys.length === expectedKeys.length &&
+    expectedKeys.every((key) => Object.hasOwn(value, key))
+  );
+}
+
+function isIdentifier(value: unknown): value is string {
+  return typeof value === "string" && identifierPattern.test(value);
+}
+
+function isRole(value: unknown): value is MembershipRole {
+  return typeof value === "string" && roleSet.has(value as MembershipRole);
+}
+
+function isStatus(value: unknown): value is MembershipStatus {
+  return typeof value === "string" && statusSet.has(value as MembershipStatus);
+}
+
+function failure(
+  code: StaffAuthorizationCommandParseCode,
+): StaffAuthorizationCommandParseResult {
+  return { code, ok: false };
+}
+
+function parseSchoolIdCommand(
+  input: Record<string, unknown>,
+  action:
+    | "school.list"
+    | "school.read"
+    | "school.settings.list"
+    | "test.list"
+    | "test.create",
+): StaffAuthorizationCommandParseResult {
+  if (!hasExactKeys(input, ["action", "schoolId"])) {
+    return failure("unexpected-fields");
+  }
+  if (!isIdentifier(input.schoolId)) {
+    return failure("invalid-identifier");
+  }
+  return { ok: true, value: { action, schoolId: input.schoolId } };
+}
+
+function parseMembershipIdCommand(
+  input: Record<string, unknown>,
+  action:
+    | "membership.read"
+    | "membership.suspend"
+    | "membership.reactivate"
+    | "membership.remove",
+): StaffAuthorizationCommandParseResult {
+  if (!hasExactKeys(input, ["action", "membershipId"])) {
+    return failure("unexpected-fields");
+  }
+  if (!isIdentifier(input.membershipId)) {
+    return failure("invalid-identifier");
+  }
+  return { ok: true, value: { action, membershipId: input.membershipId } };
+}
+
+export function parseStaffAuthorizationCommand(
+  input: unknown,
+): StaffAuthorizationCommandParseResult {
+  if (!isRecord(input)) {
+    return failure("malformed-command");
+  }
+  const action = input.action;
+  if (typeof action !== "string" || !actionSet.has(action)) {
+    return failure("unsupported-action");
+  }
+
+  switch (action) {
+    case "school.list":
+    case "school.read":
+    case "school.settings.list":
+    case "test.list":
+    case "test.create":
+      return parseSchoolIdCommand(input, action);
+    case "school.setting.read":
+    case "school.setting.update":
+      if (!hasExactKeys(input, ["action", "schoolId", "settingKey"])) {
+        return failure("unexpected-fields");
+      }
+      if (!isIdentifier(input.schoolId)) {
+        return failure("invalid-identifier");
+      }
+      if (
+        typeof input.settingKey !== "string" ||
+        !settingSet.has(input.settingKey)
+      ) {
+        return failure("invalid-setting");
+      }
+      return {
+        ok: true,
+        value: {
+          action,
+          schoolId: input.schoolId,
+          settingKey: input.settingKey as (typeof schoolSettingKeys)[number],
+        },
+      };
+    case "membership.list":
+      if (
+        !hasExactKeys(input, [
+          "action",
+          "schoolId",
+          "targetRole",
+          "targetStatus",
+        ])
+      ) {
+        return failure("unexpected-fields");
+      }
+      if (!isIdentifier(input.schoolId)) {
+        return failure("invalid-identifier");
+      }
+      if (!isRole(input.targetRole)) {
+        return failure("invalid-target-role");
+      }
+      if (!isStatus(input.targetStatus)) {
+        return failure("invalid-target-status");
+      }
+      return {
+        ok: true,
+        value: {
+          action,
+          schoolId: input.schoolId,
+          targetRole: input.targetRole,
+          targetStatus: input.targetStatus,
+        },
+      };
+    case "membership.read":
+    case "membership.suspend":
+    case "membership.reactivate":
+    case "membership.remove":
+      return parseMembershipIdCommand(input, action);
+    case "membership.invite":
+      if (!hasExactKeys(input, ["action", "requestedRole", "schoolId"])) {
+        return failure("unexpected-fields");
+      }
+      if (!isIdentifier(input.schoolId)) {
+        return failure("invalid-identifier");
+      }
+      if (!isRole(input.requestedRole)) {
+        return failure("invalid-target-role");
+      }
+      return {
+        ok: true,
+        value: {
+          action,
+          requestedRole: input.requestedRole,
+          schoolId: input.schoolId,
+        },
+      };
+    case "membership.change-role":
+      if (!hasExactKeys(input, ["action", "membershipId", "requestedRole"])) {
+        return failure("unexpected-fields");
+      }
+      if (!isIdentifier(input.membershipId)) {
+        return failure("invalid-identifier");
+      }
+      if (!isRole(input.requestedRole)) {
+        return failure("invalid-target-role");
+      }
+      return {
+        ok: true,
+        value: {
+          action,
+          membershipId: input.membershipId,
+          requestedRole: input.requestedRole,
+        },
+      };
+    case "test.read":
+    case "test.update":
+    case "test.start":
+    case "test.end":
+    case "test.archive":
+      if (!hasExactKeys(input, ["action", "testId"])) {
+        return failure("unexpected-fields");
+      }
+      if (!isIdentifier(input.testId)) {
+        return failure("invalid-identifier");
+      }
+      return { ok: true, value: { action, testId: input.testId } };
+  }
+
+  return failure("unsupported-action");
+}
