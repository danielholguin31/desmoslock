diff --git a/packages/domain/src/membership-role-storage-adapter.ts b/packages/domain/src/membership-role-storage-adapter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c0c12b9efea0306dd2570625a08e73f01d9e02ff
--- /dev/null
+++ b/packages/domain/src/membership-role-storage-adapter.ts
@@ -0,0 +1,28 @@
+import type { MembershipRole } from "./school-authorization.js";
+
+export type StorageMembershipRole = "owner" | "admin" | "teacher";
+
+export const membershipRoleStorageAdapter = Object.freeze({
+  toProduct(value: string): MembershipRole | null {
+    switch (value) {
+      case "owner":
+        return "owner";
+      case "admin":
+        return "administrator";
+      case "teacher":
+        return "teacher";
+      default:
+        return null;
+    }
+  },
+  toStorage(value: MembershipRole): StorageMembershipRole {
+    switch (value) {
+      case "owner":
+        return "owner";
+      case "administrator":
+        return "admin";
+      case "teacher":
+        return "teacher";
+    }
+  },
+});
diff --git a/packages/domain/src/school-authorization.ts b/packages/domain/src/school-authorization.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ebfac1399c49c32cc0084c59e158b286d2271f2f
--- /dev/null
+++ b/packages/domain/src/school-authorization.ts
@@ -0,0 +1,658 @@
+export type MembershipRole = "owner" | "administrator" | "teacher";
+
+export type MembershipStatus = "active" | "suspended" | "removed";
+
+export const staffAuthorizationActions = Object.freeze([
+  "school.list",
+  "school.read",
+  "school.settings.list",
+  "school.setting.read",
+  "school.setting.update",
+  "membership.list",
+  "membership.read",
+  "membership.invite",
+  "membership.change-role",
+  "membership.suspend",
+  "membership.reactivate",
+  "membership.remove",
+  "test.list",
+  "test.create",
+  "test.read",
+  "test.update",
+  "test.start",
+  "test.end",
+  "test.archive",
+] as const);
+
+export type StaffAuthorizationAction =
+  (typeof staffAuthorizationActions)[number];
+
+export const schoolSettingKeys = Object.freeze(["displayName"] as const);
+
+export type SchoolSettingKey = (typeof schoolSettingKeys)[number];
+
+export type StaffAuthorizationRule =
+  | "own-school-only"
+  | "administrator-or-teacher-memberships"
+  | "teacher-memberships-only"
+  | "allowlisted-settings-only"
+  | "owned-tests-only"
+  | "never";
+
+const ownerAuthorizationRules = Object.freeze({
+  "school.list": "own-school-only",
+  "school.read": "own-school-only",
+  "school.settings.list": "allowlisted-settings-only",
+  "school.setting.read": "allowlisted-settings-only",
+  "school.setting.update": "allowlisted-settings-only",
+  "membership.list": "administrator-or-teacher-memberships",
+  "membership.read": "administrator-or-teacher-memberships",
+  "membership.invite": "administrator-or-teacher-memberships",
+  "membership.change-role": "administrator-or-teacher-memberships",
+  "membership.suspend": "administrator-or-teacher-memberships",
+  "membership.reactivate": "administrator-or-teacher-memberships",
+  "membership.remove": "administrator-or-teacher-memberships",
+  "test.list": "never",
+  "test.create": "never",
+  "test.read": "never",
+  "test.update": "never",
+  "test.start": "never",
+  "test.end": "never",
+  "test.archive": "never",
+} as const satisfies Record<StaffAuthorizationAction, StaffAuthorizationRule>);
+
+const administratorAuthorizationRules = Object.freeze({
+  "school.list": "own-school-only",
+  "school.read": "own-school-only",
+  "school.settings.list": "allowlisted-settings-only",
+  "school.setting.read": "allowlisted-settings-only",
+  "school.setting.update": "allowlisted-settings-only",
+  "membership.list": "teacher-memberships-only",
+  "membership.read": "teacher-memberships-only",
+  "membership.invite": "teacher-memberships-only",
+  "membership.change-role": "never",
+  "membership.suspend": "teacher-memberships-only",
+  "membership.reactivate": "teacher-memberships-only",
+  "membership.remove": "teacher-memberships-only",
+  "test.list": "never",
+  "test.create": "never",
+  "test.read": "never",
+  "test.update": "never",
+  "test.start": "never",
+  "test.end": "never",
+  "test.archive": "never",
+} as const satisfies Record<StaffAuthorizationAction, StaffAuthorizationRule>);
+
+const teacherAuthorizationRules = Object.freeze({
+  "school.list": "own-school-only",
+  "school.read": "own-school-only",
+  "school.settings.list": "never",
+  "school.setting.read": "never",
+  "school.setting.update": "never",
+  "membership.list": "never",
+  "membership.read": "never",
+  "membership.invite": "never",
+  "membership.change-role": "never",
+  "membership.suspend": "never",
+  "membership.reactivate": "never",
+  "membership.remove": "never",
+  "test.list": "owned-tests-only",
+  "test.create": "owned-tests-only",
+  "test.read": "owned-tests-only",
+  "test.update": "owned-tests-only",
+  "test.start": "owned-tests-only",
+  "test.end": "owned-tests-only",
+  "test.archive": "owned-tests-only",
+} as const satisfies Record<StaffAuthorizationAction, StaffAuthorizationRule>);
+
+export const staffAuthorizationMatrix = Object.freeze({
+  administrator: administratorAuthorizationRules,
+  owner: ownerAuthorizationRules,
+  teacher: teacherAuthorizationRules,
+} as const satisfies Record<
+  MembershipRole,
+  Record<StaffAuthorizationAction, StaffAuthorizationRule>
+>);
+
+export interface AuthoritativeStaffActor {
+  readonly membershipId: string;
+  readonly role: MembershipRole;
+  readonly schoolId: string;
+  readonly status: MembershipStatus;
+}
+
+export type ResolvedSchoolTarget =
+  | {
+      readonly exists: true;
+      readonly kind: "school";
+      readonly schoolId: string;
+    }
+  | {
+      readonly exists: false;
+      readonly kind: "school";
+      readonly schoolId: string;
+    };
+
+export type ResolvedMembershipCollectionTarget =
+  | {
+      readonly exists: true;
+      readonly kind: "membership-collection";
+      readonly role: MembershipRole;
+      readonly schoolId: string;
+      readonly status: MembershipStatus;
+    }
+  | {
+      readonly exists: false;
+      readonly kind: "membership-collection";
+      readonly role: MembershipRole;
+      readonly schoolId: string;
+      readonly status: MembershipStatus;
+    };
+
+export type ResolvedMembershipTarget =
+  | {
+      readonly exists: true;
+      readonly isLastOwner: boolean;
+      readonly kind: "membership";
+      readonly membershipId: string;
+      readonly role: MembershipRole;
+      readonly schoolId: string;
+      readonly status: MembershipStatus;
+    }
+  | {
+      readonly exists: false;
+      readonly kind: "membership";
+      readonly membershipId: string;
+    };
+
+export type ResolvedTestCollectionTarget =
+  | {
+      readonly exists: true;
+      readonly kind: "test-collection";
+      readonly ownerMembershipId: string;
+      readonly schoolId: string;
+    }
+  | {
+      readonly exists: false;
+      readonly kind: "test-collection";
+      readonly schoolId: string;
+    };
+
+export type ResolvedTestTarget =
+  | {
+      readonly exists: true;
+      readonly kind: "test";
+      readonly ownerMembershipId: string;
+      readonly schoolId: string;
+      readonly testId: string;
+    }
+  | {
+      readonly exists: false;
+      readonly kind: "test";
+      readonly testId: string;
+    };
+
+export type StaffAuthorizationRequest =
+  | {
+      readonly action: "school.list" | "school.read";
+      readonly target: ResolvedSchoolTarget;
+    }
+  | {
+      readonly action: "school.settings.list";
+      readonly target: ResolvedSchoolTarget;
+    }
+  | {
+      readonly action: "school.setting.read" | "school.setting.update";
+      readonly settingKey: string;
+      readonly target: ResolvedSchoolTarget;
+    }
+  | {
+      readonly action: "membership.list";
+      readonly target: ResolvedMembershipCollectionTarget;
+    }
+  | {
+      readonly action: "membership.read";
+      readonly target: ResolvedMembershipTarget;
+    }
+  | {
+      readonly action: "membership.invite";
+      readonly requestedRole: MembershipRole;
+      readonly target: ResolvedSchoolTarget;
+    }
+  | {
+      readonly action: "membership.change-role";
+      readonly requestedRole: MembershipRole;
+      readonly target: ResolvedMembershipTarget;
+    }
+  | {
+      readonly action:
+        "membership.suspend" | "membership.reactivate" | "membership.remove";
+      readonly target: ResolvedMembershipTarget;
+    }
+  | {
+      readonly action: "test.list";
+      readonly target: ResolvedTestCollectionTarget;
+    }
+  | {
+      readonly action: "test.create";
+      readonly target: ResolvedSchoolTarget;
+    }
+  | {
+      readonly action:
+        | "test.read"
+        | "test.update"
+        | "test.start"
+        | "test.end"
+        | "test.archive";
+      readonly target: ResolvedTestTarget;
+    };
+
+export type StaffAuthorizationDenialCode =
+  | "actor-unknown"
+  | "actor-inactive"
+  | "actor-removed"
+  | "target-unknown"
+  | "target-inactive"
+  | "cross-school"
+  | "role-not-permitted"
+  | "target-role-not-permitted"
+  | "requested-role-not-permitted"
+  | "self-management-forbidden"
+  | "last-owner-forbidden"
+  | "ownership-transfer-forbidden"
+  | "target-not-owned"
+  | "setting-not-allowed";
+
+export type StaffAuthorizationAuditDetail =
+  | {
+      readonly kind: "school";
+      readonly scope: "collection" | "object";
+    }
+  | {
+      readonly kind: "school-settings";
+      readonly scope: "collection";
+      readonly settingKeys: readonly SchoolSettingKey[];
+    }
+  | {
+      readonly kind: "school-setting";
+      readonly scope: "object";
+      readonly settingKey: SchoolSettingKey | null;
+    }
+  | {
+      readonly kind: "membership-collection";
+      readonly role: MembershipRole;
+      readonly status: MembershipStatus;
+    }
+  | {
+      readonly kind: "membership-read";
+      readonly role: MembershipRole | null;
+      readonly status: MembershipStatus | null;
+    }
+  | {
+      readonly kind: "membership-invitation";
+      readonly requestedRole: MembershipRole;
+    }
+  | {
+      readonly fromRole: MembershipRole | null;
+      readonly kind: "membership-role-transition";
+      readonly toRole: MembershipRole;
+    }
+  | {
+      readonly fromStatus: MembershipStatus | null;
+      readonly kind: "membership-status-transition";
+      readonly toStatus: MembershipStatus;
+    }
+  | {
+      readonly kind: "test";
+      readonly ownership: "foreign" | "new" | "owned" | "unknown";
+      readonly scope: "collection" | "object";
+    };
+
+export interface StaffAuthorizationAuditIntent {
+  readonly action: StaffAuthorizationAction;
+  readonly actorMembershipId: string | null;
+  readonly decision: "allow" | "deny";
+  readonly denialCode: StaffAuthorizationDenialCode | null;
+  readonly detail: StaffAuthorizationAuditDetail;
+  readonly targetId: string;
+  readonly targetKind:
+    | "membership"
+    | "membership-collection"
+    | "school"
+    | "test"
+    | "test-collection";
+}
+
+export type StaffAuthorizationDecision =
+  | {
+      readonly allowed: true;
+      readonly audit: StaffAuthorizationAuditIntent;
+      readonly code: "allowed";
+    }
+  | {
+      readonly allowed: false;
+      readonly audit: StaffAuthorizationAuditIntent;
+      readonly code: StaffAuthorizationDenialCode;
+    };
+
+function isSchoolSettingKey(value: string): value is SchoolSettingKey {
+  return schoolSettingKeys.some((settingKey) => settingKey === value);
+}
+
+function targetIdentifier(request: StaffAuthorizationRequest): string {
+  switch (request.target.kind) {
+    case "membership":
+      return request.target.membershipId;
+    case "membership-collection":
+    case "school":
+    case "test-collection":
+      return request.target.schoolId;
+    case "test":
+      return request.target.testId;
+  }
+}
+
+function testOwnership(
+  actor: AuthoritativeStaffActor | null,
+  ownerMembershipId: string | null,
+): "foreign" | "owned" | "unknown" {
+  if (actor === null || ownerMembershipId === null) {
+    return "unknown";
+  }
+  return ownerMembershipId === actor.membershipId ? "owned" : "foreign";
+}
+
+function auditDetail(
+  actor: AuthoritativeStaffActor | null,
+  request: StaffAuthorizationRequest,
+): StaffAuthorizationAuditDetail {
+  switch (request.action) {
+    case "school.list":
+      return Object.freeze({ kind: "school", scope: "collection" });
+    case "school.read":
+      return Object.freeze({ kind: "school", scope: "object" });
+    case "school.settings.list":
+      return Object.freeze({
+        kind: "school-settings",
+        scope: "collection",
+        settingKeys: schoolSettingKeys,
+      });
+    case "school.setting.read":
+    case "school.setting.update":
+      return Object.freeze({
+        kind: "school-setting",
+        scope: "object",
+        settingKey: isSchoolSettingKey(request.settingKey)
+          ? request.settingKey
+          : null,
+      });
+    case "membership.list":
+      return Object.freeze({
+        kind: "membership-collection",
+        role: request.target.role,
+        status: request.target.status,
+      });
+    case "membership.read":
+      return Object.freeze({
+        kind: "membership-read",
+        role: request.target.exists ? request.target.role : null,
+        status: request.target.exists ? request.target.status : null,
+      });
+    case "membership.invite":
+      return Object.freeze({
+        kind: "membership-invitation",
+        requestedRole: request.requestedRole,
+      });
+    case "membership.change-role":
+      return Object.freeze({
+        fromRole: request.target.exists ? request.target.role : null,
+        kind: "membership-role-transition",
+        toRole: request.requestedRole,
+      });
+    case "membership.suspend":
+    case "membership.reactivate":
+    case "membership.remove": {
+      const toStatus =
+        request.action === "membership.suspend"
+          ? "suspended"
+          : request.action === "membership.reactivate"
+            ? "active"
+            : "removed";
+      return Object.freeze({
+        fromStatus: request.target.exists ? request.target.status : null,
+        kind: "membership-status-transition",
+        toStatus,
+      });
+    }
+    case "test.list":
+      return Object.freeze({
+        kind: "test",
+        ownership: testOwnership(
+          actor,
+          request.target.exists ? request.target.ownerMembershipId : null,
+        ),
+        scope: "collection",
+      });
+    case "test.create":
+      return Object.freeze({
+        kind: "test",
+        ownership: "new",
+        scope: "collection",
+      });
+    case "test.read":
+    case "test.update":
+    case "test.start":
+    case "test.end":
+    case "test.archive":
+      return Object.freeze({
+        kind: "test",
+        ownership: testOwnership(
+          actor,
+          request.target.exists ? request.target.ownerMembershipId : null,
+        ),
+        scope: "object",
+      });
+  }
+}
+
+function createAuditIntent(
+  actor: AuthoritativeStaffActor | null,
+  request: StaffAuthorizationRequest,
+  decision: "allow" | "deny",
+  denialCode: StaffAuthorizationDenialCode | null,
+): StaffAuthorizationAuditIntent {
+  return Object.freeze({
+    action: request.action,
+    actorMembershipId: actor?.membershipId ?? null,
+    decision,
+    denialCode,
+    detail: auditDetail(actor, request),
+    targetId: targetIdentifier(request),
+    targetKind: request.target.kind,
+  });
+}
+
+function allow(
+  actor: AuthoritativeStaffActor,
+  request: StaffAuthorizationRequest,
+): StaffAuthorizationDecision {
+  return Object.freeze({
+    allowed: true,
+    audit: createAuditIntent(actor, request, "allow", null),
+    code: "allowed",
+  });
+}
+
+function deny(
+  actor: AuthoritativeStaffActor | null,
+  request: StaffAuthorizationRequest,
+  code: StaffAuthorizationDenialCode,
+): StaffAuthorizationDecision {
+  return Object.freeze({
+    allowed: false,
+    audit: createAuditIntent(actor, request, "deny", code),
+    code,
+  });
+}
+
+function targetSchoolId(request: StaffAuthorizationRequest): string | null {
+  return request.target.exists ? request.target.schoolId : null;
+}
+
+function isMembershipObjectRequest(
+  request: StaffAuthorizationRequest,
+): request is Extract<
+  StaffAuthorizationRequest,
+  { readonly target: ResolvedMembershipTarget }
+> {
+  return request.target.kind === "membership";
+}
+
+function isRequestedRoleAction(
+  request: StaffAuthorizationRequest,
+): request is Extract<
+  StaffAuthorizationRequest,
+  { readonly requestedRole: MembershipRole }
+> {
+  return (
+    request.action === "membership.invite" ||
+    request.action === "membership.change-role"
+  );
+}
+
+function membershipTargetRole(
+  request: StaffAuthorizationRequest,
+): MembershipRole | null {
+  if (request.action === "membership.invite") {
+    return request.requestedRole;
+  }
+  if (
+    request.target.kind === "membership" ||
+    request.target.kind === "membership-collection"
+  ) {
+    return request.target.exists ||
+      request.target.kind === "membership-collection"
+      ? request.target.role
+      : null;
+  }
+  return null;
+}
+
+function hasValidMembershipTargetState(
+  request: StaffAuthorizationRequest,
+): boolean {
+  if (request.target.kind === "membership-collection") {
+    return request.target.status !== "removed";
+  }
+  if (request.target.kind !== "membership" || !request.target.exists) {
+    return true;
+  }
+  switch (request.action) {
+    case "membership.read":
+    case "membership.remove":
+      return request.target.status !== "removed";
+    case "membership.change-role":
+    case "membership.suspend":
+      return request.target.status === "active";
+    case "membership.reactivate":
+      return request.target.status === "suspended";
+    default:
+      return true;
+  }
+}
+
+export function evaluateStaffAuthorization(input: {
+  readonly actor: AuthoritativeStaffActor | null;
+  readonly request: StaffAuthorizationRequest;
+}): StaffAuthorizationDecision {
+  const { actor, request } = input;
+
+  if (actor === null) {
+    return deny(null, request, "actor-unknown");
+  }
+  if (actor.status === "removed") {
+    return deny(actor, request, "actor-removed");
+  }
+  if (actor.status !== "active") {
+    return deny(actor, request, "actor-inactive");
+  }
+  if (!request.target.exists) {
+    return deny(actor, request, "target-unknown");
+  }
+  if (targetSchoolId(request) !== actor.schoolId) {
+    return deny(actor, request, "cross-school");
+  }
+
+  if (isMembershipObjectRequest(request)) {
+    if (request.target.membershipId === actor.membershipId) {
+      return deny(actor, request, "self-management-forbidden");
+    }
+    if (request.target.role === "owner" && request.target.isLastOwner) {
+      return deny(actor, request, "last-owner-forbidden");
+    }
+  }
+  if (!hasValidMembershipTargetState(request)) {
+    return deny(actor, request, "target-inactive");
+  }
+  if (isRequestedRoleAction(request) && request.requestedRole === "owner") {
+    return deny(actor, request, "ownership-transfer-forbidden");
+  }
+
+  const rule = staffAuthorizationMatrix[actor.role][request.action];
+  switch (rule) {
+    case "never":
+      return deny(actor, request, "role-not-permitted");
+    case "own-school-only":
+      return allow(actor, request);
+    case "allowlisted-settings-only":
+      if (request.action === "school.settings.list") {
+        return allow(actor, request);
+      }
+      if (
+        (request.action !== "school.setting.read" &&
+          request.action !== "school.setting.update") ||
+        !isSchoolSettingKey(request.settingKey)
+      ) {
+        return deny(actor, request, "setting-not-allowed");
+      }
+      return allow(actor, request);
+    case "owned-tests-only":
+      if (request.action === "test.create") {
+        return allow(actor, request);
+      }
+      if (
+        (request.target.kind !== "test" &&
+          request.target.kind !== "test-collection") ||
+        request.target.ownerMembershipId !== actor.membershipId
+      ) {
+        return deny(actor, request, "target-not-owned");
+      }
+      return allow(actor, request);
+    case "administrator-or-teacher-memberships": {
+      const targetRole = membershipTargetRole(request);
+      if (targetRole !== "administrator" && targetRole !== "teacher") {
+        return deny(actor, request, "target-role-not-permitted");
+      }
+      if (
+        request.action === "membership.change-role" &&
+        request.requestedRole !== "administrator" &&
+        request.requestedRole !== "teacher"
+      ) {
+        return deny(actor, request, "requested-role-not-permitted");
+      }
+      return allow(actor, request);
+    }
+    case "teacher-memberships-only": {
+      if (
+        request.action === "membership.invite" &&
+        request.requestedRole !== "teacher"
+      ) {
+        return deny(actor, request, "requested-role-not-permitted");
+      }
+      if (membershipTargetRole(request) !== "teacher") {
+        return deny(actor, request, "target-role-not-permitted");
+      }
+      return allow(actor, request);
+    }
+  }
+}
diff --git a/packages/domain/tests/school-authorization.test.ts b/packages/domain/tests/school-authorization.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d7ca1163d60d9ad5b0a6d2f802d37fccc91b2d2a
--- /dev/null
+++ b/packages/domain/tests/school-authorization.test.ts
@@ -0,0 +1,720 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  evaluateStaffAuthorization,
+  membershipRoleStorageAdapter,
+  schoolSettingKeys,
+  staffAuthorizationActions,
+  staffAuthorizationMatrix,
+  type AuthoritativeStaffActor,
+  type MembershipRole,
+  type MembershipStatus,
+  type StaffAuthorizationAction,
+  type StaffAuthorizationRequest,
+} from "../src/index.js";
+
+const SCHOOL_A = "school-a";
+const SCHOOL_B = "school-b";
+const roles = ["owner", "administrator", "teacher"] as const;
+const statuses = ["active", "suspended", "removed"] as const;
+
+interface Scenario {
+  readonly label: string;
+  readonly request: StaffAuthorizationRequest;
+}
+
+function actor(
+  role: MembershipRole,
+  status: MembershipStatus = "active",
+): AuthoritativeStaffActor {
+  return {
+    membershipId: `${role}-membership`,
+    role,
+    schoolId: SCHOOL_A,
+    status,
+  };
+}
+
+function membershipTarget(input: {
+  readonly actorMembershipId: string;
+  readonly isLastOwner: boolean;
+  readonly role: MembershipRole;
+  readonly schoolId: string;
+  readonly self: boolean;
+  readonly status: MembershipStatus;
+}) {
+  return {
+    exists: true as const,
+    isLastOwner: input.isLastOwner,
+    kind: "membership" as const,
+    membershipId: input.self ? input.actorMembershipId : "target-membership",
+    role: input.role,
+    schoolId: input.schoolId,
+    status: input.status,
+  };
+}
+
+function scenariosFor(
+  action: StaffAuthorizationAction,
+  schoolId: string,
+  actorMembershipId: string,
+): readonly Scenario[] {
+  switch (action) {
+    case "school.list":
+    case "school.read":
+    case "school.settings.list":
+      return [
+        {
+          label: action,
+          request: {
+            action,
+            target: { exists: true, kind: "school", schoolId },
+          },
+        },
+      ];
+    case "school.setting.read":
+    case "school.setting.update":
+      return ["displayName", "billingPlan"].map((settingKey) => ({
+        label: `${action}/${settingKey}`,
+        request: {
+          action,
+          settingKey,
+          target: { exists: true, kind: "school", schoolId },
+        },
+      }));
+    case "membership.list":
+      return roles.flatMap((role) =>
+        statuses.map((status) => ({
+          label: `${action}/${role}/${status}`,
+          request: {
+            action,
+            target: {
+              exists: true,
+              kind: "membership-collection",
+              role,
+              schoolId,
+              status,
+            },
+          },
+        })),
+      );
+    case "membership.read":
+    case "membership.suspend":
+    case "membership.reactivate":
+    case "membership.remove":
+      return roles.flatMap((role) =>
+        statuses.flatMap((status) =>
+          [false, true].flatMap((self) =>
+            [false, true].map((isLastOwner) => ({
+              label: `${action}/${role}/${status}/self:${self}/last:${isLastOwner}`,
+              request: {
+                action,
+                target: membershipTarget({
+                  actorMembershipId,
+                  isLastOwner,
+                  role,
+                  schoolId,
+                  self,
+                  status,
+                }),
+              },
+            })),
+          ),
+        ),
+      );
+    case "membership.invite":
+      return roles.map((requestedRole) => ({
+        label: `${action}/${requestedRole}`,
+        request: {
+          action,
+          requestedRole,
+          target: { exists: true, kind: "school", schoolId },
+        },
+      }));
+    case "membership.change-role":
+      return roles.flatMap((role) =>
+        statuses.flatMap((status) =>
+          [false, true].flatMap((self) =>
+            [false, true].flatMap((isLastOwner) =>
+              roles.map((requestedRole) => ({
+                label: `${action}/${role}/${status}/self:${self}/last:${isLastOwner}/to:${requestedRole}`,
+                request: {
+                  action,
+                  requestedRole,
+                  target: membershipTarget({
+                    actorMembershipId,
+                    isLastOwner,
+                    role,
+                    schoolId,
+                    self,
+                    status,
+                  }),
+                },
+              })),
+            ),
+          ),
+        ),
+      );
+    case "test.list":
+      return [true, false].map((owned) => ({
+        label: `${action}/owned:${owned}`,
+        request: {
+          action,
+          target: {
+            exists: true,
+            kind: "test-collection",
+            ownerMembershipId: owned ? actorMembershipId : "foreign-membership",
+            schoolId,
+          },
+        },
+      }));
+    case "test.create":
+      return [
+        {
+          label: action,
+          request: {
+            action,
+            target: { exists: true, kind: "school", schoolId },
+          },
+        },
+      ];
+    case "test.read":
+    case "test.update":
+    case "test.start":
+    case "test.end":
+    case "test.archive":
+      return [true, false].map((owned) => ({
+        label: `${action}/owned:${owned}`,
+        request: {
+          action,
+          target: {
+            exists: true,
+            kind: "test",
+            ownerMembershipId: owned ? actorMembershipId : "foreign-membership",
+            schoolId,
+            testId: "test-one",
+          },
+        },
+      }));
+  }
+}
+
+function canManageRole(
+  actorRole: MembershipRole,
+  targetRole: MembershipRole,
+): boolean {
+  if (actorRole === "owner") {
+    return targetRole === "administrator" || targetRole === "teacher";
+  }
+  return actorRole === "administrator" && targetRole === "teacher";
+}
+
+function expectedAllowed(
+  currentActor: AuthoritativeStaffActor,
+  request: StaffAuthorizationRequest,
+): boolean {
+  if (
+    currentActor.status !== "active" ||
+    !request.target.exists ||
+    request.target.schoolId !== currentActor.schoolId
+  ) {
+    return false;
+  }
+
+  switch (request.action) {
+    case "school.list":
+    case "school.read":
+      return true;
+    case "school.settings.list":
+      return currentActor.role !== "teacher";
+    case "school.setting.read":
+    case "school.setting.update":
+      return (
+        currentActor.role !== "teacher" && request.settingKey === "displayName"
+      );
+    case "membership.list":
+      return (
+        request.target.status !== "removed" &&
+        canManageRole(currentActor.role, request.target.role)
+      );
+    case "membership.read":
+      return (
+        request.target.membershipId !== currentActor.membershipId &&
+        request.target.status !== "removed" &&
+        canManageRole(currentActor.role, request.target.role)
+      );
+    case "membership.invite":
+      return (
+        request.requestedRole !== "owner" &&
+        canManageRole(currentActor.role, request.requestedRole)
+      );
+    case "membership.change-role":
+      return (
+        currentActor.role === "owner" &&
+        request.target.membershipId !== currentActor.membershipId &&
+        request.target.status === "active" &&
+        !(request.target.role === "owner" && request.target.isLastOwner) &&
+        canManageRole(currentActor.role, request.target.role) &&
+        request.requestedRole !== "owner"
+      );
+    case "membership.suspend":
+      return (
+        request.target.membershipId !== currentActor.membershipId &&
+        request.target.status === "active" &&
+        !(request.target.role === "owner" && request.target.isLastOwner) &&
+        canManageRole(currentActor.role, request.target.role)
+      );
+    case "membership.reactivate":
+      return (
+        request.target.membershipId !== currentActor.membershipId &&
+        request.target.status === "suspended" &&
+        !(request.target.role === "owner" && request.target.isLastOwner) &&
+        canManageRole(currentActor.role, request.target.role)
+      );
+    case "membership.remove":
+      return (
+        request.target.membershipId !== currentActor.membershipId &&
+        request.target.status !== "removed" &&
+        !(request.target.role === "owner" && request.target.isLastOwner) &&
+        canManageRole(currentActor.role, request.target.role)
+      );
+    case "test.create":
+      return currentActor.role === "teacher";
+    case "test.list":
+    case "test.read":
+    case "test.update":
+    case "test.start":
+    case "test.end":
+    case "test.archive":
+      return (
+        currentActor.role === "teacher" &&
+        request.target.ownerMembershipId === currentActor.membershipId
+      );
+  }
+}
+
+function unresolvedRequest(
+  action: StaffAuthorizationAction,
+): StaffAuthorizationRequest {
+  switch (action) {
+    case "school.list":
+    case "school.read":
+    case "school.settings.list":
+      return {
+        action,
+        target: { exists: false, kind: "school", schoolId: "missing-school" },
+      };
+    case "school.setting.read":
+    case "school.setting.update":
+      return {
+        action,
+        settingKey: "displayName",
+        target: { exists: false, kind: "school", schoolId: "missing-school" },
+      };
+    case "membership.list":
+      return {
+        action,
+        target: {
+          exists: false,
+          kind: "membership-collection",
+          role: "teacher",
+          schoolId: "missing-school",
+          status: "active",
+        },
+      };
+    case "membership.read":
+    case "membership.suspend":
+    case "membership.reactivate":
+    case "membership.remove":
+      return {
+        action,
+        target: {
+          exists: false,
+          kind: "membership",
+          membershipId: "missing-membership",
+        },
+      };
+    case "membership.invite":
+      return {
+        action,
+        requestedRole: "teacher",
+        target: { exists: false, kind: "school", schoolId: "missing-school" },
+      };
+    case "membership.change-role":
+      return {
+        action,
+        requestedRole: "teacher",
+        target: {
+          exists: false,
+          kind: "membership",
+          membershipId: "missing-membership",
+        },
+      };
+    case "test.list":
+      return {
+        action,
+        target: {
+          exists: false,
+          kind: "test-collection",
+          schoolId: "missing-school",
+        },
+      };
+    case "test.create":
+      return {
+        action,
+        target: { exists: false, kind: "school", schoolId: "missing-school" },
+      };
+    case "test.read":
+    case "test.update":
+    case "test.start":
+    case "test.end":
+    case "test.archive":
+      return {
+        action,
+        target: { exists: false, kind: "test", testId: "missing-test" },
+      };
+  }
+}
