diff --git a/packages/contracts/tests/staff-authorization-command.test.ts b/packages/contracts/tests/staff-authorization-command.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..da63cc93f304ede53a3b925ed1eb101eaa4b0134
--- /dev/null
+++ b/packages/contracts/tests/staff-authorization-command.test.ts
@@ -0,0 +1,172 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  authorizationCommandActions,
+  parseStaffAuthorizationCommand,
+} from "../src/index.js";
+
+const SCHOOL_ID = "11111111-1111-4111-8111-111111111111";
+const MEMBERSHIP_ID = "22222222-2222-4222-8222-222222222222";
+const TEST_ID = "abcdefab-cdef-4abc-8def-abcdefabcdef";
+
+const validCommands = [
+  { action: "school.list", schoolId: SCHOOL_ID },
+  { action: "school.read", schoolId: SCHOOL_ID },
+  { action: "school.settings.list", schoolId: SCHOOL_ID },
+  {
+    action: "school.setting.read",
+    schoolId: SCHOOL_ID,
+    settingKey: "displayName",
+  },
+  {
+    action: "school.setting.update",
+    schoolId: SCHOOL_ID,
+    settingKey: "displayName",
+  },
+  {
+    action: "membership.list",
+    schoolId: SCHOOL_ID,
+    targetRole: "teacher",
+    targetStatus: "active",
+  },
+  { action: "membership.read", membershipId: MEMBERSHIP_ID },
+  {
+    action: "membership.invite",
+    requestedRole: "teacher",
+    schoolId: SCHOOL_ID,
+  },
+  {
+    action: "membership.change-role",
+    membershipId: MEMBERSHIP_ID,
+    requestedRole: "administrator",
+  },
+  { action: "membership.suspend", membershipId: MEMBERSHIP_ID },
+  { action: "membership.reactivate", membershipId: MEMBERSHIP_ID },
+  { action: "membership.remove", membershipId: MEMBERSHIP_ID },
+  { action: "test.list", schoolId: SCHOOL_ID },
+  { action: "test.create", schoolId: SCHOOL_ID },
+  { action: "test.read", testId: TEST_ID },
+  { action: "test.update", testId: TEST_ID },
+  { action: "test.start", testId: TEST_ID },
+  { action: "test.end", testId: TEST_ID },
+  { action: "test.archive", testId: TEST_ID },
+] as const;
+
+describe("staff authorization command parser", () => {
+  it("accepts only target/action identifiers for every supported action", () => {
+    expect(authorizationCommandActions).toEqual(
+      validCommands.map(({ action }) => action),
+    );
+    for (const command of validCommands) {
+      expect(parseStaffAuthorizationCommand(command), command.action).toEqual({
+        ok: true,
+        value: command,
+      });
+    }
+  });
+
+  it("rejects every actor-authority injection field across every action", () => {
+    const forgedFields = [
+      "actorId",
+      "actorMembershipId",
+      "actorRole",
+      "actorSchoolId",
+      "ownerMembershipId",
+      "serviceRole",
+    ] as const;
+    let evaluated = 0;
+    for (const command of validCommands) {
+      for (const forgedField of forgedFields) {
+        expect(
+          parseStaffAuthorizationCommand({
+            ...command,
+            [forgedField]: MEMBERSHIP_ID,
+          }),
+          `${command.action}/${forgedField}`,
+        ).toEqual({ code: "unexpected-fields", ok: false });
+        evaluated += 1;
+      }
+    }
+    expect(evaluated).toBe(
+      authorizationCommandActions.length * forgedFields.length,
+    );
+  });
+
+  it("rejects malformed, oversized, non-canonical, and nil identifiers", () => {
+    for (const forgedId of [
+      "not-a-uuid",
+      `${TEST_ID}0`,
+      TEST_ID.toUpperCase(),
+      ` ${TEST_ID}`,
+      "00000000-0000-0000-0000-000000000000",
+    ]) {
+      for (const command of [
+        { action: "school.read", schoolId: forgedId },
+        { action: "membership.read", membershipId: forgedId },
+        { action: "test.read", testId: forgedId },
+      ]) {
+        expect(parseStaffAuthorizationCommand(command), forgedId).toEqual({
+          code: "invalid-identifier",
+          ok: false,
+        });
+      }
+    }
+  });
+
+  it("rejects forged roles, statuses, and arbitrary School-setting keys", () => {
+    expect(
+      parseStaffAuthorizationCommand({
+        action: "membership.invite",
+        requestedRole: "admin",
+        schoolId: SCHOOL_ID,
+      }),
+    ).toEqual({ code: "invalid-target-role", ok: false });
+    expect(
+      parseStaffAuthorizationCommand({
+        action: "membership.list",
+        schoolId: SCHOOL_ID,
+        targetRole: "super-admin",
+        targetStatus: "active",
+      }),
+    ).toEqual({ code: "invalid-target-role", ok: false });
+    expect(
+      parseStaffAuthorizationCommand({
+        action: "membership.list",
+        schoolId: SCHOOL_ID,
+        targetRole: "teacher",
+        targetStatus: "enabled",
+      }),
+    ).toEqual({ code: "invalid-target-status", ok: false });
+    for (const action of [
+      "school.setting.read",
+      "school.setting.update",
+    ] as const) {
+      expect(
+        parseStaffAuthorizationCommand({
+          action,
+          schoolId: SCHOOL_ID,
+          settingKey: "billingPlan",
+        }),
+      ).toEqual({ code: "invalid-setting", ok: false });
+    }
+  });
+
+  it("rejects unsupported actions and non-record payloads with stable codes", () => {
+    for (const action of [
+      "school.delete",
+      "membership.claim-email-domain",
+      "test.delete",
+    ]) {
+      expect(parseStaffAuthorizationCommand({ action })).toEqual({
+        code: "unsupported-action",
+        ok: false,
+      });
+    }
+    for (const payload of [null, [], "test.start", 1]) {
+      expect(parseStaffAuthorizationCommand(payload)).toEqual({
+        code: "malformed-command",
+        ok: false,
+      });
+    }
+  });
+});
