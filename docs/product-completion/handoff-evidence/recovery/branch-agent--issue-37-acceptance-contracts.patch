+
+async function replaceResult(
+  manifest: PackagedAcceptanceManifest,
+  hostIndex: number,
+  testcaseIndex: number,
+  patch: Partial<PackagedAcceptanceTestcaseResult>,
+  recomputeDigest = true,
+): Promise<PackagedAcceptanceManifest> {
+  const copy = structuredClone(manifest);
+  const host = copy.hosts[hostIndex];
+  const result = host?.testcases[testcaseIndex];
+  if (host === undefined || result === undefined) {
+    throw new Error("fixture result is missing");
+  }
+  const replacementWithoutDigest = { ...result, ...patch };
+  let replacement = replacementWithoutDigest;
+  if (recomputeDigest) {
+    const { resultSha256: ignored, ...core } = replacementWithoutDigest;
+    void ignored;
+    replacement = {
+      ...replacementWithoutDigest,
+      resultSha256: await computePackagedAcceptanceResultDigestJson(
+        JSON.stringify(core),
+      ),
+    };
+  }
+  const testcases = [...host.testcases];
+  testcases[testcaseIndex] = replacement;
+  const hosts = [...copy.hosts];
+  hosts[hostIndex] = { ...host, testcases };
+  return { ...copy, hosts };
+}
