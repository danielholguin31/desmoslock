+    typeof downloadUrl !== "string" ||
+    new TextEncoder().encode(downloadUrl).byteLength > 2_048
+  ) {
+    fail(path, "must be a bounded approved public artifact URL");
+  }
+  let url: URL;
+  try {
+    url = new URL(downloadUrl);
+  } catch {
+    fail(path, "must be an approved public artifact URL");
+  }
+  if (
+    url.protocol !== "https:" ||
+    url.hostname !== PACKAGED_ACCEPTANCE_APPROVED_ARTIFACT_HOST ||
+    url.host !== PACKAGED_ACCEPTANCE_APPROVED_ARTIFACT_HOST ||
+    url.username !== "" ||
+    url.password !== "" ||
+    url.search !== "" ||
+    url.hash !== "" ||
