+function parseHealthPayload(
+  value: unknown,
+  path: string,
+): PackagedAcceptanceHealthPayload {
+  const record = strictRecord(value, path, HEALTH_PAYLOAD_KEYS);
+  const ref = projectRef(record.projectRef, `${path}.projectRef`);
+  const capabilities = strictArray(
+    record.capabilities,
+    `${path}.capabilities`,
+    3,
+  );
+  if (
+    capabilities.length !== 3 ||
+    capabilities[0] !== "auth" ||
+    capabilities[1] !== "database" ||
+    capabilities[2] !== "rest"
+  ) {
+    fail(`${path}.capabilities`, "must match the pinned health capabilities");
+  }
+  return {
+    schemaVersion: integerInRange(
+      record.schemaVersion,
+      1,
+      1,
+      `${path}.schemaVersion`,
+    ) as 1,
+    kind: exactString(
+      record.kind,
+      PACKAGED_ACCEPTANCE_HEALTH_KIND,
+      `${path}.kind`,
+    ),
+    attestationId: uuid(record.attestationId, `${path}.attestationId`),
+    observedAtUtc: utcSecond(record.observedAtUtc, `${path}.observedAtUtc`),
+    service: exactString(record.service, "desmoslock-v2", `${path}.service`),
+    status: exactString(record.status, "ready", `${path}.status`),
+    capabilities: ["auth", "database", "rest"],
+    projectRef: ref,
+    origin: stagingOrigin(record.origin, ref, `${path}.origin`),
+    databaseIdentity: databaseIdentity(
+      record.databaseIdentity,
+      `${path}.databaseIdentity`,
+    ),
+    fixtureDigest: exactString(
+      record.fixtureDigest,
+      INTERNAL_BASELINE_FIXTURE_DIGEST,
+      `${path}.fixtureDigest`,
+    ),
+    fixtureVersion: exactString(
+      record.fixtureVersion,
+      "internal-baseline-v1",
+      `${path}.fixtureVersion`,
+    ),
+    fixtureValid: exactBoolean(
+      record.fixtureValid,
+      true,
+      `${path}.fixtureValid`,
+    ),
+    schemaGeneration: integerInRange(
