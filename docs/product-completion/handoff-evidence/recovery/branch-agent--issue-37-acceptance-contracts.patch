+async function receiptForSettlementRequest(
+  request: PackagedAcceptanceAuthoritySettlementRequest,
+  consumedAtUtc = CONSUMED_AT,
+): Promise<PackagedAcceptancePersistedReceipt> {
+  const evidence = JSON.parse(
+    request.canonicalEvidenceJson,
+  ) as PackagedAcceptanceEvidenceEnvelope;
+  const expectedContext = JSON.parse(
+    request.canonicalExpectedContextJson,
+  ) as PackagedAcceptanceExpectedRunContext;
+  const firstCollector = evidence.collectorAttestations[0];
+  const secondCollector = evidence.collectorAttestations[1];
+  const firstWitness = evidence.humanWitnessAttestations[0];
+  const secondWitness = evidence.humanWitnessAttestations[1];
+  if (
+    firstCollector === undefined ||
+    secondCollector === undefined ||
+    firstWitness === undefined ||
+    secondWitness === undefined ||
+    expectedContext.runId !== evidence.manifest.runId
+  ) {
+    throw new Error("authority candidate is incomplete or not pinned");
+  }
+  const manifestDigestSha256 =
+    await computePackagedAcceptanceManifestDigestJson(
+      JSON.stringify(evidence.manifest),
+    );
+  const healthPayloadDigestSha256 =
+    await computePackagedAcceptanceHealthPayloadDigestJson(
+      JSON.stringify(evidence.health.payload),
+    );
+  const candidateDigestSha256 =
+    await computePackagedAcceptanceAuthorityCandidateDigestJson(
+      request.canonicalEvidenceJson,
+      request.canonicalExpectedContextJson,
+    );
+  const nonceDigestSha256 = await sha256Text(
+    JSON.stringify([
+      "desmoslock-packaged-acceptance-challenge-nonce-v1",
+      evidence.manifest.challenge.nonce,
+    ]),
+  );
+  const healthIdentity = trustIdentityFor(evidence.health.attestation.keyId);
+  if (healthIdentity === undefined) {
+    throw new Error("authority health key pin is missing");
+  }
+  const receiptWithAggregatePlaceholder: PackagedAcceptancePersistedReceipt = {
+    schemaVersion: 1,
+    kind: PACKAGED_ACCEPTANCE_PERSISTED_RECEIPT_KIND,
+    decision: "accepted-by-external-readiness-authority",
+    authorizationScope: EXTERNAL_READINESS_AUTHORIZATION_SCOPE,
+    runId: evidence.manifest.runId,
+    candidateDigestSha256,
+    manifestDigestSha256,
+    aggregateDigestSha256: "0".repeat(64),
+    healthPayloadDigestSha256,
+    hardwareCoveragePolicy: evidence.manifest.hardwareCoveragePolicy,
+    trustPolicyIdentity: TRUST_POLICY_IDENTITY,
+    challenge: {
+      challengeId: evidence.manifest.challenge.challengeId,
+      nonceDigestSha256,
+      issuedAtUtc: evidence.manifest.challenge.issuedAtUtc,
+      expiresAtUtc: evidence.manifest.challenge.expiresAtUtc,
+      consumedAtUtc,
+      ledgerRevision: evidence.manifest.challenge.ledgerRevision,
+      consumedRevision: evidence.manifest.challenge.ledgerRevision + 1,
+      settlementId: SETTLEMENT_ID,
+    },
+    attestations: {
+      collectors: [
+        persistedHostAttestationFromAuthority(firstCollector),
+        persistedHostAttestationFromAuthority(secondCollector),
+      ],
+      humanWitnesses: [
+        persistedHostAttestationFromAuthority(firstWitness),
+        persistedHostAttestationFromAuthority(secondWitness),
+      ],
+      health: {
+        attestationId: evidence.health.attestation.attestationId,
+        role: evidence.health.attestation.role,
+        payloadDigestSha256: evidence.health.attestation.payloadDigestSha256,
+        signerIdentitySha256: healthIdentity.signerIdentitySha256,
+        attestationIdentitySha256: healthIdentity.attestationIdentitySha256,
+        algorithm: evidence.health.attestation.algorithm,
+        signatureBase64Url: evidence.health.attestation.signatureBase64Url,
+      },
+    },
+    authority: {
+      algorithm: "ed25519",
+      signerIdentitySha256: AUTHORITY_SIGNER_IDENTITY_SHA256,
+      signatureBase64Url: AUTHORITY_SIGNATURE_BASE64_URL,
+    },
+  };
+  const aggregateDigestSha256 =
+    await computePackagedAcceptanceAuthorityAggregateDigestJson(
+      JSON.stringify(receiptWithAggregatePlaceholder),
+    );
+  return { ...receiptWithAggregatePlaceholder, aggregateDigestSha256 };
+}
+
+class TestAuthoritySettlementPort implements PackagedAcceptanceAuthoritySettlementPort {
+  public calls = 0;
+  public lastRequest: PackagedAcceptanceAuthoritySettlementRequest | undefined;
+  private settled = false;
+
+  public constructor(public trustedNowUtc = CONSUMED_AT) {}
+
+  public async independentlyVerifyAndAtomicallySettle(
+    request: PackagedAcceptanceAuthoritySettlementRequest,
+  ): Promise<string> {
+    this.calls += 1;
+    this.lastRequest = request;
+    if (this.settled) return JSON.stringify({ status: "replayed" });
+    const evidence = JSON.parse(
+      request.canonicalEvidenceJson,
+    ) as PackagedAcceptanceEvidenceEnvelope;
+    const trustedNow = Date.parse(this.trustedNowUtc);
+    if (
+      trustedNow < Date.parse(evidence.manifest.challenge.issuedAtUtc) ||
+      trustedNow >= Date.parse(evidence.manifest.challenge.expiresAtUtc)
+    ) {
+      return JSON.stringify({ status: "expired" });
+    }
+    this.settled = true;
+    return JSON.stringify({
+      status: "persisted",
+      serializedReceiptJson: JSON.stringify(
+        await receiptForSettlementRequest(request, this.trustedNowUtc),
+      ),
+    });
+  }
+}
