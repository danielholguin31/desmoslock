+function parsePersistedChallenge(
+  value: unknown,
+  path: string,
+): PackagedAcceptancePersistedReceipt["challenge"] {
+  const record = strictRecord(value, path, PERSISTED_CHALLENGE_KEYS);
+  const issuedAtUtc = utcSecond(record.issuedAtUtc, `${path}.issuedAtUtc`);
+  const expiresAtUtc = utcSecond(record.expiresAtUtc, `${path}.expiresAtUtc`);
+  const consumedAtUtc = utcSecond(
+    record.consumedAtUtc,
+    `${path}.consumedAtUtc`,
+  );
+  const lifetime = Date.parse(expiresAtUtc) - Date.parse(issuedAtUtc);
+  if (
+    lifetime <= 0 ||
+    lifetime > PACKAGED_ACCEPTANCE_CHALLENGE_MAX_LIFETIME_MS
+  ) {
+    fail(path, "persisted challenge lifetime is invalid");
+  }
+  if (
+    Date.parse(consumedAtUtc) < Date.parse(issuedAtUtc) ||
+    Date.parse(consumedAtUtc) >= Date.parse(expiresAtUtc)
+  ) {
+    fail(
+      `${path}.consumedAtUtc`,
+      "must be inside the authority challenge window with exclusive expiry",
+    );
+  }
+  const ledgerRevision = integerInRange(
+    record.ledgerRevision,
+    0,
+    Number.MAX_SAFE_INTEGER - 1,
+    `${path}.ledgerRevision`,
+  );
+  const consumedRevision = integerInRange(
+    record.consumedRevision,
+    1,
+    Number.MAX_SAFE_INTEGER,
+    `${path}.consumedRevision`,
+  );
+  if (consumedRevision !== ledgerRevision + 1) {
+    fail(`${path}.consumedRevision`, "must advance the ledger exactly once");
+  }
+  return {
+    challengeId: uuid(record.challengeId, `${path}.challengeId`),
+    nonceDigestSha256: sha256(
+      record.nonceDigestSha256,
+      `${path}.nonceDigestSha256`,
+    ),
+    issuedAtUtc,
+    expiresAtUtc,
+    consumedAtUtc,
+    ledgerRevision,
+    consumedRevision,
+    settlementId: uuid(record.settlementId, `${path}.settlementId`),
+  };
+}
+
+function parsePersistedReceiptSnapshot(
+  value: unknown,
+): PackagedAcceptancePersistedReceipt {
+  const path = "persistedReceipt";
+  const record = strictRecord(value, path, PERSISTED_RECEIPT_KEYS);
+  const attestationsRecord = strictRecord(
+    record.attestations,
+    `${path}.attestations`,
+    PERSISTED_ATTESTATIONS_KEYS,
+  );
+  const collectorsInput = strictArray(
+    attestationsRecord.collectors,
+    `${path}.attestations.collectors`,
+    2,
+  );
+  const witnessesInput = strictArray(
+    attestationsRecord.humanWitnesses,
+    `${path}.attestations.humanWitnesses`,
+    2,
+  );
+  if (collectorsInput.length !== 2 || witnessesInput.length !== 2) {
+    fail(
+      `${path}.attestations`,
+      "exactly two collectors and witnesses are required",
+    );
+  }
+  const collectors: [
+    PackagedAcceptancePersistedHostAttestation,
+    PackagedAcceptancePersistedHostAttestation,
+  ] = [
+    parsePersistedHostAttestation(
+      collectorsInput[0],
+      `${path}.attestations.collectors[0]`,
+      "collector",
+    ),
+    parsePersistedHostAttestation(
+      collectorsInput[1],
+      `${path}.attestations.collectors[1]`,
+      "collector",
+    ),
+  ];
+  const humanWitnesses: [
+    PackagedAcceptancePersistedHostAttestation,
+    PackagedAcceptancePersistedHostAttestation,
+  ] = [
+    parsePersistedHostAttestation(
+      witnessesInput[0],
+      `${path}.attestations.humanWitnesses[0]`,
+      "human-witness",
+    ),
+    parsePersistedHostAttestation(
+      witnessesInput[1],
+      `${path}.attestations.humanWitnesses[1]`,
+      "human-witness",
+    ),
+  ];
+  const authorityRecord = strictRecord(
+    record.authority,
+    `${path}.authority`,
+    AUTHORITY_SIGNATURE_KEYS,
+  );
+  const receipt: PackagedAcceptancePersistedReceipt = {
+    schemaVersion: integerInRange(
+      record.schemaVersion,
+      1,
+      1,
+      `${path}.schemaVersion`,
+    ) as 1,
+    kind: exactString(
+      record.kind,
+      PACKAGED_ACCEPTANCE_PERSISTED_RECEIPT_KIND,
+      `${path}.kind`,
+    ),
+    decision: exactString(
+      record.decision,
+      "accepted-by-external-readiness-authority",
+      `${path}.decision`,
+    ),
+    authorizationScope: exactString(
+      record.authorizationScope,
+      EXTERNAL_READINESS_AUTHORIZATION_SCOPE,
+      `${path}.authorizationScope`,
+    ),
+    runId: uuid(record.runId, `${path}.runId`),
+    candidateDigestSha256: sha256(
+      record.candidateDigestSha256,
+      `${path}.candidateDigestSha256`,
+    ),
+    manifestDigestSha256: sha256(
+      record.manifestDigestSha256,
+      `${path}.manifestDigestSha256`,
+    ),
+    aggregateDigestSha256: sha256(
+      record.aggregateDigestSha256,
+      `${path}.aggregateDigestSha256`,
+    ),
+    healthPayloadDigestSha256: sha256(
+      record.healthPayloadDigestSha256,
+      `${path}.healthPayloadDigestSha256`,
+    ),
+    hardwareCoveragePolicy: oneOf<HardwareCoveragePolicy>(
+      record.hardwareCoveragePolicy,
+      HARDWARE_COVERAGE_POLICIES,
+      `${path}.hardwareCoveragePolicy`,
+    ),
+    trustPolicyIdentity: parseTrustPolicyIdentity(
+      record.trustPolicyIdentity,
+      `${path}.trustPolicyIdentity`,
+    ),
+    challenge: parsePersistedChallenge(record.challenge, `${path}.challenge`),
+    attestations: {
+      collectors,
+      humanWitnesses,
+      health: parsePersistedHealthAttestation(
+        attestationsRecord.health,
+        `${path}.attestations.health`,
+      ),
+    },
+    authority: {
+      algorithm: exactString(
+        authorityRecord.algorithm,
+        "ed25519",
+        `${path}.authority.algorithm`,
+      ),
+      signerIdentitySha256: sha256(
+        authorityRecord.signerIdentitySha256,
+        `${path}.authority.signerIdentitySha256`,
+      ),
+      signatureBase64Url: signatureBase64Url(
+        authorityRecord.signatureBase64Url,
+        `${path}.authority.signatureBase64Url`,
+      ),
+    },
+  };
+  const hostSubjects = new Set(
+    collectors.map(({ subjectHostFingerprint }) => subjectHostFingerprint),
+  );
+  if (
+    hostSubjects.size !== 2 ||
+    humanWitnesses.some(
+      ({ subjectHostFingerprint }) => !hostSubjects.has(subjectHostFingerprint),
+    ) ||
+    new Set(
+      humanWitnesses.map(
+        ({ subjectHostFingerprint }) => subjectHostFingerprint,
+      ),
+    ).size !== 2
+  ) {
+    fail(
+      `${path}.attestations`,
+      "collector and witness subjects must cover two hosts",
+    );
+  }
+  const allHostAttestations = [...collectors, ...humanWitnesses];
+  if (
+    allHostAttestations.some(
+      ({ payloadDigestSha256 }) =>
+        payloadDigestSha256 !== receipt.manifestDigestSha256,
+    ) ||
+    receipt.attestations.health.payloadDigestSha256 !==
+      receipt.healthPayloadDigestSha256
+  ) {
+    fail(
+      `${path}.attestations`,
+      "attestations are not bound to receipt digests",
+    );
+  }
+  const allAttestations = [...allHostAttestations, receipt.attestations.health];
+  if (
+    new Set(allAttestations.map(({ attestationId }) => attestationId)).size !==
+      allAttestations.length ||
+    new Set(
+      allAttestations.map(
+        ({ attestationIdentitySha256 }) => attestationIdentitySha256,
+      ),
+    ).size !== allAttestations.length ||
+    new Set(collectors.map(({ signerIdentitySha256 }) => signerIdentitySha256))
+      .size !== 2
+  ) {
+    fail(`${path}.attestations`, "attestation identities must be distinct");
+  }
+  return receipt;
+}
+
+function parsePackagedAcceptancePersistedReceiptJson(
+  serializedJson: string,
+): PackagedAcceptancePersistedReceipt {
+  return parsePersistedReceiptSnapshot(
+    parseSerializedJson(serializedJson, "persistedReceipt"),
+  );
+}
+
+function authorityReceiptSigningPayload(
+  receipt: PackagedAcceptancePersistedReceipt,
+): string {
+  return canonicalJson({
+    domain: "desmoslock-packaged-acceptance-authority-receipt-v1",
+    receipt: {
+      ...receipt,
+      authority: {
+        algorithm: receipt.authority.algorithm,
+        signerIdentitySha256: receipt.authority.signerIdentitySha256,
+      },
+    },
+  });
+}
+
+async function authorityCandidateDigestFromCanonicalJson(
+  canonicalEvidenceJson: string,
+  canonicalExpectedContextJson: string,
+): Promise<string> {
+  return digestPayload(
+    canonicalJson({
+      domain: "desmoslock-packaged-acceptance-authority-candidate-v1",
+      canonicalEvidenceJson,
+      canonicalExpectedContextJson,
+    }),
+    "authority candidate digest",
+  );
+}
+
+/**
+ * Recomputes the authority candidate digest from strict, complete serialized
+ * evidence and independently pinned expected context. This only establishes a
+ * deterministic digest; it does not verify signatures or establish acceptance.
+ */
+export async function computePackagedAcceptanceAuthorityCandidateDigestJson(
+  serializedEvidenceJson: string,
+  serializedExpectedContextJson: string,
+): Promise<string> {
+  const evidence = parseEvidenceSnapshot(
+    parseSerializedJson(serializedEvidenceJson, "evidence"),
+  );
+  const expectedContext = parseExpectedContextSnapshot(
+    parseSerializedJson(serializedExpectedContextJson, "expectedContext"),
+  );
+  return authorityCandidateDigestFromCanonicalJson(
+    canonicalJson(evidence),
+    canonicalJson(expectedContext),
+  );
+}
+
+async function authorityAggregateDigest(
+  receipt: PackagedAcceptancePersistedReceipt,
+): Promise<string> {
+  const receiptClaims: Record<string, unknown> = { ...receipt };
+  delete receiptClaims.aggregateDigestSha256;
+  receiptClaims.authority = {
+    algorithm: receipt.authority.algorithm,
+    signerIdentitySha256: receipt.authority.signerIdentitySha256,
+  };
+  return digestPayload(
+    canonicalJson({
+      domain: "desmoslock-packaged-acceptance-authority-aggregate-v1",
+      receipt: receiptClaims,
+    }),
+    "persistedReceipt.aggregateDigestSha256",
+  );
+}
+
+/**
+ * Recomputes the required receipt aggregate from every persisted settlement
+ * claim except the aggregate itself and the authority signature. The candidate
+ * digest within those claims binds the complete canonical evidence/context.
+ */
+export async function computePackagedAcceptanceAuthorityAggregateDigestJson(
+  serializedReceiptJson: string,
+): Promise<string> {
+  return authorityAggregateDigest(
+    parsePackagedAcceptancePersistedReceiptJson(serializedReceiptJson),
+  );
+}
+
+export function computePackagedAcceptanceAuthoritySigningPayloadJson(
+  serializedReceiptJson: string,
+): string {
+  return authorityReceiptSigningPayload(
+    parsePackagedAcceptancePersistedReceiptJson(serializedReceiptJson),
+  );
+}
+
+export async function computePackagedAcceptancePersistedReceiptDigestJson(
+  serializedReceiptJson: string,
+): Promise<string> {
+  return digestPayload(
+    canonicalJson(
+      parsePackagedAcceptancePersistedReceiptJson(serializedReceiptJson),
+    ),
+    "persistedReceipt.receiptDigestSha256",
+  );
+}
+
+function canonicalResultPayload(
+  result: PackagedAcceptanceTestcaseResultCore,
+): string {
+  return JSON.stringify([
+    RESULT_DIGEST_DOMAIN,
+    PACKAGED_ACCEPTANCE_SCHEMA_VERSION,
+    result.runId,
+    result.testcaseRunId,
+    result.testcaseId,
+    result.sequence,
+    result.subjectSlot,
+    result.precondition,
+    result.preconditionStatus,
+    result.expectedTransition,
+    result.observedTransition,
+    result.securityAssertion,
+    result.securityAssertionStatus,
+    result.hostFingerprint,
+    result.sourceCommitSha,
+    result.signedAppSha256,
+    result.signedDmgSha256,
+    result.stagingProjectRef,
+    result.stagingOrigin,
+    result.fixtureDigest,
+    result.fixtureVersion,
+    result.schemaGeneration,
+    result.outcome,
+    result.severity,
+    result.evidenceSha256,
+    result.humanWitness,
+    result.failureInjection,
+  ]);
+}
+
+async function digestPayload(payload: string, path: string): Promise<string> {
+  const subtle = globalThis.crypto?.subtle;
+  if (subtle === undefined) fail(path, "SHA-256 is unavailable");
+  const digest = await subtle.digest(
+    "SHA-256",
+    new TextEncoder().encode(payload),
+  );
+  return Array.from(new Uint8Array(digest), (byte) =>
+    byte.toString(16).padStart(2, "0"),
+  ).join("");
+}
+
+function canonicalJson(value: unknown): string {
+  if (value === null || typeof value !== "object") {
+    const encoded = JSON.stringify(value);
+    if (encoded === undefined) fail("canonical JSON", "unsupported primitive");
+    return encoded;
+  }
+  if (Array.isArray(value)) {
+    return `[${value.map((entry) => canonicalJson(entry)).join(",")}]`;
+  }
+  return `{${Object.keys(value)
+    .sort()
+    .map(
+      (key) =>
+        `${JSON.stringify(key)}:${canonicalJson(
+          (value as Record<string, unknown>)[key],
+        )}`,
+    )
+    .join(",")}}`;
+}
+
+function deepFreeze<T>(value: T): T {
+  if (typeof value !== "object" || value === null) return value;
+  const stack: object[] = [value];
+  const seen = new WeakSet<object>();
+  while (stack.length > 0) {
+    const current = stack.pop();
+    if (current === undefined || seen.has(current)) continue;
+    seen.add(current);
+    for (const nested of Object.values(current)) {
+      if (typeof nested === "object" && nested !== null) stack.push(nested);
+    }
+    Object.freeze(current);
+  }
+  return value;
+}
+
+async function manifestDigest(
+  manifest: PackagedAcceptanceManifest,
+): Promise<string> {
+  return digestPayload(
+    canonicalJson(manifest),
+    "manifest.manifestDigestSha256",
+  );
+}
+
+export async function computePackagedAcceptanceManifestDigestJson(
+  serializedJson: string,
+): Promise<string> {
+  return manifestDigest(parsePackagedAcceptanceManifestJson(serializedJson));
+}
+
+async function healthPayloadDigest(
+  payload: PackagedAcceptanceHealthPayload,
+): Promise<string> {
+  return digestPayload(canonicalJson(payload), "health.payloadDigestSha256");
+}
+
+export async function computePackagedAcceptanceHealthPayloadDigestJson(
+  serializedJson: string,
+): Promise<string> {
+  return healthPayloadDigest(
+    parseHealthPayload(
+      parseSerializedJson(serializedJson, "healthPayload"),
+      "healthPayload",
+    ),
+  );
+}
+
+export async function computeRunScopedHostFingerprint(
+  runId: string,
+  runNonce: string,
+  privacySafeHardwareInputSha256: string,
+): Promise<string> {
+  const parsedRunId = uuid(runId, "host fingerprint runId");
+  const nonce = canonicalUnpaddedBase64Url(
+    runNonce,
+    32,
+    "host fingerprint run nonce",
+  );
+  const hardwareInput = sha256(
+    privacySafeHardwareInputSha256,
+    "host fingerprint privacy-safe hardware input",
+  );
+  return digestPayload(
+    JSON.stringify([
+      HOST_FINGERPRINT_DOMAIN,
+      PACKAGED_ACCEPTANCE_SCHEMA_VERSION,
+      parsedRunId,
+      nonce,
+      hardwareInput,
+    ]),
+    "host fingerprint",
+  );
+}
+
+export async function computePackagedAcceptanceResultDigestJson(
+  serializedJson: string,
+): Promise<string> {
+  return resultDigest(
+    parseResultCore(parseSerializedJson(serializedJson, "result"), "result"),
+  );
+}
+
+function resultDigest(
+  result: PackagedAcceptanceTestcaseResultCore,
+): Promise<string> {
+  return digestPayload(canonicalResultPayload(result), "result.resultSha256");
+}
+
+function assertHostRuntimeIdentity(host: PackagedAcceptanceHost): void {
+  const valid =
+    (host.hardwareFamily === "apple-silicon" &&
+      host.architecture === "arm64" &&
+      host.executionMode === "native") ||
+    (host.hardwareFamily === "apple-silicon" &&
+      host.architecture === "x86_64" &&
+      host.executionMode === "rosetta") ||
+    (host.hardwareFamily === "intel" &&
+      host.architecture === "x86_64" &&
+      host.executionMode === "native");
+  if (!valid) {
+    fail(
+      `host ${host.hostFingerprint}`,
+      "hardware family, architecture, and execution mode are inconsistent",
+    );
+  }
+}
+
+function assertHardwareCoverage(
+  hosts: readonly PackagedAcceptanceHost[],
+  policy: HardwareCoveragePolicy,
+): void {
+  const counts = {
+    appleNative: hosts.filter(
+      (host) =>
+        host.hardwareFamily === "apple-silicon" &&
+        host.architecture === "arm64" &&
+        host.executionMode === "native",
+    ).length,
+    appleRosetta: hosts.filter(
+      (host) =>
+        host.hardwareFamily === "apple-silicon" &&
+        host.architecture === "x86_64" &&
+        host.executionMode === "rosetta",
+    ).length,
+    intelNative: hosts.filter(
+      (host) =>
+        host.hardwareFamily === "intel" &&
+        host.architecture === "x86_64" &&
+        host.executionMode === "native",
+    ).length,
+  };
+  const satisfied =
+    (policy === "apple-silicon-native-and-intel-native" &&
+      counts.appleNative === 1 &&
+      counts.intelNative === 1) ||
+    (policy === "apple-silicon-native-and-rosetta" &&
+      counts.appleNative === 1 &&
+      counts.appleRosetta === 1) ||
+    (policy === "two-apple-silicon-native" && counts.appleNative === 2);
+  if (!satisfied) {
+    fail(
+      "manifest.hardwareCoveragePolicy",
+      `hosts do not satisfy hardware coverage policy ${policy}`,
+    );
+  }
+}
+
+function sameBinding(
+  host: PackagedAcceptanceHost,
+  manifest: PackagedAcceptanceManifest,
+): boolean {
+  return (
+    host.sourceCommitSha === manifest.source.commitSha &&
+    host.signedAppSha256 === manifest.artifact.signedAppSha256 &&
+    host.signedDmgSha256 === manifest.artifact.signedDmgSha256 &&
+    host.stagingProjectRef === manifest.staging.projectRef &&
+    host.stagingOrigin === manifest.staging.origin &&
+    host.fixtureDigest === manifest.staging.fixtureDigest &&
+    host.fixtureVersion === manifest.staging.fixtureVersion &&
+    host.schemaGeneration === manifest.staging.schemaGeneration
+  );
+}
+
+function sameResultBinding(
+  result: PackagedAcceptanceTestcaseResult,
+  host: PackagedAcceptanceHost,
+): boolean {
+  return (
+    result.sourceCommitSha === host.sourceCommitSha &&
+    result.signedAppSha256 === host.signedAppSha256 &&
+    result.signedDmgSha256 === host.signedDmgSha256 &&
+    result.stagingProjectRef === host.stagingProjectRef &&
+    result.stagingOrigin === host.stagingOrigin &&
+    result.fixtureDigest === host.fixtureDigest &&
+    result.fixtureVersion === host.fixtureVersion &&
+    result.schemaGeneration === host.schemaGeneration
+  );
+}
+
+function resultCore(
+  result: PackagedAcceptanceTestcaseResult,
+): PackagedAcceptanceTestcaseResultCore {
+  const { resultSha256, ...core } = result;
+  void resultSha256;
+  return core;
+}
+
+interface ValidatedManifestSummary {
+  readonly cleanHostCount: 1 | 2;
+  readonly testcaseResultCount: number;
+  readonly hosts: readonly PackagedAcceptanceReceiptHost[];
+}
+
+async function validateAndSummarizeManifest(
+  manifest: PackagedAcceptanceManifest,
+): Promise<ValidatedManifestSummary> {
+  if (manifest.hosts.length !== 2) {
+    fail("manifest.hosts", "exactly two hosts are required");
+  }
+  const hostFingerprints = new Set(
+    manifest.hosts.map(({ hostFingerprint }) => hostFingerprint),
+  );
+  if (hostFingerprints.size !== 2) {
+    fail("manifest.hosts", "two distinct hosts are required");
+  }
+
+  for (const host of manifest.hosts) {
+    if (host.runId !== manifest.runId) {
+      fail(`host ${host.hostFingerprint}`, "cross-run host is not permitted");
+    }
+    if (host.fingerprintRunId !== manifest.runId) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "host fingerprint must be scoped to this run",
+      );
+    }
+    if (!sameBinding(host, manifest)) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "cross-artifact or staging host binding is not permitted",
+      );
+    }
+    if (
+      host.download.signedDmgSha256 !== manifest.artifact.signedDmgSha256 ||
+      host.download.releasePathDigestSha256 !==
+        manifest.artifact.publicArtifact.releasePathDigestSha256
+    ) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "fresh download is bound to a different DMG artifact",
+      );
+    }
+    if (
+      host.installation.sourceReleasePathDigestSha256 !==
+        host.download.releasePathDigestSha256 ||
+      host.installation.signedAppSha256 !== manifest.artifact.signedAppSha256 ||
+      host.installation.signedDmgSha256 !== manifest.artifact.signedDmgSha256
+    ) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "installation is not bound to the fresh download and exact signed artifact",
+      );
+    }
+    if (host.quarantine.mutated) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "quarantine mutation invalidates acceptance",
+      );
+    }
+    if (host.cleanHost && host.developerCheckoutPresent) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "clean host cannot contain a developer checkout",
+      );
+    }
+    if (host.cleanHost && host.priorDesmosLockStatePresent) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "clean host cannot contain prior DesmosLock state",
+      );
+    }
+    if (host.firstOpen.humanWitness !== "witnessed") {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "fresh download and first-open Gatekeeper launch must be human witnessed",
+      );
+    }
+    if (host.installation.humanWitness !== "witnessed") {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "fresh DMG installation must be human witnessed",
+      );
+    }
+    assertHostRuntimeIdentity(host);
+  }
+  const downloadBrowsers = new Set(
+    manifest.hosts.map(({ download }) => download.browser),
+  );
+  if (!downloadBrowsers.has("chrome") || !downloadBrowsers.has("safari")) {
+    fail(
+      "manifest.hosts",
+      "fresh-download evidence must cover both Chrome and Safari",
+    );
+  }
+
+  const trulyCleanHosts = manifest.hosts.filter(
+    (host) =>
+      host.cleanHost &&
+      !host.developerCheckoutPresent &&
+      !host.priorDesmosLockStatePresent,
+  );
+  if (trulyCleanHosts.length < 1) {
+    fail("manifest.hosts", "at least one truly clean host is required");
+  }
+  assertHardwareCoverage(manifest.hosts, manifest.hardwareCoveragePolicy);
+
+  const seenTestcaseRunIds = new Set<string>();
+  const seenEvidenceDigests = new Set<string>();
+  const pendingDigestChecks: Array<{
+    readonly result: PackagedAcceptanceTestcaseResult;
+    readonly path: string;
+  }> = [];
+
+  for (const host of manifest.hosts) {
+    const testcaseIds = new Set<string>();
+    for (const [index, result] of host.testcases.entries()) {
+      const path = `host ${host.hostFingerprint} testcase ${result.testcaseId}`;
+      if (testcaseIds.has(result.testcaseId)) {
+        fail(path, "duplicate testcase is not permitted");
+      }
+      testcaseIds.add(result.testcaseId);
+      const specification = REQUIRED_PACKAGED_ACCEPTANCE_TESTCASES[index];
+      if (
+        specification === undefined ||
+        result.testcaseId !== specification.id
+      ) {
+        fail(path, "journey and fault testcase ordering is invalid");
+      }
+      if (
+        result.sequence !== specification.sequence ||
+        result.subjectSlot !== specification.subjectSlot ||
+        result.precondition !== specification.precondition ||
+        result.expectedTransition !== specification.expectedTransition ||
+        result.securityAssertion !== specification.securityAssertion
+      ) {
+        fail(
+          path,
+          "typed testcase specification does not match required journey",
+        );
+      }
+      if (seenTestcaseRunIds.has(result.testcaseRunId)) {
+        fail(path, "duplicate testcase run is not permitted");
+      }
+      seenTestcaseRunIds.add(result.testcaseRunId);
+      if (seenEvidenceDigests.has(result.evidenceSha256)) {
+        fail(path, "duplicate evidence digest is not permitted");
+      }
+      seenEvidenceDigests.add(result.evidenceSha256);
+
+      if (result.runId !== manifest.runId) {
+        fail(path, "cross-run testcase is not permitted");
+      }
+      if (result.hostFingerprint !== host.hostFingerprint) {
+        fail(path, "cross-host testcase is not permitted");
+      }
+      if (!sameResultBinding(result, host)) {
+        fail(path, "cross-artifact, staging, or fixture result binding");
+      }
+      if (result.severity === "critical" || result.severity === "high") {
+        fail(path, `${result.severity} severity blocks acceptance`);
+      }
+      if (result.outcome !== "passed") {
+        fail(path, `${result.outcome} outcome blocks acceptance`);
+      }
+      if (result.severity !== "none") {
+        fail(path, "a passing outcome must have no unresolved severity");
+      }
+      if (result.preconditionStatus !== "satisfied") {
+        fail(path, "testcase precondition is unsatisfied or unverifiable");
+      }
+      if (result.observedTransition !== result.expectedTransition) {
+        fail(
+          path,
+          "observed state transition does not match expected transition",
+        );
+      }
+      if (result.securityAssertionStatus !== "satisfied") {
+        fail(path, "security assertion is violated or unverifiable");
+      }
+      if (result.humanWitness !== "witnessed") {
+        fail(path, "human witness status must be witnessed");
+      }
+      if (
+        result.failureInjection !==
+        EXPECTED_FAILURE_INJECTION.get(result.testcaseId)
+      ) {
+        fail(path, "failure-injection category does not match testcase");
+      }
+      pendingDigestChecks.push({ result, path });
+    }
+
+    if (
+      testcaseIds.size !== REQUIRED_PACKAGED_ACCEPTANCE_TESTCASES.length ||
+      REQUIRED_PACKAGED_ACCEPTANCE_TESTCASES.some(
+        ({ id }) => !testcaseIds.has(id),
+      )
+    ) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "complete required testcase set is mandatory",
+      );
+    }
+  }
+
+  for (const host of manifest.hosts) {
+    const firstJoin = host.testcases.find(
+      ({ testcaseId }) => testcaseId === "accountless-student-join-1",
+    );
+    const secondJoin = host.testcases.find(
+      ({ testcaseId }) => testcaseId === "accountless-student-join-2",
+    );
+    const crossSchool = host.testcases.find(
+      ({ testcaseId }) => testcaseId === "cross-school-rejection",
+    );
+    if (
+      firstJoin?.subjectSlot !== "student-slot-1" ||
+      secondJoin?.subjectSlot !== "student-slot-2" ||
+      new Set([firstJoin.subjectSlot, secondJoin.subjectSlot]).size !== 2
+    ) {
+      fail(
+        `host ${host.hostFingerprint}`,
+        "two distinct student slots are required",
+      );
+    }
+    if (
+      crossSchool?.subjectSlot !== "cross-school-student" ||
+      crossSchool.expectedTransition !== "cross-school-join-denied" ||
+      crossSchool.observedTransition !== "cross-school-join-denied" ||
+      crossSchool.securityAssertion !== "cross-school-boundary-enforced"
+    ) {
+      fail(`host ${host.hostFingerprint}`, "cross-School denial is required");
+    }
+  }
+
+  for (const { result, path } of pendingDigestChecks) {
+    const expected = await resultDigest(resultCore(result));
+    if (result.resultSha256 !== expected) {
+      fail(path, "result digest does not match deterministic outcome metadata");
+    }
+  }
+
+  const hosts = [...manifest.hosts]
+    .sort((left, right) =>
+      left.hostFingerprint.localeCompare(right.hostFingerprint),
+    )
+    .map<PackagedAcceptanceReceiptHost>((host) => ({
+      hostFingerprint: host.hostFingerprint,
+      fingerprintRunId: host.fingerprintRunId,
+      fingerprintVersion: host.fingerprintVersion,
+      hardwareFamily: host.hardwareFamily,
+      architecture: host.architecture,
+      executionMode: host.executionMode,
+      os: host.os,
+      download: host.download,
+      installation: {
+        status: "installed-from-fresh-downloaded-dmg",
+        sourceReleasePathDigestSha256:
+          host.installation.sourceReleasePathDigestSha256,
+        signedAppSha256: host.installation.signedAppSha256,
+        signedDmgSha256: host.installation.signedDmgSha256,
+        completedBeforeFirstOpen: true,
+        humanWitness: "witnessed",
+      },
+      quarantine: {
+        presentBeforeFirstOpen: true,
+        mutated: false,
+      },
+      firstOpen: {
+        gatekeeperAssessment: "accepted",
+        launchStatus: "launched",
+        humanWitness: "witnessed",
+      },
+      cleanHost: host.cleanHost,
+      developerCheckoutPresent: host.developerCheckoutPresent,
+      priorDesmosLockStatePresent: host.priorDesmosLockStatePresent,
+      testcases: host.testcases.map<PackagedAcceptanceReceiptTestcase>(
+        (result) => ({
+          testcaseRunId: result.testcaseRunId,
+          testcaseId: result.testcaseId,
+          sequence: result.sequence,
+          subjectSlot: result.subjectSlot,
+          precondition: result.precondition,
+          preconditionStatus: "satisfied",
+          expectedTransition: result.expectedTransition,
+          observedTransition: result.observedTransition,
+          securityAssertion: result.securityAssertion,
+          securityAssertionStatus: "satisfied",
+          outcome: "passed",
+          severity: "none",
+          evidenceSha256: result.evidenceSha256,
+          resultSha256: result.resultSha256,
+          humanWitness: "witnessed",
+          failureInjection: result.failureInjection,
+        }),
+      ),
+    }));
+
+  return {
+    cleanHostCount: trulyCleanHosts.length as 1 | 2,
+    testcaseResultCount:
+      manifest.hosts.length * REQUIRED_PACKAGED_ACCEPTANCE_TESTCASES.length,
+    hosts,
+  };
+}
+
+interface VerifiedTrustIdentity {
+  readonly signerIdentitySha256: string;
+  readonly attestationIdentitySha256: string;
+  readonly privacySafeHardwareInputSha256?: string;
+}
+
+interface SpecificationEvaluationRecord {
+  readonly evidence: PackagedAcceptanceEvidenceEnvelope;
+  readonly canonicalEvidenceJson: string;
+  readonly canonicalExpectedContextJson: string;
+  readonly manifest: PackagedAcceptanceManifest;
+  readonly manifestDigestSha256: string;
+  readonly aggregateDigestSha256: string;
+  readonly healthPayloadDigestSha256: string;
+  readonly nonceDigestSha256: string;
+  readonly collectorAttestationIds: readonly [string, string];
+  readonly humanWitnessAttestationIds: readonly [string, string];
+  readonly healthAttestationId: string;
+  readonly collectorAttestations: readonly {
+    readonly envelope: PackagedAcceptanceHostAttestationEnvelope;
+    readonly identity: VerifiedTrustIdentity;
+  }[];
+  readonly humanWitnessAttestations: readonly {
+    readonly envelope: PackagedAcceptanceHostAttestationEnvelope;
+    readonly identity: VerifiedTrustIdentity;
+  }[];
+  readonly healthAttestation: {
+    readonly envelope: PackagedAcceptanceHealthAttestationEnvelope;
+    readonly identity: VerifiedTrustIdentity;
+  };
+  readonly trustPolicyIdentity: PackagedAcceptanceTrustPolicyIdentity;
+  readonly summary: ValidatedManifestSummary;
+}
+
+const EVALUATED_SPECIFICATIONS = new WeakMap<
+  object,
+  SpecificationEvaluationRecord
+>();
+
+function sameCanonicalValue(left: unknown, right: unknown): boolean {
+  return canonicalJson(left) === canonicalJson(right);
+}
+
+function parseTrustPolicyIdentity(
+  value: unknown,
+  path: string,
+): PackagedAcceptanceTrustPolicyIdentity {
+  const record = strictRecord(value, path, TRUST_POLICY_IDENTITY_KEYS);
+  return {
+    policyId: exactString(
+      record.policyId,
+      "external-readiness-trust-policy-v1",
+      `${path}.policyId`,
+    ),
+    policyDigestSha256: sha256(
+      record.policyDigestSha256,
+      `${path}.policyDigestSha256`,
+    ),
+    trustRootFingerprintSha256: sha256(
+      record.trustRootFingerprintSha256,
+      `${path}.trustRootFingerprintSha256`,
+    ),
+  };
+}
+
+function parseExpectedAuthorityContextJson(
+  serializedJson: string,
+): PackagedAcceptanceExpectedAuthorityContext {
+  const path = "expectedAuthorityContext";
+  const snapshot = parseSerializedJson(serializedJson, path);
+  const record = strictRecord(snapshot, path, EXPECTED_AUTHORITY_CONTEXT_KEYS);
+  return {
+    schemaVersion: integerInRange(
+      record.schemaVersion,
+      1,
+      1,
+      `${path}.schemaVersion`,
+    ) as 1,
+    kind: exactString(
+      record.kind,
+      PACKAGED_ACCEPTANCE_AUTHORITY_CONTEXT_KIND,
+      `${path}.kind`,
+    ),
+    authoritySignerIdentitySha256: sha256(
+      record.authoritySignerIdentitySha256,
+      `${path}.authoritySignerIdentitySha256`,
+    ),
+    candidateDigestSha256: sha256(
+      record.candidateDigestSha256,
+      `${path}.candidateDigestSha256`,
+    ),
+    trustPolicyIdentity: parseTrustPolicyIdentity(
+      record.trustPolicyIdentity,
+      `${path}.trustPolicyIdentity`,
+    ),
+  };
+}
+
+function parseTrustDecision(
+  serializedJson: string,
+  path: string,
+): PackagedAcceptanceTrustDecision {
+  const snapshot = parseSerializedJson(serializedJson, path);
+  if (!isRecord(snapshot)) fail(path, "must be a plain object");
+  if (snapshot.status === "rejected") {
+    strictRecord(snapshot, path, REJECTED_TRUST_DECISION_KEYS);
+    return { status: "rejected" };
+  }
+  if (snapshot.status !== "verified") {
+    fail(`${path}.status`, "contains an unsupported value");
+  }
+  const hasHardwareInput = Object.prototype.hasOwnProperty.call(
+    snapshot,
+    "privacySafeHardwareInputSha256",
+  );
+  const record = strictRecord(
+    snapshot,
+    path,
+    hasHardwareInput
+      ? VERIFIED_COLLECTOR_TRUST_DECISION_KEYS
+      : VERIFIED_TRUST_DECISION_KEYS,
+  );
+  return {
+    status: "verified",
+    signerIdentitySha256: sha256(
+      record.signerIdentitySha256,
+      `${path}.signerIdentitySha256`,
+    ),
+    attestationIdentitySha256: sha256(
+      record.attestationIdentitySha256,
+      `${path}.attestationIdentitySha256`,
+    ),
+    ...(hasHardwareInput
+      ? {
+          privacySafeHardwareInputSha256: sha256(
+            record.privacySafeHardwareInputSha256,
+            `${path}.privacySafeHardwareInputSha256`,
+          ),
+        }
+      : {}),
+  };
+}
+
+async function verifyTrustedAttestation(
+  trustPolicy: PackagedAcceptanceTrustPolicy,
+  role: PackagedAcceptanceAttestationRole,
+  envelope:
+    | PackagedAcceptanceHostAttestationEnvelope
+    | PackagedAcceptanceHealthAttestationEnvelope,
+  expectedPayloadDigestSha256: string,
+  path: string,
+): Promise<VerifiedTrustIdentity> {
+  if (envelope.payloadDigestSha256 !== expectedPayloadDigestSha256) {
+    fail(path, "attestation is not bound to the exact expected digest");
+  }
+  let decision: PackagedAcceptanceTrustDecision;
+  try {
+    const rawDecision = await trustPolicy.verifyAttestation({
+      role,
+      envelope: Object.freeze({ ...envelope }),
+      expectedPayloadDigestSha256,
+      signingPayload: canonicalJson({
+        domain: "desmoslock-packaged-acceptance-attestation-v1",
+        ...Object.fromEntries(
+          Object.entries(envelope).filter(
+            ([key]) => key !== "signatureBase64Url",
+          ),
+        ),
+      }),
+    });
+    decision = parseTrustDecision(rawDecision, `${path}.decision`);
+  } catch {
+    fail(path, "trust-policy verification failed closed");
+  }
+  if (decision.status !== "verified") {
+    fail(path, "attestation signature or trust policy was rejected");
+  }
+  if (
+    role !== "collector" &&
+    decision.privacySafeHardwareInputSha256 !== undefined
+  ) {
+    fail(path, "only collector trust decisions may carry hardware provenance");
+  }
+  const signerIdentitySha256 = sha256(
+    decision.signerIdentitySha256,
+    `${path}.signerIdentitySha256`,
+  );
+  const attestationIdentitySha256 = sha256(
+    decision.attestationIdentitySha256,
+    `${path}.attestationIdentitySha256`,
+  );
+  if (decision.privacySafeHardwareInputSha256 === undefined) {
+    return { signerIdentitySha256, attestationIdentitySha256 };
+  }
+  return {
+    signerIdentitySha256,
+    attestationIdentitySha256,
+    privacySafeHardwareInputSha256: sha256(
+      decision.privacySafeHardwareInputSha256,
+      `${path}.privacySafeHardwareInputSha256`,
+    ),
+  };
+}
+
+function assertExpectedRunContext(
+  manifest: PackagedAcceptanceManifest,
+  context: PackagedAcceptanceExpectedRunContext,
+): void {
+  if (manifest.runId !== context.runId) {
+    fail("expectedContext.runId", "manifest is from a different run");
+  }
+  if (manifest.hardwareCoveragePolicy !== context.hardwareCoveragePolicy) {
+    fail(
+      "expectedContext.hardwareCoveragePolicy",
+      "manifest hardware coverage policy is not independently pinned",
+    );
+  }
+  if (!sameCanonicalValue(manifest.challenge, context.challenge)) {
+    fail(
+      "expectedContext.challenge",
+      "manifest challenge is not independently pinned",
+    );
+  }
+  if (!sameCanonicalValue(manifest.source, context.source)) {
+    fail(
+      "expectedContext.source",
+      "manifest source does not match pinned source",
+    );
+  }
+  if (!sameCanonicalValue(manifest.artifact, context.artifact)) {
+    fail(
+      "expectedContext.artifact",
+      "manifest artifact does not match pinned signed artifact",
+    );
+  }
+  const manifestStaging = {
+    environment: manifest.staging.environment,
+    projectRef: manifest.staging.projectRef,
+    origin: manifest.staging.origin,
+    databaseIdentity: manifest.staging.databaseIdentity,
+    fixtureDigest: manifest.staging.fixtureDigest,
+    fixtureVersion: manifest.staging.fixtureVersion,
+    schemaGeneration: manifest.staging.schemaGeneration,
+    dataPolicy: manifest.staging.dataPolicy,
+  };
+  if (!sameCanonicalValue(manifestStaging, context.staging)) {
+    fail(
+      "expectedContext.staging",
+      "manifest staging/database/fixture identity is not independently pinned",
+    );
+  }
+}
+
+function assertHealthMatchesContext(
+  health: PackagedAcceptanceHealthPayload,
+  manifest: PackagedAcceptanceManifest,
+  context: PackagedAcceptanceExpectedRunContext,
+): void {
+  if (
+    health.projectRef !== context.staging.projectRef ||
+    health.origin !== context.staging.origin ||
+    health.databaseIdentity !== context.staging.databaseIdentity ||
+    health.fixtureDigest !== context.staging.fixtureDigest ||
+    health.fixtureVersion !== context.staging.fixtureVersion ||
+    health.schemaGeneration !== context.staging.schemaGeneration
+  ) {
+    fail(
+      "evidence.health",
+      "verified health does not match pinned staging context",
+    );
+  }
+  if (
+    health.attestationId !== manifest.staging.healthAttestationId ||
+    Date.parse(health.observedAtUtc) <
+      Date.parse(context.challenge.issuedAtUtc) ||
+    Date.parse(health.observedAtUtc) >=
+      Date.parse(context.challenge.expiresAtUtc)
+  ) {
+    fail(
+      "evidence.health",
+      "health attestation identity or observation time is outside the run challenge",
+    );
+  }
+}
+
+async function verifyHostAttestationSet(
+  attestations: readonly PackagedAcceptanceHostAttestationEnvelope[],
+  expectedRole: "collector" | "human-witness",
+  manifest: PackagedAcceptanceManifest,
+  manifestDigestSha256: string,
+  trustPolicy: PackagedAcceptanceTrustPolicy,
+): Promise<
+  readonly {
+    readonly envelope: PackagedAcceptanceHostAttestationEnvelope;
+    readonly identity: VerifiedTrustIdentity;
+  }[]
+> {
+  if (attestations.length !== 2) {
+    fail(
+      `evidence.${expectedRole}`,
+      `exactly two ${expectedRole} attestations are required`,
+    );
+  }
+  const expectedHosts = new Set(
+    manifest.hosts.map(({ hostFingerprint }) => hostFingerprint),
+  );
+  const subjects = new Set<string>();
+  const verified = [];
+  for (const [index, envelope] of attestations.entries()) {
+    const path = `evidence.${expectedRole}[${index}]`;
+    if (envelope.role !== expectedRole) {
+      fail(path, `attestation role must be ${expectedRole}`);
+    }
+    if (
+      !expectedHosts.has(envelope.subjectHostFingerprint) ||
+      subjects.has(envelope.subjectHostFingerprint)
+    ) {
+      fail(path, "attestation host subject is missing, reused, or cross-run");
+    }
+    subjects.add(envelope.subjectHostFingerprint);
+    verified.push({
+      envelope,
+      identity: await verifyTrustedAttestation(
+        trustPolicy,
+        expectedRole,
+        envelope,
+        manifestDigestSha256,
+        path,
+      ),
+    });
+  }
+  return verified;
+}
+
+export async function evaluatePackagedAcceptanceSpecificationJson(
+  serializedEvidenceJson: string,
+  serializedExpectedContextJson: string,
+  ports: PackagedAcceptanceVerificationPorts,
+): Promise<PackagedAcceptanceSpecificationEvaluation> {
+  if (typeof ports.trustPolicy?.verifyAttestation !== "function") {
+    fail("verification ports", "the attestation trust policy is required");
+  }
+  const evidence = parseEvidenceSnapshot(
+    parseSerializedJson(serializedEvidenceJson, "evidence"),
+  );
+  const context = parseExpectedContextSnapshot(
+    parseSerializedJson(serializedExpectedContextJson, "expectedContext"),
+  );
+  const trustPolicyIdentity = parseTrustPolicyIdentity(
+    parseSerializedJson(
+      ports.serializedTrustPolicyIdentityJson,
+      "verification ports.trustPolicyIdentity",
+    ),
+    "verification ports.trustPolicyIdentity",
+  );
+  const manifestDigestSha256 = await manifestDigest(evidence.manifest);
+  if (evidence.manifestDigestSha256 !== manifestDigestSha256) {
+    fail(
+      "evidence.manifestDigestSha256",
+      "entire manifest digest does not match",
+    );
+  }
+  assertExpectedRunContext(evidence.manifest, context);
+  const summary = await validateAndSummarizeManifest(evidence.manifest);
+
+  const healthPayloadDigestSha256 = await healthPayloadDigest(
+    evidence.health.payload,
+  );
+  if (
+    evidence.health.payloadDigestSha256 !== healthPayloadDigestSha256 ||
+    evidence.health.attestation.payloadDigestSha256 !==
+      healthPayloadDigestSha256 ||
+    evidence.health.attestation.attestationId !==
+      evidence.health.payload.attestationId ||
+    evidence.manifest.staging.healthPayloadDigestSha256 !==
+      healthPayloadDigestSha256
+  ) {
+    fail(
+      "evidence.health",
+      "health payload, envelope, and manifest binding mismatch",
+    );
+  }
+  assertHealthMatchesContext(
+    evidence.health.payload,
+    evidence.manifest,
+    context,
+  );
+  const healthIdentity = await verifyTrustedAttestation(
+    ports.trustPolicy,
+    "backend-health",
+    evidence.health.attestation,
+    healthPayloadDigestSha256,
+    "evidence.health.attestation",
+  );
+
+  const collectorAttestations = await verifyHostAttestationSet(
+    evidence.collectorAttestations,
+    "collector",
+    evidence.manifest,
+    manifestDigestSha256,
+    ports.trustPolicy,
+  );
+  const humanWitnessAttestations = await verifyHostAttestationSet(
+    evidence.humanWitnessAttestations,
+    "human-witness",
+    evidence.manifest,
+    manifestDigestSha256,
+    ports.trustPolicy,
+  );
+  const collectorSignerIdentities = new Set(
+    collectorAttestations.map(({ identity }) => identity.signerIdentitySha256),
+  );
+  const collectorKeyIds = new Set(
+    collectorAttestations.map(({ envelope }) => envelope.keyId),
+  );
+  const collectorEvidenceIdentities = new Set(
+    collectorAttestations.map(
+      ({ identity }) => identity.attestationIdentitySha256,
+    ),
+  );
+  if (
+    collectorKeyIds.size !== 2 ||
+    collectorSignerIdentities.size !== 2 ||
+    collectorEvidenceIdentities.size !== 2
+  ) {
+    fail(
+      "evidence.collectorAttestations",
+      "collectors must have distinct verified key and attestation identities",
+    );
+  }
+  for (const { envelope, identity } of collectorAttestations) {
+    if (identity.privacySafeHardwareInputSha256 === undefined) {
+      fail(
+        "evidence.collectorAttestations",
+        "verified collector omitted privacy-safe hardware provenance",
+      );
+    }
+    const expectedFingerprint = await computeRunScopedHostFingerprint(
+      evidence.manifest.runId,
+      evidence.manifest.challenge.nonce,
+      identity.privacySafeHardwareInputSha256,
+    );
+    if (envelope.subjectHostFingerprint !== expectedFingerprint) {
+      fail(
+        "evidence.collectorAttestations",
+        "host fingerprint was not derived from verified run-scoped collector provenance",
+      );
+    }
+  }
+
+  const allAttestationIds = [
+    ...collectorAttestations.map(({ envelope }) => envelope.attestationId),
+    ...humanWitnessAttestations.map(({ envelope }) => envelope.attestationId),
+    evidence.health.attestation.attestationId,
+  ];
+  if (new Set(allAttestationIds).size !== allAttestationIds.length) {
+    fail(
+      "evidence attestations",
+      "duplicate attestation identity is not permitted",
+    );
+  }
+  const allVerifiedAttestationIdentities = [
+    ...collectorAttestations.map(
+      ({ identity }) => identity.attestationIdentitySha256,
+    ),
+    ...humanWitnessAttestations.map(
+      ({ identity }) => identity.attestationIdentitySha256,
+    ),
+    healthIdentity.attestationIdentitySha256,
+  ];
+  if (
+    new Set(allVerifiedAttestationIdentities).size !==
+    allVerifiedAttestationIdentities.length
+  ) {
+    fail(
+      "evidence attestations",
+      "duplicate verified attestation identity is not permitted",
+    );
+  }
+
+  const nonceDigestSha256 = await digestPayload(
+    JSON.stringify([
+      "desmoslock-packaged-acceptance-challenge-nonce-v1",
+      evidence.manifest.challenge.nonce,
+    ]),
+    "challenge.nonceDigestSha256",
+  );
+  const sortedCollectors = [...collectorAttestations].sort((left, right) =>
+    left.envelope.subjectHostFingerprint.localeCompare(
+      right.envelope.subjectHostFingerprint,
+    ),
+  );
+  const sortedWitnesses = [...humanWitnessAttestations].sort((left, right) =>
+    left.envelope.subjectHostFingerprint.localeCompare(
+      right.envelope.subjectHostFingerprint,
+    ),
+  );
+  const collectorAttestationIds: [string, string] = [
+    sortedCollectors[0]?.envelope.attestationId ?? fail("collector", "missing"),
+    sortedCollectors[1]?.envelope.attestationId ?? fail("collector", "missing"),
+  ];
+  const humanWitnessAttestationIds: [string, string] = [
+    sortedWitnesses[0]?.envelope.attestationId ?? fail("witness", "missing"),
+    sortedWitnesses[1]?.envelope.attestationId ?? fail("witness", "missing"),
+  ];
+  const aggregateDigestSha256 = await digestPayload(
+    canonicalJson({
+      kind: "desmoslock-packaged-acceptance-aggregate-v1",
+      manifestDigestSha256,
+      healthPayloadDigestSha256,
+      challengeId: evidence.manifest.challenge.challengeId,
+      nonceDigestSha256,
+      trustPolicyIdentity,
+      collectors: sortedCollectors.map(({ envelope, identity }) => ({
+        envelope,
+        signerIdentitySha256: identity.signerIdentitySha256,
+        attestationIdentitySha256: identity.attestationIdentitySha256,
+      })),
+      humanWitnesses: sortedWitnesses.map(({ envelope, identity }) => ({
+        envelope,
+        signerIdentitySha256: identity.signerIdentitySha256,
+        attestationIdentitySha256: identity.attestationIdentitySha256,
+      })),
+      health: {
+        envelope: evidence.health.attestation,
+        signerIdentitySha256: healthIdentity.signerIdentitySha256,
+        attestationIdentitySha256: healthIdentity.attestationIdentitySha256,
+      },
+    }),
+    "receipt.aggregateDigestSha256",
+  );
+
+  const evaluation: PackagedAcceptanceSpecificationEvaluation = deepFreeze({
+    schemaVersion: PACKAGED_ACCEPTANCE_SCHEMA_VERSION,
+    kind: PACKAGED_ACCEPTANCE_SPECIFICATION_EVALUATION_KIND,
+    status: "specification_satisfied",
+    trustBoundary: "untrusted-caller-supplied-adapters",
+    authorizationScope: EXTERNAL_READINESS_AUTHORIZATION_SCOPE,
+    runId: evidence.manifest.runId,
+    manifestDigestSha256,
+    aggregateDigestSha256,
+    healthPayloadDigestSha256,
+    challenge: {
+      challengeId: evidence.manifest.challenge.challengeId,
+      nonceDigestSha256,
+      issuedAtUtc: evidence.manifest.challenge.issuedAtUtc,
+      expiresAtUtc: evidence.manifest.challenge.expiresAtUtc,
+      ledgerRevision: evidence.manifest.challenge.ledgerRevision,
+    },
+    adapterAssertedAttestations: {
+      collectorAttestationIds,
+      humanWitnessAttestationIds,
+      healthAttestationId: evidence.health.attestation.attestationId,
+    },
+    trustPolicyIdentity,
+    hardwareCoveragePolicy: evidence.manifest.hardwareCoveragePolicy,
+    source: evidence.manifest.source,
+    artifact: evidence.manifest.artifact,
+    staging: evidence.manifest.staging,
+    hostCount: 2,
+    cleanHostCount: summary.cleanHostCount,
+    testcaseResultCount: summary.testcaseResultCount,
+    hosts: summary.hosts,
+  });
+  EVALUATED_SPECIFICATIONS.set(evaluation, {
+    evidence,
+    canonicalEvidenceJson: canonicalJson(evidence),
+    canonicalExpectedContextJson: canonicalJson(context),
+    manifest: evidence.manifest,
+    manifestDigestSha256,
+    aggregateDigestSha256,
+    healthPayloadDigestSha256,
+    nonceDigestSha256,
+    collectorAttestationIds,
+    humanWitnessAttestationIds,
+    healthAttestationId: evidence.health.attestation.attestationId,
+    collectorAttestations: sortedCollectors,
+    humanWitnessAttestations: sortedWitnesses,
+    healthAttestation: {
+      envelope: evidence.health.attestation,
+      identity: healthIdentity,
+    },
+    trustPolicyIdentity,
+    summary,
+  });
+  return evaluation;
+}
+
+async function settlementRequestFor(
+  record: SpecificationEvaluationRecord,
+): Promise<PackagedAcceptanceAuthoritySettlementRequest> {
+  const candidateDigestSha256 = await authorityCandidateDigestFromCanonicalJson(
+    record.canonicalEvidenceJson,
+    record.canonicalExpectedContextJson,
+  );
+  return deepFreeze({
+    schemaVersion: 1,
+    kind: PACKAGED_ACCEPTANCE_SETTLEMENT_REQUEST_KIND,
+    canonicalEvidenceJson: record.canonicalEvidenceJson,
+    canonicalExpectedContextJson: record.canonicalExpectedContextJson,
+    candidateDigestSha256,
+  });
+}
+
+function hostEnvelopeClaims(
+  envelope:
+    | PackagedAcceptanceHostAttestationEnvelope
+    | PackagedAcceptancePersistedHostAttestation,
+): object {
+  return {
+    attestationId: envelope.attestationId,
+    role: envelope.role,
+    subjectHostFingerprint: envelope.subjectHostFingerprint,
+    payloadDigestSha256: envelope.payloadDigestSha256,
+    algorithm: envelope.algorithm,
+    signatureBase64Url: envelope.signatureBase64Url,
+  };
+}
+
+function healthEnvelopeClaims(
+  envelope:
+    | PackagedAcceptanceHealthAttestationEnvelope
+    | PackagedAcceptancePersistedHealthAttestation,
+): object {
+  return {
+    attestationId: envelope.attestationId,
+    role: envelope.role,
+    payloadDigestSha256: envelope.payloadDigestSha256,
+    algorithm: envelope.algorithm,
+    signatureBase64Url: envelope.signatureBase64Url,
+  };
+}
+
+function sortedCanonicalClaims(values: readonly object[]): readonly object[] {
+  return [...values].sort((left, right) =>
+    canonicalJson(left).localeCompare(canonicalJson(right)),
+  );
+}
+
+async function assertReceiptMatchesSubmittedEvidence(
+  receipt: PackagedAcceptancePersistedReceipt,
+  record: SpecificationEvaluationRecord,
+): Promise<void> {
+  const independentlyRecomputedCandidateDigestSha256 =
+    await authorityCandidateDigestFromCanonicalJson(
+      record.canonicalEvidenceJson,
+      record.canonicalExpectedContextJson,
+    );
+  if (
+    receipt.candidateDigestSha256 !==
+    independentlyRecomputedCandidateDigestSha256
+  ) {
+    fail(
+      "authority settlement candidateDigestSha256",
+      "persisted receipt does not bind the independently recomputed complete evidence/context",
+    );
+  }
+  const receiptClaims = {
+    runId: receipt.runId,
+    manifestDigestSha256: receipt.manifestDigestSha256,
+    healthPayloadDigestSha256: receipt.healthPayloadDigestSha256,
+    hardwareCoveragePolicy: receipt.hardwareCoveragePolicy,
+    challenge: {
+      challengeId: receipt.challenge.challengeId,
+      nonceDigestSha256: receipt.challenge.nonceDigestSha256,
+      issuedAtUtc: receipt.challenge.issuedAtUtc,
+      expiresAtUtc: receipt.challenge.expiresAtUtc,
+      ledgerRevision: receipt.challenge.ledgerRevision,
+    },
+    collectors: sortedCanonicalClaims(
+      receipt.attestations.collectors.map(hostEnvelopeClaims),
+    ),
+    humanWitnesses: sortedCanonicalClaims(
+      receipt.attestations.humanWitnesses.map(hostEnvelopeClaims),
+    ),
+    health: healthEnvelopeClaims(receipt.attestations.health),
+  };
+  const evidenceClaims = {
+    runId: record.evidence.manifest.runId,
+    manifestDigestSha256: record.manifestDigestSha256,
+    healthPayloadDigestSha256: record.healthPayloadDigestSha256,
+    hardwareCoveragePolicy: record.evidence.manifest.hardwareCoveragePolicy,
+    challenge: {
+      challengeId: record.evidence.manifest.challenge.challengeId,
+      nonceDigestSha256: record.nonceDigestSha256,
+      issuedAtUtc: record.evidence.manifest.challenge.issuedAtUtc,
+      expiresAtUtc: record.evidence.manifest.challenge.expiresAtUtc,
+      ledgerRevision: record.evidence.manifest.challenge.ledgerRevision,
+    },
+    collectors: sortedCanonicalClaims(
+      record.evidence.collectorAttestations.map(hostEnvelopeClaims),
+    ),
+    humanWitnesses: sortedCanonicalClaims(
+      record.evidence.humanWitnessAttestations.map(hostEnvelopeClaims),
+    ),
+    health: healthEnvelopeClaims(record.evidence.health.attestation),
+  };
+  if (!sameCanonicalValue(receiptClaims, evidenceClaims)) {
+    fail(
+      "authority settlement",
+      "persisted receipt does not match the complete submitted evidence",
+    );
+  }
+  if (
+    receipt.aggregateDigestSha256 !== (await authorityAggregateDigest(receipt))
+  ) {
+    fail(
+      "authority settlement aggregateDigestSha256",
+      "persisted receipt aggregate does not match the required candidate-bound formula",
+    );
+  }
