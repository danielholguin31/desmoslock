+    authority: "external-readiness-artifact-authority-v1",
+    approvedHost: PACKAGED_ACCEPTANCE_APPROVED_ARTIFACT_HOST,
+    releasePathGrammar: PACKAGED_ACCEPTANCE_RELEASE_PATH_GRAMMAR,
