+async function sha256Text(value: string): Promise<string> {
+  const digest = await globalThis.crypto.subtle.digest(
+    "SHA-256",
+    new TextEncoder().encode(value),
+  );
+  return Array.from(new Uint8Array(digest), (byte) =>
+    byte.toString(16).padStart(2, "0"),
+  ).join("");
+}
+
+function persistedHostAttestationFromAuthority(
+  envelope: PackagedAcceptanceEvidenceEnvelope["collectorAttestations"][number],
+) {
+  const identity = trustIdentityFor(envelope.keyId);
+  if (identity === undefined) throw new Error("authority key pin is missing");
+  return {
+    attestationId: envelope.attestationId,
+    role: envelope.role,
+    subjectHostFingerprint: envelope.subjectHostFingerprint,
+    payloadDigestSha256: envelope.payloadDigestSha256,
+    signerIdentitySha256: identity.signerIdentitySha256,
+    attestationIdentitySha256: identity.attestationIdentitySha256,
+    algorithm: envelope.algorithm,
+    signatureBase64Url: envelope.signatureBase64Url,
+  };
+}
