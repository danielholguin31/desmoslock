+async function buildSettledReceiptFixture(): Promise<{
+  readonly receipt: PackagedAcceptancePersistedReceipt;
+  readonly serializedReceiptJson: string;
+  readonly signingPayload: string;
+  readonly receiptDigestSha256: string;
+  readonly durableSettlement: PackagedAcceptanceDurableSettlementRecord;
+  readonly expectedAuthorityContextJson: string;
+}> {
+  const fixture = await buildFixture();
+  const evaluation = await verifyPackagedAcceptanceEvidence(
+    fixture.evidence,
+    fixture.context,
+    fixture.ports,
+  );
+  const authorityLedger = new TestAuthoritySettlementPort();
+  const submission = await submitPackagedAcceptanceForAuthoritySettlement(
+    evaluation,
+    authorityLedger,
+  );
+  if (submission.status !== "authority_receipt_returned_unverified") {
+    throw new Error("test authority did not return a receipt");
+  }
+  const receipt = JSON.parse(
+    submission.serializedReceiptJson,
+  ) as PackagedAcceptancePersistedReceipt;
+  const signingPayload = computePackagedAcceptanceAuthoritySigningPayloadJson(
+    submission.serializedReceiptJson,
+  );
+  const receiptDigestSha256 =
+    await computePackagedAcceptancePersistedReceiptDigestJson(
+      submission.serializedReceiptJson,
+    );
+  return {
+    receipt,
+    serializedReceiptJson: submission.serializedReceiptJson,
+    signingPayload,
+    receiptDigestSha256,
+    durableSettlement: durableSettlementFor(receipt, receiptDigestSha256),
+    expectedAuthorityContextJson: JSON.stringify(
+      expectedAuthorityContextFor(receipt.candidateDigestSha256),
+    ),
+  };
+}
