+async function bindManifest(
+  fixture: AcceptanceFixture,
+  manifest: PackagedAcceptanceManifest,
+): Promise<PackagedAcceptanceEvidenceEnvelope> {
+  const manifestDigestSha256 =
+    await computePackagedAcceptanceManifestDigestJson(JSON.stringify(manifest));
+  const evidence = structuredClone(fixture.evidence);
+  const collectorAttestations = evidence.collectorAttestations.map(
+    (attestation, index) => ({
+      ...attestation,
+      subjectHostFingerprint:
+        manifest.hosts[index]?.hostFingerprint ??
+        attestation.subjectHostFingerprint,
+      payloadDigestSha256: manifestDigestSha256,
+    }),
+  );
+  const humanWitnessAttestations = evidence.humanWitnessAttestations.map(
+    (attestation, index) => ({
+      ...attestation,
+      subjectHostFingerprint:
+        manifest.hosts[index]?.hostFingerprint ??
+        attestation.subjectHostFingerprint,
+      payloadDigestSha256: manifestDigestSha256,
+    }),
+  );
+  return {
+    ...evidence,
+    manifest: structuredClone(manifest),
+    manifestDigestSha256,
+    collectorAttestations,
+    humanWitnessAttestations,
+  };
+}
