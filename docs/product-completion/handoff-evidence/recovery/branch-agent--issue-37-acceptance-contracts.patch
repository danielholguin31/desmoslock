+export async function submitPackagedAcceptanceForAuthoritySettlement(
+  evaluation: PackagedAcceptanceSpecificationEvaluation,
+  authorityLedger: PackagedAcceptanceAuthoritySettlementPort,
+): Promise<PackagedAcceptanceAuthoritySettlementSubmission> {
+  if (typeof evaluation !== "object" || evaluation === null) {
+    fail("specification evaluation", "module-produced evaluation is required");
+  }
+  const record = EVALUATED_SPECIFICATIONS.get(evaluation);
+  if (record === undefined) {
+    fail(
+      "specification evaluation",
+      "module-produced evaluation is required; caller brands are rejected",
+    );
+  }
+  if (
+    typeof authorityLedger?.independentlyVerifyAndAtomicallySettle !==
+    "function"
+  ) {
+    fail("authority settlement", "atomic authority ledger adapter is required");
+  }
+  const request = await settlementRequestFor(record);
+  let responseSnapshot: unknown;
+  try {
+    responseSnapshot = parseSerializedJson(
+      await authorityLedger.independentlyVerifyAndAtomicallySettle(request),
+      "authority settlement response",
+    );
+  } catch {
+    fail("authority settlement", "authority ledger failed closed");
+  }
+  if (!isRecord(responseSnapshot)) {
+    fail("authority settlement response", "must be a plain object");
+  }
+  if (
+    responseSnapshot.status === "expired" ||
+    responseSnapshot.status === "replayed" ||
+    responseSnapshot.status === "conflict"
+  ) {
+    const rejected = strictRecord(
+      responseSnapshot,
+      "authority settlement response",
+      SETTLEMENT_PORT_REJECTION_KEYS,
+    );
+    return {
+      status: "authority_rejected",
+      reason: oneOf<"expired" | "replayed" | "conflict">(
+        rejected.status,
+        new Set(["expired", "replayed", "conflict"]),
+        "authority settlement response.status",
+      ),
+    };
+  }
+  const persisted = strictRecord(
+    responseSnapshot,
+    "authority settlement response",
+    SETTLEMENT_PORT_PERSISTED_KEYS,
+  );
+  exactString(
+    persisted.status,
+    "persisted",
+    "authority settlement response.status",
+  );
+  if (typeof persisted.serializedReceiptJson !== "string") {
+    fail(
+      "authority settlement response.serializedReceiptJson",
+      "must be serialized JSON text",
+    );
+  }
+  const receipt = parsePackagedAcceptancePersistedReceiptJson(
+    persisted.serializedReceiptJson,
+  );
+  await assertReceiptMatchesSubmittedEvidence(receipt, record);
+  return {
+    status: "authority_receipt_returned_unverified",
+    serializedReceiptJson: persisted.serializedReceiptJson,
+  };
+}
+
+interface AuthorityVerificationDecision {
+  readonly status: "verified";
+  readonly signerIdentitySha256: string;
+  readonly trustRootFingerprintSha256: string;
+  readonly policyDigestSha256: string;
+}
+
+function parseAuthorityVerificationDecision(
+  serializedJson: string,
+): AuthorityVerificationDecision | { readonly status: "rejected" } {
+  const path = "authority signature verification response";
+  const snapshot = parseSerializedJson(serializedJson, path);
+  if (!isRecord(snapshot)) fail(path, "must be a plain object");
+  if (snapshot.status === "rejected") {
+    strictRecord(snapshot, path, AUTHORITY_VERIFIER_REJECTED_KEYS);
+    return { status: "rejected" };
+  }
+  const record = strictRecord(snapshot, path, AUTHORITY_VERIFIER_VERIFIED_KEYS);
+  return {
+    status: exactString(record.status, "verified", `${path}.status`),
+    signerIdentitySha256: sha256(
+      record.signerIdentitySha256,
+      `${path}.signerIdentitySha256`,
+    ),
+    trustRootFingerprintSha256: sha256(
+      record.trustRootFingerprintSha256,
+      `${path}.trustRootFingerprintSha256`,
+    ),
+    policyDigestSha256: sha256(
+      record.policyDigestSha256,
+      `${path}.policyDigestSha256`,
+    ),
+  };
+}
+
+function parseDurableSettlement(
+  value: unknown,
+  path: string,
+): PackagedAcceptanceDurableSettlementRecord {
+  const record = strictRecord(value, path, DURABLE_SETTLEMENT_KEYS);
+  return {
+    receiptDigestSha256: sha256(
+      record.receiptDigestSha256,
+      `${path}.receiptDigestSha256`,
+    ),
+    runId: uuid(record.runId, `${path}.runId`),
+    candidateDigestSha256: sha256(
+      record.candidateDigestSha256,
+      `${path}.candidateDigestSha256`,
+    ),
+    manifestDigestSha256: sha256(
+      record.manifestDigestSha256,
+      `${path}.manifestDigestSha256`,
+    ),
+    aggregateDigestSha256: sha256(
+      record.aggregateDigestSha256,
+      `${path}.aggregateDigestSha256`,
+    ),
+    challengeId: uuid(record.challengeId, `${path}.challengeId`),
+    settlementId: uuid(record.settlementId, `${path}.settlementId`),
+    issuedAtUtc: utcSecond(record.issuedAtUtc, `${path}.issuedAtUtc`),
+    expiresAtUtc: utcSecond(record.expiresAtUtc, `${path}.expiresAtUtc`),
+    consumedAtUtc: utcSecond(record.consumedAtUtc, `${path}.consumedAtUtc`),
+    ledgerRevision: integerInRange(
+      record.ledgerRevision,
+      0,
+      Number.MAX_SAFE_INTEGER - 1,
+      `${path}.ledgerRevision`,
+    ),
+    consumedRevision: integerInRange(
+      record.consumedRevision,
+      1,
+      Number.MAX_SAFE_INTEGER,
+      `${path}.consumedRevision`,
+    ),
+    policyDigestSha256: sha256(
+      record.policyDigestSha256,
+      `${path}.policyDigestSha256`,
+    ),
+    trustRootFingerprintSha256: sha256(
+      record.trustRootFingerprintSha256,
+      `${path}.trustRootFingerprintSha256`,
+    ),
+    authoritySignerIdentitySha256: sha256(
+      record.authoritySignerIdentitySha256,
+      `${path}.authoritySignerIdentitySha256`,
+    ),
+  };
+}
+
+function receiptSettlementRecord(
+  receipt: PackagedAcceptancePersistedReceipt,
+  receiptDigestSha256: string,
+): PackagedAcceptanceDurableSettlementRecord {
+  return {
+    receiptDigestSha256,
+    runId: receipt.runId,
+    candidateDigestSha256: receipt.candidateDigestSha256,
+    manifestDigestSha256: receipt.manifestDigestSha256,
+    aggregateDigestSha256: receipt.aggregateDigestSha256,
+    challengeId: receipt.challenge.challengeId,
+    settlementId: receipt.challenge.settlementId,
+    issuedAtUtc: receipt.challenge.issuedAtUtc,
+    expiresAtUtc: receipt.challenge.expiresAtUtc,
+    consumedAtUtc: receipt.challenge.consumedAtUtc,
+    ledgerRevision: receipt.challenge.ledgerRevision,
+    consumedRevision: receipt.challenge.consumedRevision,
+    policyDigestSha256: receipt.trustPolicyIdentity.policyDigestSha256,
+    trustRootFingerprintSha256:
+      receipt.trustPolicyIdentity.trustRootFingerprintSha256,
+    authoritySignerIdentitySha256: receipt.authority.signerIdentitySha256,
+  };
+}
+
+export async function inspectPackagedAcceptancePersistedReceiptJson(
+  serializedReceiptJson: string,
+  serializedExpectedAuthorityContextJson: string,
+  ports: PackagedAcceptancePersistedReceiptInspectionPorts,
+): Promise<PackagedAcceptanceUntrustedSettlementInspection> {
+  if (
+    typeof ports.authoritySignatureVerifier?.verifyAuthoritySignature !==
+      "function" ||
+    typeof ports.settlementReader?.readCurrentSettlement !== "function"
+  ) {
+    fail(
+      "persisted receipt inspection",
+      "authority signature and durable settlement read adapters are required",
+    );
+  }
+  const expectedAuthorityContext = parseExpectedAuthorityContextJson(
+    serializedExpectedAuthorityContextJson,
+  );
+  const receipt = parsePackagedAcceptancePersistedReceiptJson(
+    serializedReceiptJson,
+  );
+  if (
+    receipt.authority.signerIdentitySha256 !==
+      expectedAuthorityContext.authoritySignerIdentitySha256 ||
+    receipt.candidateDigestSha256 !==
+      expectedAuthorityContext.candidateDigestSha256 ||
+    !sameCanonicalValue(
+      receipt.trustPolicyIdentity,
+      expectedAuthorityContext.trustPolicyIdentity,
+    )
+  ) {
+    fail(
+      "persisted receipt expected authority context",
+      "receipt-selected authority, candidate, or trust root does not match the independent pin",
+    );
+  }
+  if (
+    receipt.aggregateDigestSha256 !== (await authorityAggregateDigest(receipt))
+  ) {
+    fail(
+      "persisted receipt aggregateDigestSha256",
+      "does not match the required candidate-bound aggregate formula",
+    );
+  }
+  const receiptDigestSha256 =
+    await computePackagedAcceptancePersistedReceiptDigestJson(
+      serializedReceiptJson,
+    );
+  let authorityDecision:
+    | AuthorityVerificationDecision
+    | {
+        readonly status: "rejected";
+      };
+  try {
+    authorityDecision = parseAuthorityVerificationDecision(
+      await ports.authoritySignatureVerifier.verifyAuthoritySignature({
+        signingPayload: authorityReceiptSigningPayload(receipt),
+        signatureBase64Url: receipt.authority.signatureBase64Url,
+        claimedSignerIdentitySha256:
+          expectedAuthorityContext.authoritySignerIdentitySha256,
+        trustRootFingerprintSha256:
+          expectedAuthorityContext.trustPolicyIdentity
+            .trustRootFingerprintSha256,
+        policyDigestSha256:
+          expectedAuthorityContext.trustPolicyIdentity.policyDigestSha256,
+      }),
+    );
+  } catch {
+    fail("persisted receipt authority signature", "verification failed closed");
+  }
+  if (authorityDecision.status !== "verified") {
+    fail("persisted receipt authority signature", "signature was rejected");
+  }
+  if (
+    authorityDecision.signerIdentitySha256 !==
+      expectedAuthorityContext.authoritySignerIdentitySha256 ||
+    authorityDecision.trustRootFingerprintSha256 !==
+      expectedAuthorityContext.trustPolicyIdentity.trustRootFingerprintSha256 ||
+    authorityDecision.policyDigestSha256 !==
+      expectedAuthorityContext.trustPolicyIdentity.policyDigestSha256
+  ) {
+    fail(
+      "persisted receipt authority signature",
+      "verified authority or trust policy identity does not match receipt",
+    );
+  }
+
+  let settlementSnapshot: unknown;
+  try {
+    settlementSnapshot = parseSerializedJson(
+      await ports.settlementReader.readCurrentSettlement({
+        challengeId: receipt.challenge.challengeId,
+        settlementId: receipt.challenge.settlementId,
+        receiptDigestSha256,
+      }),
+      "durable settlement read response",
+    );
+  } catch {
+    fail("durable settlement read", "ledger read failed closed");
+  }
+  if (!isRecord(settlementSnapshot)) {
+    fail("durable settlement read response", "must be a plain object");
+  }
+  if (
+    settlementSnapshot.status === "missing" ||
+    settlementSnapshot.status === "superseded" ||
+    settlementSnapshot.status === "replayed"
+  ) {
+    const rejected = strictRecord(
+      settlementSnapshot,
+      "durable settlement read response",
+      SETTLEMENT_READ_REJECTED_KEYS,
+    );
+    fail(
+      "durable settlement read",
+      `receipt settlement is ${String(rejected.status)}`,
+    );
+  }
+  const current = strictRecord(
+    settlementSnapshot,
+    "durable settlement read response",
+    SETTLEMENT_READ_CURRENT_KEYS,
+  );
+  exactString(
+    current.status,
+    "current",
+    "durable settlement read response.status",
+  );
+  const settlement = parseDurableSettlement(
+    current.settlement,
+    "durable settlement read response.settlement",
+  );
+  if (
+    settlement.consumedRevision !== settlement.ledgerRevision + 1 ||
+    Date.parse(settlement.consumedAtUtc) < Date.parse(settlement.issuedAtUtc) ||
+    Date.parse(settlement.consumedAtUtc) >=
+      Date.parse(settlement.expiresAtUtc) ||
+    !sameCanonicalValue(
+      settlement,
+      receiptSettlementRecord(receipt, receiptDigestSha256),
+    )
+  ) {
+    fail(
+      "durable settlement read",
+      "ledger record does not exactly bind the signed receipt or atomic challenge consumption",
+    );
+  }
+  return deepFreeze({
+    status: "untrusted_adapter_assertions_only",
+    acceptanceDecision: "not-established",
+    trustBoundary: "caller-supplied-pin-signature-and-ledger-adapters",
+    receiptDigestSha256,
+    candidateDigestSha256: receipt.candidateDigestSha256,
+    runId: receipt.runId,
+    challengeId: receipt.challenge.challengeId,
+    settlementId: receipt.challenge.settlementId,
+    authoritySignerIdentitySha256: authorityDecision.signerIdentitySha256,
+    trustRootFingerprintSha256: authorityDecision.trustRootFingerprintSha256,
+  });
+}
