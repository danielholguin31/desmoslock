+      readonly role: "administrator" | "owner";
+    }
+  | {
+      readonly access: StaffAuthAccessGrant;
+      readonly challengeReceipt: string;
+      readonly kind: "step_up";
+      readonly role: "administrator" | "owner";
+    };
+
+interface PendingInvitation {
